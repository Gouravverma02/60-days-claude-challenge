  if (!S.voiceEnabled || !speechSynth) return;
  if (currentUtterance && !priority) return; // Don't interrupt
  if (currentUtterance) { speechSynth.cancel(); currentUtterance = null; }
  const utt = new SpeechSynthesisUtterance(text);
  // Prefer a high-quality English voice
  const voices = speechSynth.getVoices();
  const preferred = voices.find(v => /google|natural|premium|samantha|daniel|karen|moira/i.test(v.name) && /en/i.test(v.lang))
    || voices.find(v => /en-US|en-GB/i.test(v.lang))
    || voices[0];
  if (preferred) utt.voice = preferred;
  utt.rate  = 0.92;
  utt.pitch = 1.0;
  utt.volume = 1.0;
  utt.onstart = () => {
    document.getElementById('voice-indicator').classList.add('visible');
  };
  utt.onend = utt.onerror = () => {
    document.getElementById('voice-indicator').classList.remove('visible');
    currentUtterance = null;
  };
  speechSynth.speak(utt);
  currentUtterance = utt;
}

function stopSpeech() {
  if (speechSynth) { speechSynth.cancel(); currentUtterance = null; }
  document.getElementById('voice-indicator').classList.remove('visible');
}

function toggleVoice() {
  S.voiceEnabled = !S.voiceEnabled;
  const btn = document.getElementById('voice-btn');
  if (S.voiceEnabled) {
    btn.textContent = '🔇 Voice Off';
    btn.classList.add('active-voice');
    speak('Voice instructions enabled. Welcome to the Prior Authorization Workflow Simulator. Select a patient scenario to begin.', true);
  } else {
    btn.textContent = '🔊 Voice On';
    btn.classList.remove('active-voice');
    stopSpeech();
  }
}

function readEduNote() {
  const text = document.getElementById('edu-body').textContent;
  if (text) speak(text, true);
}


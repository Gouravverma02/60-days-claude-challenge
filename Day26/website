/* STEP 3: Doc collection UI */
function renderDocCollection() {
  const remaining = S.scenario.docs.filter(d => !S.docs.includes(d.name));
  const allDone   = remaining.length === 0;

  // Build doc grid in ap-btns
  const btnsEl = document.getElementById('ap-btns');
  const grid   = document.createElement('div');
  grid.id = 'doc-grid';

  S.scenario.docs.forEach(d => {
    const done = S.docs.includes(d.name);
    const item = document.createElement('div');
    item.className = 'doc-item' + (done ? ' doc-done' : '');
    item.innerHTML = `
      <div class="doc-check">${done ? '✅' : d.icon}</div>
      <div class="dn">${d.name}</div>
      ${done ? '<div style="font-size:10px;color:#a8f0c8;margin-top:3px">Collected</div>' : '<div style="font-size:10px;color:rgba(255,255,255,.5);margin-top:3px">Click to collect</div>'}`;
    if (!done) item.onclick = () => collectDoc(d.name);
    grid.appendChild(item);
  });

  btnsEl.innerHTML = '';
  btnsEl.appendChild(grid);

  // Progress note
  const note = document.createElement('div');
  note.style.cssText = 'font-size:12px;color:rgba(255,255,255,.6);margin-top:8px;';
  note.textContent = `${S.docs.length} of ${S.scenario.docs.length} documents collected`;
  btnsEl.appendChild(note);

  if (allDone) {
    const btn = document.createElement('button');
    btn.className = 'act-btn c-green';
    btn.style.marginTop = '10px';
    btn.innerHTML = '📤 All Docs Collected — Submit PA';
    btn.onclick = moveToSubmission;
    btnsEl.appendChild(btn);
    speak('All documents collected. You may now submit the prior authorization to the payer.');
  }

  updateStats();
  placeCard('doc-collection');
}

function collectDoc(name) {
  if (!S.docs.includes(name)) {
    S.docs.push(name);
    addDays(1);
    logStep('Document Collected', name, 'doc-collection');
    showToast('📎 Collected: ' + name, 'blue');
    speak('Collected: ' + name);
  }
  renderDocCollection();
}


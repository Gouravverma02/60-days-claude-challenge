<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prior Authorization Workflow Simulator</title>
<style>
/* ═══════════════════════════════════════════
   DESIGN TOKENS
═══════════════════════════════════════════ */
:root {
  --b50:#e8f1fb;--b100:#c3d9f5;--b200:#9ac0ef;--b300:#5f9be4;
  --b400:#2e7dd6;--b500:#1a62b8;--b600:#114d9a;--b700:#0b3b7c;
  --b800:#072b5e;--b900:#041d42;
  --g50:#e6f7ed;--g400:#27ae60;--g700:#145a32;
  --a50:#fef9e7;--a400:#d4ac0d;--a700:#7d6608;
  --r50:#fdedec;--r400:#e74c3c;--r700:#922b21;
  --p50:#f5eef8;--p400:#8e44ad;--p700:#5b2c6f;
  --k50:#e8f8f5;--k400:#16a085;--k700:#0e6655;
  --gray50:#f8f9fa;--gray100:#eceff3;--gray200:#dde1e9;
  --gray400:#8a95a8;--gray600:#4e5a70;--gray800:#1e2535;
  --rs:6px;--rm:10px;--rl:16px;
  --sh-sm:0 2px 8px rgba(4,29,66,.10);
  --sh-md:0 6px 20px rgba(4,29,66,.14);
  --sh-lg:0 16px 48px rgba(4,29,66,.20);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  background:var(--b900);color:var(--gray800);min-height:100vh;
  font-size:14px;line-height:1.5;overflow-x:hidden;
}

/* ═══════════════════════════════════════════
   HEADER
═══════════════════════════════════════════ */
#hdr{
  background:linear-gradient(135deg,var(--b900) 0%,var(--b700) 100%);
  color:#fff;padding:14px 24px;display:flex;align-items:center;
  justify-content:space-between;gap:12px;flex-wrap:wrap;
  border-bottom:1px solid rgba(255,255,255,.08);position:sticky;top:0;z-index:100;
}
#hdr h1{font-size:18px;font-weight:800;letter-spacing:-.4px;display:flex;align-items:center;gap:8px}
#hdr .tag{font-size:11px;opacity:.6;margin-top:2px}
.hdr-ctrl{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.btn-hdr{
  background:rgba(255,255,255,.1);color:#fff;
  border:1px solid rgba(255,255,255,.2);padding:7px 14px;
  border-radius:var(--rs);font-size:12px;font-weight:600;
  cursor:pointer;transition:all .18s;display:flex;align-items:center;gap:5px;
}
.btn-hdr:hover{background:rgba(255,255,255,.2);border-color:rgba(255,255,255,.4)}
.btn-hdr.active-voice{background:rgba(46,158,90,.3);border-color:var(--g400);color:#a8f0c8}

/* ═══════════════════════════════════════════
   PROGRESS TRACKER
═══════════════════════════════════════════ */
#prog-bar{
  background:linear-gradient(90deg,var(--b800),var(--b700));
  padding:0 24px;display:flex;align-items:center;gap:0;overflow-x:auto;
  border-bottom:1px solid rgba(255,255,255,.06);
}
.pstep{display:flex;align-items:center;gap:0;flex-shrink:0;padding:10px 0}
.pdot{
  width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,.1);
  border:2px solid rgba(255,255,255,.15);display:flex;align-items:center;
  justify-content:center;font-size:11px;font-weight:800;color:rgba(255,255,255,.4);
  transition:all .35s cubic-bezier(.34,1.56,.64,1);flex-shrink:0;position:relative;
}
.pdot.active{background:var(--b300);border-color:#fff;color:#fff;
  box-shadow:0 0 0 4px rgba(95,155,228,.3);transform:scale(1.12)}
.pdot.done{background:var(--g400);border-color:#fff;color:#fff}
.plbl{
  font-size:10px;color:rgba(255,255,255,.55);white-space:nowrap;
  padding:0 8px;line-height:1.3;max-width:72px;text-align:center;
}
.plbl.active{color:#fff;font-weight:700}
.plbl.done{color:rgba(255,255,255,.8)}
.pline{width:28px;height:2px;background:rgba(255,255,255,.12);flex-shrink:0;transition:background .35s}
.pline.done{background:var(--g400)}

/* ═══════════════════════════════════════════
   STATS BAR
═══════════════════════════════════════════ */
#stats{
  background:rgba(4,29,66,.6);backdrop-filter:blur(8px);
  padding:8px 24px;display:flex;gap:0;align-items:stretch;
  border-bottom:1px solid rgba(255,255,255,.06);flex-wrap:wrap;
}
.stt{
  display:flex;align-items:center;gap:8px;padding:4px 20px;
  border-right:1px solid rgba(255,255,255,.08);color:rgba(255,255,255,.7);
  font-size:12px;
}
.stt:last-child{border-right:none}
.stt-val{font-size:18px;font-weight:800;color:#fff;line-height:1}
.stt-lbl{font-size:10px;opacity:.6;line-height:1;margin-top:2px}
.stt-icon{font-size:18px;opacity:.7}

/* Score color animation */
.score-high{color:#a8f0c8!important}
.score-med{color:#fde68a!important}
.score-low{color:#fca5a5!important}

/* ═══════════════════════════════════════════
   VOICE INDICATOR
═══════════════════════════════════════════ */
#voice-indicator{
  display:none;align-items:center;gap:8px;
  background:rgba(39,174,96,.15);border:1px solid rgba(39,174,96,.3);
  border-radius:var(--rs);padding:6px 14px;font-size:12px;color:#a8f0c8;
}
#voice-indicator.visible{display:flex}
.voice-wave{display:flex;align-items:flex-end;gap:2px;height:16px}
.voice-bar{
  width:3px;background:var(--g400);border-radius:2px;
  animation:wave 1s ease-in-out infinite;
}
.voice-bar:nth-child(2){animation-delay:.1s}
.voice-bar:nth-child(3){animation-delay:.2s}
.voice-bar:nth-child(4){animation-delay:.3s}
.voice-bar:nth-child(5){animation-delay:.4s}
@keyframes wave{
  0%,100%{height:4px}
  50%{height:14px}
}

/* ═══════════════════════════════════════════
   SCENARIO SELECT SCREEN
═══════════════════════════════════════════ */
#scene-sel{padding:28px 24px;background:var(--b900)}
.scene-hero{
  text-align:center;margin-bottom:28px;
}
.scene-hero h2{font-size:26px;font-weight:800;color:#fff;margin-bottom:8px}
.scene-hero p{font-size:14px;color:rgba(255,255,255,.55);max-width:500px;margin:0 auto}
#scene-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
  gap:16px;max-width:960px;margin:0 auto 24px;
}
.sc-card{
  background:#fff;border-radius:var(--rl);padding:22px 18px;
  cursor:pointer;border:2.5px solid transparent;box-shadow:var(--sh-md);
  transition:all .22s cubic-bezier(.34,1.56,.64,1);text-align:center;
  position:relative;overflow:hidden;
}
.sc-card::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(46,125,214,.06),transparent);
  opacity:0;transition:opacity .2s;
}
.sc-card:hover{
  border-color:var(--b300);transform:translateY(-4px) scale(1.01);
  box-shadow:var(--sh-lg);
}
.sc-card:hover::before{opacity:1}
.sc-card.sel{border-color:var(--b400);background:var(--b50);transform:translateY(-2px)}
.sc-card.sel::after{
  content:'✓';position:absolute;top:10px;right:12px;
  background:var(--b400);color:#fff;width:22px;height:22px;
  border-radius:50%;font-size:11px;font-weight:800;
  display:flex;align-items:center;justify-content:center;
}
.sc-icon{font-size:38px;margin-bottom:12px;display:block}
.sc-card h3{font-size:15px;font-weight:800;color:var(--b800);margin-bottom:3px}
.sc-card .sc-sub{font-size:12px;color:var(--gray600);margin-bottom:10px}
.sc-card .sc-desc{font-size:11px;color:var(--gray400);line-height:1.5;margin-bottom:12px;min-height:36px}
.sc-tags{display:flex;justify-content:center;gap:6px;flex-wrap:wrap}
.badge{
  font-size:10px;font-weight:700;padding:3px 8px;border-radius:20px;
  text-transform:uppercase;letter-spacing:.4px;white-space:nowrap;
}
.badge-lo{background:var(--g50);color:var(--g700)}
.badge-md{background:var(--a50);color:var(--a700)}
.badge-hi{background:var(--r50);color:var(--r700)}
.badge-type{background:var(--b50);color:var(--b700)}
.sc-meta-row{
  display:flex;justify-content:center;gap:16px;margin-top:10px;
  padding-top:10px;border-top:1px solid var(--gray100);
}
.sc-meta-item{text-align:center}
.sc-meta-item .mv{font-size:13px;font-weight:800;color:var(--b700)}
.sc-meta-item .ml{font-size:10px;color:var(--gray400)}

#start-wrap{text-align:center;margin-top:4px}
.btn-start{
  background:linear-gradient(135deg,var(--b400),var(--b500));
  color:#fff;border:none;padding:14px 40px;border-radius:var(--rm);
  font-size:16px;font-weight:800;cursor:pointer;box-shadow:var(--sh-md);
  transition:all .22s;display:inline-flex;align-items:center;gap:10px;
  letter-spacing:-.2px;
}
.btn-start:hover{transform:translateY(-2px);box-shadow:var(--sh-lg)}
.btn-start:disabled{opacity:.4;cursor:not-allowed;transform:none}

/* ═══════════════════════════════════════════
   WORKFLOW AREA
═══════════════════════════════════════════ */
#wf-area{display:none;padding:18px 20px 24px;background:var(--b900)}

/* LANES */
.lanes{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:16px}
.lane{
  border-radius:var(--rl);overflow:hidden;
  border:1px solid rgba(255,255,255,.1);
  background:rgba(255,255,255,.04);display:flex;flex-direction:column;
}
.lane-hdr{
  padding:12px 14px;display:flex;align-items:center;gap:8px;
  border-bottom:1px solid rgba(255,255,255,.07);
}
.lane-hdr .li{font-size:22px}
.lane-hdr h2{font-size:13px;font-weight:800;color:#fff}
.lane-hdr .ls{font-size:10px;color:rgba(255,255,255,.45);margin-top:1px}
.lane-patient .lane-hdr{background:linear-gradient(135deg,rgba(46,125,214,.3),rgba(46,125,214,.12))}
.lane-provider .lane-hdr{background:linear-gradient(135deg,rgba(39,174,96,.3),rgba(39,174,96,.12))}
.lane-payer .lane-hdr{background:linear-gradient(135deg,rgba(212,172,13,.3),rgba(212,172,13,.12))}

/* STAGES */
.stg{padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.05);flex:0 0 auto}
.stg:last-child{border-bottom:none;flex:1}
.stg-lbl{
  font-size:9px;font-weight:800;color:rgba(255,255,255,.35);
  text-transform:uppercase;letter-spacing:.7px;margin-bottom:5px;
  display:flex;align-items:center;gap:4px;
}
.stg-lbl .stg-num{
  background:rgba(255,255,255,.1);color:rgba(255,255,255,.5);
  width:16px;height:16px;border-radius:50%;font-size:8px;
  display:flex;align-items:center;justify-content:center;
}
.stg-lbl .stg-num.done{background:var(--g400);color:#fff}
.stg-lbl .stg-num.active{background:var(--b300);color:#fff;
  box-shadow:0 0 0 3px rgba(95,155,228,.25)}
.drop-zone{
  min-height:54px;border-radius:var(--rs);
  border:1.5px dashed rgba(255,255,255,.1);
  transition:all .2s;padding:4px;
  display:flex;flex-direction:column;gap:5px;
}
.drop-zone.dz-active{
  border-color:rgba(255,255,255,.3);
  background:rgba(255,255,255,.04);
}
.drop-zone.dz-hover{
  border-color:var(--b300);
  background:rgba(46,125,214,.12);
}
.drop-zone.dz-error{
  border-color:var(--r400)!important;
  background:rgba(231,76,60,.1)!important;
  animation:shake .3s ease;
}
@keyframes shake{
  0%,100%{transform:translateX(0)}
  25%{transform:translateX(-4px)}
  75%{transform:translateX(4px)}
}

/* CASE CARD */
.case-card{
  background:#fff;border-radius:var(--rs);padding:10px 12px;
  cursor:grab;box-shadow:var(--sh-sm);
  border-left:3px solid var(--b400);
  transition:all .2s;position:relative;user-select:none;
}
.case-card:hover{box-shadow:var(--sh-md);transform:translateY(-1px)}
.case-card.dragging{opacity:.45;transform:rotate(3deg) scale(.97);cursor:grabbing}
.case-card.card-approved{border-left-color:var(--g400)}
.case-card.card-denied{border-left-color:var(--r400)}
.case-card.card-pend{border-left-color:var(--a400)}
.case-card.card-appeal{border-left-color:var(--p400)}
.case-card.card-p2p{border-left-color:var(--k400)}
.cc-name{font-size:13px;font-weight:800;color:var(--b800);margin-bottom:2px}
.cc-type{font-size:11px;color:var(--gray600)}
.cc-code{font-size:10px;color:var(--gray400);margin-top:3px;font-family:monospace}
.cc-docs{margin-top:5px;display:flex;align-items:center;gap:3px;flex-wrap:wrap}
.doc-pip{
  width:8px;height:8px;border-radius:50%;background:var(--gray200);
  transition:background .3s;
}
.doc-pip.done{background:var(--g400)}
.cc-status{
  position:absolute;top:6px;right:8px;font-size:9px;font-weight:800;
  padding:2px 7px;border-radius:20px;text-transform:uppercase;letter-spacing:.4px;
}

/* ═══════════════════════════════════════════
   BOTTOM ACTION PANEL
═══════════════════════════════════════════ */
#action-panel{
  background:rgba(255,255,255,.06);border-radius:var(--rl);
  border:1px solid rgba(255,255,255,.1);overflow:hidden;
}
#ap-head{
  padding:14px 18px 0;display:flex;align-items:flex-start;
  justify-content:space-between;gap:10px;
}
#ap-title{font-size:16px;font-weight:800;color:#fff;line-height:1.3}
#ap-step-badge{
  font-size:10px;font-weight:800;color:var(--b300);
  background:rgba(46,125,214,.15);border:1px solid rgba(46,125,214,.25);
  padding:3px 10px;border-radius:20px;white-space:nowrap;flex-shrink:0;
  margin-top:2px;
}
#ap-body{padding:10px 18px 0}
#ap-desc{font-size:13px;color:rgba(255,255,255,.75);line-height:1.7;margin-bottom:12px}
#ap-btns{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.act-btn{
  border:none;padding:10px 18px;border-radius:var(--rs);
  font-size:13px;font-weight:700;cursor:pointer;
  transition:all .18s;display:inline-flex;align-items:center;gap:7px;
  color:#fff;position:relative;overflow:hidden;
}
.act-btn::after{
  content:'';position:absolute;inset:0;background:rgba(255,255,255,0);
  transition:background .15s;
}
.act-btn:hover::after{background:rgba(255,255,255,.12)}
.act-btn:active{transform:scale(.97)}
.act-btn.c-blue{background:linear-gradient(135deg,var(--b400),var(--b500))}
.act-btn.c-green{background:linear-gradient(135deg,#27ae60,#1e8449)}
.act-btn.c-amber{background:linear-gradient(135deg,#d4ac0d,#b7950b)}
.act-btn.c-red{background:linear-gradient(135deg,#e74c3c,#c0392b)}
.act-btn.c-purple{background:linear-gradient(135deg,#8e44ad,#7d3c98)}
.act-btn.c-teal{background:linear-gradient(135deg,#16a085,#0e6655)}

/* EDU PANEL */
#edu-panel{
  margin:0 18px 16px;border-radius:var(--rs);
  background:linear-gradient(135deg,rgba(46,125,214,.12),rgba(46,125,214,.06));
  border:1px solid rgba(46,125,214,.25);overflow:hidden;
}
.edu-head{
  padding:10px 14px;display:flex;align-items:center;gap:8px;
  border-bottom:1px solid rgba(46,125,214,.15);cursor:pointer;
  justify-content:space-between;
}
.edu-head .edu-title-txt{
  font-size:12px;font-weight:800;color:var(--b300);
  display:flex;align-items:center;gap:6px;
}
.edu-chevron{color:rgba(255,255,255,.4);font-size:12px;transition:transform .2s}
.edu-chevron.open{transform:rotate(180deg)}
#edu-text{
  font-size:13px;color:rgba(255,255,255,.75);line-height:1.7;
  padding:12px 14px;display:none;
}
#edu-text.open{display:block}
.edu-read-btn{
  display:flex;align-items:center;gap:5px;font-size:11px;
  color:var(--b300);background:none;border:none;cursor:pointer;
  padding:2px 0;font-weight:700;margin-top:6px;
}
.edu-read-btn:hover{color:#fff}

/* ═══════════════════════════════════════════
   DOC COLLECTION UI
═══════════════════════════════════════════ */
#doc-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
  gap:8px;margin-bottom:12px;
}
.doc-item{
  background:rgba(255,255,255,.07);border-radius:var(--rs);
  padding:10px 12px;border:1px solid rgba(255,255,255,.1);
  cursor:pointer;transition:all .2s;text-align:center;
}
.doc-item:hover:not(.doc-done){
  border-color:var(--b300);background:rgba(46,125,214,.15);
}
.doc-item.doc-done{
  border-color:var(--g400);background:rgba(39,174,96,.12);cursor:default;
}
.doc-item .di{font-size:20px;margin-bottom:4px}
.doc-item .dn{font-size:11px;font-weight:700;color:rgba(255,255,255,.8)}
.doc-item.doc-done .dn{color:#a8f0c8}
.doc-check{font-size:16px;margin-bottom:2px}

/* ═══════════════════════════════════════════
   DECISION BUTTONS (big)
═══════════════════════════════════════════ */
.decision-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
  gap:10px;margin-bottom:14px;
}
.dec-btn{
  border:none;border-radius:var(--rm);padding:16px 12px;cursor:pointer;
  transition:all .22s cubic-bezier(.34,1.56,.64,1);text-align:center;color:#fff;
  font-weight:800;font-size:13px;display:flex;flex-direction:column;
  align-items:center;gap:6px;
}
.dec-btn:hover{transform:translateY(-3px) scale(1.03);box-shadow:var(--sh-md)}
.dec-btn:active{transform:scale(.97)}
.dec-btn .di{font-size:26px}
.dec-btn .dt{font-size:11px;opacity:.85;font-weight:600;margin-top:2px}
.dec-approve{background:linear-gradient(135deg,#27ae60,#1d8348)}
.dec-pend{background:linear-gradient(135deg,#d4ac0d,#9a7d0a)}
.dec-deny{background:linear-gradient(135deg,#e74c3c,#a93226)}

/* ═══════════════════════════════════════════
   TOAST NOTIFICATION
═══════════════════════════════════════════ */
#toast-container{
  position:fixed;bottom:24px;right:24px;z-index:500;
  display:flex;flex-direction:column;gap:8px;pointer-events:none;
}
.toast{
  background:rgba(7,43,94,.95);backdrop-filter:blur(12px);
  color:#fff;padding:12px 18px;border-radius:var(--rm);
  font-size:13px;font-weight:600;box-shadow:var(--sh-lg);
  border:1px solid rgba(255,255,255,.1);
  animation:toast-in .3s cubic-bezier(.34,1.56,.64,1);
  display:flex;align-items:center;gap:8px;min-width:220px;
  pointer-events:all;
}
.toast.out{animation:toast-out .3s ease forwards}
.toast-icon{font-size:16px}
@keyframes toast-in{from{transform:translateX(120%);opacity:0}to{transform:none;opacity:1}}
@keyframes toast-out{from{opacity:1}to{transform:translateX(120%);opacity:0}}

/* ═══════════════════════════════════════════
   SUMMARY MODAL
═══════════════════════════════════════════ */
#sum-overlay{
  display:none;position:fixed;inset:0;
  background:rgba(4,29,66,.88);backdrop-filter:blur(8px);
  z-index:900;align-items:center;justify-content:center;padding:20px;
}
#sum-overlay.vis{display:flex}
#sum-modal{
  background:#fff;border-radius:var(--rl);padding:30px;
  max-width:560px;width:100%;box-shadow:var(--sh-lg);
  max-height:90vh;overflow-y:auto;animation:modal-in .35s cubic-bezier(.34,1.56,.64,1);
}
@keyframes modal-in{from{transform:scale(.85);opacity:0}to{transform:none;opacity:1}}
.sum-top{text-align:center;margin-bottom:20px}
.sum-emoji{font-size:52px;display:block;margin-bottom:10px;
  animation:pop .5s cubic-bezier(.34,1.56,.64,1) .1s both}
@keyframes pop{from{transform:scale(0)}to{transform:scale(1)}}
#sum-title{font-size:24px;font-weight:900;color:var(--b800)}
#sum-sub{font-size:14px;color:var(--gray600);margin-top:4px}
.sum-metrics{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:18px}
.sm{
  background:var(--b50);border-radius:var(--rm);padding:12px 14px;
  display:flex;flex-direction:column;gap:2px;
}
.sm .sv{font-size:20px;font-weight:900;color:var(--b900)}
.sm .sk{font-size:11px;color:var(--b600);font-weight:600}
.sum-journey h3{font-size:11px;font-weight:800;color:var(--gray400);
  text-transform:uppercase;letter-spacing:.6px;margin-bottom:10px}
.sj-item{
  display:flex;gap:10px;align-items:flex-start;
  padding:9px 0;border-bottom:1px solid var(--gray100);font-size:13px;
}
.sj-item:last-child{border:none}
.sj-num{

═══════════════════════════════════════════════════════════ */
function renderProgress() {
  const el = document.getElementById('prog-bar');
  el.innerHTML = PROGRESS_STEPS.map((p, i) => {
    const done   = i < S.progStep;
    const active = i === S.progStep;
    const dotCls = done ? 'pdot done' : active ? 'pdot active' : 'pdot';
    const lblCls = done ? 'plbl done' : active ? 'plbl active' : 'plbl';
    const lineCls= done ? 'pline done' : 'pline';
    const inner  = done ? '✓' : (i + 1);
    const labelTxt = p.label.replace('\n','<br>');
    return `<div class="pstep">
        <div class="${dotCls}">${inner}</div>
        <div class="${lblCls}">${labelTxt}</div>
      </div>
      ${i < PROGRESS_STEPS.length - 1 ? `<div class="${lineCls}"></div>` : ''}`;
  }).join('');
}

function advanceProgress(n) {
  S.progStep = Math.min(S.progStep + n, PROGRESS_STEPS.length - 1);
  renderProgress();
}


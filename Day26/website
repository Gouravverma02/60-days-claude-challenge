/* Apply outcome */
function applyOutcome(outcome) {
  S.outcome = outcome;
  addDays(1);
  logStep('Decision: ' + outcome.toUpperCase(), 'Payer determination issued', 'payer-decision');
  advanceProgress(1);

  if (outcome === 'approved') {
    placeCard('final-outcome');
    S.stage = 'final-outcome';
    showApprovalPanel();
  } else if (outcome === 'pend') {
    placeCard('payer-decision');
    showToast('⏳ Pended — additional info required', 'amber');
    speak('The payer has pended the request and requires additional clinical information. You may submit additional info or request a peer-to-peer review.');
    setPanel(
      '⏳ Outcome: PENDED — Additional Info Required',
      'Step 8b',
      `The payer has <strong>pended</strong> this request. They need additional clinical information before making a final determination.<br><br>
      You must respond within <strong>10–14 calendar days</strong> or the request will be administratively closed as a denial.`,
      [
        {label:'📋 Submit Additional Info', cls:'c-amber', fn:'moveToAppeal()'},
        {label:'📞 Request Peer-to-Peer',   cls:'c-teal',  fn:'moveToP2P()'},
      ],
      {title:'What is a "Pend" determination?', text:'A pend (also called "pend for information") means the payer has not yet approved or denied — they need more clinical documentation. This is not a denial and does not start the formal appeals clock. However, failure to respond in time results in an administrative closure, which effectively functions as a denial. Common pend reasons: missing lab values, incomplete treatment history, or unclear clinical rationale.'}
    );
  } else {
    placeCard('payer-decision');
    deduct(15, 'Authorization denied');
    showToast('❌ PA Denied by payer', 'red');
    speak('The prior authorization has been denied. You may file a formal appeal or request a peer to peer review with the payer\'s medical director.');
    setPanel(
      '❌ Outcome: DENIED',
      'Step 8c',
      `The payer has <strong>denied</strong> the PA for <strong>${S.scenario.name}</strong>. The denial notice includes the specific criteria not met.<br><br>
      You have options: file a formal internal appeal, or request a peer-to-peer (P2P) review with the payer's medical director. Both can be pursued simultaneously.`,
      [
        {label:'⚖️ File Formal Appeal', cls:'c-red',   fn:'moveToAppeal()'},
        {label:'📞 Request P2P Review', cls:'c-purple', fn:'moveToP2P()'},
      ],
      {title:'Common denial reasons', text:S.scenario.voice.edu.denial}
    );
  }
}

/* APPEAL */
function moveToAppeal() {
  S.outcome = 'appeal';
  addDays(S.scenario.days);
  deduct(10, 'Appeal required');
  placeCard('appeal');
  logStep('Appeal Filed', 'Formal appeal submitted with new evidence', 'appeal');
  setPhase('Appeal Review');
  showToast('⚖️ Formal appeal filed', 'purple');
  speak(S.scenario.voice.edu.appeal);
  setPanel(
    '⚖️ Step 9: Formal Appeal Filed',
    'Step 9 of 9',
    `A formal appeal has been submitted with new clinical evidence, peer-reviewed literature, and an updated physician letter of medical necessity.<br><br>
    <strong>Regulatory timelines:</strong> Standard appeal — 30–60 days · Expedited — 72 hours (urgent/ongoing treatment)`,
    [
      {label:'✅ Appeal Approved', cls:'c-green',  fn:"resolveAppeal('approved')"},
      {label:'❌ Appeal Denied',   cls:'c-red',    fn:"resolveAppeal('denied')"},
    ],
    {title:'The formal appeals process', text:S.scenario.voice.edu.appeal}
  );
}

/* P2P */
function moveToP2P() {
  S.outcome = 'p2p';
  addDays(3);
  deduct(5, 'P2P required');
  placeCard('appeal');
  logStep('P2P Review Requested', 'Physician-to-medical director call scheduled', 'appeal');
  setPhase('Peer-to-Peer Review');
  showToast('📞 P2P review scheduled', 'teal');
  speak(S.scenario.voice.edu.p2p);
  setPanel(
    '📞 Step 9: Peer-to-Peer Review',
    'Step 9 of 9',
    `The treating physician has scheduled a direct clinical discussion with the payer's medical director. During this call, the physician presents:<br><br>
    • Patient-specific clinical evidence<br>
    • Peer-reviewed medical literature<br>
    • Why the patient uniquely qualifies<br><br>
    <em style="font-size:12px;opacity:.7">P2P calls typically last 15–30 minutes and overturn denials 30–50% of the time</em>`,
    [
      {label:'✅ P2P Successful — Approved', cls:'c-green', fn:"resolveAppeal('approved')"},
      {label:'❌ P2P Failed — Still Denied', cls:'c-red',   fn:"resolveAppeal('denied')"},
    ],
    {title:'Peer-to-Peer review effectiveness', text:S.scenario.voice.edu.p2p}
  );
}

/* Resolve appeal/P2P */
function resolveAppeal(result) {
  S.appealOutcome = result;
  addDays(2);
  logStep('Final Decision after ' + (S.outcome === 'p2p' ? 'P2P' : 'Appeal'), result.toUpperCase(), 'final-outcome');

  if (result === 'approved') {
    S.outcome = 'approved';
    placeCard('final-outcome');
    advanceProgress(1);
    showApprovalPanel();
  } else {
    placeCard('final-outcome');
    advanceProgress(1);
    showFinalDenial();
  }
}

/* ═══════════════════════════════════════════════════════════
   APPROVAL & DENIAL PANELS
═══════════════════════════════════════════════════════════ */
function showApprovalPanel() {
  launchConfetti();
  const bonus = S.days <= S.scenario.days * 2 ? 15 : 0;
  S.score = Math.min(100, S.score + bonus);
  updateStats();
  setPhase('APPROVED ✅');
  showToast('🎉 Prior Authorization APPROVED!', 'green');
  speak('Congratulations! The prior authorization has been approved. An authorization number has been issued. The provider may now schedule the service.');
  logStep('APPROVED ✅', 'Authorization granted — auth number issued', 'final-outcome');

  setPanel(
    '🎉 APPROVED — Prior Authorization Granted!',
    'Complete',
    `<div style="background:var(--g50);border-radius:var(--rs);padding:12px 14px;color:var(--g700);font-weight:800;font-size:15px;margin-bottom:12px;">
      ✅ Authorization Number Issued for ${S.scenario.icon} ${S.scenario.name}
    </div>
    The provider may now schedule the service. The authorization number must be included on all claims for this service. Remember: PA approval ≠ payment guarantee — claims are still subject to adjudication.<br><br>
    <strong>PA expiration:</strong> typically 90–180 days`,
    [{label:'📊 View Full Summary', cls:'c-green', fn:'showSummary()'}],
    {title:'After PA approval — what happens next?', text:'An approved PA does not guarantee payment — it removes the medical necessity barrier. The provider must: (1) Schedule the service before the auth expires; (2) Submit the claim with the auth number; (3) The payer adjudicates the claim verifying the auth number, dates, provider, and benefit eligibility; (4) Cost-sharing (deductible, copay, coinsurance) is applied. If the auth expires before the service is rendered, a new PA is required.'}
  );
}

function showFinalDenial() {
  deduct(20, 'Final denial after all appeals');
  setPhase('DENIED 🚫');
  S.outcome = 'denied';
  placeCard('final-outcome');
  showToast('🚫 Final denial — all options exhausted', 'red');
  speak('The payer has upheld the denial after all internal appeals are exhausted. Further options include external independent review or state insurance department complaint.');
  logStep('FINAL DENIAL 🚫', 'All internal appeals exhausted', 'final-outcome');

  setPanel(
    '🚫 Final Outcome: Denied After All Appeals',
    'Complete',
    `<div style="background:var(--r50);border-radius:var(--rs);padding:12px 14px;color:var(--r700);font-weight:800;font-size:15px;margin-bottom:12px;">
      ❌ Authorization Denied — Internal Appeals Exhausted
    </div>
    The payer has upheld the denial. Remaining options include:<br><br>
    • <strong>External Independent Review</strong> — state-mandated third-party review (45–60 days)<br>
    • <strong>State Insurance Department</strong> — file a formal complaint<br>
    • <strong>Manufacturer PAP</strong> — for medications, patient assistance programs<br>
    • <strong>Patient Financial Counseling</strong> — explore self-pay or alternative funding`,
    [{label:'📊 View Workflow Summary', cls:'c-red', fn:'showSummary()'}],
    {title:'After final denial — regulatory rights', text:'After internal appeals are exhausted, patients have statutory rights in most states: (1) External Independent Review — required by ACA for non-grandfathered plans, must be completed in 45–60 days (4 business hours for urgent); (2) State Insurance Department complaint can trigger regulatory review; (3) Legal action is available but rarely practical for individual claims; (4) Many states have enacted PA reform legislation (Gold Carding, time limit laws, peer reviewer specialty matching requirements) that may provide additional protections.'}
  );
}

/* ═══════════════════════════════════════════════════════════
   SUMMARY
═══════════════════════════════════════════════════════════ */
function showSummary() {
  const sc = S.scenario;
  const approved = S.outcome === 'approved';
  const gradeScore = S.score;
  let grade, gradeCls, gradeLabel;
  if      (gradeScore >= 85) { grade='A'; gradeCls='grade-a'; gradeLabel='Excellent — Efficient Authorization' }
  else if (gradeScore >= 70) { grade='B'; gradeCls='grade-b'; gradeLabel='Good — Minor Delays' }
  else if (gradeScore >= 55) { grade='C'; gradeCls='grade-c'; gradeLabel='Fair — Multiple Setbacks' }
  else                       { grade='D'; gradeCls='grade-d'; gradeLabel='Needs Improvement — Many Denials' }

  document.getElementById('sum-emoji').textContent = approved ? '🎉' : '📋';
  document.getElementById('sum-title').textContent = approved ? 'Authorization Complete!' : 'Case Closed';
  document.getElementById('sum-sub').textContent   = sc.icon + ' ' + sc.name + ' — ' + sc.type;

  document.getElementById('sum-grade').className = 'sum-grade ' + gradeCls;
  document.getElementById('sum-grade').innerHTML = `Grade: ${grade} &nbsp;·&nbsp; ${gradeLabel}`;

  document.getElementById('sum-metrics').innerHTML = [
    {k:'Final Outcome',          v: approved ? '✅ Approved' : '❌ Denied',
     style: approved ? 'color:var(--g700)' : 'color:var(--r700)'},
    {k:'Efficiency Score',       v: gradeScore + '/100', style:''},
    {k:'Total Days Elapsed',     v: S.days + ' days', style:''},
    {k:'Documents Collected',    v: S.docs.length + ' / ' + sc.docs.length, style:''},
    {k:'ICD-10 Code',            v: sc.icd10, style:'font-family:monospace'},
    {k:'CPT Code',               v: sc.cpt,   style:'font-family:monospace'},
  ].map(m => `<div class="sm"><div class="sv" style="${m.style}">${m.v}</div><div class="sk">${m.k}</div></div>`).join('');

  document.getElementById('sum-steps').innerHTML = S.log.map((l, i) =>
    `<div class="sj-item">
      <div class="sj-num">${i+1}</div>
      <div><div class="sj-txt"><strong>${l.step}</strong> — ${l.action}</div>
      <div class="sj-day">Day ${l.day}</div></div>
    </div>`
  ).join('');

  document.getElementById('sum-overlay').classList.add('vis');
  speak('Workflow complete. ' + (approved ? 'The prior authorization was approved.' : 'The prior authorization was denied after all options.') +
    ' Your efficiency score is ' + gradeScore + ' out of 100, earning a grade of ' + grade + '.');
}

/* ═══════════════════════════════════════════════════════════
   ACTION PANEL HELPERS
═══════════════════════════════════════════════════════════ */
function setPanel(title, stepLabel, desc, buttons, edu) {
  document.getElementById('ap-title').innerHTML = title;
  document.getElementById('ap-step-badge').textContent = stepLabel;
  document.getElementById('ap-desc').innerHTML = desc;

  const btnsEl = document.getElementById('ap-btns');
  btnsEl.innerHTML = buttons.map(b =>
    `<button class="act-btn ${b.cls}" onclick="${b.fn}">${b.label}</button>`
  ).join('');

  if (edu) setEdu(edu.title, edu.text);
}

function setEdu(title, text) {
  document.getElementById('edu-title-txt').textContent = '📚 ' + title;
  document.getElementById('edu-body').textContent = text;
  // Auto-open edu panel
  const panel = document.getElementById('edu-panel');
  panel.style.display = 'block';
  const textEl = document.getElementById('edu-text');
  textEl.classList.add('open');
  document.getElementById('edu-chevron').classList.add('open');
}

function toggleEdu() {
  const textEl   = document.getElementById('edu-text');
  const chevron  = document.getElementById('edu-chevron');
  const isOpen   = textEl.classList.contains('open');
  textEl.classList.toggle('open', !isOpen);
  chevron.classList.toggle('open', !isOpen);
}

/* ═══════════════════════════════════════════════════════════
   TOAST
═══════════════════════════════════════════════════════════ */
function showToast(msg, type) {
  const colors = {
    green:'#27ae60', blue:'#2e7dd6', amber:'#d4ac0d',
    red:'#e74c3c', purple:'#8e44ad', teal:'#16a085'
  };
  const container = document.getElementById('toast-container');
  const t = document.createElement('div');
  t.className = 'toast';
  t.style.borderLeft = '3px solid ' + (colors[type] || colors.blue);
  t.innerHTML = msg;
  container.appendChild(t);
  setTimeout(() => {
    t.classList.add('out');
    setTimeout(() => t.remove(), 350);
  }, 3200);
}

/* ═══════════════════════════════════════════════════════════
   CONFETTI
═══════════════════════════════════════════════════════════ */
function launchConfetti() {
  const canvas = document.getElementById('confetti-canvas');
  const ctx    = canvas.getContext('2d');
  canvas.width  = window.innerWidth;
  canvas.height = window.innerHeight;
  const colors  = ['#2e7dd6','#27ae60','#d4ac0d','#e74c3c','#8e44ad','#16a085','#f39c12','#3498db'];
  const pieces  = Array.from({length:150}, () => ({
    x:   Math.random() * canvas.width,
    y:   -Math.random() * canvas.height * 0.5,
    w:   Math.random() * 11 + 5,
    h:   Math.random() * 7 + 3,
    col: colors[Math.floor(Math.random() * colors.length)],
    rot: Math.random() * Math.PI * 2,
    vx:  (Math.random() - .5) * 4,
    vy:  Math.random() * 5 + 2,
    vr:  (Math.random() - .5) * .18,
    alpha: 0.9,
  }));
  let frame = 0;
  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    pieces.forEach(p => {
      p.x += p.vx; p.y += p.vy; p.rot += p.vr;
      if (p.y > canvas.height + 20) { p.y = -20; p.x = Math.random() * canvas.width; }
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      ctx.globalAlpha = p.alpha;
      ctx.fillStyle = p.col;
      ctx.fillRect(-p.w/2, -p.h/2, p.w, p.h);
      ctx.restore();
    });
    frame++;
    if (frame < 260) requestAnimationFrame(draw);
    else ctx.clearRect(0, 0, canvas.width, canvas.height);
  }
  draw();
}

/* ═══════════════════════════════════════════════════════════
   UTILITY
═══════════════════════════════════════════════════════════ */
function addDays(n) {
  S.days += n;
  if (S.scenario && S.days > S.scenario.days * 4) deduct(1, 'Extended timeline');
  updateStats();
}

function deduct(pts, reason) {
  S.score = Math.max(0, S.score - pts);
  updateStats();
}

function logStep(step, action, stageId) {
  S.log.push({step, action, stageId:stageId||null, day:S.days});
}

/* ═══════════════════════════════════════════════════════════
   MODALS
═══════════════════════════════════════════════════════════ */
function openHowTo()  { document.getElementById('howto-overlay').classList.add('vis'); }
function closeHowTo() { document.getElementById('howto-overlay').classList.remove('vis'); }

// Close modals on overlay click
document.getElementById('howto-overlay').addEventListener('click', function(e) {
  if (e.target === this) closeHowTo();
});
document.getElementById('sum-overlay').addEventListener('click', function(e) {
  if (e.target === this) document.getElementById('sum-overlay').classList.remove('vis');
});

/* ═══════════════════════════════════════════════════════════
   RESTART
═══════════════════════════════════════════════════════════ */
function restartApp() {
  stopSpeech();
  document.getElementById('sum-overlay').classList.remove('vis');

  S = {
    scenario:null, selectedId:null, phase:'select', stage:null,
    docs:[], days:0, score:100, progStep:0, log:[],
    outcome:null, appealOutcome:null,
    voiceEnabled:S.voiceEnabled, dragging:false,
  };

  document.getElementById('wf-area').style.display   = 'none';
  document.getElementById('scene-sel').style.display = 'block';
  document.querySelectorAll('.sc-card').forEach(c => c.classList.remove('sel'));
  document.getElementById('start-btn').disabled = true;

  renderProgress();
  updateStats();
  setPhase('Select Case');
  document.getElementById('st-case').textContent = '—';

  if (S.voiceEnabled) speak('Select a new patient scenario to start another workflow simulation.');
  showToast('↺ Ready for new patient', 'blue');
}

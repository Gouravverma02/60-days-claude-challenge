/* Place the case card into a stage */
function placeCard(stageId) {
  // Remove all existing cards
  document.querySelectorAll('.case-card').forEach(c => c.remove());
  // Remove active highlight from all zones
  document.querySelectorAll('.drop-zone').forEach(z => {
    z.classList.remove('dz-active','dz-hover','dz-error');
  });

  S.stage = stageId;
  const zone = document.getElementById('dz-' + stageId);
  if (!zone) return;
  zone.classList.add('dz-active');

  // Rebuild stage number indicators
  STAGES_DEF.forEach(st => {
    const el = document.querySelector(`#stg-wrap-${st.id} .stg-num`);
    if (!el) return;
    const idx = STAGE_ORDER.indexOf(st.id);
    const cur = STAGE_ORDER.indexOf(stageId);
    if (idx < cur) { el.className = 'stg-num done'; el.textContent = '✓'; }
    else if (idx === cur) { el.className = 'stg-num active'; el.textContent = st.num; }
    else { el.className = 'stg-num'; el.textContent = st.num; }
  });

  const sc = S.scenario;
  const totalDocs = sc.docs.length;

  // Status badge
  let statusHtml = '';
  if (S.outcome === 'approved') {
    statusHtml = `<div class="cc-status" style="background:#e6f7ed;color:#145a32">✓ Approved</div>`;
  } else if (S.outcome === 'denied') {
    statusHtml = `<div class="cc-status" style="background:#fdedec;color:#922b21">✗ Denied</div>`;
  } else if (S.outcome === 'pend') {
    statusHtml = `<div class="cc-status" style="background:#fef9e7;color:#7d6608">⏳ Pending</div>`;
  } else if (S.outcome === 'appeal') {
    statusHtml = `<div class="cc-status" style="background:#f5eef8;color:#5b2c6f">⚖ Appeal</div>`;
  } else if (S.outcome === 'p2p') {
    statusHtml = `<div class="cc-status" style="background:#e8f8f5;color:#0e6655">📞 P2P</div>`;
  }

  const cardCls = S.outcome ? 'case-card card-' + S.outcome : 'case-card';
  const pipsHtml = sc.docs.map(d =>
    `<div class="doc-pip ${S.docs.includes(d.name) ? 'done' : ''}" title="${d.name}"></div>`
  ).join('');

  const card = document.createElement('div');
  card.className = cardCls;
  card.id = 'the-card';
  card.draggable = true;
  card.innerHTML = `
    ${statusHtml}
    <div class="cc-name">${sc.icon} ${sc.name}</div>
    <div class="cc-type">${sc.type}</div>
    <div class="cc-code">ICD-10: ${sc.icd10} · CPT: ${sc.cpt}</div>
    <div class="cc-docs">${pipsHtml}
      <span style="font-size:10px;color:var(--gray400);margin-left:4px">${S.docs.length}/${totalDocs}</span>
    </div>`;
  card.addEventListener('dragstart', onDragStart);
  card.addEventListener('dragend',   onDragEnd);
  zone.appendChild(card);
}

/* ═══════════════════════════════════════════════════════════
   DRAG & DROP
═══════════════════════════════════════════════════════════ */
function onDragStart(e) {
  e.dataTransfer.effectAllowed = 'move';
  e.dataTransfer.setData('text/plain', 'case-card');
  this.classList.add('dragging');
  S.dragging = true;
}
function onDragEnd() {
  this.classList.remove('dragging');
  S.dragging = false;
  document.querySelectorAll('.drop-zone').forEach(z => z.classList.remove('dz-hover','dz-error'));
}
function dzOver(e, stageId) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  document.getElementById('dz-' + stageId).classList.add('dz-hover');
}
function dzLeave(e, stageId) {
  document.getElementById('dz-' + stageId).classList.remove('dz-hover');
}
function dzDrop(e, stageId) {
  e.preventDefault();
  document.getElementById('dz-' + stageId).classList.remove('dz-hover');
  handleDropTo(stageId);
}

function handleDropTo(targetId) {
  if (!S.stage || !S.scenario) return;
  const valid = (VALID_TRANSITIONS[S.stage] || []).includes(targetId);
  if (!valid) {
    errorZone(targetId, 'That move is not valid at this stage. Use the action buttons below.');
    return;
  }
  // Route to correct action
  const map = {
    'provider-visit':  moveToProviderVisit,
    'med-necessity':   moveToMedNecessity,
    'doc-collection':  moveToDocCollection,
    'pa-submission':   () => {
      if (S.docs.length < S.scenario.docs.length) {
        errorZone(targetId, 'Collect all required documents before submitting.');
      } else { moveToSubmission(); }
    },
    'payer-intake':    moveToPayer,
    'clinical-review': moveToClinicalReview,
    'payer-decision':  renderDecisionPanel,
    'appeal':          moveToAppeal,
    'final-outcome':   () => showFinalDenial(),
  };
  if (map[targetId]) map[targetId]();
}

function errorZone(stageId, msg) {
  const el = document.getElementById('dz-' + stageId);
  if (!el) return;
  el.classList.add('dz-error');
  setTimeout(() => el.classList.remove('dz-error'), 600);
  showToast('⚠️ ' + msg, 'amber');
  speak(msg);
}


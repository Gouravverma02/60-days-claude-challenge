   RENDER: OVERVIEW
   ============================================================ */
function computeLedgerEntries(){
  const entries = [];
  state.income.forEach(i=> entries.push({date:i.date, label:i.client+" — "+ (i.type==="retainer"?"retainer":"project"), amt:i.amount}));
  state.expenses.forEach(e=> entries.push({date:e.date, label:e.category+(e.notes?" · "+e.notes:""), amt:-e.amount}));
  entries.sort((a,b)=> new Date(a.date)-new Date(b.date));
  let bal = state.startBalance;
  return entries.map(e=>{ bal += e.amt; return {...e, balance:bal}; });
}

function renderOverview(){
  const entries = computeLedgerEntries();
  const currentBalance = entries.length ? entries[entries.length-1].balance : state.startBalance;
  const cutoffMonth = thisMonthKey();
  const incomeThisMonth = state.income.filter(i=>monthKey(i.date)===cutoffMonth).reduce((s,i)=>s+i.amount,0);
  const expenseThisMonth = state.expenses.filter(e=>monthKey(e.date)===cutoffMonth).reduce((s,e)=>s+e.amount,0);
  const netThisMonth = incomeThisMonth - expenseThisMonth;
  const overdueCount = state.invoices.filter(i=>i.status==="overdue").length;

  document.getElementById("overview-stats").innerHTML = `
    <div class="card">
      <div class="card-title">Current balance</div>
      <div class="stat-value">${fmt(currentBalance)}</div>
      <div class="stat-sub">Across tracked accounts</div>
    </div>
    <div class="card">
      <div class="card-title">Income this month</div>
      <div class="stat-value">${fmt(incomeThisMonth)}</div>
      <div class="stat-delta ${incomeThisMonth>=expenseThisMonth?'up':'down'}">${incomeThisMonth>=expenseThisMonth?'▲':'▼'} vs ${fmt(expenseThisMonth)} spent</div>
    </div>
    <div class="card">
      <div class="card-title">Net cash flow, this month</div>
      <div class="stat-value" style="color:${netThisMonth>=0?'var(--positive-bright)':'var(--negative-bright)'}">${fmt(netThisMonth)}</div>
      <div class="stat-sub">Income minus expenses</div>
    </div>
    <div class="card">
      <div class="card-title">Open invoices</div>
      <div class="stat-value">${state.invoices.filter(i=>i.status!=='paid'&&i.status!=='draft').length}</div>
      <div class="stat-sub ${overdueCount?'':'text-dim'}" style="${overdueCount?'color:var(--negative-bright)':''}">${overdueCount} overdue</div>
    </div>
  `;

  // health score
  const score = computeHealthScore();
  const ring = document.getElementById("score-ring-fill");
  const circumference = 2*Math.PI*52;
  ring.setAttribute("stroke-dasharray", circumference.toFixed(1));
  ring.setAttribute("stroke-dashoffset", (circumference*(1-score.total/100)).toFixed(1));
  ring.style.stroke = score.total>=70 ? "var(--positive)" : score.total>=45 ? "var(--accent)" : "var(--negative)";
  document.getElementById("score-num").textContent = score.total;
  document.getElementById("score-factors").innerHTML = score.factors.map(f=>`
    <div class="score-factor">
      <div class="label">${f.name}</div>
      <div class="progress"><div style="width:${Math.min(100,f.pct)}%; background:linear-gradient(90deg,var(--brass-700),var(--accent-bright));"></div></div>
      <div class="pts">${f.pts}/${f.max}</div>
    </div>
  `).join("");

  // ledger strip chart + rows (last 8 weeks)
  const cutoff = new Date(); cutoff.setDate(cutoff.getDate()-56);
  const recent = entries.filter(e=> new Date(e.date) >= cutoff);
  const chartData = (recent.length?recent:entries).slice(-16).map(e=>({x:0,y:e.balance,label:fmtDate(e.date)}));
  if(chartData.length>1) lineChart(document.getElementById("overview-chart"), chartData, {w:760,h:200});
  document.getElementById("ledger-current-balance").textContent = "Balance: " + fmt(currentBalance);

  const rows = (recent.length?recent:entries).slice(-12).reverse();
  document.getElementById("overview-ledger-rows").innerHTML = rows.length ? rows.map(e=>`
    <div class="ledger-row">
      <div class="mono text-dim">${fmtDate(e.date)}</div>
      <div>${e.label}</div>
      <div class="ledger-amt in">${e.amt>0?fmt(e.amt):""}</div>
      <div class="ledger-amt out">${e.amt<0?fmt(Math.abs(e.amt)):""}</div>
      <div class="ledger-bal">${fmt(e.balance)}</div>
    </div>
  `).join("") : `<div class="empty">No entries yet — log your first income or expense.</div>`;

  renderInsights();
}

function computeHealthScore(){
  const factors = [];
  // 1. cash flow positivity (25)
  const cutoffMonth = thisMonthKey();
  const incomeThisMonth = state.income.filter(i=>monthKey(i.date)===cutoffMonth).reduce((s,i)=>s+i.amount,0);
  const expenseThisMonth = state.expenses.filter(e=>monthKey(e.date)===cutoffMonth).reduce((s,e)=>s+e.amount,0);
  const net = incomeThisMonth-expenseThisMonth;
  const cfPct = incomeThisMonth>0 ? Math.max(0,Math.min(1, net/Math.max(incomeThisMonth,1))) : 0;
  factors.push({name:"Positive cash flow", pts:Math.round(cfPct*25), max:25, pct:cfPct*100});
  // 2. emergency fund (25)
  const baseline = monthlyExpenseBaseline();
  const target = baseline*state.efMonths;
  const efPct = target>0 ? Math.min(1, state.efSaved/target) : 0;
  factors.push({name:"Emergency fund coverage", pts:Math.round(efPct*25), max:25, pct:efPct*100});
  // 3. tax readiness (20)
  const estTaxNeed = incomeThisMonth * (state.taxRate/100) * 3; // quarter estimate
  const taxPct = estTaxNeed>0 ? Math.min(1, state.taxReserved/estTaxNeed) : 1;
  factors.push({name:"Tax reserve readiness", pts:Math.round(taxPct*20), max:20, pct:taxPct*100});
  // 4. invoice health (15)
  const totalInv = state.invoices.filter(i=>i.status!=='draft').length || 1;
  const badInv = state.invoices.filter(i=>i.status==='overdue').length;
  const invPct = Math.max(0, 1-(badInv/totalInv));
  factors.push({name:"Invoice / payment health", pts:Math.round(invPct*15), max:15, pct:invPct*100});
  // 5. goals progress (15)
  const goalPct = state.goals.length ? state.goals.reduce((s,g)=>s+Math.min(1,g.saved/g.target),0)/state.goals.length : 0.5;
  factors.push({name:"Savings goal progress", pts:Math.round(goalPct*15), max:15, pct:goalPct*100});

  const total = factors.reduce((s,f)=>s+f.pts,0);
  return {total, factors};
}

function renderInsights(){
  const insights = [];
  const overdue = state.invoices.filter(i=>i.status==="overdue");
  if(overdue.length){
    const sum = overdue.reduce((s,i)=>s+i.amount,0);
    insights.push({type:"warn", mark:"!", title:`${overdue.length} overdue invoice${overdue.length>1?'s':''} worth ${fmt(sum)}`, body:"Send a polite follow‑up now — overdue invoices are the single biggest cause of freelance cash‑flow gaps."});
  }
  const baseline = monthlyExpenseBaseline();
  const efTarget = baseline*state.efMonths;
  if(state.efSaved < efTarget*0.5){
    insights.push({type:"warn", mark:"⛨", title:"Emergency fund is under half of target", body:`At ${fmt(baseline)}/mo baseline spending, aim for ${fmt(efTarget)}. Consider auto‑moving a fixed % of each payment.`});
  }else if(state.efSaved >= efTarget){
    insights.push({type:"good", mark:"✓", title:"Emergency fund goal reached", body:"Your buffer covers your target months of expenses — consider directing extra cash flow to savings goals or investing."});
  }
  const recurringIncome = state.income.filter(i=>i.recurring).reduce((s,i)=>s+i.amount,0);
  const totalIncome30 = state.income.filter(i=> daysBetween(i.date, todayISO()) <= 30).reduce((s,i)=>s+i.amount,0);
  if(recurringIncome > 0 && totalIncome30 > 0 && recurringIncome/Math.max(totalIncome30,1) > 0.75){
    insights.push({type:"warn", mark:"◆", title:"Retainer concentration is high", body:"A large share of income comes from recurring retainers. Confirm you don't rely on just one or two clients — losing one would hit hard (see What‑If Simulator)."});
  }
  const estTaxNeed = (state.income.filter(i=>monthKey(i.date)===thisMonthKey()).reduce((s,i)=>s+i.amount,0)) * (state.taxRate/100) * 3;
  if(state.taxReserved < estTaxNeed*0.6){
    insights.push({type:"warn", mark:"%", title:"Tax reserve may be falling behind", body:"Based on this month's pace, your quarterly set‑aside need is trending ahead of what you've reserved."});
  }else{
    insights.push({type:"good", mark:"%", title:"Tax reserve is on pace", body:"Your set‑aside jar is tracking well against estimated quarterly need."});
  }
  const subsMonthly = state.subscriptions.reduce((s,x)=> s + (x.cycle==="monthly"?x.amount:x.amount/12),0);
  if(subsMonthly > baseline*0.15){
    insights.push({type:"warn", mark:"↻", title:"Subscriptions are a meaningful expense", body:`Recurring subscriptions run about ${fmt(subsMonthly)}/mo — worth a quick audit for anything unused.`});
  }
  if(!insights.length){
    insights.push({type:"good", mark:"✓", title:"No urgent flags", body:"Your finances look steady this week. Check the What‑If Simulator to stress‑test the months ahead."});
  }
  document.getElementById("overview-insights").innerHTML = insights.map(i=>`
    <div class="insight ${i.type}"><div class="mark">${i.mark}</div><div class="body"><b>${i.title}</b><p>${i.body}</p></div></div>
  `).join("");
}


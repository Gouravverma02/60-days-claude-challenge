  const resources = [
    {t:"IRS Self-Employed Tax Center", d:"Official guidance on estimated taxes and deductions."},
    {t:"A local fee-only financial planner", d:"For a tailored plan beyond general guidance."},
    {t:"Your accounting software's quarterly report", d:"Cross-check the numbers in this dashboard."},

  document.getElementById("resource-list").innerHTML = resources.map(r=>`<div class="card"><div class="card-title">Resource</div><b style="font-family:var(--font-display); font-size:15px;">${r.t}</b><p class="stat-sub mt-8">${r.d}</p></div>`).join("");

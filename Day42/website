    <h2 class="section-title">Score breakdown</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Factor</th><th>Points</th></tr></thead>
      <tbody>${score.factors.map(f=>`<tr><td>${f.name}</td><td class="num">${f.pts} / ${f.max}</td></tr>`).join("")}</tbody>
    </table></div>
  `;
}


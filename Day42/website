    </ul>

    <div class="nav-group-label">Planning</div>
    <ul class="nav">
      <li><button class="nav-btn" data-tab="budget"><span class="ico">▤</span> Budget</button></li>
      <li><button class="nav-btn" data-tab="tax"><span class="ico">%</span> Tax Set‑Aside</button></li>
      <li><button class="nav-btn" data-tab="emergency"><span class="ico">⛨</span> Emergency Fund</button></li>
      <li><button class="nav-btn" data-tab="goals"><span class="ico">★</span> Savings Goals</button></li>
    </ul>

    <div class="nav-group-label">Learn &amp; Export</div>
    <ul class="nav">
      <li><button class="nav-btn" data-tab="reports"><span class="ico">▥</span> Reports</button></li>

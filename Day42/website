<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Ledger — Personal Financial Command Center</title>
<style>
/* ============================================================
   THE LEDGER — design tokens
   A freelancer's cash-flow register: paper, brass, ink, teal.
   ============================================================ */
:root{
  --ink-950:#0D1315;
  --ink-900:#141C1F;
  --ink-850:#182124;
  --ink-800:#1E292C;
  --ink-700:#2A373A;
  --ink-line: rgba(230,225,210,0.09);
  --paper-text:#EDE8DC;
  --paper-text-dim:#9FAEB0;
  --paper-text-dimmer:#6D7A7C;

  --brass-300:#E4C878;
  --brass-500:#C79A3E;
  --brass-700:#8C6A26;

  --teal-300:#7FCBBB;
  --teal-500:#379C86;
  --teal-700:#215F51;

  --rust-300:#E39A7C;
  --rust-500:#B85732;
  --rust-700:#7C3A20;

  --bg:var(--ink-950);
  --surface:var(--ink-900);
  --surface-raised:var(--ink-850);
  --surface-hover:var(--ink-800);
  --border:var(--ink-line);
  --text:var(--paper-text);
  --text-dim:var(--paper-text-dim);
  --text-dimmer:var(--paper-text-dimmer);
  --accent:var(--brass-500);
  --accent-bright:var(--brass-300);
  --positive:var(--teal-500);
  --positive-bright:var(--teal-300);
  --negative:var(--rust-500);
  --negative-bright:var(--rust-300);

  --font-display: Georgia, 'Iowan Old Style', 'Palatino Linotype', 'URW Palladio L', serif;
  --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --font-mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;

  --radius-sm:6px;
  --radius:10px;
  --radius-lg:16px;
  --shadow: 0 8px 30px rgba(0,0,0,0.35);
  --shadow-sm: 0 2px 10px rgba(0,0,0,0.25);
  --transition: 180ms cubic-bezier(.4,0,.2,1);
}

[data-theme="light"]{
  --bg:#F5F1E7;
  --surface:#FBF8F1;
  --surface-raised:#FFFFFF;
  --surface-hover:#EFE9DA;
  --border: rgba(30,25,10,0.10);
  --text:#241D12;
  --text-dim:#5B5340;
  --text-dimmer:#8A806A;
  --accent:var(--brass-700);
  --accent-bright:#A87B26;
  --positive:var(--teal-700);
  --positive-bright:#1F6A57;
  --negative:var(--rust-700);
  --negative-bright:#8C4322;
  --shadow: 0 8px 24px rgba(60,45,10,0.12);
  --shadow-sm: 0 2px 8px rgba(60,45,10,0.08);
}

*{box-sizing:border-box; margin:0; padding:0;}
html{-webkit-text-size-adjust:100%;}
body{
  background:var(--bg);
  color:var(--text);
  font-family:var(--font-body);
  min-height:100vh;
  transition:background var(--transition), color var(--transition);
  line-height:1.5;
}
@media (prefers-reduced-motion: reduce){
  *{animation-duration:0.01ms !important; transition-duration:0.01ms !important;}
}
::selection{ background:var(--accent); color:var(--ink-950); }

a{color:inherit;}
button{font-family:inherit; cursor:pointer;}
input, select, textarea{
  font-family:var(--font-body);
  background:var(--surface-hover);
  border:1px solid var(--border);
  color:var(--text);
  border-radius:var(--radius-sm);
  padding:9px 11px;
  font-size:14px;
  width:100%;
  transition:border-color var(--transition), box-shadow var(--transition);
}
input:focus, select:focus, textarea:focus{
  outline:none;
  border-color:var(--accent);
  box-shadow:0 0 0 3px rgba(199,154,62,0.18);
}
input[type="number"]{font-family:var(--font-mono);}
label{ font-size:12px; color:var(--text-dim); display:block; margin-bottom:5px; letter-spacing:.02em; }
:focus-visible{ outline:2px solid var(--accent-bright); outline-offset:2px; }

/* Ledger-line background texture on paper surfaces */
.ledger-lines{
  background-image: repeating-linear-gradient(
    to bottom, transparent 0, transparent 27px, var(--border) 28px
  );
}

/* ============================= LAYOUT ============================= */
.app{ display:grid; grid-template-columns:248px 1fr; min-height:100vh; }
@media (max-width: 900px){ .app{ grid-template-columns:1fr; } }

/* ---- Sidebar ---- */
.sidebar{
  background:var(--surface);
  border-right:1px solid var(--border);
  padding:22px 14px 18px;
  display:flex; flex-direction:column;
  position:sticky; top:0; height:100vh; overflow-y:auto;
}
@media (max-width:900px){
  .sidebar{ position:relative; height:auto; border-right:none; border-bottom:1px solid var(--border); }
}
.brand{ display:flex; align-items:center; gap:10px; padding:4px 8px 20px; }
.brand-mark{
  width:34px; height:34px; border-radius:8px;
  background:linear-gradient(155deg, var(--brass-500), var(--brass-700));
  display:flex; align-items:center; justify-content:center;
  color:var(--ink-950); font-family:var(--font-display); font-weight:700; font-size:17px;
  flex-shrink:0;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.35);
}
.brand-word{ font-family:var(--font-display); font-size:18px; letter-spacing:.01em; }
.brand-sub{ font-size:10.5px; color:var(--text-dimmer); letter-spacing:.12em; text-transform:uppercase; margin-top:1px;}

.nav-group-label{
  font-size:10.5px; text-transform:uppercase; letter-spacing:.12em;
  color:var(--text-dimmer); padding:16px 10px 6px;
}
.nav{ list-style:none; display:flex; flex-direction:column; gap:1px; }
.nav-btn{
  display:flex; align-items:center; gap:10px;
  width:100%; text-align:left; background:transparent; border:none;
  color:var(--text-dim); padding:9px 10px; border-radius:var(--radius-sm);
  font-size:13.5px; transition:background var(--transition), color var(--transition);
}
.nav-btn:hover{ background:var(--surface-hover); color:var(--text); }
.nav-btn.active{ background:var(--surface-hover); color:var(--accent-bright); font-weight:600; }
.nav-btn .ico{ width:16px; text-align:center; font-family:var(--font-mono); font-size:12px; opacity:.85;}

.sidebar-foot{ margin-top:auto; padding-top:14px; border-top:1px solid var(--border); display:flex; flex-direction:column; gap:8px;}
.theme-toggle{
  display:flex; align-items:center; justify-content:space-between;
  background:var(--surface-hover); border:1px solid var(--border); border-radius:999px;
  padding:5px 6px; font-size:12px; color:var(--text-dim);
}
.theme-toggle button{
  border:none; background:transparent; padding:5px 10px; border-radius:999px; color:var(--text-dim); font-size:12px;
}
.theme-toggle button.active{ background:var(--accent); color:var(--ink-950); font-weight:600; }
.data-note{ font-size:10.5px; color:var(--text-dimmer); padding:2px 6px; line-height:1.5;}

/* ---- Main ---- */
.main{ padding:26px 32px 60px; max-width:1180px; width:100%; margin:0 auto; }
@media (max-width:700px){ .main{ padding:18px 16px 50px; } }

.page-head{ display:flex; justify-content:space-between; align-items:flex-end; gap:16px; margin-bottom:22px; flex-wrap:wrap;}
.page-eyebrow{ font-size:11px; text-transform:uppercase; letter-spacing:.14em; color:var(--accent-bright); margin-bottom:6px; font-weight:600;}
.page-title{ font-family:var(--font-display); font-size:30px; letter-spacing:-.01em; }
.page-desc{ color:var(--text-dim); font-size:13.5px; margin-top:5px; max-width:56ch;}
.page-actions{ display:flex; gap:8px; flex-wrap:wrap; }

.btn{
  display:inline-flex; align-items:center; gap:7px;
  border-radius:var(--radius-sm); border:1px solid var(--border);
  background:var(--surface-raised); color:var(--text);
  padding:9px 14px; font-size:13px; font-weight:500;
  transition:transform var(--transition), background var(--transition), border-color var(--transition);
}
.btn:hover{ background:var(--surface-hover); }
.btn:active{ transform:scale(0.97); }
.btn-primary{ background:var(--accent); border-color:var(--accent); color:var(--ink-950); font-weight:700; }
.btn-primary:hover{ background:var(--accent-bright); border-color:var(--accent-bright);}
.btn-ghost{ background:transparent; }
.btn-danger{ color:var(--negative-bright); }
.btn-sm{ padding:6px 10px; font-size:12px; }

.tab-page{ display:none; animation:fadeUp 420ms cubic-bezier(.16,1,.3,1); }
.tab-page.active{ display:block; }
@keyframes fadeUp{ from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);} }

/* ---- Grid / Cards ---- */
.grid{ display:grid; gap:16px; }
.grid-4{ grid-template-columns:repeat(4,1fr); }
.grid-3{ grid-template-columns:repeat(3,1fr); }
.grid-2{ grid-template-columns:repeat(2,1fr); }
@media (max-width:900px){ .grid-4{grid-template-columns:repeat(2,1fr);} .grid-3{grid-template-columns:repeat(2,1fr);} }
@media (max-width:560px){ .grid-4,.grid-3,.grid-2{grid-template-columns:1fr;} }

.card{
  background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg);
  padding:18px 18px; box-shadow:var(--shadow-sm);
}
.card-title{ font-size:12px; text-transform:uppercase; letter-spacing:.09em; color:var(--text-dimmer); margin-bottom:10px; display:flex; justify-content:space-between; align-items:center;}
.section-title{ font-family:var(--font-display); font-size:20px; margin:34px 0 14px; padding-top:6px; border-top:1px solid var(--border); }
.section-title:first-of-type{ margin-top:0; border-top:none; padding-top:0;}

/* ---- Stat / metric cards ---- */
.stat-value{ font-family:var(--font-mono); font-size:26px; font-weight:600; letter-spacing:-.01em; }
.stat-value.small{font-size:20px;}
.stat-delta{ font-size:12px; margin-top:6px; display:inline-flex; align-items:center; gap:4px;}
.stat-delta.up{ color:var(--positive-bright); }
.stat-delta.down{ color:var(--negative-bright); }
.stat-sub{ font-size:11.5px; color:var(--text-dimmer); margin-top:4px;}

/* progress bars */
.progress{ height:8px; border-radius:99px; background:var(--surface-hover); overflow:hidden; margin-top:10px; border:1px solid var(--border);}
.progress > div{ height:100%; background:linear-gradient(90deg, var(--teal-700), var(--positive-bright)); border-radius:99px; transition:width 700ms cubic-bezier(.16,1,.3,1);}
.progress.brass > div{ background:linear-gradient(90deg, var(--brass-700), var(--accent-bright)); }
.progress.rust > div{ background:linear-gradient(90deg, var(--rust-700), var(--negative-bright)); }

/* Health score ring */
.score-wrap{ display:flex; align-items:center; gap:22px; flex-wrap:wrap;}
.score-ring{ position:relative; width:132px; height:132px; flex-shrink:0;}
.score-ring svg{ transform:rotate(-90deg); }
.score-ring .track{ fill:none; stroke:var(--surface-hover); stroke-width:10; }
.score-ring .fill{ fill:none; stroke:var(--accent); stroke-width:10; stroke-linecap:round; transition:stroke-dashoffset 900ms cubic-bezier(.16,1,.3,1); }
.score-num{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.score-num b{ font-family:var(--font-display); font-size:34px; line-height:1;}
.score-num span{ font-size:10px; color:var(--text-dimmer); text-transform:uppercase; letter-spacing:.1em; margin-top:2px;}
.score-factors{ display:flex; flex-direction:column; gap:8px; flex:1; min-width:220px;}
.score-factor{ display:flex; align-items:center; gap:10px; font-size:12.5px;}
.score-factor .label{ width:150px; color:var(--text-dim); flex-shrink:0;}
.score-factor .progress{ flex:1; margin-top:0;}
.score-factor .pts{ width:32px; text-align:right; font-family:var(--font-mono); color:var(--text-dimmer); font-size:11.5px;}

/* ---- Ledger strip (signature element) ---- */
.ledger-strip{
  background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg);
  overflow:hidden; box-shadow:var(--shadow-sm);
}
.ledger-strip-head{ display:flex; justify-content:space-between; align-items:center; padding:16px 18px 0;}
.ledger-scroll{ overflow-x:auto; padding:6px 18px 18px; }
.ledger-row{
  display:grid; grid-template-columns:88px 1fr 110px 110px 130px; gap:10px;
  align-items:center; padding:9px 4px; font-size:12.5px; min-width:560px;
  border-bottom:1px dashed var(--border);
}
.ledger-row.head{ color:var(--text-dimmer); text-transform:uppercase; letter-spacing:.06em; font-size:10.5px; border-bottom:1px solid var(--border);}
.ledger-row:last-child{ border-bottom:none; }
.ledger-amt{ font-family:var(--font-mono); text-align:right; }
.ledger-amt.in{ color:var(--positive-bright); }
.ledger-amt.out{ color:var(--negative-bright); }
.ledger-bal{ font-family:var(--font-mono); text-align:right; font-weight:600;}
.tag{ display:inline-block; padding:2px 8px; border-radius:99px; font-size:10.5px; border:1px solid var(--border); color:var(--text-dim);}
.tag.paid{ color:var(--positive-bright); border-color:var(--positive); }
.tag.pending{ color:var(--accent-bright); border-color:var(--accent);}
.tag.overdue{ color:var(--negative-bright); border-color:var(--negative);}
.tag.draft{ color:var(--text-dimmer); }

/* ---- Tables (generic entries) ---- */
.table-wrap{ overflow-x:auto; }
table{ width:100%; border-collapse:collapse; font-size:13px; min-width:520px;}
th{ text-align:left; font-size:10.5px; text-transform:uppercase; letter-spacing:.07em; color:var(--text-dimmer); padding:8px 10px; border-bottom:1px solid var(--border);}
td{ padding:10px 10px; border-bottom:1px solid var(--border); vertical-align:middle;}
tr:last-child td{ border-bottom:none;}
td.num{ font-family:var(--font-mono); text-align:right; }
.row-actions{ display:flex; gap:6px; justify-content:flex-end; }
.icon-btn{ background:transparent; border:1px solid var(--border); border-radius:6px; width:26px; height:26px; display:inline-flex; align-items:center; justify-content:center; color:var(--text-dim); font-size:12px;}
.icon-btn:hover{ color:var(--negative-bright); border-color:var(--negative); }

/* ---- Forms / quick add ---- */
.form-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:12px; align-items:end;}
.form-row-actions{ display:flex; justify-content:flex-end; margin-top:12px; gap:8px;}

/* ---- Chart canvas containers ---- */
.chart-box{ position:relative; width:100%; }
svg.chart-svg{ width:100%; height:auto; display:block; overflow:visible;}
.axis-label{ font-size:9.5px; fill:var(--text-dimmer); font-family:var(--font-mono); }
.grid-line{ stroke:var(--border); stroke-width:1;}

/* ---- Insight / recommendation cards ---- */
.insight{
  display:flex; gap:12px; padding:14px 16px; border-radius:var(--radius); border:1px solid var(--border);
  background:var(--surface-raised); margin-bottom:10px; align-items:flex-start;
}
.insight .mark{ font-family:var(--font-display); font-size:15px; color:var(--accent-bright); flex-shrink:0; width:22px; text-align:center;}
.insight .body b{ display:block; font-size:13.5px; margin-bottom:2px;}
.insight .body p{ font-size:12.5px; color:var(--text-dim); }
.insight.warn .mark{ color:var(--negative-bright); }
.insight.good .mark{ color:var(--positive-bright); }

/* ---- Checklist ---- */
.checklist{ display:flex; flex-direction:column; gap:8px; }
.check-item{ display:flex; align-items:center; gap:10px; padding:10px 12px; border:1px solid var(--border); border-radius:var(--radius-sm); background:var(--surface-raised); font-size:13px; cursor:pointer;}
.check-item input{ width:auto; accent-color:var(--accent); }
.check-item.done span{ text-decoration:line-through; color:var(--text-dimmer);}

/* ---- Perforated invoice card (signature detail) ---- */
.invoice-card{
  position:relative; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius);
  padding:14px 16px; display:flex; flex-direction:column; gap:6px;
}
.invoice-card::before{
  content:""; position:absolute; left:-1px; right:-1px; top:calc(100% - 1px); height:0;
}
.invoice-perf{
  height:10px; margin:0 -1px;
  background-image: radial-gradient(circle, var(--bg) 2.6px, transparent 2.7px);
  background-size: 14px 14px; background-position: 4px 0;
  border-bottom:1px dashed var(--border);
}

/* ---- Tabs pill nav for sub-views ---- */
.pill-tabs{ display:flex; gap:6px; flex-wrap:wrap; margin-bottom:16px;}
.pill{ padding:7px 13px; border-radius:99px; border:1px solid var(--border); font-size:12.5px; color:var(--text-dim); background:var(--surface-raised);}
.pill.active{ background:var(--accent); color:var(--ink-950); border-color:var(--accent); font-weight:600;}

/* ---- Empty state ---- */
.empty{ text-align:center; padding:34px 16px; color:var(--text-dimmer); font-size:13px; }
.empty b{ display:block; color:var(--text-dim); font-family:var(--font-display); font-size:16px; margin-bottom:4px;}

/* ---- Toast ---- */
.toast{
  position:fixed; bottom:22px; left:50%; transform:translateX(-50%) translateY(20px);
  background:var(--ink-950); color:var(--paper-text); border:1px solid var(--brass-700);
  padding:11px 20px; border-radius:99px; font-size:13px; box-shadow:var(--shadow);
  opacity:0; pointer-events:none; transition:all 320ms cubic-bezier(.16,1,.3,1); z-index:999;
}
[data-theme="light"] .toast{ background:#241D12; color:#F5F1E7; }
.toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }

/* ---- Modal ---- */
.modal-backdrop{ position:fixed; inset:0; background:rgba(0,0,0,0.55); display:none; align-items:center; justify-content:center; z-index:900; padding:20px;}
.modal-backdrop.show{ display:flex; }
.modal{
  background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg);
  width:100%; max-width:440px; padding:22px; box-shadow:var(--shadow); max-height:88vh; overflow-y:auto;
}
.modal h3{ font-family:var(--font-display); font-size:19px; margin-bottom:14px;}
.modal .form-grid{ grid-template-columns:1fr 1fr; }

/* ---- Slider (what-if) ---- */
.slider-row{ margin-bottom:18px; }
.slider-row .top{ display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;}
.slider-row .top b{ font-family:var(--font-mono); color:var(--accent-bright);}
input[type="range"]{ -webkit-appearance:none; height:5px; background:var(--surface-hover); border-radius:99px; padding:0; border:1px solid var(--border);}
input[type="range"]::-webkit-slider-thumb{ -webkit-appearance:none; width:17px; height:17px; border-radius:50%; background:var(--accent); border:2px solid var(--surface); cursor:pointer; margin-top:-1px;}
input[type="range"]::-moz-range-thumb{ width:15px; height:15px; border-radius:50%; background:var(--accent); border:2px solid var(--surface); cursor:pointer;}

/* ---- Utility ---- */
.flex{ display:flex; }
.between{ justify-content:space-between; }
.center{ align-items:center; }
.gap-8{gap:8px;} .gap-12{gap:12px;} .gap-16{gap:16px;}
.mt-8{margin-top:8px;} .mt-16{margin-top:16px;} .mt-24{margin-top:24px;}
.text-dim{ color:var(--text-dim); }
.text-pos{ color:var(--positive-bright); }
.text-neg{ color:var(--negative-bright); }
.mono{ font-family:var(--font-mono); }
.w-full{width:100%;}

/* ---- Print ---- */
@media print{
  .sidebar, .page-actions, .no-print, .modal-backdrop, .toast{ display:none !important; }
  .app{ display:block; }
  .main{ max-width:100%; padding:0; }
  body{ background:#fff; color:#111; }
  .card, .ledger-strip, .invoice-card{ box-shadow:none; border:1px solid #ccc; break-inside:avoid; }
  .tab-page{ display:none !important; }
  .tab-page.print-active{ display:block !important; }
}
</style>
</head>
<body data-theme="dark">

<div class="app">
  <!-- ============================= SIDEBAR ============================= -->
  <nav class="sidebar no-print" aria-label="Primary">
    <div class="brand">
      <div class="brand-mark">L</div>
      <div>
        <div class="brand-word">The Ledger</div>
        <div class="brand-sub">Command Center</div>

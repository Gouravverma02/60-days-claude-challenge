/* ============================================================
   RENDER: WHAT-IF
   ============================================================ */
function renderWhatIf(){
  const els = {
    lose: document.getElementById("wi-lose"),
    raise: document.getElementById("wi-raise"),
    cut: document.getElementById("wi-cut"),
    shock: document.getElementById("wi-shock"),
  };
  function compute(){
    const cutoffMonth = thisMonthKey();
    const incomeThisMonth = state.income.filter(i=>monthKey(i.date)===cutoffMonth).reduce((s,i)=>s+i.amount,0) || state.income.reduce((s,i)=>s+i.amount,0)/Math.max(1,new Set(state.income.map(i=>monthKey(i.date))).size);
    const expenseThisMonth = state.expenses.filter(e=>monthKey(e.date)===cutoffMonth).reduce((s,e)=>s+e.amount,0) || monthlyExpenseBaseline();
    const baseNet = incomeThisMonth - expenseThisMonth;

    let scenarioIncome = incomeThisMonth;
    if(els.lose.value==="1"){
      const clientTotals = {};
      state.income.forEach(i=> clientTotals[i.client] = (clientTotals[i.client]||0)+i.amount);
      const biggest = Object.entries(clientTotals).sort((a,b)=>b[1]-a[1])[0];
      if(biggest){
        const share = biggest[1]/state.income.reduce((s,i)=>s+i.amount,1);
        scenarioIncome = scenarioIncome*(1-share);
      }
    }
    scenarioIncome = scenarioIncome * (1 + parseInt(els.raise.value)/100);
    let scenarioExpense = expenseThisMonth * (1 - parseInt(els.cut.value)/100*0.5); // cut applies to ~50% discretionary portion
    const shock = parseInt(els.shock.value);
    const scenarioNet = scenarioIncome - scenarioExpense - shock;

    document.getElementById("wi-lose-val").textContent = els.lose.value==="1"?"Yes":"No";
    document.getElementById("wi-raise-val").textContent = els.raise.value+"%";
    document.getElementById("wi-cut-val").textContent = els.cut.value+"%";
    document.getElementById("wi-shock-val").textContent = fmt(shock);
    document.getElementById("wi-base-net").textContent = fmt(baseNet);
    document.getElementById("wi-scenario-net").textContent = fmt(scenarioNet);
    document.getElementById("wi-scenario-net").style.color = scenarioNet>=0 ? "var(--positive-bright)":"var(--negative-bright)";

    // 6-month projection chart comparing base vs scenario
    const entries = computeLedgerEntries();
    const startBal = entries.length ? entries[entries.length-1].balance : state.startBalance;
    const pointsBase=[], pointsScenario=[];
    let b1=startBal, b2=startBal;
    for(let m=0;m<=6;m++){
      pointsBase.push({x:0,y:b1,label:"M"+m});
      pointsScenario.push({x:0,y:b2,label:"M"+m});
      b1+=baseNet; b2+=scenarioNet;
    }
    const w=400,h=200,pad={t:10,r:10,b:20,l:40};
    const allY = pointsBase.concat(pointsScenario).map(p=>p.y);
    const minY=Math.min(...allY,0), maxY=Math.max(...allY,1);
    const x=(i)=>pad.l+(i/6)*(w-pad.l-pad.r);
    const y=(v)=>h-pad.b-((v-minY)/((maxY-minY)||1))*(h-pad.t-pad.b);
    const path=(pts)=>pts.map((p,i)=>(i===0?"M":"L")+x(i).toFixed(1)+","+y(p.y).toFixed(1)).join(" ");
    const svg = document.getElementById("wi-chart");
    svg.setAttribute("viewBox",`0 0 ${w} ${h}`);
    svg.innerHTML = `
      <line class="grid-line" x1="${pad.l}" x2="${w-pad.r}" y1="${y(0).toFixed(1)}" y2="${y(0).toFixed(1)}" stroke-dasharray="3,3"></line>
      <path d="${path(pointsBase)}" fill="none" stroke="var(--text-dimmer)" stroke-width="2" stroke-dasharray="4,3"></path>
      <path d="${path(pointsScenario)}" fill="none" stroke="${scenarioNet>=0?'var(--positive)':'var(--negative)'}" stroke-width="2.4"></path>
      <text class="axis-label" x="${pad.l}" y="12">6‑month balance projection</text>
    `;
    const shortfallMonth = pointsScenario.findIndex(p=>p.y<0);
    document.getElementById("wi-runway-note").textContent = shortfallMonth>=0
      ? `In this scenario, balance goes negative around month ${shortfallMonth}. Dashed line = current baseline for comparison.`
      : `In this scenario, balance stays positive through the 6‑month window. Dashed line = current baseline for comparison.`;
  }
  Object.values(els).forEach(el=> el.addEventListener("input", compute));
  compute();
}


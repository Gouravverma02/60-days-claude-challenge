/* ============================================================
   RENDER: CASH FLOW FORECAST
   ============================================================ */
function buildForecast(days){
  days = days||90;
  const entries = computeLedgerEntries();
  let balance = entries.length ? entries[entries.length-1].balance : state.startBalance;
  const events = [];
  const start = new Date();
  // recurring income (retainers) — assume same day-of-month as their last entry, repeats monthly
  const recurringIncomes = state.income.filter(i=>i.recurring);
  const seenClients = {};
  recurringIncomes.forEach(i=>{ seenClients[i.client] = i; }); // latest wins due to array order (assume sorted asc already roughly)
  Object.values(seenClients).forEach(i=>{
    const dom = new Date(i.date).getDate();
    for(let m=0;m<=3;m++){
      const d = new Date(start.getFullYear(), start.getMonth()+m, dom);
      if(d>=start && daysBetween(todayISO(), d.toISOString().slice(0,10))<=days){
        events.push({date:d.toISOString().slice(0,10), label:i.client+" retainer", amt:i.amount, type:"income"});
      }
    }
  });
  // open invoices due
  state.invoices.filter(inv=>inv.status==="pending"||inv.status==="overdue").forEach(inv=>{
    let d = inv.dueDate;
    if(new Date(d) < start){ d = todayISO(); } // treat as due ASAP if already overdue
    if(daysBetween(todayISO(), d) <= days){
      events.push({date:d, label:inv.client+" invoice", amt:inv.amount, type:"income"});
    }
  });
  // subscriptions
  state.subscriptions.forEach(s=>{
    const amt = s.cycle==="monthly" ? s.amount : s.amount; // charge on cycle date
    let d = new Date(s.nextDate);
    while(d < start) d.setMonth(d.getMonth() + (s.cycle==="monthly"?1:12));
    while(daysBetween(todayISO(), d.toISOString().slice(0,10)) <= days){
      events.push({date:d.toISOString().slice(0,10), label:s.name, amt:-amt, type:"expense"});
      d = new Date(d); d.setMonth(d.getMonth() + (s.cycle==="monthly"?1:12));
    }
  });
  // baseline daily living expense spread (using baseline/30 per day, excluding subs already counted)
  const baseline = monthlyExpenseBaseline();
  const subsMonthly = state.subscriptions.reduce((s,x)=> s + (x.cycle==="monthly"?x.amount:x.amount/12),0);
  const dailyLiving = Math.max(0, baseline - subsMonthly) / 30;

  events.sort((a,b)=>new Date(a.date)-new Date(b.date));

  const points = [];
  let running = balance;
  for(let d=0; d<=days; d++){
    const dt = new Date(start); dt.setDate(dt.getDate()+d);
    const iso = dt.toISOString().slice(0,10);
    const todays = events.filter(e=>e.date===iso);
    todays.forEach(e=> running += e.amt);
    running -= dailyLiving;
    if(d%3===0 || d===days) points.push({x:0, y:running, label: dt.toLocaleDateString("en-US",{month:"short",day:"numeric"})});
  }
  return {points, events, startBalance:balance};
}

function renderForecast(){
  const f = buildForecast(90);
  lineChart(document.getElementById("forecast-chart"), f.points, {w:760,h:240, color:"var(--positive)"});
  const lowest = Math.min(...f.points.map(p=>p.y));
  const end = f.points[f.points.length-1].y;
  const dipBelowZero = f.points.find(p=>p.y<0);
  document.getElementById("forecast-stats").innerHTML = `
    <div class="card"><div class="card-title">Projected in 90 days</div><div class="stat-value" style="color:${end>=f.startBalance?'var(--positive-bright)':'var(--negative-bright)'}">${fmt(end)}</div></div>
    <div class="card"><div class="card-title">Lowest projected point</div><div class="stat-value" style="color:${lowest<f.startBalance*0.3?'var(--negative-bright)':'var(--text)'}">${fmt(lowest)}</div></div>
    <div class="card"><div class="card-title">Runway status</div><div class="stat-value small">${dipBelowZero? 'Risk of shortfall' : 'Stable'}</div><div class="stat-sub">${dipBelowZero? 'Balance dips below $0 in projection — see What‑If Simulator':'No projected shortfall in 90 days'}</div></div>
  `;
  const upcoming = [...f.events].sort((a,b)=>new Date(a.date)-new Date(b.date)).slice(0,14);
  document.getElementById("forecast-table").innerHTML = upcoming.length ? upcoming.map(e=>`
    <tr>
      <td class="mono">${fmtDate(e.date)}</td>
      <td>${e.label}</td>

    },
  };
}
function addMonths(n){ const d=new Date(); d.setMonth(d.getMonth()+n); return d.toISOString().slice(0,10); }

let state = load();
function load(){
  try{
    const raw = localStorage.getItem(STORE_KEY);
    if(raw) return Object.assign(defaultState(), JSON.parse(raw));
  }catch(e){}
  return defaultState();
}
function save(){
  localStorage.setItem(STORE_KEY, JSON.stringify(state));
}

/* ============================================================
   HELPERS
   ============================================================ */
const fmt = (n)=>{
  const sign = n<0 ? "-" : "";
  n = Math.abs(Math.round(n));
  return sign + "$" + n.toLocaleString("en-US");
};
const fmt2 = (n)=>{
  const sign = n<0 ? "-" : "";
  n = Math.abs(n);
  return sign + "$" + n.toLocaleString("en-US", {minimumFractionDigits:2, maximumFractionDigits:2});
};
function daysBetween(a,b){ return Math.round((new Date(b)-new Date(a))/86400000); }
function fmtDate(iso){
  const d = new Date(iso+"T00:00:00");
  return d.toLocaleDateString("en-US",{month:"short", day:"numeric"});
}
function toast(msg){
  const t = document.getElementById("toast");
  t.textContent = msg;
  t.classList.add("show");
  clearTimeout(toast._t);
  toast._t = setTimeout(()=>t.classList.remove("show"), 2200);
}
function monthKey(iso){ return iso.slice(0,7); }
function thisMonthKey(){ return todayISO().slice(0,7); }

/* Derived monthly baseline expense (avg of recurring-ish categories + all expenses last 90d /3) */
function monthlyExpenseBaseline(){
  const cutoff = new Date(); cutoff.setDate(cutoff.getDate()-90);
  const recent = state.expenses.filter(e=> new Date(e.date) >= cutoff);
  const subMonthly = state.subscriptions.reduce((s,x)=> s + (x.cycle==="monthly" ? x.amount : x.amount/12), 0);
  const expTotal = recent.reduce((s,e)=>s+e.amount,0);
  const expMonthly = recent.length ? expTotal/3 : 0;
  return Math.max(expMonthly, subMonthly) || (expMonthly+subMonthly);
}


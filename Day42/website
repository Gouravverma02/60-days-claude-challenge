function addDaysISO(n){ const d=new Date(); d.setDate(d.getDate()+n); return d.toISOString().slice(0,10); }

document.querySelectorAll("[data-open-modal]").forEach(btn=>{
  btn.addEventListener("click", ()=> openModal(btn.dataset.openModal));
});

function openModal(key){
  const def = modalDefs[key];
  let html = `<h3>${def.title}</h3><div class="form-grid">`;
  def.fields.forEach(f=>{
    const fullStyle = f.full ? "grid-column:1/-1;" : "";
    html += `<div style="${fullStyle}"><label>${f.label}</label>`;
    if(f.type==="select"){
      html += `<select data-field="${f.k}">` + f.opts.map(o=>`<option value="${o}">${o}</option>`).join("") + `</select>`;
    }else{
      html += `<input data-field="${f.k}" type="${f.type}" placeholder="${f.ph||""}" value="${f.value||""}">`;
    }
    html += `</div>`;
  });
  html += `</div><div class="form-row-actions">
    <button class="btn" id="modal-cancel">Cancel</button>
    <button class="btn btn-primary" id="modal-submit">Save</button>
  </div>`;
  modalContent.innerHTML = html;
  backdrop.classList.add("show");
  document.getElementById("modal-cancel").addEventListener("click", closeModal);
  document.getElementById("modal-submit").addEventListener("click", ()=>{
    const data = {};
    let ok = true;
    def.fields.forEach(f=>{
      const el = modalContent.querySelector(`[data-field="${f.k}"]`);
      data[f.k] = el.value;
      if(f.required && !el.value){ ok=false; el.style.borderColor = "var(--negative)"; }
    });
    if(!ok){ toast("Please fill required fields"); return; }
    def.submit(data);
  });
}
function closeModal(){ backdrop.classList.remove("show"); modalContent.innerHTML=""; }
backdrop.addEventListener("click", (e)=>{ if(e.target===backdrop) closeModal(); });

function deleteItem(list, id){
  state[list] = state[list].filter(x=>x.id!==id);
  save(); renderAll(); toast("Removed");
}
window.__deleteItem = deleteItem;

/* ============================================================
   CHART HELPERS (pure SVG, no libs)
   ============================================================ */
function lineChart(svgEl, points, opts){
  opts = opts||{};
  const w = opts.w||760, h = opts.h||200, pad = opts.pad||{t:14,r:14,b:22,l:46};
  const xs = points.map(p=>p.x), ys = points.map(p=>p.y);
  const minY = Math.min(0, ...ys), maxY = Math.max(...ys, 1);
  const x = (i)=> pad.l + (i/(points.length-1||1)) * (w-pad.l-pad.r);
  const y = (v)=> h-pad.b - ((v-minY)/((maxY-minY)||1)) * (h-pad.t-pad.b);
  let d = points.map((p,i)=> (i===0?"M":"L") + x(i).toFixed(1) + "," + y(p.y).toFixed(1)).join(" ");
  let area = d + ` L${x(points.length-1).toFixed(1)},${y(minY).toFixed(1)} L${x(0).toFixed(1)},${y(minY).toFixed(1)} Z`;
  const zeroY = y(0);
  const gridLines = [];
  const steps = 4;
  for(let i=0;i<=steps;i++){
    const v = minY + (maxY-minY)*i/steps;
    gridLines.push(`<line class="grid-line" x1="${pad.l}" x2="${w-pad.r}" y1="${y(v).toFixed(1)}" y2="${y(v).toFixed(1)}"></line>`);
    gridLines.push(`<text class="axis-label" x="4" y="${(y(v)+3).toFixed(1)}">${Math.round(v/1000)}k</text>`);
  }
  const accentColor = opts.color || "var(--accent)";
  const labelStep = Math.ceil(points.length/8);
  const xLabels = points.map((p,i)=> (i%labelStep===0 || i===points.length-1) ? `<text class="axis-label" x="${x(i).toFixed(1)}" y="${h-4}" text-anchor="middle">${p.label||""}</text>` : "").join("");
  svgEl.setAttribute("viewBox", `0 0 ${w} ${h}`);
  svgEl.innerHTML = `
    ${gridLines.join("")}
    <line class="grid-line" x1="${pad.l}" x2="${w-pad.r}" y1="${zeroY.toFixed(1)}" y2="${zeroY.toFixed(1)}" stroke-dasharray="3,3"></line>
    <path d="${area}" fill="${accentColor}" fill-opacity="0.12" stroke="none"></path>
    <path d="${d}" fill="none" stroke="${accentColor}" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"></path>
    ${points.map((p,i)=>`<circle cx="${x(i).toFixed(1)}" cy="${y(p.y).toFixed(1)}" r="3" fill="${accentColor}"><title>${p.label}: ${fmt(p.y)}</title></circle>`).join("")}
    ${xLabels}
  `;
}

function barChart(svgEl, bars, opts){
  opts = opts||{};
  const w = opts.w||400, h = opts.h||220, pad={t:14,r:10,b:26,l:44};
  const maxV = Math.max(...bars.map(b=>b.y), 1);
  const bw = (w-pad.l-pad.r)/bars.length * 0.6;
  const gap = (w-pad.l-pad.r)/bars.length;
  const y = (v)=> h-pad.b - (v/maxV)*(h-pad.t-pad.b);
  let bodies = bars.map((b,i)=>{
    const bx = pad.l + gap*i + (gap-bw)/2;
    const by = y(b.y);
    return `<rect x="${bx.toFixed(1)}" y="${by.toFixed(1)}" width="${bw.toFixed(1)}" height="${(h-pad.b-by).toFixed(1)}" rx="3" fill="${b.color||'var(--accent)'}"><title>${b.label}: ${fmt(b.y)}</title></rect>
      <text class="axis-label" x="${(bx+bw/2).toFixed(1)}" y="${h-6}" text-anchor="middle">${b.label}</text>`;
  }).join("");
  const gridLines=[];
  for(let i=0;i<=3;i++){
    const v = maxV*i/3;
    gridLines.push(`<line class="grid-line" x1="${pad.l}" x2="${w-pad.r}" y1="${y(v).toFixed(1)}" y2="${y(v).toFixed(1)}"></line>`);
    gridLines.push(`<text class="axis-label" x="2" y="${(y(v)+3).toFixed(1)}">${Math.round(v/1000)}k</text>`);
  }
  svgEl.setAttribute("viewBox", `0 0 ${w} ${h}`);
  svgEl.innerHTML = gridLines.join("") + bodies;
}

function pieChart(svgEl, slices){
  const total = slices.reduce((s,x)=>s+x.value,0) || 1;
  const r = 90, cx=110, cy=110;
  let angle = -Math.PI/2;
  let paths = "";
  slices.forEach(s=>{
    const frac = s.value/total;
    const a2 = angle + frac*2*Math.PI;
    const x1 = cx + r*Math.cos(angle), y1 = cy + r*Math.sin(angle);
    const x2 = cx + r*Math.cos(a2), y2 = cy + r*Math.sin(a2);
    const large = frac > 0.5 ? 1 : 0;
    paths += `<path d="M${cx},${cy} L${x1.toFixed(2)},${y1.toFixed(2)} A${r},${r} 0 ${large} 1 ${x2.toFixed(2)},${y2.toFixed(2)} Z" fill="${s.color}"><title>${s.label}: ${fmt(s.value)}</title></path>`;
    angle = a2;
  });
  svgEl.setAttribute("viewBox","0 0 220 220");
  svgEl.innerHTML = paths + `<circle cx="${cx}" cy="${cy}" r="46" fill="var(--surface)"></circle>`;
}

const PALETTE = ["#C79A3E","#379C86","#B85732","#7C6FB0","#4E8FBF","#B0824F","#6FA88F","#B06F9E"];


   RENDER: EXPENSES
   ============================================================ */
function renderExpenses(){
  const sorted = [...state.expenses].sort((a,b)=>new Date(b.date)-new Date(a.date));
  document.getElementById("expense-table").innerHTML = sorted.map(e=>`
    <tr>
      <td class="mono">${fmtDate(e.date)}</td>
      <td>${e.category}</td>
      <td class="text-dim">${e.notes||""}</td>
      <td class="num text-neg">${fmt(e.amount)}</td>
      <td><div class="row-actions"><button class="icon-btn" onclick="__deleteItem('expenses','${e.id}')">✕</button></div></td>
    </tr>
  `).join("");
  document.getElementById("expense-empty").innerHTML = sorted.length ? "" : `<div class="empty"><b>No expenses logged</b>Add your first expense to see category breakdowns.</div>`;

  // pie by category (this month, fallback all-time)
  const cutoffMonth = thisMonthKey();
  let byCat = {};
  let pool = state.expenses.filter(e=>monthKey(e.date)===cutoffMonth);
  if(!pool.length) pool = state.expenses;
  pool.forEach(e=> byCat[e.category] = (byCat[e.category]||0)+e.amount);
  const cats = Object.keys(byCat);
  const slices = cats.map((c,i)=>({label:c, value:byCat[c], color:PALETTE[i%PALETTE.length]}));
  if(slices.length) pieChart(document.getElementById("expense-pie"), slices);
  else document.getElementById("expense-pie").innerHTML = "";
  document.getElementById("expense-legend").innerHTML = slices.map(s=>`
    <div class="flex between" style="font-size:12.5px; padding:4px 0;">
      <span class="flex center gap-8"><span style="width:9px;height:9px;border-radius:3px;background:${s.color};display:inline-block;"></span>${s.label}</span>
      <span class="mono text-dim">${fmt(s.value)}</span>

const ARCHETYPES = {
  quiet_leader: {
    name:'Quiet Leader',
    desc:'You lead by example and substance, not noise — setting high private standards, staying composed under pressure, and measuring success by what the team achieves.',
    traits:['Team-First','Composed','Analytical','Disciplined','Leads by Delegation']

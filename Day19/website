/* ============== QUIZ DEFINITIONS ============== */
function getIQQuiz(level){
  // calibrate difficulty mix based on knowledge level (1-4)
  const base = [
    {id:'q1', level:'Beginner', text:'A draw in the group stage gives each team how many points?', options:['0 points','1 point','2 points','3 points'], correct:1},

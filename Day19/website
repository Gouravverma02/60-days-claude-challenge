/* ============== STORAGE HELPERS ============== */
async function loadLeaderboard(){
  try{
    const res = await window.storage.get('leaderboard', true);
    return res ? JSON.parse(res.value) : [];
  }catch(e){ return []; }
}
async function saveToLeaderboard(entry){
  try{
    const list = await loadLeaderboard();
    list.unshift(entry);
    const trimmed = list.slice(0, 100);
    await window.storage.set('leaderboard', JSON.stringify(trimmed), true);
    return true;
  }catch(e){ return false; }
}


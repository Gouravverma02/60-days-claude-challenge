<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Football Intelligence Profile</title>
<style>
:root{
  --bg-deep:#0B2818; --bg-deep2:#0E331E; --bg-card:rgba(245,242,234,0.045);
  --gold:#E8B84B; --gold-soft:#C9A24B; --chalk:#F5F2EA;
  --sage:#8FAE9C; --sage-dim:#5C7A66; --line:rgba(245,242,234,0.14);
  --messi-blue:#6FA3C7; --ronaldo-red:#C06A5E;
}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{height:100%;}
body{
  font-family:'Inter','Helvetica Neue',Arial,sans-serif;
  background:radial-gradient(circle at 50% -10%, #143824 0%, var(--bg-deep) 45%, #071c12 100%);
  color:var(--chalk);
  min-height:100vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:32px 16px 60px;
  position:relative;
  overflow-x:hidden;
}
.bg-circle{
  position:fixed; top:50%; left:50%; transform:translate(-50%,-50%);
  width:900px; height:900px; border-radius:50%;
  border:1.5px solid rgba(245,242,234,0.05);
  pointer-events:none; z-index:0;
}
.bg-circle::after{
  content:''; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
  width:6px; height:6px; border-radius:50%; background:rgba(245,242,234,0.08);
}
.condensed{font-family:'DejaVu Sans Condensed', Arial, sans-serif; font-weight:700;}

.shell{ width:100%; max-width:680px; position:relative; z-index:1; }

.top-eyebrow{
  font-size:13px; letter-spacing:4px; text-transform:uppercase;
  color:var(--gold); font-weight:600; text-align:center; margin-bottom:8px;
}
.top-title{
  font-size:clamp(32px,7vw,46px); text-align:center; text-transform:uppercase;
  letter-spacing:0.5px; margin-bottom:6px; line-height:1.02;
}
.top-title span{color:var(--gold);}
.top-sub{
  text-align:center; color:var(--sage); font-size:14.5px; margin-bottom:34px;
  max-width:480px; margin-left:auto; margin-right:auto; line-height:1.6;
}

.progress-track{
  display:flex; gap:6px; margin-bottom:30px;
}
.progress-seg{
  flex:1; height:4px; border-radius:2px; background:rgba(245,242,234,0.12); overflow:hidden;
}
.progress-seg.done{background:var(--gold);}
.progress-seg.active{background:linear-gradient(90deg,var(--gold) 50%, rgba(245,242,234,0.12) 50%);}

.panel{
  background:var(--bg-card); border:1px solid var(--line); border-radius:16px;
  padding:32px 28px; margin-bottom:18px; animation:fadeIn .4s ease;
}
@keyframes fadeIn{ from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);} }

.sec-label{
  display:flex; align-items:center; gap:10px; font-size:12px; letter-spacing:3px;
  text-transform:uppercase; color:var(--sage); font-weight:700; margin-bottom:18px;
}
.sec-label .num{color:var(--gold); font-size:13px;}
.sec-label::after{content:''; flex:1; height:1px; background:var(--line);}

.q-text{font-size:19px; font-weight:600; margin-bottom:18px; line-height:1.4;}
.q-meta{font-size:12px; color:var(--sage-dim); letter-spacing:1px; text-transform:uppercase; margin-bottom:8px; font-weight:700;}

.opt-grid{display:flex; flex-direction:column; gap:10px;}
.opt-btn{
  background:rgba(245,242,234,0.03); border:1.5px solid var(--line); border-radius:10px;
  padding:14px 18px; text-align:left; color:var(--chalk); font-size:15px; cursor:pointer;
  transition:all .15s ease; font-family:inherit;
}
.opt-btn:hover{border-color:var(--gold-soft); background:rgba(232,184,75,0.07);}
.opt-btn.selected{border-color:var(--gold); background:rgba(232,184,75,0.14); color:var(--gold);}
.opt-btn:disabled{cursor:default;}

.rating-row{display:flex; gap:8px; justify-content:space-between;}
.rating-btn{
  flex:1; aspect-ratio:1; border-radius:10px; border:1.5px solid var(--line);
  background:rgba(245,242,234,0.03); color:var(--chalk); font-size:16px; font-weight:700;
  cursor:pointer; transition:all .15s ease;
}
.rating-btn:hover{border-color:var(--gold-soft);}
.rating-btn.selected{border-color:var(--gold); background:var(--gold); color:var(--bg-deep);}
.rating-labels{display:flex; justify-content:space-between; font-size:11px; color:var(--sage-dim); margin-top:8px; letter-spacing:0.3px;}

.btn-row{display:flex; gap:12px; margin-top:8px;}
.btn{
  font-family:inherit; font-size:14px; font-weight:700; letter-spacing:0.5px;
  padding:14px 26px; border-radius:10px; cursor:pointer; border:none;
  transition:all .15s ease; text-transform:uppercase;
}
.btn-primary{background:var(--gold); color:var(--bg-deep); flex:1;}
.btn-primary:hover{background:#f0c668;}
.btn-primary:disabled{background:rgba(232,184,75,0.3); color:rgba(11,40,24,0.5); cursor:not-allowed;}
.btn-ghost{background:transparent; border:1.5px solid var(--line); color:var(--sage);}
.btn-ghost:hover{border-color:var(--gold-soft); color:var(--gold-soft);}

/* Stage 1 prediction tiles */
.predict-row{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:22px;}
.predict-tile{
  flex:1; min-width:140px; background:rgba(245,242,234,0.04); border:1px solid var(--line);
  border-radius:10px; padding:16px 14px;
}
.predict-tile.win{border-color:rgba(232,184,75,0.45);}
.predict-tile .role{font-size:10.5px; letter-spacing:2px; text-transform:uppercase; color:var(--sage-dim); font-weight:700; margin-bottom:6px;}
.predict-tile .team{font-size:23px; margin-bottom:4px;}
.predict-tile .conf{font-size:12.5px; color:var(--gold); font-weight:700;}
.evidence-block{background:rgba(245,242,234,0.03); border-left:2px solid var(--gold-soft); border-radius:6px; padding:14px 16px; margin-bottom:14px;}
.evidence-block .ev-title{font-size:13px; font-weight:700; color:var(--gold-soft); margin-bottom:6px; letter-spacing:0.3px;}
.evidence-block p{font-size:13.5px; color:var(--sage); line-height:1.65;}
.evidence-block p b{color:var(--chalk);}
.players-list{display:flex; flex-direction:column; gap:8px; margin-top:14px;}
.player-row{display:flex; justify-content:space-between; align-items:center; background:rgba(245,242,234,0.03); border-radius:8px; padding:10px 14px; font-size:14px;}
.player-row .pname{font-weight:600;}
.player-row .pmeta{color:var(--sage-dim); font-size:12.5px;}

/* Gauge */
.gauge-section{display:flex; align-items:center; gap:24px; flex-wrap:wrap;}
.gauge-wrap{position:relative; width:140px; height:140px; flex-shrink:0;}
.gauge-num{position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;}
.gauge-num .n{font-size:38px; color:var(--gold);}
.gauge-num .d{font-size:10px; color:var(--sage); letter-spacing:1px; margin-top:2px;}
.gauge-text .class-name{font-size:26px; color:var(--chalk); text-transform:uppercase; margin-bottom:8px;}
.gauge-text .meta{font-size:13.5px; color:var(--sage); line-height:1.6;}
.gauge-text .meta b{color:var(--chalk); font-weight:600;}

/* Compatibility bar */
.compat-names{display:flex; justify-content:space-between; margin-bottom:10px; flex-wrap:wrap; gap:6px;}
.compat-names .name{font-size:17px; letter-spacing:0.3px;}
.compat-names .messi{color:var(--messi-blue);}
.compat-names .ronaldo{color:var(--ronaldo-red);}
.compat-bar{height:30px; border-radius:8px; overflow:hidden; display:flex; border:1px solid var(--line); margin-bottom:12px;}
.compat-bar .seg{display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:700;}
.compat-bar .messi-seg{background:var(--messi-blue); color:#0B2818;}
.compat-bar .ronaldo-seg{background:var(--ronaldo-red); color:#1a0d0b;}
.compat-note{font-size:13.5px; color:var(--sage); line-height:1.6;}
.compat-note b{color:var(--chalk);}

.archetype-box{
  background:linear-gradient(120deg, rgba(232,184,75,0.14), rgba(232,184,75,0.03));
  border:1px solid rgba(232,184,75,0.4); border-radius:14px; padding:22px 22px; margin-top:16px;
}
.archetype-box .kicker{font-size:11px; letter-spacing:3px; text-transform:uppercase; color:var(--gold-soft); font-weight:700; margin-bottom:6px;}
.archetype-box .name{font-size:30px; color:var(--gold); text-transform:uppercase; margin-bottom:10px;}
.archetype-box .desc{font-size:14px; color:var(--chalk); line-height:1.6; opacity:0.92;}
.trait-pills{display:flex; flex-wrap:wrap; gap:7px; margin-top:14px;}
.trait-pill{font-size:11.5px; font-weight:600; color:var(--bg-deep); background:var(--sage); padding:5px 12px; border-radius:20px;}

.recs-grid{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:16px;}
.rec-tile{background:rgba(245,242,234,0.04); border:1px solid var(--line); border-radius:10px; padding:14px 14px;}
.rec-tile .label{font-size:10px; letter-spacing:1.5px; text-transform:uppercase; color:var(--sage-dim); font-weight:700; margin-bottom:6px;}
.rec-tile .value{font-size:16px; color:var(--chalk);}

.nav-label{font-size:12px; color:var(--sage-dim); text-align:center; margin-bottom:14px; letter-spacing:0.3px;}

/* Leaderboard */
.lb-item{
  display:flex; align-items:center; gap:12px; padding:12px 14px; border-radius:10px;
  background:rgba(245,242,234,0.03); border:1px solid var(--line); margin-bottom:8px;
}
.lb-rank{font-size:15px; color:var(--gold-soft); width:24px; flex-shrink:0; text-align:center;}
.lb-name{flex:1; font-size:14px; font-weight:600;}
.lb-archetype{font-size:11.5px; color:var(--sage); flex-shrink:0;}
.lb-leg{font-size:12px; font-weight:700; padding:3px 10px; border-radius:12px; flex-shrink:0;}
.lb-leg.messi{background:rgba(111,163,199,0.2); color:var(--messi-blue);}
.lb-leg.ronaldo{background:rgba(192,106,94,0.2); color:var(--ronaldo-red);}
.empty-state{text-align:center; color:var(--sage-dim); font-size:13.5px; padding:24px 0;}

.name-input{
  width:100%; background:rgba(245,242,234,0.05); border:1.5px solid var(--line); border-radius:10px;
  padding:14px 16px; color:var(--chalk); font-size:15px; font-family:inherit; margin-bottom:14px;
}
.name-input::placeholder{color:var(--sage-dim);}
.name-input:focus{outline:none; border-color:var(--gold-soft);}

.footer-credit{
  text-align:center; font-size:11.5px; color:var(--sage-dim); margin-top:30px; letter-spacing:0.3px;
}
.loading-msg{text-align:center; color:var(--sage); font-size:13px; padding:30px 0;}
.toggle-link{
  display:block; text-align:center; color:var(--gold-soft); font-size:13px; margin-top:6px;
  cursor:pointer; text-decoration:underline; text-underline-offset:3px;
}

/* ---- AI FEATURES ---- */
.ai-badge{
  display:inline-flex; align-items:center; gap:5px; font-size:10.5px; letter-spacing:1.5px;
  text-transform:uppercase; font-weight:700; color:var(--bg-deep); background:var(--gold);
  padding:3px 9px; border-radius:20px; margin-bottom:12px;
}
.ai-badge::before{ content:'✦'; font-size:9px; }

.ai-commentary{
  background:linear-gradient(135deg, rgba(232,184,75,0.10), rgba(232,184,75,0.03));
  border:1px solid rgba(232,184,75,0.35); border-radius:12px; padding:18px 20px; margin-top:18px;
}
.ai-commentary p{ font-size:14px; color:var(--chalk); line-height:1.7; opacity:0.93; }
.ai-loading{ display:flex; align-items:center; gap:8px; color:var(--sage); font-size:13px; padding:8px 0; }
.ai-loading .dots span{ animation:blink 1.2s infinite; }
.ai-loading .dots span:nth-child(2){ animation-delay:.2s; }
.ai-loading .dots span:nth-child(3){ animation-delay:.4s; }
@keyframes blink{ 0%,80%,100%{opacity:0.2;} 40%{opacity:1;} }

/* AI Chat */
.ai-chat-panel{
  background:var(--bg-card); border:1px solid var(--line); border-radius:16px;
  margin-bottom:18px; overflow:hidden;
}
.ai-chat-header{
  display:flex; align-items:center; gap:10px; padding:16px 20px;
  border-bottom:1px solid var(--line); cursor:pointer; user-select:none;
}
.ai-chat-header .ch-title{ flex:1; font-size:15px; font-weight:700; }
.ai-chat-header .ch-icon{ font-size:18px; }
.ai-chat-header .ch-toggle{ color:var(--sage-dim); font-size:12px; }
.chat-body{ display:none; padding:0 0 0; }
.chat-body.open{ display:flex; flex-direction:column; }
.chat-messages{
  max-height:340px; overflow-y:auto; padding:16px 20px; display:flex; flex-direction:column; gap:12px;
  scrollbar-width:thin; scrollbar-color:rgba(245,242,234,0.1) transparent;
}
.msg{ display:flex; flex-direction:column; gap:4px; }
.msg.user{ align-items:flex-end; }
.msg.ai{ align-items:flex-start; }
.msg-bubble{
  max-width:85%; padding:11px 15px; border-radius:12px; font-size:13.5px; line-height:1.6;
}
.msg.user .msg-bubble{ background:rgba(232,184,75,0.18); border:1px solid rgba(232,184,75,0.3); color:var(--chalk); border-bottom-right-radius:3px; }
.msg.ai .msg-bubble{ background:rgba(245,242,234,0.06); border:1px solid var(--line); color:var(--chalk); border-bottom-left-radius:3px; }
.msg-label{ font-size:10px; letter-spacing:1px; color:var(--sage-dim); font-weight:700; text-transform:uppercase; padding:0 4px; }
.chat-input-row{
  display:flex; gap:8px; padding:14px 16px; border-top:1px solid var(--line); background:rgba(0,0,0,0.15);
}
.chat-input{
  flex:1; background:rgba(245,242,234,0.05); border:1.5px solid var(--line); border-radius:8px;
  padding:10px 14px; color:var(--chalk); font-size:13.5px; font-family:inherit; resize:none;
  max-height:100px; min-height:40px;
}
.chat-input::placeholder{ color:var(--sage-dim); }
.chat-input:focus{ outline:none; border-color:var(--gold-soft); }
.chat-send{
  background:var(--gold); border:none; border-radius:8px; padding:0 16px; cursor:pointer;
  color:var(--bg-deep); font-size:16px; font-weight:700; flex-shrink:0; transition:background .15s;
}
.chat-send:hover{ background:#f0c668; }
.chat-send:disabled{ background:rgba(232,184,75,0.3); cursor:not-allowed; color:rgba(11,40,24,0.5); }

/* AI Match Predictor */
.predictor-grid{ display:grid; grid-template-columns:1fr auto 1fr; gap:10px; align-items:center; margin-bottom:14px; }
.pred-input{
  background:rgba(245,242,234,0.05); border:1.5px solid var(--line); border-radius:10px;
  padding:12px 14px; color:var(--chalk); font-size:14px; font-family:inherit; text-align:center;
}
.pred-input::placeholder{ color:var(--sage-dim); }
.pred-input:focus{ outline:none; border-color:var(--gold-soft); }
.vs-label{ color:var(--gold); font-size:15px; font-weight:700; text-align:center; }
.pred-result-box{
  background:rgba(245,242,234,0.03); border:1px solid var(--line); border-radius:12px;
  padding:16px 18px; margin-top:12px; display:none;
}
.pred-result-box.visible{ display:block; }
.pred-result-box .winner{ font-size:22px; color:var(--gold); font-weight:700; text-transform:uppercase; margin-bottom:6px; }
.pred-result-box .reason{ font-size:13.5px; color:var(--sage); line-height:1.6; }
.pred-result-box .reason b{ color:var(--chalk); }
</style>
</head>

function submitPersonality(){
  const a = state.personalityAnswers;

  // trait scores (1-5 scale) derived from answers
  const traits = {
    discipline: a.p2 || 3,
    risk: a.p4 || 3,
    confidence: a.p7 || 3,
    ambition: a.p10 || 3,
    leadership: a.p1 === 'lead_delegate' || a.p3 === 'vocal_leader' ? 5 : (a.p3 === 'reliable' ? 4 : 3),
    teamwork: a.p13 === 'team_success' ? 5 : (a.p13 === 'consistency' ? 4 : 3),
    decision: a.p8 === 'analytical' ? 4 : (a.p8 === 'gut' ? 2 : 3),
    work_ethic: a.p9 === 'relentless' ? 5 : (a.p9 === 'balanced' ? 3 : 4)
  };

  // Messi-lean vs Ronaldo-lean qualitative scoring based on specific answer choices
  let messiScore = 0, ronaldoScore = 0;

  // Teamwork axis
  if(a.p13 === 'team_success') messiScore += 3;
  else if(a.p13 === 'personal_records' || a.p13 === 'goat_status') ronaldoScore += 3;
  else messiScore += 1;

  // Confidence style axis
  if(a.p12 === 'quiet_proof' || a.p12 === 'calm_trust') messiScore += 2.5;
  else if(a.p12 === 'vocal_backing') ronaldoScore += 2.5;
  else messiScore += 1;

  // Pressure behavior
  if(a.p11 === 'quiet_focus') messiScore += 2;
  else if(a.p11 === 'vocal_energy') ronaldoScore += 2;

  // Decision making
  if(a.p8 === 'analytical') messiScore += 1.5;
  else if(a.p8 === 'gut') ronaldoScore += 1;

  // Discipline / routine
  ronaldoScore += (traits.discipline - 3) * 1.0;

  // Ambition (unreasonable goals)
  ronaldoScore += (traits.ambition - 3) * 0.8;
  messiScore += (traits.ambition - 3) * 0.3;

  // Work ethic
  if(a.p9 === 'relentless') ronaldoScore += 2;
  else if(a.p9 === 'balanced') messiScore += 1;

  // Creativity / risk
  messiScore += (traits.risk - 3) * 0.6;

  // Leadership style
  if(a.p1 === 'lead_delegate' || a.p3 === 'vocal_leader') { messiScore += 1; ronaldoScore += 0.5; }
  if(a.p6 === 'trial_error') messiScore += 0.5;

  // baseline so neither is ever 0
  messiScore += 4;
  ronaldoScore += 2.5;

  const total = messiScore + ronaldoScore;
  let messiPct = Math.round((messiScore/total)*100);
  messiPct = Math.max(15, Math.min(85, messiPct)); // keep within believable bounds
  state.messiPct = messiPct;
  state.ronaldoPct = 100 - messiPct;
  state.traits = traits;

  // Archetype assignment
  state.archetypeKey = assignArchetype(a, traits);

  goTo('results');
}

function assignArchetype(a, t){
  if(a.p13 === 'team_success' && (a.p12==='quiet_proof'||a.p12==='calm_trust') && a.p11==='quiet_focus') return 'quiet_leader';
  if(a.p9 === 'relentless' && a.p5 === 'self_critical') return 'relentless_competitor';
  if(a.p4 >= 4 && a.p6 === 'trial_error' && (a.p1==='instinct'||a.p1==='visionary')) return 'creative_playmaker';
  if(a.p8 === 'analytical' && a.p1 === 'tactical' && a.p6 === 'theory') return 'tactical_visionary';
  if(a.p11 === 'vocal_energy' && a.p8 === 'gut') return 'fearless_attacker';
  if((a.p1==='lead_delegate'||a.p3==='vocal_leader') && a.p12==='vocal_backing') return 'strategic_commander';
  if(a.p3 === 'reliable' && a.p9 === 'balanced') return 'consistent_performer';
  if(a.p11 === 'quiet_focus' && a.p7 >= 4) return 'big_match_specialist';
  // fallback by dominant trait
  if(t.teamwork >= 4) return 'quiet_leader';
  if(t.ambition >= 4) return 'relentless_competitor';
  return 'consistent_performer';
}


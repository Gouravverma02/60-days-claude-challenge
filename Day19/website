      <div id="saveStatus" style="text-align:center; font-size:13px; color:var(--sage); margin-top:10px;"></div>
    </div>

    <div class="btn-row">
      <button class="btn btn-ghost" style="flex:1;" onclick="goTo('leaderboard')">View Leaderboard</button>
      <button class="btn btn-ghost" style="flex:1;" onclick="restartQuiz()">Take Again</button>
    </div>
    <div class="footer-credit">Source: ABTalks World Cup Intelligence Master</div>
  `;
  // Trigger AI commentary asynchronously
  generateAICommentary();
}

async function saveResult(){
  const nameInput = document.getElementById('nameInput');
  const name = nameInput.value.trim();
  if(!name){ document.getElementById('saveStatus').textContent = 'Please enter a name first.'; return; }
  state.userName = name;
  const btn = document.getElementById('saveBtn');
  btn.disabled = true; btn.textContent = 'Saving...';
  const entry = {
    name,
    archetype: ARCHETYPES[state.archetypeKey].name,
    messiPct: state.messiPct,
    ronaldoPct: state.ronaldoPct,
    awarenessScore: state.quizScore,
    awarenessClass: awarenessClass(state.quizScore),
    ts: Date.now()
  };
  const ok = await saveToLeaderboard(entry);
  document.getElementById('saveStatus').textContent = ok ? '✓ Saved! Visible to everyone on the leaderboard.' : 'Could not save — please try again.';
  btn.textContent = 'Save My Result';
  btn.disabled = false;
}

function restartQuiz(){
  state = {stage:'landing', knowledge:null, quizAnswers:{}, quizScore:0, personalityAnswers:{}, messiPct:0, ronaldoPct:0, archetypeKey:null, userName: state.userName};
  goTo('stage0');
}

/* ---------- LEADERBOARD ---------- */
async function renderLeaderboard(){
  app.innerHTML = `
    ${progressBar(4)}
    <div class="panel">
      <div class="sec-label"><span class="num">★</span> Leaderboard</div>
      <div class="loading-msg">Loading results...</div>
    </div>
    <div class="btn-row"><button class="btn btn-ghost" style="flex:1;" onclick="goTo('landing')">← Back Home</button></div>
  `;
  const list = await loadLeaderboard();
  let body;
  if(list.length === 0){
    body = `<div class="empty-state">No results yet — be the first to save your profile!</div>`;
  } else {
    body = list.map((e,i)=>`
      <div class="lb-item">
        <div class="lb-rank condensed">${i+1}</div>
        <div class="lb-name">${escapeHtml(e.name)}</div>
        <div class="lb-archetype">${e.archetype}</div>
        <div class="lb-leg ${e.messiPct>=50?'messi':'ronaldo'}">${e.messiPct>=50?'Messi '+e.messiPct+'%':'Ronaldo '+e.ronaldoPct+'%'}</div>
      </div>
    `).join('');
  }
  app.innerHTML = `
    ${progressBar(4)}
    <div class="panel">
      <div class="sec-label"><span class="num">★</span> Leaderboard <span style="color:var(--sage-dim); font-weight:400; text-transform:none; letter-spacing:0;">(${list.length})</span></div>
      ${body}
    </div>
    <div class="btn-row">
      <button class="btn btn-ghost" style="flex:1;" onclick="goTo('landing')">← Back Home</button>
      <button class="btn btn-primary" style="flex:1;" onclick="goTo('stage0')">Take the Quiz</button>
    </div>
    <div class="footer-credit">Shared leaderboard — visible to all visitors</div>
  `;
}
function escapeHtml(s){
  const d = document.createElement('div'); d.textContent = s; return d.innerHTML;
}

/* ============== AI FEATURES ============== */

const DATA_CONTEXT = `
You are an expert football analyst assistant embedded in the "Football Intelligence Profile" app.
Current date: June 2026. World Cup 2026 is underway.
Key data from the app:
- Contenders: Argentina (rank 1, form 92, goals conceded 6, scored 22), Spain (rank 2, form 91, conceded 5, scored 24), France (rank 3, form 90), England (rank 4, form 89), Portugal (rank 5), Brazil (rank 6, form 88), Germany (rank 9), Morocco (rank 12, form 86)
- Historical win rates: Brazil 70%, Argentina 68%, France 62%, Spain 60%, England/Netherlands 58%, Germany 56%, Portugal 54%
- Recent finals: 2022 Argentina def France (Messi Golden Ball), 2018 France def Croatia (Modric Golden Ball), 2014 Germany def Argentina (Messi Golden Ball), 2010 Spain def Netherlands, 2006 Italy def France (Zidane Golden Ball)
- Top players: Messi (20G/12A, 96 rating), Mbappe (22G/8A, 95), Ronaldo (18G/5A, 94), Haaland (25G/4A, 94), Bellingham (10G/9A, 91)
- 2026 live: Argentina beat Algeria 3-0, Spain drew Cape Verde 0-0, Brazil drew Morocco 1-1, Germany beat Curacao 7-1 (21 group matches played as of June 17 2026)
Keep answers focused, insightful, and under 120 words. Use football-specific terminology. Be direct and confident.
`;

async function callClaude(messages, systemExtra='') {
  const resp = await fetch('https://api.anthropic.com/v1/messages', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      model:'claude-sonnet-4-6',
      max_tokens:1000,
      system: DATA_CONTEXT + systemExtra,
      messages
    })
  });
  const data = await resp.json();
  return data.content?.map(b=>b.text||'').join('') || 'Unable to get AI response.';
}

/* AI Commentary on Results */
async function generateAICommentary(){
  const arch = ARCHETYPES[state.archetypeKey];
  const legend = state.messiPct >= 50 ? 'Messi' : 'Ronaldo';
  const prompt = `The user just completed the Football Intelligence Profile quiz. Here are their results:
- Archetype: ${arch.name} (${arch.traits.join(', ')})
- Football Awareness Score: ${state.quizScore}/100 (${state.quizCorrect}/${state.quizTotal} correct) — classified as "${awarenessClass(state.quizScore)}"
- Messi/Ronaldo match: ${legend} (${state.messiPct >= 50 ? state.messiPct : state.ronaldoPct}% aligned)
Write a personal, insightful 3-sentence commentary on this person's football profile. Mention their archetype, their awareness level, and connect their personality to how they'd actually behave watching or playing football. Make it feel like a real analyst is speaking to them. Start directly, no intro preamble.`;
  try {
    const text = await callClaude([{role:'user', content: prompt}]);
    const el = document.getElementById('aiText');
    const loading = document.getElementById('aiLoading');
    if(el && loading){
      loading.style.display = 'none';
      el.style.display = 'block';
      el.querySelector('p').textContent = text;
    }
  } catch(e) {
    const loading = document.getElementById('aiLoading');
    if(loading) loading.style.display = 'none';
  }
}

/* Match Predictor */
async function runPrediction(){
  const t1 = document.getElementById('team1').value.trim();
  const t2 = document.getElementById('team2').value.trim();
  if(!t1 || !t2){ return; }
  const box = document.getElementById('predResult');
  const loading = document.getElementById('predLoading');
  const content = document.getElementById('predContent');
  box.classList.add('visible');
  loading.style.display = 'flex';
  content.innerHTML = '';
  try {
    const text = await callClaude([{role:'user',
      content:`Predict a World Cup 2026 knockout match: ${t1} vs ${t2}. Use the data context provided. Give: 1) Likely winner with predicted scoreline, 2) Key tactical factor in 1 sentence, 3) One key player to watch. Format: "WINNER: [Team] [score] — [reason]. Key: [tactical]. Watch: [player, reason]." Be concise and analytical.`
    }]);
    loading.style.display = 'none';
    content.innerHTML = `<div style="font-size:14px; color:var(--chalk); line-height:1.7;">${text.replace(/\n/g,'<br>')}</div>`;
  } catch(e){
    loading.style.display = 'none';
    content.innerHTML = '<span style="color:var(--sage-dim); font-size:13px;">Could not get prediction — try again.</span>';
  }
}

/* Chat */
let chatHistory = [];

function buildChatPanel(placeholder){
  return `
  <div class="ai-chat-panel">
    <div class="ai-chat-header" onclick="togglePanel('chatBody','chatToggle')">
      <span class="ch-icon">🧠</span>
      <div class="ch-title">AI Football Analyst</div>
      <div class="ai-badge" style="margin-bottom:0;">AI</div>
      <span class="ch-toggle" id="chatToggle">▼ Open</span>
    </div>
    <div class="chat-body" id="chatBody">
      <div class="chat-messages" id="chatMessages">
        <div class="msg ai">
          <div class="msg-label">AI Analyst</div>
          <div class="msg-bubble">Ask me anything about football — tactics, history, players, World Cup 2026 predictions, or Messi vs Ronaldo debates. I'm here to analyse.</div>
        </div>
      </div>
      <div class="chat-input-row">
        <textarea class="chat-input" id="chatInput" placeholder="${placeholder}" rows="1"
          onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendChat();}"></textarea>
        <button class="chat-send" id="chatSend" onclick="sendChat()">↑</button>
      </div>
    </div>
  </div>`;
}

function initChat(){ chatHistory = []; }

function togglePanel(bodyId, toggleId){
  const body = document.getElementById(bodyId);
  const toggle = document.getElementById(toggleId);
  if(!body) return;
  const isOpen = body.classList.contains('open');
  body.classList.toggle('open', !isOpen);
  if(toggle) toggle.textContent = isOpen ? '▼ Open' : '▲ Close';
}

async function sendChat(){
  const input = document.getElementById('chatInput');
  const send = document.getElementById('chatSend');
  const messages = document.getElementById('chatMessages');
  const text = input.value.trim();
  if(!text || send.disabled) return;
  input.value = '';
  send.disabled = true;

  // Add user message
  chatHistory.push({role:'user', content: text});
  messages.innerHTML += `<div class="msg user"><div class="msg-label">You</div><div class="msg-bubble">${escapeHtml(text)}</div></div>`;

  // Typing indicator
  const typingId = 'typing_' + Date.now();
  messages.innerHTML += `<div class="msg ai" id="${typingId}"><div class="msg-label">AI Analyst</div><div class="msg-bubble"><div class="ai-loading" style="padding:0;"><div class="dots"><span>.</span><span>.</span><span>.</span></div></div></div></div>`;
  messages.scrollTop = messages.scrollHeight;

  try {
    const reply = await callClaude(chatHistory.slice(-10));
    chatHistory.push({role:'assistant', content: reply});
    const typingEl = document.getElementById(typingId);
    if(typingEl) typingEl.querySelector('.msg-bubble').innerHTML = reply.replace(/\n/g,'<br>');
  } catch(e) {
    const typingEl = document.getElementById(typingId);
    if(typingEl) typingEl.querySelector('.msg-bubble').textContent = 'Something went wrong — please try again.';
  }
  messages.scrollTop = messages.scrollHeight;
  send.disabled = false;
  input.focus();
}

/* ============== INIT ============== */
render();
</script>

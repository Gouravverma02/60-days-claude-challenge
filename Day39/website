/* --- parsing helpers --- */
function parsePageList(str, max){
  // returns {values:[...], error:null} or {values:null, error:"..."}
  const cleaned = str.trim();
  if(!cleaned) return {values:null, error:"Enter at least one page number."};
  const parts = cleaned.split(",").map(s=>s.trim()).filter(Boolean);
  const values = [];
  for(const part of parts){
    if(!/^\d+$/.test(part)) return {values:null, error:`"${part}" isn't a valid page number.`};
    const n = parseInt(part,10);
    if(n < 1 || n > max) return {values:null, error:`Page ${n} is outside 1–${max}.`};
    values.push(n);
  }
  return {values, error:null};
}
function parseRangeToken(str, max){
  const cleaned = str.trim();
  const m = cleaned.match(/^(\d+)\s*-\s*(\d+)$/);
  if(m){
    const start = parseInt(m[1],10), end = parseInt(m[2],10);
    if(start < 1 || end > max || start > end) return {error:`Range ${cleaned} is invalid for a ${max}-page document.`};
    return {start, end};
  }
  if(/^\d+$/.test(cleaned)){
    const n = parseInt(cleaned,10);
    if(n<1 || n>max) return {error:`Page ${n} is outside 1–${max}.`};
    return {start:n, end:n};
  }
  return {error:`"${cleaned}" isn't a valid page or range.`};
}

/* --- ranges method --- */
let rangeIdCounter = 1;
$("#addRangeBtn").addEventListener("click", ()=>{
  const input = $("#rangeInput");
  const errEl = $("#rangeError");
  const raw = input.value.trim();
  if(!raw){ errEl.textContent="Enter a page or range, e.g. 1-3."; errEl.classList.add("show"); input.classList.add("invalid"); return; }
  const tokens = raw.split(",").map(s=>s.trim()).filter(Boolean);
  let added = 0;
  for(const tok of tokens){
    const r = parseRangeToken(tok, splitState.numPages);
    if(r.error){ errEl.textContent = r.error; errEl.classList.add("show"); input.classList.add("invalid"); return; }
    splitState.ranges.push({id: rangeIdCounter++, start:r.start, end:r.end});
    added++;
  }
  errEl.classList.remove("show"); input.classList.remove("invalid");
  input.value = "";
  renderRangeList();
  renderOutputPreview();
  showToast("Range added", `${added} range${added===1?"":"s"} added to the split plan.`, "success");
});
$("#rangeInput").addEventListener("keydown", e=>{ if(e.key==="Enter"){ e.preventDefault(); $("#addRangeBtn").click(); }});

function renderRangeList(){
  const list = $("#rangeList");
  list.innerHTML = "";
  if(splitState.ranges.length===0){
    list.innerHTML = '<div class="field-hint" style="margin:4px 0 0;">No ranges added yet.</div>';
    return;
  }
  splitState.ranges.forEach((r,idx)=>{
    const chip = document.createElement("div");
    chip.className = "range-chip";
    const count = r.end - r.start + 1;
    chip.innerHTML = `
      <div class="range-chip-label"><span class="range-chip-badge">File ${idx+1}</span> Pages ${r.start}–${r.end} <span style="color:var(--text-secondary)">(${count} pg)</span></div>
      <button class="chip-remove" aria-label="Remove range ${r.start}-${r.end}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>`;
    chip.querySelector(".chip-remove").addEventListener("click", ()=>{
      splitState.ranges = splitState.ranges.filter(x=>x.id!==r.id);
      renderRangeList();
      renderOutputPreview();
    });
    list.appendChild(chip);
  });
}

/* --- every N method --- */
$("#applyEveryNBtn").addEventListener("click", ()=>{
  const n = parseInt($("#everyNInput").value,10);
  if(!n || n<1){ showToast("Invalid value", "Enter a number of pages of at least 1.", "error"); return; }
  splitState.ranges = [];
  for(let start=1; start<=splitState.numPages; start+=n){
    const end = Math.min(start+n-1, splitState.numPages);
    splitState.ranges.push({id:rangeIdCounter++, start, end});
  }
  renderRangeList();
  renderOutputPreview();
  showToast("Split plan updated", `${splitState.ranges.length} files of up to ${n} pages each.`, "success");
});

/* --- split after pages method --- */
$("#applyAfterBtn").addEventListener("click", ()=>{
  const errEl = $("#afterError");
  const input = $("#afterInput");
  const res = parsePageList(input.value, splitState.numPages);
  if(res.error){ errEl.textContent = res.error; errEl.classList.add("show"); input.classList.add("invalid"); return; }
  errEl.classList.remove("show"); input.classList.remove("invalid");
  const breaks = Array.from(new Set(res.values)).sort((a,b)=>a-b);
  splitState.ranges = [];
  let start = 1;
  for(const b of breaks){
    if(b < start) continue;
    splitState.ranges.push({id:rangeIdCounter++, start, end:b});
    start = b+1;
  }
  if(start <= splitState.numPages) splitState.ranges.push({id:rangeIdCounter++, start, end:splitState.numPages});
  renderRangeList();
  renderOutputPreview();
  showToast("Split plan updated", `Document split after page${breaks.length===1?"":"s"} ${breaks.join(", ")}.`, "success");
});

/* --- extract selected --- */
$("#applyExtractBtn").addEventListener("click", ()=>{
  const selected = splitState.pages.filter(p=>p.selected).map(p=>p.index+1);
  if(selected.length===0){ showToast("Nothing selected", "Click pages in the preview above to select them first.", "error"); return; }
  const mode = $$('input[name="extractMode"]').find(r=>r.checked).value;
  splitState.ranges = [];
  if(mode==="single"){
    // combined file preserving selection order — represent as explicit page list
    splitState.ranges.push({id:rangeIdCounter++, pages: selected});
  } else {
    selected.forEach(p=> splitState.ranges.push({id:rangeIdCounter++, pages:[p]}) );
  }
  renderRangeListExtract();
  renderOutputPreview();
});
function renderRangeListExtract(){
  // reuse renderRangeList visuals but ranges may have .pages instead of start/end
  const list = $("#rangeList");
  list.innerHTML="";
}

/* --- output preview --- */
function currentOutputFiles(){
  // Build a normalized list: [{name, pages:[1-indexed...]}]
  if(splitState.ranges.length===0) return [];
  return splitState.ranges.map((r,idx)=>{
    const pages = r.pages ? r.pages : Array.from({length:r.end-r.start+1}, (_,i)=>r.start+i);
    return {name:`${baseName()}_part${idx+1}.pdf`, pages};
  });
}
function baseName(){
  const n = splitState.file ? splitState.file.name.replace(/\.pdf$/i,"") : "document";
  return n;
}
function renderOutputPreview(){
  const wrap = $("#outputPreviewList");
  const files = currentOutputFiles();
  if(files.length===0){
    wrap.innerHTML = '<div class="empty-state" style="padding:24px 8px;">Add a range or choose a method to see the files you\'ll get.</div>';
    return;
  }
  wrap.innerHTML = files.map(f=>{
    const deletedInRange = f.pages.filter(p=> splitState.pages[p-1] && splitState.pages[p-1].deleted).length;
    const effective = f.pages.length - deletedInRange;
    return `<div class="preview-item">
      <div class="pf-icon"></div>
      <div style="flex:1;">
        <div class="pf-name">${f.name}</div>
        <div class="pf-sub">${effective} page${effective===1?"":"s"}${deletedInRange? " · "+deletedInRange+" excluded":""}</div>
      </div>
    </div>`;
  }).join("");
}

/* --- process split --- */
$("#splitProcessBtn").addEventListener("click", doSplit);
async function doSplit(){
  const files = currentOutputFiles();
  if(files.length===0){ showToast("No split plan yet", "Add at least one range, or choose a split method.", "error"); return; }
  try{
    showOverlay("Building your PDFs…", "Applying edits and assembling pages");
    const outputs = [];
    const addPageNumbers = $("#optPageNumbers").checked;
    const addWatermark = $("#optWatermark").checked;
    const watermarkText = $("#watermarkText").value.trim() || "CONFIDENTIAL";
    const compress = $("#optCompress").checked;

    for(let fi=0; fi<files.length; fi++){
      const f = files[fi];
      const validPages = f.pages.filter(p => splitState.pages[p-1] && !splitState.pages[p-1].deleted);
      if(validPages.length===0) continue;
      const outDoc = await PDFLib.PDFDocument.create();
      const copied = await outDoc.copyPages(splitState.pdfLibDoc, validPages.map(p=>p-1));
      copied.forEach((pg, i)=>{
        const srcPage = splitState.pages[validPages[i]-1];
        if(srcPage.rotation){
          const cur = pg.getRotation().angle || 0;
          pg.setRotation(PDFLib.degrees(cur + srcPage.rotation));
        }
        outDoc.addPage(pg);
      });
      if(addPageNumbers || addWatermark){
        const helv = await outDoc.embedFont(PDFLib.StandardFonts.HelveticaBold);
        outDoc.getPages().forEach((pg, i)=>{
          const {width, height} = pg.getSize();
          if(addPageNumbers){
            pg.drawText(String(i+1), {
              x: width/2 - 6, y: 22, size: 10, font: helv, color: PDFLib.rgb(0.2,0.24,0.3)
            });
          }
          if(addWatermark){
            pg.drawText(watermarkText, {
              x: width*0.12, y: height*0.42, size: Math.max(24, width*0.09),
              font: helv, color: PDFLib.rgb(0.75,0.63,0.15), opacity:0.28, rotate: PDFLib.degrees(35)
            });
          }
        });
      }
      const bytes = await outDoc.save({useObjectStreams: compress});
      outputs.push({name:f.name, bytes});
      setProgress(((fi+1)/files.length)*100);
    }

    if(outputs.length===0){ hideOverlay(); showToast("Nothing to export", "All selected pages were deleted.", "error"); return; }

    if(outputs.length===1){
      download(outputs[0].bytes, outputs[0].name);
    } else {
      const zip = new JSZip();
      outputs.forEach(o=> zip.file(o.name, o.bytes));
      const zipBytes = await zip.generateAsync({type:"uint8array"});
      download(zipBytes, `${baseName()}_split.zip`, "application/zip");
    }
    hideOverlay();
    showToast("Split complete", `${outputs.length} file${outputs.length===1?"":"s"} generated and downloaded.`, "success");
  }catch(err){
    hideOverlay();
    console.error(err);
    showToast("Something went wrong", "Couldn't complete the split. Please try again.", "error");
  }
}

$("#optWatermark").addEventListener("change", e=>{
  $("#watermarkText").style.display = e.target.checked ? "block" : "none";
});

/* --- download corrected (edited, unsplit) PDF --- */
$("#downloadEditedBtn").addEventListener("click", downloadCorrectedPdf);
async function downloadCorrectedPdf(){
  if(!splitState.pdfLibDoc){ showToast("No file loaded", "Upload a PDF first.", "error"); return; }
  const keptPages = splitState.pages.filter(p=>!p.deleted);
  if(keptPages.length===0){ showToast("Nothing to export", "Every page is marked deleted.", "error"); return; }
  try{
    showOverlay("Applying your corrections…", "Rotations, deletions, and output options");
    const addPageNumbers = $("#optPageNumbers").checked;
    const addWatermark = $("#optWatermark").checked;
    const watermarkText = $("#watermarkText").value.trim() || "CONFIDENTIAL";
    const compress = $("#optCompress").checked;

    const outDoc = await PDFLib.PDFDocument.create();
    const copied = await outDoc.copyPages(splitState.pdfLibDoc, keptPages.map(p=>p.index));
    copied.forEach((pg, i)=>{
      const rotation = keptPages[i].rotation;
      if(rotation){
        const cur = pg.getRotation().angle || 0;
        pg.setRotation(PDFLib.degrees(cur + rotation));
      }
      outDoc.addPage(pg);
    });

    if(addPageNumbers || addWatermark){
      const helv = await outDoc.embedFont(PDFLib.StandardFonts.HelveticaBold);
      outDoc.getPages().forEach((pg, i)=>{
        const {width, height} = pg.getSize();
        if(addPageNumbers){
          pg.drawText(String(i+1), {x: width/2 - 6, y: 22, size: 10, font: helv, color: PDFLib.rgb(0.2,0.24,0.3)});
        }
        if(addWatermark){
          pg.drawText(watermarkText, {
            x: width*0.12, y: height*0.42, size: Math.max(24, width*0.09),
            font: helv, color: PDFLib.rgb(0.75,0.63,0.15), opacity:0.28, rotate: PDFLib.degrees(35)
          });
        }
      });
    }
    setProgress(70);
    const bytes = await outDoc.save({useObjectStreams: compress});
    setProgress(100);
    download(bytes, `${baseName()}_corrected.pdf`);
    hideOverlay();
    showToast("Corrected PDF ready", `${keptPages.length} page${keptPages.length===1?"":"s"} exported with your edits.`, "success");
  }catch(err){
    hideOverlay();
    console.error(err);
    showToast("Something went wrong", "Couldn't export the corrected PDF. Please try again.", "error");
  }
}

/* ==================================================================
   MERGE
   ================================================================== */
const mergeState = { files: [] }; // {id, name, size, pdfLibDoc, numPages, thumbUrl}
let mergeIdCounter = 1;

wirePdfDrop($("#mergeDrop"), $("#mergeFileInput"), (files)=> addMergeFiles(files), true);
$("#mergeAddMoreBtn").addEventListener("click", ()=> $("#mergeFileInput").click());

async function addMergeFiles(files){
  showOverlay("Reading files…", "Generating previews for each PDF");
  let okCount = 0;
  for(const file of files){
    try{
      const buf = await file.arrayBuffer();
      const pdfLibDoc = await PDFLib.PDFDocument.load(buf, {ignoreEncryption:true});
      const pdfjsDoc = await pdfjsLib.getDocument({data: buf.slice(0)}).promise;
      const numPages = pdfLibDoc.getPageCount();
      const entry = {id: mergeIdCounter++, name:file.name, size:file.size, pdfLibDoc, numPages, thumbUrl:null};
      mergeState.files.push(entry);
      renderMergeThumb(entry, pdfjsDoc);
      okCount++;
    }catch(err){
      console.error(err);
      showToast("Skipped a file", `"${file.name}" couldn't be read as a PDF.`, "error");
    }
  }
  hideOverlay();
  if(okCount){
    $("#mergeDrop").parentElement; // no-op
    document.getElementById("mergeWorkspace").style.display = "block";
    renderMergeList();
    updateMergeStats();
    showToast("Files added", `${okCount} file${okCount===1?"":"s"} ready to merge.`, "success");
  }
}

async function renderMergeThumb(entry, pdfjsDoc){
  try{
    const page = await pdfjsDoc.getPage(1);
    const viewport = page.getViewport({scale:0.3});
    const canvas = document.createElement("canvas");
    canvas.width = viewport.width; canvas.height = viewport.height;
    await page.render({canvasContext:canvas.getContext("2d"), viewport}).promise;
    entry.thumbUrl = canvas.toDataURL();
    const img = document.querySelector(`.merge-item[data-id="${entry.id}"] .merge-thumb`);
    if(img) img.src = entry.thumbUrl;
  }catch(err){ console.warn("merge thumb failed", err); }
}

function renderMergeList(){
  const list = $("#mergeList");
  list.innerHTML = "";
  if(mergeState.files.length===0){
    list.innerHTML = '<div class="empty-state">No files yet — add PDFs above.</div>';
    return;
  }
  mergeState.files.forEach((f, idx)=>{
    const item = document.createElement("div");
    item.className = "merge-item";
    item.draggable = true;
    item.dataset.id = f.id;
    item.innerHTML = `
      <div class="merge-order-badge">${idx+1}</div>
      <div class="merge-handle" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6h.01M9 12h.01M9 18h.01M15 6h.01M15 12h.01M15 18h.01"/></svg>
      </div>
      <img class="merge-thumb" src="${f.thumbUrl || ''}" alt="">
      <div class="merge-info">
        <div class="merge-name">${f.name}</div>
        <div class="merge-sub">${f.numPages} page${f.numPages===1?"":"s"} · ${fmtBytes(f.size)}</div>
      </div>
      <button class="merge-remove" aria-label="Remove ${f.name}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    `;
    item.querySelector(".merge-remove").addEventListener("click", ()=>{
      mergeState.files = mergeState.files.filter(x=>x.id!==f.id);
      renderMergeList();
      updateMergeStats();
      if(mergeState.files.length===0) $("#mergeWorkspace").style.display="none";
    });
    wireDrag(item);
    list.appendChild(item);
  });
}

let dragSrcId = null;
function wireDrag(item){
  item.addEventListener("dragstart", e=>{
    dragSrcId = item.dataset.id;
    item.classList.add("dragging");
    e.dataTransfer.effectAllowed = "move";
  });
  item.addEventListener("dragend", ()=>{
    item.classList.remove("dragging");
    $$(".merge-item").forEach(i=> i.classList.remove("drag-over-top","drag-over-bottom"));
  });
  item.addEventListener("dragover", e=>{
    e.preventDefault();
    const rect = item.getBoundingClientRect();
    const before = (e.clientY - rect.top) < rect.height/2;
    item.classList.toggle("drag-over-top", before);
    item.classList.toggle("drag-over-bottom", !before);
  });
  item.addEventListener("dragleave", ()=> item.classList.remove("drag-over-top","drag-over-bottom"));
  item.addEventListener("drop", e=>{
    e.preventDefault();
    const targetId = item.dataset.id;
    item.classList.remove("drag-over-top","drag-over-bottom");
    if(!dragSrcId || dragSrcId===targetId) return;
    const rect = item.getBoundingClientRect();
    const before = (e.clientY - rect.top) < rect.height/2;
    const srcIdx = mergeState.files.findIndex(f=>String(f.id)===String(dragSrcId));
    const [moved] = mergeState.files.splice(srcIdx,1);
    let tgtIdx = mergeState.files.findIndex(f=>String(f.id)===String(targetId));
    if(!before) tgtIdx += 1;
    mergeState.files.splice(tgtIdx,0,moved);
    renderMergeList();
  });
}

function updateMergeStats(){
  const totalFiles = mergeState.files.length;
  const totalPages = mergeState.files.reduce((s,f)=>s+f.numPages,0);
  const totalSize = mergeState.files.reduce((s,f)=>s+f.size,0);
  $("#statFiles").textContent = totalFiles;
  $("#statPages").textContent = totalPages;
  $("#statSize").textContent = fmtBytes(totalSize);
}

$("#mergeProcessBtn").addEventListener("click", doMerge);
async function doMerge(){
  if(mergeState.files.length < 2){ showToast("Add more files", "Merging needs at least two PDFs.", "error"); return; }
  try{
    showOverlay("Merging your PDFs…", "Combining pages in order");
    const outDoc = await PDFLib.PDFDocument.create();
    for(let i=0;i<mergeState.files.length;i++){
      const f = mergeState.files[i];
      const pages = await outDoc.copyPages(f.pdfLibDoc, f.pdfLibDoc.getPageIndices());
      pages.forEach(p=> outDoc.addPage(p));
      setProgress(((i+1)/mergeState.files.length)*100);
    }
    const bytes = await outDoc.save();
    download(bytes, "merged.pdf");
    hideOverlay();
    showToast("Merge complete", `${mergeState.files.length} files combined into one PDF.`, "success");
  }catch(err){
    hideOverlay();
    console.error(err);
    showToast("Something went wrong", "Couldn't complete the merge. Please try again.", "error");
  }
}

/* ==================================================================
   Keyboard shortcuts
   ================================================================== */
document.addEventListener("keydown", e=>{
  if(e.target.matches("input,textarea")) return;
  if(e.key === "?"){ showShortcuts(); }
  if(e.key.toLowerCase()==="d"){ themeBtn.click(); }
  if((e.ctrlKey||e.metaKey) && e.key==="Enter"){
    e.preventDefault();
    if($("#panel-split").classList.contains("active")) doSplit();
    else doMerge();
  }
});
function showShortcuts(){
  showToast("Keyboard shortcuts",
    `<span class="kbd-hint">?</span> shortcuts &nbsp; <span class="kbd-hint">d</span> theme &nbsp; <span class="kbd-hint">Ctrl+Enter</span> process`, "info");
}
$("#shortcutsBtn").addEventListener("click", showShortcuts);
</script>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PDF Splitter &amp; Merger</title>
<style>
:root{
  --navy-900:#0B1520;
  --navy-800:#0F2942;
  --navy-700:#16334F;
  --navy-600:#1B3A5C;
  --steel-500:#4A6A85;
  --steel-300:#8FA6B8;
  --paper-50:#F7F8FA;
  --paper-100:#EEF1F4;
  --paper-200:#E2E7EC;
  --gold-500:#C9A227;
  --gold-400:#D9B850;
  --danger-500:#B0362E;
  --success-500:#2E7D5B;
  --ink-900:#101820;
  --ink-500:#54626E;
  --radius-sm:6px;
  --radius-md:10px;
  --radius-lg:16px;
  --shadow-1:0 1px 2px rgba(16,24,32,.06), 0 1px 1px rgba(16,24,32,.04);
  --shadow-2:0 6px 16px rgba(16,24,32,.10), 0 2px 6px rgba(16,24,32,.06);
  --shadow-3:0 20px 48px rgba(16,24,32,.18), 0 6px 16px rgba(16,24,32,.10);
  --font-display:'Sora', 'Segoe UI', sans-serif;
  --font-body:'Inter', 'Segoe UI', sans-serif;
  --font-mono:'IBM Plex Mono', ui-monospace, monospace;

  --bg:var(--paper-50);
  --bg-elevated:#FFFFFF;
  --bg-sunken:var(--paper-100);
  --border:var(--paper-200);
  --text-primary:var(--ink-900);
  --text-secondary:var(--ink-500);
  --accent:var(--navy-800);
  --accent-2:var(--gold-500);
}
[data-theme="dark"]{
  --bg:var(--navy-900);
  --bg-elevated:#122033;
  --bg-sunken:#0D1826;
  --border:#22364B;
  --text-primary:#EAF0F5;
  --text-secondary:#93A6B7;
  --accent:#8FB4DC;
  --accent-2:var(--gold-400);
}

*,*::before,*::after{box-sizing:border-box;}
html{-webkit-font-smoothing:antialiased;}
body{
  margin:0;
  background:var(--bg);
  color:var(--text-primary);
  font-family:var(--font-body);
  transition:background .25s ease, color .25s ease;
  min-height:100vh;
}
@media (prefers-reduced-motion: reduce){
  *{animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important;}
}
a{color:inherit;}
button{font-family:inherit;}
::selection{background:var(--accent-2); color:var(--navy-900);}

.visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}

/* ---------- Skip link ---------- */
.skip-link{position:absolute; left:-9999px; top:0; background:var(--accent-2); color:var(--navy-900); padding:10px 16px; z-index:1000; border-radius:0 0 8px 0; font-weight:600;}
.skip-link:focus{left:0;}

/* ---------- Top bar ---------- */
.topbar{
  position:sticky; top:0; z-index:50;
  display:flex; align-items:center; justify-content:space-between;
  padding:14px 28px;
  background:var(--bg-elevated);
  border-bottom:1px solid var(--border);
}
.brand{display:flex; align-items:center; gap:12px;}
.brand-mark{
  width:34px;height:34px;border-radius:9px;
  background:linear-gradient(155deg, var(--navy-800), var(--navy-600) 60%, var(--gold-500));
  position:relative; flex:none;
  box-shadow: var(--shadow-1);
}
.brand-mark::before,.brand-mark::after{
  content:"";position:absolute;left:7px;right:7px;height:2px;background:rgba(255,255,255,.55);border-radius:2px;
}
.brand-mark::before{top:12px;}
.brand-mark::after{top:18px; right:12px;}
.brand-name{font-family:var(--font-display); font-weight:700; font-size:17px; letter-spacing:.01em;}
.brand-tag{display:block; font-size:11px; color:var(--text-secondary); font-weight:500; letter-spacing:.04em; text-transform:uppercase;}

.top-actions{display:flex; align-items:center; gap:10px;}
.icon-btn{
  width:38px;height:38px; display:flex; align-items:center; justify-content:center;
  border-radius:var(--radius-md); border:1px solid var(--border); background:var(--bg-sunken);
  cursor:pointer; color:var(--text-primary); transition:transform .15s ease, background .15s ease, border-color .15s ease;
}
.icon-btn:hover{background:var(--paper-200); border-color:var(--steel-300);}
[data-theme="dark"] .icon-btn:hover{background:#1a2c42;}
.icon-btn:active{transform:scale(.94);}
.icon-btn:focus-visible, button:focus-visible, [tabindex]:focus-visible, input:focus-visible, .file-drop:focus-visible{
  outline:2px solid var(--gold-500); outline-offset:2px;
}

/* ---------- Tabs ---------- */
.mode-tabs{
  display:flex; gap:6px; background:var(--bg-sunken); border:1px solid var(--border); padding:4px; border-radius:12px;
}
.mode-tab{
  border:none; background:transparent; padding:9px 18px; border-radius:9px; font-weight:600; font-size:13.5px;
  color:var(--text-secondary); cursor:pointer; display:flex; align-items:center; gap:8px; transition:all .18s ease;
}
.mode-tab svg{width:16px;height:16px;}
.mode-tab.active{background:var(--accent); color:#fff; box-shadow:var(--shadow-1);}
[data-theme="dark"] .mode-tab.active{background:var(--navy-600); color:#fff;}

/* ---------- Layout ---------- */
.app-shell{max-width:1280px; margin:0 auto; padding:28px 28px 80px;}
.hero{
  padding:38px 8px 30px; display:flex; align-items:flex-end; justify-content:space-between; gap:24px; flex-wrap:wrap;
}
.hero h1{
  font-family:var(--font-display); font-size:clamp(28px,3.4vw,40px); margin:0 0 8px; font-weight:700; letter-spacing:-.01em;
}
.hero p{margin:0; color:var(--text-secondary); max-width:52ch; font-size:15px; line-height:1.55;}
.hero-spine{display:flex; align-items:flex-end; gap:3px; height:56px;}
.hero-spine .bar{width:5px; background:linear-gradient(180deg, var(--gold-500), var(--navy-700)); border-radius:3px 3px 0 0; opacity:.85;}

.panel{display:none;}
.panel.active{display:block; animation:fadeUp .35s ease;}
@keyframes fadeUp{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}

.card{
  background:var(--bg-elevated); border:1px solid var(--border); border-radius:var(--radius-lg);
  box-shadow:var(--shadow-1);
}

/* ---------- Dropzone ---------- */
.file-drop{
  border:2px dashed var(--border); border-radius:var(--radius-lg); padding:44px 24px; text-align:center;
  cursor:pointer; background:var(--bg-sunken); transition:border-color .18s ease, background .18s ease, transform .12s ease;
}
.file-drop:hover{border-color:var(--accent-2); background:var(--paper-200);}
[data-theme="dark"] .file-drop:hover{background:#152437;}
.file-drop.drag-over{border-color:var(--accent-2); background:rgba(201,162,39,.10); transform:scale(1.005);}
.file-drop-icon{
  width:56px;height:56px;margin:0 auto 14px; border-radius:14px;
  background:linear-gradient(155deg, var(--navy-800), var(--navy-600));
  display:flex;align-items:center;justify-content:center; box-shadow:var(--shadow-2);
}
.file-drop-icon svg{width:26px;height:26px; stroke:#fff;}
.file-drop h3{margin:0 0 4px; font-family:var(--font-display); font-size:17px;}
.file-drop p{margin:0; color:var(--text-secondary); font-size:13.5px;}
.file-drop .browse{color:var(--accent-2); font-weight:600; text-decoration:underline; text-underline-offset:3px;}

/* ---------- Toolbar / Sections ---------- */
.section-title{
  display:flex; align-items:center; gap:10px; font-family:var(--font-display); font-size:14px; font-weight:700;
  text-transform:uppercase; letter-spacing:.06em; color:var(--text-secondary); margin:0 0 14px;
}
.section-title .num{
  width:22px;height:22px;border-radius:50%;background:var(--accent);color:#fff;font-family:var(--font-mono);
  font-size:11px; display:flex;align-items:center;justify-content:center; letter-spacing:0;
}

.split-layout{display:grid; grid-template-columns:1.5fr 1fr; gap:22px; align-items:start;}
@media (max-width:980px){.split-layout{grid-template-columns:1fr;}}

.doc-meta-bar{
  display:flex; align-items:center; justify-content:space-between; padding:16px 20px; gap:12px; flex-wrap:wrap;
}
.doc-meta-left{display:flex; align-items:center; gap:14px;}
.doc-icon{width:40px;height:48px;border-radius:4px;background:var(--navy-800); position:relative; flex:none;
  background:linear-gradient(160deg, var(--navy-700), var(--navy-900));}
.doc-icon::after{content:"PDF"; position:absolute; bottom:6px; left:0; right:0; text-align:center; font-family:var(--font-mono);
  font-size:8px; color:var(--gold-400); font-weight:700; letter-spacing:.03em;}
.doc-name{font-weight:600; font-size:14.5px; word-break:break-all;}
.doc-sub{font-size:12.5px; color:var(--text-secondary); font-family:var(--font-mono);}
.btn{
  border:none; cursor:pointer; font-weight:600; border-radius:9px; padding:10px 16px; font-size:13.5px;
  display:inline-flex; align-items:center; gap:8px; transition:transform .12s ease, box-shadow .12s ease, background .15s ease;
}
.btn:active{transform:scale(.96);}
.btn-primary{background:var(--accent); color:#fff; box-shadow:var(--shadow-1);}
.btn-primary:hover{box-shadow:var(--shadow-2);}
.btn-gold{background:var(--gold-500); color:var(--navy-900);}
.btn-gold:hover{background:var(--gold-400);}
.btn-ghost{background:transparent; color:var(--text-primary); border:1px solid var(--border);}
.btn-ghost:hover{background:var(--bg-sunken);}
.btn-danger{background:transparent; color:var(--danger-500); border:1px solid rgba(176,54,46,.35);}
.btn-danger:hover{background:rgba(176,54,46,.08);}
.btn:disabled{opacity:.45; cursor:not-allowed; transform:none !important;}
.btn svg{width:15px;height:15px;}

/* thumbnail grid */
.thumb-toolbar{display:flex; align-items:center; gap:8px; padding:0 20px 16px; flex-wrap:wrap;}
.thumb-grid{
  display:grid; grid-template-columns:repeat(auto-fill,minmax(118px,1fr)); gap:14px; padding:4px 20px 22px; max-height:560px; overflow-y:auto;
}
.thumb{
  position:relative; border-radius:10px; overflow:hidden; background:var(--bg-sunken); border:1px solid var(--border);
  cursor:pointer; transition:border-color .15s ease, transform .15s ease;
}
.thumb:hover{transform:translateY(-2px); border-color:var(--steel-300);}
.thumb.selected{border-color:var(--accent-2); box-shadow:0 0 0 2px var(--accent-2);}
.thumb.deleted{opacity:.35;}
.thumb img,.thumb canvas{width:100%; display:block; aspect-ratio:3/4; object-fit:contain; background:#fff;}
.thumb-page-num{
  position:absolute; bottom:6px; left:6px; background:rgba(15,20,26,.72); color:#fff; font-family:var(--font-mono);
  font-size:10.5px; padding:2px 6px; border-radius:5px;
}
.thumb-check{
  position:absolute; top:6px; left:6px; width:18px;height:18px; border-radius:5px; border:1.5px solid rgba(255,255,255,.85);
  background:rgba(15,20,26,.35); display:flex; align-items:center; justify-content:center;
}
.thumb.selected .thumb-check{background:var(--accent-2); border-color:var(--accent-2);}
.thumb.selected .thumb-check svg{opacity:1;}
.thumb-check svg{width:12px;height:12px; opacity:0; stroke:var(--navy-900); stroke-width:3;}
.thumb-actions{position:absolute; top:6px; right:6px; display:flex; gap:4px;}
.thumb-mini-btn{
  width:22px;height:22px; border-radius:5px; border:none; background:rgba(15,20,26,.55); color:#fff;
  display:flex; align-items:center; justify-content:center; cursor:pointer;
}
.thumb-mini-btn:hover{background:rgba(15,20,26,.8);}
.thumb-mini-btn svg{width:12px;height:12px;}
.thumb.deleted .thumb-restore{background:var(--success-500);}
.thumb-rot{--r:0deg;}
.thumb-rot img,.thumb-rot canvas{transform:rotate(var(--r));}

/* Split methods */
.method-tabs{display:flex; gap:6px; padding:16px 20px 0; flex-wrap:wrap;}
.method-tab{
  border:1px solid var(--border); background:var(--bg-sunken); color:var(--text-secondary); padding:8px 13px;
  border-radius:8px; font-size:12.5px; font-weight:600; cursor:pointer; transition:all .15s ease;
}
.method-tab.active{background:var(--accent); color:#fff; border-color:var(--accent);}
.method-body{padding:18px 20px 6px;}
.field-row{display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:12px;}
.field-row label{font-size:12.5px; color:var(--text-secondary); font-weight:600;}
input[type="text"],input[type="number"]{
  background:var(--bg-sunken); border:1px solid var(--border); border-radius:8px; padding:9px 11px; color:var(--text-primary);
  font-family:var(--font-mono); font-size:13.5px; width:100%;
}
input[type="text"]:focus,input[type="number"]:focus{outline:none; border-color:var(--accent-2);}
.field-hint{font-size:11.5px; color:var(--text-secondary); margin-top:-6px; margin-bottom:12px;}
.field-error{font-size:12px; color:var(--danger-500); margin-top:-8px; margin-bottom:10px; display:none;}
.field-error.show{display:block;}
input.invalid{border-color:var(--danger-500); background:rgba(176,54,46,.06);}

.range-list{display:flex; flex-direction:column; gap:8px; margin:14px 0;}
.range-chip{
  display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 12px; border-radius:9px;
  background:var(--bg-sunken); border:1px solid var(--border);
}
.range-chip.invalid{border-color:var(--danger-500); background:rgba(176,54,46,.06);}
.range-chip-label{font-family:var(--font-mono); font-size:12.5px; display:flex; align-items:center; gap:8px;}
.range-chip-badge{background:var(--accent); color:#fff; font-size:10.5px; padding:2px 7px; border-radius:5px; font-family:var(--font-body); font-weight:700;}
.chip-remove{background:none; border:none; color:var(--text-secondary); cursor:pointer; padding:2px;}
.chip-remove:hover{color:var(--danger-500);}

/* sidebar / options + preview */
.sidebar-stack{display:flex; flex-direction:column; gap:18px; position:sticky; top:88px;}
.opt-row{display:flex; align-items:center; justify-content:space-between; padding:11px 0; border-bottom:1px solid var(--border);}
.opt-row:last-child{border-bottom:none;}
.opt-label{font-size:13.5px; font-weight:600;}
.opt-sub{font-size:11.5px; color:var(--text-secondary); font-weight:400; margin-top:2px;}
.switch{position:relative; width:40px; height:23px; flex:none;}
.switch input{opacity:0; width:0; height:0;}
.switch .track{position:absolute; inset:0; background:var(--border); border-radius:20px; cursor:pointer; transition:background .18s ease;}
.switch .track::after{content:""; position:absolute; width:17px;height:17px; border-radius:50%; background:#fff; top:3px; left:3px; transition:transform .18s ease; box-shadow:var(--shadow-1);}
.switch input:checked + .track{background:var(--accent-2);}
.switch input:checked + .track::after{transform:translateX(17px);}

.preview-list{display:flex; flex-direction:column; gap:8px; max-height:260px; overflow-y:auto;}
.preview-item{
  display:flex; align-items:center; gap:10px; padding:9px 11px; border-radius:8px; background:var(--bg-sunken); border:1px solid var(--border);
  font-size:12.5px;
}
.preview-item .pf-icon{width:22px;height:26px; border-radius:3px; background:var(--navy-800); flex:none;}
.preview-item .pf-name{font-weight:600;}
.preview-item .pf-sub{color:var(--text-secondary); font-family:var(--font-mono); font-size:11px;}

.stat-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:10px;}
.stat-box{background:var(--bg-sunken); border:1px solid var(--border); border-radius:10px; padding:12px 10px; text-align:center;}
.stat-num{font-family:var(--font-display); font-size:20px; font-weight:700;}
.stat-label{font-size:10.5px; color:var(--text-secondary); text-transform:uppercase; letter-spacing:.05em; margin-top:2px;}

/* Merge list */
.merge-list{display:flex; flex-direction:column; gap:10px; padding:18px 20px;}
.merge-item{
  display:flex; align-items:center; gap:14px; padding:12px; border-radius:11px; background:var(--bg-sunken); border:1px solid var(--border);
  cursor:grab; transition:box-shadow .15s ease, transform .15s ease, opacity .15s ease;
}
.merge-item.dragging{opacity:.4;}
.merge-item.drag-over-top{box-shadow:inset 0 3px 0 var(--accent-2);}
.merge-item.drag-over-bottom{box-shadow:inset 0 -3px 0 var(--accent-2);}
.merge-handle{color:var(--text-secondary); cursor:grab; padding:4px;}
.merge-handle svg{width:16px;height:16px;}
.merge-thumb{width:42px;height:54px; border-radius:4px; background:#fff; border:1px solid var(--border); object-fit:contain; flex:none;}
.merge-info{flex:1; min-width:0;}
.merge-name{font-weight:600; font-size:13.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.merge-sub{font-size:12px; color:var(--text-secondary); font-family:var(--font-mono);}
.merge-order-badge{
  width:26px;height:26px; border-radius:50%; background:var(--accent); color:#fff; font-family:var(--font-mono); font-size:11.5px;
  display:flex; align-items:center; justify-content:center; flex:none;
}
.merge-remove{background:none; border:none; color:var(--text-secondary); cursor:pointer; padding:6px;}
.merge-remove:hover{color:var(--danger-500);}

/* Loading / toast */
.overlay{
  position:fixed; inset:0; background:rgba(11,21,32,.55); backdrop-filter:blur(3px); display:none; align-items:center; justify-content:center; z-index:200;
}
.overlay.show{display:flex;}
.loader-card{
  background:var(--bg-elevated); padding:30px 38px; border-radius:16px; text-align:center; box-shadow:var(--shadow-3); min-width:260px;
}
.spinner{
  width:44px;height:44px; margin:0 auto 16px; border-radius:50%; border:3px solid var(--border); border-top-color:var(--accent-2);
  animation:spin .8s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg);}}
.loader-text{font-weight:600; font-size:14px;}
.loader-sub{font-size:12px; color:var(--text-secondary); margin-top:4px;}
.progress-bar{height:5px; background:var(--border); border-radius:3px; overflow:hidden; margin-top:14px;}
.progress-fill{height:100%; width:0%; background:linear-gradient(90deg,var(--accent-2),var(--gold-400)); transition:width .2s ease;}

.toast-region{position:fixed; bottom:22px; right:22px; display:flex; flex-direction:column; gap:10px; z-index:300; max-width:340px;}
.toast{
  background:var(--bg-elevated); border:1px solid var(--border); border-left:4px solid var(--accent-2); border-radius:10px;
  padding:13px 16px; box-shadow:var(--shadow-2); font-size:13px; display:flex; gap:10px; align-items:flex-start;
  animation:slideIn .25s ease;
}
.toast.error{border-left-color:var(--danger-500);}
.toast.success{border-left-color:var(--success-500);}
@keyframes slideIn{from{opacity:0; transform:translateX(20px);} to{opacity:1; transform:translateX(0);}}
.toast-title{font-weight:700; margin-bottom:2px;}
.toast-msg{color:var(--text-secondary);}
.toast-close{margin-left:auto; background:none; border:none; color:var(--text-secondary); cursor:pointer;}

.empty-state{padding:60px 20px; text-align:center; color:var(--text-secondary);}
.empty-state svg{width:44px;height:44px; margin-bottom:12px; opacity:.5;}

.kbd-hint{font-family:var(--font-mono); font-size:11px; padding:2px 6px; border:1px solid var(--border); border-radius:5px; background:var(--bg-sunken);}

footer.app-footer{text-align:center; padding:30px 20px 10px; color:var(--text-secondary); font-size:12px;}

.watermark-preview{
  margin-top:10px; padding:14px; border-radius:10px; background:var(--bg-sunken); border:1px dashed var(--border);
  font-size:12px; color:var(--text-secondary); display:flex; align-items:center; gap:10px;
}

@media (max-width:640px){
  .topbar{padding:12px 16px;}
  .app-shell{padding:18px 14px 60px;}
  .brand-tag{display:none;}
  .stat-grid{grid-template-columns:repeat(3,1fr);}
}
</style>
</head>
<body data-theme="light">
<a href="#main" class="skip-link">Skip to content</a>

<header class="topbar">
  <div class="brand">
    <div class="brand-mark" aria-hidden="true"></div>
    <div>
      <span class="brand-name">Foliant</span>
      <span class="brand-tag">PDF Splitter &amp; Merger</span>
    </div>
  </div>

  <nav class="mode-tabs" role="tablist" aria-label="Choose tool">
    <button class="mode-tab active" role="tab" aria-selected="true" id="tab-split-btn" data-mode="split">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3v18M3 8l5-5 5 5M16 21v-18M21 16l-5 5-5-5"/></svg>
      Split
    </button>
    <button class="mode-tab" role="tab" aria-selected="false" id="tab-merge-btn" data-mode="merge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3v7a4 4 0 0 0 4 4 4 4 0 0 0 4-4V3M4 21h16"/></svg>
      Merge
    </button>
  </nav>

  <div class="top-actions">
    <button class="icon-btn" id="shortcutsBtn" aria-label="Keyboard shortcuts" title="Keyboard shortcuts (?)">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M6 9h.01M10 9h.01M14 9h.01M18 9h.01M6 13h12"/></svg>
    </button>
    <button class="icon-btn" id="themeBtn" aria-label="Toggle dark mode" title="Toggle theme">
      <svg id="themeIcon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>
  </div>
</header>

<main id="main" class="app-shell">

  <div class="hero">
    <div>
      <h1 id="heroTitle">Split PDFs precisely. Merge them cleanly.</h1>

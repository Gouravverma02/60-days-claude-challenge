const splitState = {
  file:null, pdfLibDoc:null, pdfjsDoc:null, numPages:0,
  pages:[], // {index, rotation, deleted, thumbUrl, selected}
  ranges:[], // {id, start, end}
  method:"ranges",
};

function wirePdfDrop(dropEl, inputEl, onFiles, multiple){
  dropEl.addEventListener("click", ()=> inputEl.click());
  dropEl.addEventListener("keydown", e=>{ if(e.key==="Enter"||e.key===" "){ e.preventDefault(); inputEl.click(); }});
  ["dragenter","dragover"].forEach(ev=> dropEl.addEventListener(ev, e=>{ e.preventDefault(); dropEl.classList.add("drag-over"); }));
  ["dragleave","drop"].forEach(ev=> dropEl.addEventListener(ev, e=>{ e.preventDefault(); dropEl.classList.remove("drag-over"); }));
  dropEl.addEventListener("drop", e=>{
    const files = Array.from(e.dataTransfer.files).filter(f=>f.type==="application/pdf" || f.name.toLowerCase().endsWith(".pdf"));
    if(files.length===0){ showToast("Unsupported file", "Please drop a PDF file.", "error"); return; }
    onFiles(multiple ? files : [files[0]]);
  });
  inputEl.addEventListener("change", e=>{
    const files = Array.from(e.target.files);
    if(files.length) onFiles(multiple ? files : [files[0]]);
    inputEl.value = "";
  });
}

wirePdfDrop($("#splitDrop"), $("#splitFileInput"), (files)=> loadSplitFile(files[0]), false);
$("#splitReplaceBtn").addEventListener("click", ()=> $("#splitFileInput").click());

async function loadSplitFile(file){
  try{
    showOverlay("Reading your PDF…", "Detecting pages and generating previews");
    const buf = await file.arrayBuffer();
    const pdfLibDoc = await PDFLib.PDFDocument.load(buf, {ignoreEncryption:true});
    const pdfjsDoc = await pdfjsLib.getDocument({data: buf.slice(0)}).promise;
    const numPages = pdfLibDoc.getPageCount();

    splitState.file = file;
    splitState.pdfLibDoc = pdfLibDoc;
    splitState.pdfjsDoc = pdfjsDoc;
    splitState.numPages = numPages;
    splitState.pages = Array.from({length:numPages}, (_,i)=>({index:i, rotation:0, deleted:false, thumbUrl:null, selected:false}));
    splitState.ranges = [];

    $("#splitDocName").textContent = file.name;
    $("#splitDocSub").textContent = `${numPages} page${numPages===1?"":"s"} · ${fmtBytes(file.size)}`;
    $("#splitDropWrap").style.display = "none";
    $("#splitWorkspace").style.display = "block";

    await renderAllThumbs();
    updateSelectionCount();
    renderRangeList();
    renderOutputPreview();
    hideOverlay();
    showToast("PDF loaded", `${numPages} page${numPages===1?"":"s"} detected.`, "success");
  }catch(err){
    hideOverlay();
    console.error(err);
    showToast("Couldn't read that file", "Make sure it's a valid, unencrypted PDF.", "error");
  }
}

async function renderAllThumbs(){
  const grid = $("#thumbGrid");
  grid.innerHTML = "";
  const total = splitState.numPages;
  for(let i=0;i<total;i++){
    const page = splitState.pages[i];
    const thumb = document.createElement("div");
    thumb.className = "thumb thumb-rot";
    thumb.style.setProperty("--r", "0deg");
    thumb.setAttribute("role","listitem");
    thumb.setAttribute("tabindex","0");
    thumb.setAttribute("aria-label", `Page ${i+1}`);
    thumb.dataset.index = i;
    thumb.innerHTML = `
      <div class="thumb-check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg></div>
      <div class="thumb-actions">
        <button class="thumb-mini-btn thumb-rotate" aria-label="Rotate page ${i+1}" title="Rotate 90°">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
        </button>
        <button class="thumb-mini-btn thumb-restore" aria-label="Delete page ${i+1}" title="Delete page">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>
        </button>
      </div>
      <canvas></canvas>
      <div class="thumb-page-num">${i+1}</div>
    `;
    grid.appendChild(thumb);
    renderThumbCanvas(i, thumb.querySelector("canvas"));
    thumb.addEventListener("click", (e)=>{
      if(e.target.closest(".thumb-mini-btn")) return;
      toggleSelect(i);
    });
    thumb.addEventListener("keydown", e=>{ if(e.key==="Enter"||e.key===" "){ e.preventDefault(); toggleSelect(i); }});
    thumb.querySelector(".thumb-rotate").addEventListener("click", (e)=>{ e.stopPropagation(); rotatePage(i); });
    thumb.querySelector(".thumb-restore").addEventListener("click", (e)=>{ e.stopPropagation(); toggleDelete(i); });
  }
}

async function renderThumbCanvas(index, canvas){
  try{
    const page = await splitState.pdfjsDoc.getPage(index+1);
    const viewport = page.getViewport({scale:0.45});
    canvas.width = viewport.width; canvas.height = viewport.height;
    const ctx = canvas.getContext("2d");
    await page.render({canvasContext:ctx, viewport}).promise;
  }catch(err){ console.warn("thumb render failed", err); }
}

function toggleSelect(i){
  splitState.pages[i].selected = !splitState.pages[i].selected;
  $(`.thumb[data-index="${i}"]`).classList.toggle("selected", splitState.pages[i].selected);
  updateSelectionCount();
  if(splitState.method === "extract") renderOutputPreview();
}
function updateSelectionCount(){
  const n = splitState.pages.filter(p=>p.selected).length;
  $("#selectionCount").textContent = `${n} selected`;
}
$("#selectAllBtn").addEventListener("click", ()=>{
  splitState.pages.forEach(p=>p.selected=true);
  $$(".thumb").forEach(t=>t.classList.add("selected"));

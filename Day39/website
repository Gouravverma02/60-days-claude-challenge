function showToast(title, msg, type="info"){
  const region = $("#toastRegion");
  const el = document.createElement("div");
  el.className = "toast" + (type==="error" ? " error" : type==="success" ? " success" : "");
  el.innerHTML = `<div><div class="toast-title">${title}</div><div class="toast-msg">${msg}</div></div><button class="toast-close" aria-label="Dismiss">&times;</button>`;
  el.querySelector(".toast-close").onclick = () => el.remove();
  region.appendChild(el);
  setTimeout(()=>{ el.style.opacity="0"; el.style.transform="translateX(20px)"; setTimeout(()=>el.remove(),250); }, 5500);
}
function showOverlay(text, sub){
  $("#loaderText").textContent = text || "Processing…";
  $("#loaderSub").textContent = sub || "This stays on your device";
  $("#progressFill").style.width = "0%";
  $("#overlay").classList.add("show");
}
function setProgress(pct){ $("#progressFill").style.width = Math.min(100,Math.max(0,pct)) + "%"; }
function hideOverlay(){ $("#overlay").classList.remove("show"); }
function fmtBytes(bytes){
  if(bytes < 1024) return bytes + " B";
  if(bytes < 1024*1024) return (bytes/1024).toFixed(0) + " KB";
  return (bytes/(1024*1024)).toFixed(2) + " MB";
}
function download(bytes, filename, mime="application/pdf"){
  const blob = new Blob([bytes], {type:mime});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(url), 4000);
}


// RENDER FUNCTIONS
// ══════════════════════════════════════════════
function refreshAll() {
  buildHeatmap();
  buildCompanyChart();
  buildMatrix();
  buildRadar();
  buildWow();
  buildAssets();
  buildSimulator();
  buildVerdict();
}

function buildHeatmap() {
  const c = document.getElementById('heatmapContainer');
  const labels = ['', ...HEATMAP_COLS];
  let html = '<div class="heatmap-grid">';
  html += labels.map(l => `<div class="heatmap-header">${l}</div>`).join('');
  HEATMAP_ROWS.forEach((row, ri) => {
    html += `<div class="heatmap-row-label">${row}</div>`;
    HEATMAP_DATA[ri].forEach((v, ci) => {
      const tips = ['None','Low','Medium','High','Critical'];
      html += `<div class="heatmap-cell heat-${v}" onmouseenter="showTip(event,'${row} → ${HEATMAP_COLS[ci]}: ${tips[v]}')" onmouseleave="hideTip()">${v>0?tips[v].slice(0,3):''}</div>`;
    });
  });
  html += '</div>';
  c.innerHTML = html;
}

function buildCompanyChart() {
  const companies = {};
  USER_APPS.forEach(a => { companies[a.company] = (companies[a.company] || 0) + 1; });
  const sorted = Object.entries(companies).sort((a,b) => b[1]-a[1]);
  const max = sorted[0][1];
  const colors = ['#00d4ff','#7c3aed','#ff2d55','#ffd60a','#ff6b35','#00ff88','#ec4899','#14b8a6'];
  document.getElementById('companyChart').innerHTML = sorted.map(([name, count], i) => {
    const pct = Math.round(count / USER_APPS.length * 100);
    return `
      <div class="bar-row">
        <div class="bar-label">${name}</div>
        <div class="bar-track">
          <div class="bar-fill" style="background:${colors[i%colors.length]};width:0%" data-w="${count/max*100}%">${count} app${count>1?'s':''}</div>
        </div>
        <div class="bar-count" style="color:${colors[i%colors.length]}">${pct}%</div>
      </div>`;
  }).join('');
  setTimeout(() => {
    document.querySelectorAll('.bar-fill').forEach(el => {
      el.style.transition = 'width 1.2s cubic-bezier(0.4,0,0.2,1)';
      el.style.width = el.dataset.w;
    });
  }, 100);
}

function buildMatrix() {
  const table = document.getElementById('matrixTable');
  const riskColors = ['','#00ff88','#ffd60a','#ff6b35','#ff2d55'];
  const riskLabels = ['','Low','Medium','High','Critical'];
  const dotColors = ['rgba(255,255,255,0.1)','rgba(0,255,136,0.7)','rgba(255,214,10,0.7)','rgba(255,107,53,0.7)','rgba(255,45,85,0.7)'];

  let html = `<thead><tr>
    <th>App</th><th>Company</th><th>Risk</th>
    ${DATA_TYPES.map(d=>`<th style="text-align:center">${d.slice(0,3)}</th>`).join('')}
  </tr></thead><tbody>`;

  USER_APPS.forEach(app => {
    const dataMap = APP_DATA_MAP[app.name] || [1,1,0,2,0,1,1,2];
    const rc = riskColors[app.risk] || '#00ff88';
    html += `<tr>
      <td><div class="app-chip">${app.icon} ${app.name}</div></td>
      <td style="color:var(--text2)">${app.company}</td>
      <td><div class="risk-pill" style="background:${rc}22;color:${rc};border:1px solid ${rc}44">${riskLabels[app.risk]||'Low'}</div></td>
      ${dataMap.map((v,i) => `<td style="text-align:center">
        <div class="data-dot" style="background:${dotColors[v]};width:10px;height:10px;border-radius:50%;margin:0 auto;display:block"
          onmouseenter="showTip(event,'${app.name} → ${DATA_TYPES[i]}: ${['None','Low','Med','High','Critical'][v]}')"
          onmouseleave="hideTip()"></div></td>`).join('')}
    </tr>`;
  });
  html += '</tbody>';
  table.innerHTML = html;
}

function buildRadar() {
  const canvas = document.getElementById('radarCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const w = canvas.width, h = canvas.height;
  const cx = w/2, cy = h/2, r = Math.min(w,h)/2 - 40;
  const n = RADAR_DATA.length;
  ctx.clearRect(0,0,w,h);

  // Grid
  for (let ring = 1; ring <= 5; ring++) {
    ctx.beginPath();
    for (let i = 0; i <= n; i++) {
      const a = (i/n)*Math.PI*2 - Math.PI/2;
      const rr = r * ring/5;
      if (i===0) ctx.moveTo(cx+Math.cos(a)*rr, cy+Math.sin(a)*rr);
      else ctx.lineTo(cx+Math.cos(a)*rr, cy+Math.sin(a)*rr);
    }
    ctx.closePath();
    ctx.strokeStyle = 'rgba(0,212,255,0.1)';
    ctx.lineWidth = 1;
    ctx.stroke();
  }

  // Axes
  for (let i = 0; i < n; i++) {
    const a = (i/n)*Math.PI*2 - Math.PI/2;
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(cx+Math.cos(a)*r, cy+Math.sin(a)*r);
    ctx.strokeStyle = 'rgba(0,212,255,0.15)';
    ctx.lineWidth = 1;
    ctx.stroke();
  }

  // Data polygon
  ctx.beginPath();
  RADAR_DATA.forEach((d,i) => {
    const a = (i/n)*Math.PI*2 - Math.PI/2;
    const rr = r*(d.value/100);
    if(i===0) ctx.moveTo(cx+Math.cos(a)*rr, cy+Math.sin(a)*rr);
    else ctx.lineTo(cx+Math.cos(a)*rr, cy+Math.sin(a)*rr);
  });
  ctx.closePath();
  ctx.fillStyle = 'rgba(255,45,85,0.12)';
  ctx.fill();
  ctx.strokeStyle = '#ff2d55';
  ctx.lineWidth = 2;
  ctx.stroke();

  // Dots
  RADAR_DATA.forEach((d,i) => {
    const a = (i/n)*Math.PI*2 - Math.PI/2;
    const rr = r*(d.value/100);
    ctx.beginPath();
    ctx.arc(cx+Math.cos(a)*rr, cy+Math.sin(a)*rr, 4, 0, Math.PI*2);
    ctx.fillStyle = d.color;
    ctx.fill();
  });

  // Labels
  RADAR_DATA.forEach((d,i) => {
    const a = (i/n)*Math.PI*2 - Math.PI/2;
    const lx = cx+Math.cos(a)*(r+22);
    const ly = cy+Math.sin(a)*(r+22);
    ctx.fillStyle = 'rgba(107,130,153,0.9)';
    ctx.font = '9px Space Grotesk, sans-serif';
    ctx.textAlign = lx>cx?'left':lx<cx-5?'right':'center';
    ctx.fillText(d.label.split(' ')[0], lx, ly);
  });

  document.getElementById('radarLegend').innerHTML = RADAR_DATA.map(d => `
    <div class="radar-legend-item">
      <div class="radar-legend-dot" style="background:${d.color}"></div>
      <div class="radar-legend-label">${d.label}</div>
      <div class="radar-legend-value" style="color:${d.color}">${d.value}</div>
    </div>`).join('');
}

function buildWow() {
  const wowColors = { danger:var_('--red'), warning:var_('--orange'), info:var_('--accent'), purple:var_('--accent2'), teal:var_('--accent3'), green:var_('--green') };
  document.getElementById('wowGrid').innerHTML = WOW_INSIGHTS.map(w => `
    <div class="wow-card ${w.type}">
      <div class="wow-number" style="color:${wowColors[w.type]||var_('--accent')}">${w.number}<span style="font-size:14px;font-weight:500">${w.unit||''}</span></div>
      <div class="wow-title">${w.title}</div>
      <div class="wow-desc">${w.desc}</div>
      <div class="wow-tag"><span class="tag ${w.estFact.includes('Fact')?'tag-fact':'tag-estimate'}">${w.estFact}</span></div>
    </div>`).join('');
}

function var_(v) {
  return getComputedStyle(document.documentElement).getPropertyValue(v).trim();
}

function buildAssets() {
  document.getElementById('assetsList').innerHTML = ASSETS.map((a,i) => `
    <div class="asset-item">
      <div class="asset-rank">${i+1}</div>
      <div class="asset-icon">${a.icon}</div>
      <div class="asset-info">
        <div class="asset-name">${a.name}</div>
        <div class="asset-desc">${a.desc}</div>
      </div>
      <div class="asset-value">
        <div class="value-score" style="color:${a.color}">${a.score}</div>
        <div class="value-label">Value Score</div>
        <div class="asset-bar" style="margin-top:4px">
          <div class="asset-bar-fill" style="background:${a.color};width:0%;height:100%;border-radius:2px;transition:width 1.2s ease" data-w="${a.score}%"></div>
        </div>
      </div>
    </div>`).join('');
  setTimeout(() => {
    document.querySelectorAll('.asset-bar-fill').forEach(el => { el.style.width = el.dataset.w; });
  }, 200);
}

function buildSimulator() {
  simState = {};
  SIM_TOGGLES.forEach(t => simState[t.id] = false);
  document.getElementById('simToggles').innerHTML = SIM_TOGGLES.map(t => `
    <div class="sim-toggle-row" onclick="toggleSim('${t.id}')">
      <div class="toggle-switch" id="sw_${t.id}"></div>
      <div class="toggle-info">
        <div class="toggle-title">${t.title}</div>
        <div class="toggle-sub">${t.sub}</div>
      </div>
      <div class="toggle-impact" style="color:var(--green)">+${t.impact} pts</div>
    </div>`).join('');
  updateSim();
}

function toggleSim(id) {
  simState[id] = !simState[id];
  const sw = document.getElementById('sw_'+id);
  if (sw) sw.classList.toggle('on', simState[id]);
  updateSim();
}

function updateSim() {
  const gained = SIM_TOGGLES.filter(t => simState[t.id]).reduce((a,t)=>a+t.impact, 0);
  const ns = Math.min(100, PS + gained);
  const el = document.getElementById('simScore');
  el.textContent = ns;
  el.style.color = ns>=81?'var(--green)':ns>=61?'var(--yellow)':ns>=31?'var(--orange)':'var(--red)';
  document.getElementById('simDelta').textContent = `+${gained} points from baseline (${PS} → ${ns})`;
  const active = SIM_TOGGLES.filter(t => simState[t.id]);
  document.getElementById('simBreakdown').innerHTML = active.length===0
    ? '<div style="font-size:10px;color:var(--text3);text-align:center;padding:12px;font-family:var(--mono)">Toggle actions to simulate improvements</div>'
    : active.map(t=>`<div class="sim-break-row"><span style="color:var(--text2)">${t.title}</span><span style="color:var(--green)">+${t.impact}</span></div>`).join('');
}

function buildVerdict() {
  const grade = PS >= 80 ? 'A' : PS >= 60 ? 'B' : PS >= 40 ? 'C–' : PS >= 20 ? 'D' : 'F';
  document.getElementById('verdictGrade').textContent = grade;
  document.getElementById('actionList').innerHTML = ACTIONS.map((a,i) => `
    <div class="action-item">
      <div class="action-num">${i+1}</div>
      <div class="action-text"><strong>${a.title}</strong>${a.body}</div>
    </div>`).join('');
}

// ══════════════════════════════════════════════
// DRAG & DROP (Panel Reordering)
// ══════════════════════════════════════════════
function dragStart(e, id) {
  dragSrcId = id;
  e.dataTransfer.effectAllowed = 'move';
  setTimeout(() => { document.getElementById(id).classList.add('dragging'); }, 0);
}

function dragEnd(e) {
  document.querySelectorAll('.moveable-section').forEach(el => {
    el.classList.remove('dragging', 'drag-over');
  });
}

function dragOver(e) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  const section = e.currentTarget.closest('.moveable-section');
  if (section && section.id !== dragSrcId) section.classList.add('drag-over');
}

function dragLeave(e) {
  const section = e.currentTarget.closest('.moveable-section');
  if (section) section.classList.remove('drag-over');
}

function dragDrop(e, targetId) {
  e.preventDefault();
  if (dragSrcId === targetId) return;
  const wrapper = document.getElementById('sectionsWrapper');
  const src = document.getElementById(dragSrcId);
  const tgt = document.getElementById(targetId);
  if (!src || !tgt) return;

  // Determine position
  const srcIdx = Array.from(wrapper.children).indexOf(src);
  const tgtIdx = Array.from(wrapper.children).indexOf(tgt);

  if (srcIdx < tgtIdx) {
    wrapper.insertBefore(src, tgt.nextSibling);
  } else {
    wrapper.insertBefore(src, tgt);
  }
  showToast('Panel reordered! ⠿');
}

// ══════════════════════════════════════════════
// AI ASSISTANT
// ══════════════════════════════════════════════
function getAISystem() {
  const appNames = USER_APPS.map(a => a.name).join(', ');
  const userName = USER_NAME || 'the user';
  return `You are a cybersecurity and digital privacy expert AI assistant embedded in a premium privacy dashboard. ${userName} uses these ${USER_APPS.length} apps: ${appNames}. Their Digital Footprint Score is ${DFS}/100 and Privacy Score is ${PS}/100. Always distinguish between Facts (from the app list) and Estimates (inferences). Be concise, specific, and actionable. Format responses clearly with line breaks. Never claim access to private databases.`;
}

async function sendAI() {
  const input = document.getElementById('aiInput');
  const text = input.value.trim();
  if (!text) return;
  addMsg(text, 'user');
  input.value = '';
  const typing = addMsg('🔍 Analyzing your digital footprint…', 'bot typing');
  try {
    const resp = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-6',
        max_tokens: 1000,
        system: getAISystem(),
        messages: [{ role: 'user', content: text }]
      })
    });
    const data = await resp.json();
    typing.remove();
    const reply = data.content?.map(b => b.text||'').join('') || 'Sorry, could not generate a response.';
    addMsg(reply, 'bot');
  } catch(e) {
    typing.remove();
    addMsg('⚠️ AI request failed. Please check connection and try again.', 'bot');
  }
}

function sendAISugg(el) {
  document.getElementById('aiInput').value = el.textContent;
  sendAI();
}

function addMsg(text, type) {
  const msgs = document.getElementById('aiMessages');
  const div = document.createElement('div');
  div.className = 'ai-msg ' + type;
  div.textContent = text;
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
  return div;
}

function focusAI() {
  document.getElementById('aiInput').focus();
  document.getElementById('aiPanel').scrollIntoView({ behavior: 'smooth' });
}

// ══════════════════════════════════════════════
// UTILITIES
// ══════════════════════════════════════════════
function scrollTo(id) {
  const el = document.getElementById(id);
  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
}

function setMode(mode, e) {
  currentMode = mode;
  document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
  if (e) e.target.classList.add('active');
  const detailedOnly = ['radarSection', 'matrixSection'];
  detailedOnly.forEach(id => {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('hidden', mode === 'overview');
  });
  if (mode === 'detailed') buildRadar();
}

function animateCount(el, target, duration = 1400) {
  if (!el) return;
  let start = 0;
  const step = () => {
    start += Math.ceil(target / (duration / 16));
    if (start >= target) { el.textContent = target; return; }
    el.textContent = start;
    requestAnimationFrame(step);
  };
  requestAnimationFrame(step);
}

function showTip(e, text) {
  const tt = document.getElementById('tooltip');
  tt.textContent = text;
  tt.style.left = (e.clientX + 12) + 'px';
  tt.style.top = (e.clientY - 10) + 'px';
  tt.classList.add('show');
}

function hideTip() {
  document.getElementById('tooltip').classList.remove('show');
}

function showToast(msg) {
  const t = document.getElementById('toast');
  document.getElementById('toastMsg').textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3000);
}

function runLoadBar() {
  const bar = document.getElementById('loadBar');
  let w = 0;
  const t = setInterval(() => {
    w += Math.random() * 18;
    if (w >= 100) { w = 100; clearInterval(t); setTimeout(() => { bar.style.opacity = '0'; }, 400); }
    bar.style.width = w + '%';
  }, 70);
}

function updateClock() {
  const el = document.getElementById('statusTime');
  if (el) {
    const now = new Date();
    el.textContent = now.toLocaleTimeString('en-IN', { hour12: false });
  }
}

// ══════════════════════════════════════════════
// BOOT

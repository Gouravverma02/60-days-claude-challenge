<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PrivacyIQ Pro — Digital Footprint Intelligence</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600;700&display=swap');

  :root {
    --bg: #060810;
    --surface: #0d1117;
    --surface2: #111827;
    --surface3: #1a2235;
    --border: #1f2d45;
    --border2: #2a3f5f;
    --accent: #00d4ff;
    --accent2: #7c3aed;
    --accent3: #00ff88;
    --warn: #ff6b35;
    --danger: #ff2d55;
    --green: #00ff88;
    --yellow: #ffd60a;
    --orange: #ff6b35;
    --red: #ff2d55;
    --text: #e8f4fd;
    --text2: #6b8299;
    --text3: #3a4a5c;
    --fact: #00d4ff;
    --estimate: #a78bfa;
    --font: 'Space Grotesk', -apple-system, sans-serif;
    --mono: 'JetBrains Mono', 'Courier New', monospace;
    --glow-blue: 0 0 20px rgba(0,212,255,0.3);
    --glow-purple: 0 0 20px rgba(124,58,237,0.3);
    --glow-green: 0 0 20px rgba(0,255,136,0.3);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 14px;
    line-height: 1.6;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* AMBIENT BG */
  body::before {
    content: '';
    position: fixed; inset: 0;
    background:
      radial-gradient(ellipse 800px 600px at 20% 10%, rgba(0,212,255,0.04) 0%, transparent 70%),
      radial-gradient(ellipse 600px 500px at 80% 80%, rgba(124,58,237,0.05) 0%, transparent 70%),
      repeating-linear-gradient(0deg, transparent, transparent 40px, rgba(255,255,255,0.01) 40px, rgba(255,255,255,0.01) 41px),
      repeating-linear-gradient(90deg, transparent, transparent 40px, rgba(255,255,255,0.01) 40px, rgba(255,255,255,0.01) 41px);
    pointer-events: none; z-index: 0;
  }

  /* SCAN LINE */
  .scanline {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,212,255,0.015) 3px, rgba(0,212,255,0.015) 4px);
    pointer-events: none; z-index: 0; animation: scanMove 8s linear infinite;
  }
  @keyframes scanMove {
    0% { background-position: 0 0; }
    100% { background-position: 0 100vh; }
  }

  /* LOAD BAR */
  .load-bar {
    position: fixed; top: 0; left: 0; height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent2), var(--accent3));
    z-index: 9999; transition: width 0.4s; width: 0%;
    box-shadow: 0 0 10px var(--accent);
  }

  /* HEADER */
  .header {
    position: sticky; top: 0; z-index: 200;
    background: rgba(6,8,16,0.92);
    backdrop-filter: blur(24px) saturate(180%);
    border-bottom: 1px solid rgba(0,212,255,0.15);
    padding: 0;
  }
  .header-top {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 32px; height: 64px;
    max-width: 1600px; margin: 0 auto;
  }

  /* PREMIUM LOGO */
  .logo-wrap { display: flex; align-items: center; gap: 14px; text-decoration: none; }
  .logo-emblem {
    position: relative; width: 44px; height: 44px; flex-shrink: 0;
  }
  .logo-emblem svg { width: 44px; height: 44px; }
  .logo-hex {
    animation: hexRotate 20s linear infinite;
    transform-origin: center;
  }
  @keyframes hexRotate { to { transform: rotate(360deg); } }
  .logo-text-wrap { display: flex; flex-direction: column; }
  .logo-name {
    font-family: var(--mono);
    font-size: 18px; font-weight: 700;
    letter-spacing: -0.5px;
    background: linear-gradient(135deg, #00d4ff, #7c3aed);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    line-height: 1.2;
  }
  .logo-badge {
    display: inline-flex; align-items: center; gap: 4px;
    background: linear-gradient(135deg, rgba(0,212,255,0.2), rgba(124,58,237,0.2));
    border: 1px solid rgba(0,212,255,0.4);
    border-radius: 3px; padding: 1px 6px;
    font-size: 9px; font-weight: 700; letter-spacing: 1.5px;
    color: var(--accent); text-transform: uppercase;
  }
  .logo-badge::before {
    content: '◆'; font-size: 6px; color: var(--yellow);
  }

  /* NAV */
  .nav-links {
    display: flex; align-items: center; gap: 4px;
  }
  .nav-link {
    padding: 6px 14px; font-size: 12px; font-weight: 500;
    color: var(--text2); border-radius: 6px; cursor: pointer;
    transition: all 0.2s; border: 1px solid transparent;
    background: none; text-decoration: none; white-space: nowrap;
  }
  .nav-link:hover { color: var(--accent); border-color: rgba(0,212,255,0.2); background: rgba(0,212,255,0.05); }
  .nav-link.active { color: var(--accent); border-color: rgba(0,212,255,0.3); background: rgba(0,212,255,0.1); }

  .nav-right { display: flex; align-items: center; gap: 10px; }

  .mode-toggle {
    display: flex; background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; overflow: hidden;
  }
  .mode-btn {
    padding: 6px 16px; font-size: 11px; font-weight: 600; cursor: pointer;
    border: none; background: transparent; color: var(--text2); transition: all 0.2s; letter-spacing: 0.5px; font-family: var(--font);
  }
  .mode-btn.active { background: linear-gradient(135deg, rgba(0,212,255,0.2), rgba(124,58,237,0.2)); color: var(--accent); }

  .btn-ai {
    display: flex; align-items: center; gap: 7px; padding: 8px 16px;
    background: linear-gradient(135deg, rgba(0,212,255,0.15), rgba(124,58,237,0.15));
    border: 1px solid rgba(0,212,255,0.4); border-radius: 8px;
    color: var(--accent); font-size: 12px; font-weight: 600; cursor: pointer;
    transition: all 0.2s; font-family: var(--font);
    box-shadow: 0 0 12px rgba(0,212,255,0.1);
  }
  .btn-ai:hover { background: linear-gradient(135deg, rgba(0,212,255,0.25), rgba(124,58,237,0.25)); box-shadow: var(--glow-blue); }

  /* HEADER STATUS BAR */
  .header-status {
    display: flex; align-items: center; justify-content: center; gap: 28px;
    padding: 6px 32px; background: rgba(0,212,255,0.03);
    border-top: 1px solid rgba(0,212,255,0.08);
    font-size: 10px; font-family: var(--mono); color: var(--text3);
    max-width: 1600px; margin: 0 auto;
  }
  .status-item { display: flex; align-items: center; gap: 6px; }
  .status-dot { width: 5px; height: 5px; border-radius: 50%; }
  .status-dot.green { background: var(--green); box-shadow: 0 0 6px var(--green); animation: blink 2s infinite; }
  .status-dot.yellow { background: var(--yellow); }
  .status-dot.red { background: var(--red); }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.4} }

  /* CONTAINER */
  .container { max-width: 1600px; margin: 0 auto; padding: 28px 32px; position: relative; z-index: 1; }

  /* HERO */
  .hero {
    padding: 36px 0 28px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 28px;
  }
  .hero-eyebrow {
    font-family: var(--mono); font-size: 10px; letter-spacing: 2px;
    color: var(--accent); font-weight: 600; margin-bottom: 10px;
    display: flex; align-items: center; gap: 8px;
  }
  .hero-eyebrow::before { content: ''; display: block; width: 20px; height: 1px; background: var(--accent); }
  .hero-title {
    font-size: 36px; font-weight: 700; letter-spacing: -1.5px;
    line-height: 1.1; margin-bottom: 10px;
    background: linear-gradient(135deg, #ffffff 0%, #a0c4ff 60%, #7c3aed 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .hero-sub { font-size: 14px; color: var(--text2); max-width: 700px; line-height: 1.8; }
  .hero-meta { margin-top: 20px; display: flex; gap: 12px; flex-wrap: wrap; }
  .meta-chip {
    display: flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,0.03); border: 1px solid var(--border);
    border-radius: 20px; padding: 5px 14px; font-size: 11px; color: var(--text2);
    font-family: var(--mono);
  }
  .meta-chip .dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }

  /* USER SETUP PANEL */
  .setup-panel {
    background: linear-gradient(135deg, rgba(0,212,255,0.06), rgba(124,58,237,0.06));
    border: 1px solid rgba(0,212,255,0.2); border-radius: 16px;
    padding: 24px; margin-bottom: 28px;
  }
  .setup-title { font-size: 15px; font-weight: 700; margin-bottom: 6px; color: var(--accent); }
  .setup-sub { font-size: 12px; color: var(--text2); margin-bottom: 16px; }
  .setup-form { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; }
  .form-field { display: flex; flex-direction: column; gap: 4px; }
  .form-label { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--text2); }
  .form-input {
    background: var(--surface); border: 1px solid var(--border2); border-radius: 8px;
    padding: 8px 12px; color: var(--text); font-size: 12px; font-family: var(--font);
    outline: none; transition: border-color 0.2s; min-width: 200px;
  }
  .form-input:focus { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(0,212,255,0.1); }
  .form-input::placeholder { color: var(--text3); }
  .btn-analyze {
    padding: 8px 20px; background: linear-gradient(135deg, var(--accent), var(--accent2));
    border: none; border-radius: 8px; color: #000; font-size: 12px; font-weight: 700;
    cursor: pointer; font-family: var(--font); transition: opacity 0.2s; white-space: nowrap;
  }
  .btn-analyze:hover { opacity: 0.9; }
  .apps-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .app-tag {
    display: flex; align-items: center; gap: 5px; padding: 4px 10px;
    background: var(--surface2); border: 1px solid var(--border2); border-radius: 20px;
    font-size: 11px; cursor: pointer; transition: all 0.15s;
  }
  .app-tag.selected { background: rgba(0,212,255,0.1); border-color: rgba(0,212,255,0.4); color: var(--accent); }
  .app-tag .remove { opacity: 0.5; font-size: 10px; }
  .app-tag:hover .remove { opacity: 1; color: var(--red); }

  /* SCORE CARDS */
  .scores-row {
    display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; margin-bottom: 28px;
  }
  @media(max-width:1200px){ .scores-row { grid-template-columns: repeat(3,1fr); } }
  @media(max-width:700px){ .scores-row { grid-template-columns: repeat(2,1fr); } }

  .score-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
    padding: 18px; position: relative; overflow: hidden; cursor: pointer;
    transition: all 0.25s;
  }
  .score-card:hover {
    border-color: var(--border2);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }
  .score-card .card-glow {
    position: absolute; top: -30px; right: -30px; width: 100px; height: 100px;
    border-radius: 50%; filter: blur(30px); opacity: 0.15;
  }
  .score-card .card-line {
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    border-radius: 14px 14px 0 0;
  }
  .score-card .card-label {
    font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px;
    color: var(--text2); font-weight: 600; margin-bottom: 10px; font-family: var(--mono);
  }
  .score-card .card-value {
    font-size: 36px; font-weight: 700; letter-spacing: -2px; line-height: 1;
    font-family: var(--mono);
  }
  .score-card .card-badge {
    display: inline-flex; align-items: center; gap: 4px; margin-top: 8px;
    font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 4px;
    letter-spacing: 0.3px; font-family: var(--mono);
  }
  .score-card .card-sub { font-size: 10px; color: var(--text2); margin-top: 4px; }
  .badge-green { background: rgba(0,255,136,0.1); color: var(--green); border: 1px solid rgba(0,255,136,0.2); }
  .badge-yellow { background: rgba(255,214,10,0.1); color: var(--yellow); border: 1px solid rgba(255,214,10,0.2); }
  .badge-orange { background: rgba(255,107,53,0.1); color: var(--orange); border: 1px solid rgba(255,107,53,0.2); }
  .badge-red { background: rgba(255,45,85,0.1); color: var(--red); border: 1px solid rgba(255,45,85,0.2); }
  .badge-blue { background: rgba(0,212,255,0.1); color: var(--accent); border: 1px solid rgba(0,212,255,0.2); }

  /* MOVEABLE PANELS */
  .moveable-section {
    background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
    margin-bottom: 20px; overflow: hidden; transition: border-color 0.2s, box-shadow 0.2s;
    position: relative;
  }
  .moveable-section.dragging {
    opacity: 0.7; border-color: var(--accent); box-shadow: var(--glow-blue);
    cursor: grabbing !important;
  }
  .moveable-section.drag-over {
    border-color: var(--accent2); box-shadow: var(--glow-purple);
    background: rgba(124,58,237,0.05);
  }
  .panel-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 20px; border-bottom: 1px solid var(--border);
    cursor: grab; user-select: none;
    background: rgba(255,255,255,0.01);
  }
  .panel-header:active { cursor: grabbing; }
  .panel-header-left { display: flex; align-items: center; gap: 10px; }
  .panel-icon {
    width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center;
    justify-content: center; font-size: 15px; flex-shrink: 0;
  }
  .panel-title { font-size: 14px; font-weight: 700; letter-spacing: -0.3px; }
  .panel-meta { font-size: 11px; color: var(--text2); margin-top: 1px; }
  .panel-header-right { display: flex; align-items: center; gap: 8px; }
  .drag-handle {
    color: var(--text3); font-size: 14px; cursor: grab; padding: 4px;
    transition: color 0.2s;
  }
  .drag-handle:hover { color: var(--accent); }
  .panel-body { padding: 20px; }

  /* TAG */
  .tag {
    font-size: 9px; font-weight: 700; padding: 2px 7px; border-radius: 3px;
    letter-spacing: 0.8px; text-transform: uppercase; font-family: var(--mono);
  }
  .tag-fact { background: rgba(0,212,255,0.1); color: var(--fact); border: 1px solid rgba(0,212,255,0.25); }
  .tag-estimate { background: rgba(167,139,250,0.1); color: var(--estimate); border: 1px solid rgba(167,139,250,0.25); }
  .tag-premium { background: linear-gradient(135deg, rgba(255,214,10,0.2), rgba(255,107,53,0.2)); color: var(--yellow); border: 1px solid rgba(255,214,10,0.3); }

  /* AI PANEL */
  .ai-section {
    background: linear-gradient(135deg, rgba(0,212,255,0.05), rgba(124,58,237,0.05));
    border: 1px solid rgba(0,212,255,0.2); border-radius: 16px;
    margin-bottom: 20px; overflow: hidden;
  }
  .ai-header { display: flex; align-items: center; gap: 10px; padding: 16px 20px; border-bottom: 1px solid rgba(0,212,255,0.1); }
  .ai-icon-wrap {
    width: 36px; height: 36px; background: linear-gradient(135deg, var(--accent), var(--accent2));
    border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px;
    box-shadow: 0 0 15px rgba(0,212,255,0.3);
  }
  .ai-title { font-size: 14px; font-weight: 700; }
  .ai-sub { font-size: 11px; color: var(--text2); }
  .pulse-dot { width: 8px; height: 8px; background: var(--green); border-radius: 50%; box-shadow: 0 0 6px var(--green); animation: blink 2s infinite; }
  .ai-body { padding: 16px 20px; }
  .ai-messages {
    display: flex; flex-direction: column; gap: 8px;
    max-height: 260px; overflow-y: auto; margin-bottom: 12px;
    scrollbar-width: thin; scrollbar-color: var(--border2) transparent;
  }
  .ai-msg {
    padding: 10px 14px; border-radius: 10px; font-size: 12px; line-height: 1.6;
    animation: fadeUp 0.3s ease; white-space: pre-wrap; word-break: break-word;
  }
  @keyframes fadeUp { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:none} }
  .ai-msg.user {
    background: rgba(0,212,255,0.1); border: 1px solid rgba(0,212,255,0.2);
    align-self: flex-end; max-width: 80%;
  }
  .ai-msg.bot {
    background: var(--surface2); border: 1px solid var(--border); max-width: 92%;
  }
  .ai-msg.typing { color: var(--text2); font-style: italic; }
  .ai-suggestions { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
  .ai-sugg {
    font-size: 11px; padding: 4px 12px;
    background: rgba(0,212,255,0.05); border: 1px solid rgba(0,212,255,0.2);
    border-radius: 20px; cursor: pointer; color: var(--text2); transition: all 0.15s;
    font-family: var(--mono);
  }
  .ai-sugg:hover { border-color: var(--accent); color: var(--accent); background: rgba(0,212,255,0.1); }
  .ai-input-row { display: flex; gap: 8px; }
  .ai-input {
    flex: 1; background: var(--surface); border: 1px solid var(--border2); border-radius: 10px;
    padding: 10px 14px; color: var(--text); font-size: 12px; outline: none;
    transition: border-color 0.2s; font-family: var(--font);
  }
  .ai-input:focus { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(0,212,255,0.08); }
  .ai-input::placeholder { color: var(--text3); }
  .ai-send {
    padding: 10px 18px; background: linear-gradient(135deg, var(--accent), var(--accent2));
    border: none; border-radius: 10px; color: #000; font-size: 12px; font-weight: 700;
    cursor: pointer; transition: opacity 0.2s; font-family: var(--font);
  }
  .ai-send:hover { opacity: 0.85; }

  /* TWIN */
  .twin-grid { display: grid; grid-template-columns: 260px 1fr; gap: 16px; }
  @media(max-width:900px){ .twin-grid { grid-template-columns:1fr; } }
  .twin-avatar-panel {
    background: var(--surface2); border: 1px solid var(--border); border-radius: 12px;
    padding: 20px; display: flex; flex-direction: column; align-items: center; text-align: center;
  }
  .avatar-ring {
    width: 90px; height: 90px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent2), var(--accent3));
    display: flex; align-items: center; justify-content: center;
    font-size: 36px; margin-bottom: 14px; position: relative;
    box-shadow: 0 0 0 3px rgba(0,212,255,0.2), 0 0 30px rgba(0,212,255,0.15);
  }
  .avatar-ring::after {
    content: ''; position: absolute; inset: -5px; border-radius: 50%;
    border: 2px dashed rgba(0,212,255,0.35); animation: spin 12s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .twin-name { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
  .twin-archetype { font-size: 10px; color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 10px; font-family: var(--mono); }
  .twin-traits { width: 100%; display: flex; flex-direction: column; gap: 8px; margin-top: 10px; }
  .trait-row { display: flex; justify-content: space-between; align-items: center; padding: 4px 0; border-bottom: 1px solid var(--border); }
  .trait-label { font-size: 10px; color: var(--text2); }
  .trait-value { font-size: 10px; font-weight: 600; color: var(--text); font-family: var(--mono); }
  .twin-details { background: var(--surface2); border: 1px solid var(--border); border-radius: 12px; padding: 18px; }
  .twin-cat-title { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text3); font-weight: 700; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; font-family: var(--mono); }
  .twin-item { display: flex; align-items: flex-start; gap: 8px; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 12px; }
  .twin-item:last-child { border-bottom: none; }

  /* HEATMAP */
  .heatmap-grid { display: grid; gap: 4px; grid-template-columns: 130px repeat(8, 1fr); }
  .heatmap-header { font-size: 9px; color: var(--text2); text-align: center; padding: 4px 2px; font-weight: 600; font-family: var(--mono); }
  .heatmap-row-label { font-size: 10px; color: var(--text2); display: flex; align-items: center; padding-right: 8px; font-weight: 500; }
  .heatmap-cell {
    height: 34px; border-radius: 6px; display: flex; align-items: center; justify-content: center;
    font-size: 9px; font-weight: 700; cursor: pointer; transition: all 0.15s;
    font-family: var(--mono);
  }
  .heatmap-cell:hover { transform: scale(1.1); z-index: 10; box-shadow: 0 4px 16px rgba(0,0,0,0.5); }
  .heat-0 { background: rgba(255,255,255,0.03); color: var(--text3); }
  .heat-1 { background: rgba(0,255,136,0.15); color: var(--green); }
  .heat-2 { background: rgba(255,214,10,0.18); color: var(--yellow); }
  .heat-3 { background: rgba(255,107,53,0.22); color: var(--orange); }
  .heat-4 { background: rgba(255,45,85,0.25); color: var(--red); }

  /* BAR CHART */
  .bar-chart { display: flex; flex-direction: column; gap: 10px; }
  .bar-row { display: flex; align-items: center; gap: 10px; }
  .bar-label { font-size: 11px; color: var(--text2); width: 130px; flex-shrink: 0; text-align: right; font-family: var(--mono); }
  .bar-track { flex: 1; height: 22px; background: var(--surface3); border-radius: 6px; overflow: hidden; }
  .bar-fill {
    height: 100%; border-radius: 6px; display: flex; align-items: center; padding-left: 8px;
    font-size: 10px; font-weight: 700; color: #000; transition: width 1.2s cubic-bezier(0.4,0,0.2,1);
    white-space: nowrap; font-family: var(--mono);
  }
  .bar-count { font-size: 11px; font-weight: 700; width: 40px; flex-shrink: 0; color: var(--text2); font-family: var(--mono); }

  /* RADAR */
  .radar-wrapper { display: flex; align-items: center; gap: 28px; }
  @media(max-width:700px){ .radar-wrapper{flex-direction:column;} }
  .radar-container { flex-shrink: 0; }
  .radar-legend { flex: 1; display: flex; flex-direction: column; gap: 10px; }
  .radar-legend-item { display: flex; align-items: center; gap: 10px; }
  .radar-legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .radar-legend-label { font-size: 11px; color: var(--text2); flex: 1; }
  .radar-legend-value { font-size: 12px; font-weight: 700; font-family: var(--mono); }

  /* MATRIX */
  .matrix-table { width: 100%; border-collapse: collapse; }
  .matrix-table th { font-size: 9px; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text3); font-weight: 700; padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--border); font-family: var(--mono); }
  .matrix-table td { padding: 9px 12px; border-bottom: 1px solid var(--border); font-size: 11px; vertical-align: middle; }
  .matrix-table tr:last-child td { border-bottom: none; }
  .matrix-table tr:hover td { background: rgba(255,255,255,0.015); }
  .app-chip { display: inline-flex; align-items: center; gap: 5px; background: var(--surface3); border: 1px solid var(--border2); border-radius: 6px; padding: 3px 8px; font-size: 10px; font-weight: 600; }
  .risk-pill { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 20px; font-size: 10px; font-weight: 700; font-family: var(--mono); }
  .dots-row { display: flex; gap: 3px; }
  .data-dot { width: 8px; height: 8px; border-radius: 50%; cursor: pointer; transition: transform 0.15s; }
  .data-dot:hover { transform: scale(1.5); }

  /* WOW INSIGHTS */
  .wow-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  @media(max-width:900px){ .wow-grid{grid-template-columns:repeat(2,1fr);} }
  @media(max-width:600px){ .wow-grid{grid-template-columns:1fr;} }
  .wow-card {
    background: var(--surface2); border: 1px solid var(--border); border-radius: 12px;
    padding: 18px; position: relative; overflow: hidden; cursor: default;
    transition: all 0.2s;
  }
  .wow-card:hover { border-color: var(--border2); transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.4); }
  .wow-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; }
  .wow-card.danger::before { background: var(--red); box-shadow: 0 0 8px var(--red); }
  .wow-card.warning::before { background: var(--orange); }
  .wow-card.info::before { background: var(--accent); box-shadow: 0 0 8px var(--accent); }
  .wow-card.purple::before { background: var(--accent2); }
  .wow-card.teal::before { background: var(--accent3); }
  .wow-card.green::before { background: var(--green); box-shadow: 0 0 8px var(--green); }
  .wow-number { font-size: 40px; font-weight: 700; letter-spacing: -2px; line-height: 1; margin-bottom: 4px; font-family: var(--mono); }
  .wow-title { font-size: 12px; font-weight: 700; margin-bottom: 4px; }
  .wow-desc { font-size: 10px; color: var(--text2); line-height: 1.6; }
  .wow-tag { margin-top: 8px; }

  /* ASSETS */
  .assets-list { display: flex; flex-direction: column; gap: 10px; }
  .asset-item {
    display: flex; align-items: center; gap: 14px;
    background: var(--surface2); border: 1px solid var(--border); border-radius: 10px;
    padding: 14px 16px; transition: all 0.2s;
  }
  .asset-item:hover { border-color: var(--border2); transform: translateX(4px); }
  .asset-rank { font-size: 20px; font-weight: 900; color: var(--text3); width: 28px; flex-shrink: 0; text-align: center; font-family: var(--mono); }
  .asset-icon { font-size: 22px; flex-shrink: 0; }
  .asset-info { flex: 1; }
  .asset-name { font-size: 13px; font-weight: 700; margin-bottom: 2px; }
  .asset-desc { font-size: 10px; color: var(--text2); line-height: 1.5; }
  .asset-value { text-align: right; flex-shrink: 0; }
  .value-score { font-size: 18px; font-weight: 700; font-family: var(--mono); }
  .value-label { font-size: 9px; color: var(--text2); font-family: var(--mono); }
  .asset-bar { width: 80px; height: 3px; background: var(--surface3); border-radius: 2px; margin-top: 4px; }
  .asset-bar-fill { height: 100%; border-radius: 2px; }

  /* SIMULATOR */
  .simulator-layout { display: grid; grid-template-columns: 1fr 300px; gap: 16px; }
  @media(max-width:900px){ .simulator-layout{grid-template-columns:1fr;} }
  .sim-toggles { display: flex; flex-direction: column; gap: 8px; }
  .sim-toggle-row {
    display: flex; align-items: center; gap: 12px;
    background: var(--surface2); border: 1px solid var(--border); border-radius: 10px;
    padding: 12px 14px; cursor: pointer; transition: all 0.2s;
  }
  .sim-toggle-row:hover { border-color: var(--border2); background: rgba(0,212,255,0.03); }
  .toggle-switch {
    width: 38px; height: 20px; background: var(--surface3); border-radius: 10px;
    position: relative; transition: background 0.2s; flex-shrink: 0; border: 1px solid var(--border2);
  }
  .toggle-switch.on { background: var(--green); border-color: var(--green); box-shadow: 0 0 8px rgba(0,255,136,0.3); }
  .toggle-switch::after {
    content: ''; position: absolute; top: 2px; left: 2px;
    width: 14px; height: 14px; background: #fff; border-radius: 50%;
    transition: transform 0.2s;
  }
  .toggle-switch.on::after { transform: translateX(18px); }
  .toggle-info { flex: 1; }
  .toggle-title { font-size: 12px; font-weight: 600; }
  .toggle-sub { font-size: 10px; color: var(--text2); margin-top: 1px; }
  .toggle-impact { font-size: 11px; font-weight: 700; flex-shrink: 0; font-family: var(--mono); }
  .sim-results { background: var(--surface2); border: 1px solid var(--border); border-radius: 14px; padding: 20px; }
  .sim-score-display { text-align: center; padding: 18px 0; }
  .sim-score-number { font-size: 60px; font-weight: 700; letter-spacing: -3px; line-height: 1; font-family: var(--mono); }
  .sim-score-label { font-size: 11px; color: var(--text2); margin-top: 4px; }
  .sim-delta { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 8px; }
  .delta-text { font-size: 12px; font-weight: 700; font-family: var(--mono); }
  .sim-breakdown { display: flex; flex-direction: column; gap: 6px; margin-top: 16px; }
  .sim-break-row { display: flex; justify-content: space-between; font-size: 10px; padding: 5px 0; border-bottom: 1px solid var(--border); font-family: var(--mono); }

  /* VERDICT */
  .verdict-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media(max-width:700px){ .verdict-layout{grid-template-columns:1fr;} }
  .verdict-score-panel {
    background: linear-gradient(135deg, var(--surface2), var(--surface3));
    border: 1px solid var(--border); border-radius: 14px; padding: 28px; text-align: center;
    position: relative; overflow: hidden;
  }
  .verdict-grade {
    font-size: 80px; font-weight: 700; letter-spacing: -4px; line-height: 1;
    background: linear-gradient(135deg, var(--orange), var(--red));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    font-family: var(--mono);
  }
  .verdict-grade-label { font-size: 13px; color: var(--text2); margin-top: 4px; }
  .verdict-summary { font-size: 12px; color: var(--text); margin-top: 14px; line-height: 1.8; }
  .verdict-actions { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 20px; }
  .action-list { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
  .action-item {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border);
    background: var(--surface2); transition: border-color 0.2s;
  }
  .action-item:hover { border-color: rgba(0,212,255,0.2); }
  .action-num {
    width: 20px; height: 20px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    display: flex; align-items: center; justify-content: center;
    font-size: 9px; font-weight: 700; flex-shrink: 0; margin-top: 2px; color: #000;
  }
  .action-text { font-size: 11px; line-height: 1.6; }
  .action-text strong { color: var(--text); font-weight: 700; display: block; margin-bottom: 2px; }

  /* RATIONALE */
  .rationale {
    background: rgba(0,212,255,0.03); border: 1px solid rgba(0,212,255,0.1); border-radius: 10px;
    padding: 14px; margin-top: 12px;
  }
  .rationale-title { font-size: 11px; font-weight: 700; color: var(--text2); margin-bottom: 6px; }
  .rationale-text { font-size: 10px; color: var(--text3); line-height: 1.7; }

  /* TOOLTIP */
  .tooltip {
    position: fixed; background: var(--surface2); border: 1px solid var(--border2);
    border-radius: 8px; padding: 8px 12px; font-size: 10px; line-height: 1.5;
    pointer-events: none; z-index: 9999; opacity: 0; transition: opacity 0.15s;
    max-width: 200px; box-shadow: 0 8px 24px rgba(0,0,0,0.5); font-family: var(--mono);
  }
  .tooltip.show { opacity: 1; }

  .info-note {
    font-size: 10px; color: var(--text2); background: rgba(255,255,255,0.02);
    border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px; margin-top: 10px;
    display: flex; gap: 8px; align-items: flex-start;
  }

  .section.hidden { display: none !important; }

  ::-webkit-scrollbar { width: 5px; height: 5px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 3px; }

  /* GRID LAYOUT */
  .dash-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media(max-width:1000px){ .dash-grid{grid-template-columns:1fr;} }

  /* NOTIFICATION TOAST */
  .toast {
    position: fixed; bottom: 24px; right: 24px; z-index: 1000;
    background: var(--surface2); border: 1px solid var(--border2); border-radius: 10px;
    padding: 12px 18px; font-size: 12px; display: flex; align-items: center; gap: 10px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5); transform: translateY(80px); opacity: 0;
    transition: all 0.3s;
  }
  .toast.show { transform: translateY(0); opacity: 1; }

  /* FOOTER */
  .footer {
    border-top: 1px solid var(--border); padding: 24px 32px;
    text-align: center; font-size: 11px; color: var(--text3); font-family: var(--mono);
    max-width: 1600px; margin: 0 auto;
  }
</style>
</head>
<body>
<div class="load-bar" id="loadBar"></div>
<div class="scanline"></div>
<div class="tooltip" id="tooltip"></div>
<div class="toast" id="toast">
  <span id="toastMsg"></span>
</div>

<!-- ══════════ HEADER ══════════ -->
<header class="header">
  <div class="header-top">
    <!-- PREMIUM LOGO -->
    <a class="logo-wrap" href="#" onclick="return false">
      <div class="logo-emblem">
        <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Outer hex -->
          <polygon class="logo-hex" points="22,2 38,11 38,33 22,42 6,33 6,11"
            stroke="rgba(0,212,255,0.6)" stroke-width="1.5" fill="none"/>
          <!-- Inner hex -->
          <polygon points="22,8 34,15 34,29 22,36 10,29 10,15"
            stroke="rgba(124,58,237,0.4)" stroke-width="1" fill="rgba(0,212,255,0.05)"/>
          <!-- Shield icon -->
          <path d="M22 12 L29 16 L29 24 C29 28 22 32 22 32 C22 32 15 28 15 24 L15 16 Z"
            fill="url(#shieldGrad)" opacity="0.9"/>
          <!-- Lock -->
          <rect x="19" y="22" width="6" height="5" rx="1" fill="white" opacity="0.9"/>
          <path d="M20 22 L20 20 C20 18.3 23.7 18.3 23.7 20 L23.7 22" stroke="white" stroke-width="1.5" fill="none"/>
          <defs>
            <linearGradient id="shieldGrad" x1="15" y1="12" x2="29" y2="32">
              <stop offset="0%" stop-color="#00d4ff"/>
              <stop offset="100%" stop-color="#7c3aed"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
      <div class="logo-text-wrap">
        <div class="logo-name">PrivacyIQ</div>
        <div class="logo-badge">PRO · INTELLIGENCE</div>
      </div>
    </a>

    <!-- NAV LINKS -->
    <nav class="nav-links" id="navLinks">
      <a class="nav-link active" onclick="scrollTo('aiPanel')">AI Analyst</a>
      <a class="nav-link" onclick="scrollTo('twinSection')">Digital Twin</a>
      <a class="nav-link" onclick="scrollTo('heatSection')">Heatmap</a>
      <a class="nav-link" onclick="scrollTo('radarSection')">Risk Radar</a>
      <a class="nav-link" onclick="scrollTo('simSection')">Simulator</a>
      <a class="nav-link" onclick="scrollTo('verdictSection')">Verdict</a>
    </nav>

    <div class="nav-right">
      <div class="mode-toggle">
        <button class="mode-btn active" onclick="setMode('overview',event)">Overview</button>
        <button class="mode-btn" onclick="setMode('detailed',event)">Detailed</button>
      </div>
      <button class="btn-ai" onclick="focusAI()">
        <div class="pulse-dot"></div>
        Ask AI
      </button>
    </div>
  </div>

  <!-- STATUS BAR -->
  <div class="header-status">
    <div class="status-item"><div class="status-dot green"></div>SYSTEM ACTIVE</div>
    <div class="status-item"><div class="status-dot yellow"></div><span id="statusApps">15 APPS LOADED</span></div>
    <div class="status-item"><div class="status-dot red"></div>HIGH EXPOSURE DETECTED</div>
    <div class="status-item"><div class="status-dot green"></div>AI ONLINE</div>
    <div class="status-item" style="margin-left:auto" id="statusTime">—</div>
  </div>
</header>

<div class="container">

  <!-- HERO -->
  <div class="hero">
    <div class="hero-eyebrow">Digital Footprint Intelligence Report — v2.0 PRO</div>
    <h1 class="hero-title">Your Digital Shadow Analysis</h1>
    <p class="hero-sub">Analyzing your digital ecosystem in real-time. Behavioral inferences are clearly labeled as <span style="color:var(--estimate);font-weight:700">Estimates</span>. Verified data points carry a <span style="color:var(--fact);font-weight:700">Fact</span> label. All data is processed locally — nothing leaves your browser.</p>
    <div class="hero-meta" id="heroMeta">
      <div class="meta-chip"><div class="dot" style="background:var(--green)"></div><span id="metaDate">Last analyzed: —</span></div>
      <div class="meta-chip"><div class="dot" style="background:var(--accent)"></div><span id="metaApps">Dataset: loading…</span></div>
      <div class="meta-chip"><div class="dot" style="background:var(--yellow)"></div><span id="metaCompanies">—</span></div>
      <div class="meta-chip"><div class="dot" style="background:var(--red)"></div>High exposure risk</div>
    </div>
  </div>

  <!-- USER SETUP PANEL -->
  <div class="setup-panel" id="setupPanel">
    <div class="setup-title">⚙️ Analyze Your Apps — Works for Anyone</div>
    <div class="setup-sub">Enter your name and add the apps you use. The dashboard will recalculate all scores for you personally.</div>
    <div class="setup-form">
      <div class="form-field">
        <div class="form-label">Your Name</div>
        <input class="form-input" id="userName" placeholder="e.g. Alex" value="" style="min-width:140px">
      </div>
      <div class="form-field" style="flex:1">
        <div class="form-label">Add App (type & press Enter)</div>
        <input class="form-input" id="appInput" placeholder="e.g. Twitter, Netflix, Snapchat…" onkeydown="if(event.key==='Enter')addApp()">
      </div>
      <button class="btn-analyze" onclick="runAnalysis()">⚡ Analyze Now</button>
    </div>
    <div class="apps-tags" id="appsTags"></div>
  </div>

  <!-- SCORE CARDS -->
  <div class="scores-row" id="scoreCards">
    <div class="score-card" onclick="scrollTo('twinSection')">
      <div class="card-glow" style="background:var(--red)"></div>
      <div class="card-line" style="background:linear-gradient(90deg,var(--red),transparent)"></div>
      <div class="card-label">Digital Footprint Score</div>
      <div class="card-value" style="color:var(--red)" id="dfsDisplay">0</div>
      <div class="card-badge badge-red" id="dfsBadge">● Extensive</div>
      <div class="card-sub"><span id="dfsAppsLabel">15 services</span> <span class="tag tag-fact">Fact</span></div>
    </div>
    <div class="score-card" onclick="scrollTo('simSection')">
      <div class="card-glow" style="background:var(--orange)"></div>
      <div class="card-line" style="background:linear-gradient(90deg,var(--orange),transparent)"></div>
      <div class="card-label">Privacy Score</div>
      <div class="card-value" style="color:var(--orange)" id="psDisplay">0</div>
      <div class="card-badge badge-orange" id="psBadge">● Fair</div>
      <div class="card-sub">Inferred from app risks <span class="tag tag-estimate">Estimate</span></div>
    </div>
    <div class="score-card">
      <div class="card-glow" style="background:var(--accent)"></div>
      <div class="card-line" style="background:linear-gradient(90deg,var(--accent),transparent)"></div>
      <div class="card-label">Total Services Used</div>
      <div class="card-value" style="color:var(--accent)" id="appCountDisplay">15</div>
      <div class="card-sub" id="appListPreview">Instagram, Snapchat + 13 more <span class="tag tag-fact">Fact</span></div>
    </div>
    <div class="score-card">
      <div class="card-glow" style="background:var(--accent2)"></div>
      <div class="card-line" style="background:linear-gradient(90deg,var(--accent2),transparent)"></div>
      <div class="card-label">Parent Companies</div>
      <div class="card-value" style="color:var(--accent2)" id="companiesDisplay">5</div>
      <div class="card-sub" id="companiesLabel">Meta, Google, ByteDance + 2 <span class="tag tag-fact">Fact</span></div>
    </div>
    <div class="score-card">
      <div class="card-glow" style="background:var(--yellow)"></div>
      <div class="card-line" style="background:linear-gradient(90deg,var(--yellow),transparent)"></div>
      <div class="card-label">Ecosystem Concentration</div>
      <div class="card-value" style="color:var(--yellow)" id="ecoDisplay">0</div>
      <div class="card-sub">Top company dominance <span class="tag tag-estimate">Estimate</span></div>
    </div>
    <div class="score-card">
      <div class="card-glow" style="background:var(--accent3)"></div>
      <div class="card-line" style="background:linear-gradient(90deg,var(--accent3),transparent)"></div>
      <div class="card-label">Tracking Surface</div>
      <div class="card-value" style="color:var(--accent3)" id="trackDisplay">High</div>
      <div class="card-sub">~<span id="trackerCount">12</span> active trackers est. <span class="tag tag-estimate">Estimate</span></div>
    </div>
  </div>

  <!-- MOVEABLE SECTIONS WRAPPER -->
  <div id="sectionsWrapper">

    <!-- AI PANEL -->
    <div class="ai-section" id="aiPanel">
      <div class="ai-header">
        <div class="ai-icon-wrap">🤖</div>
        <div style="flex:1">
          <div class="ai-title">AI Privacy Analyst</div>
          <div class="ai-sub">Ask questions about your digital footprint — powered by Claude AI</div>
        </div>
        <div class="pulse-dot"></div>
        <span class="tag tag-premium">PREMIUM AI</span>
      </div>
      <div class="ai-body">
        <div class="ai-messages" id="aiMessages">
          <div class="ai-msg bot">👋 Hi! I'm your AI privacy analyst. I've analyzed your app list and can answer questions about your digital footprint, risks, or privacy improvements. What would you like to know?</div>
        </div>
        <div class="ai-suggestions" id="aiSuggestions">
          <div class="ai-sugg" onclick="sendAISugg(this)">Which app is most dangerous?</div>
          <div class="ai-sugg" onclick="sendAISugg(this)">How much does Google know about me?</div>
          <div class="ai-sugg" onclick="sendAISugg(this)">How can I improve my privacy score?</div>
          <div class="ai-sugg" onclick="sendAISugg(this)">What data does TikTok collect?</div>
          <div class="ai-sugg" onclick="sendAISugg(this)">Create a privacy action plan for me</div>
          <div class="ai-sugg" onclick="sendAISugg(this)">Explain my biggest privacy risk</div>
        </div>
        <div class="ai-input-row">
          <input class="ai-input" id="aiInput" type="text" placeholder="Ask anything about your privacy, data risks, or how to protect yourself…" onkeydown="if(event.key==='Enter')sendAI()">
          <button class="ai-send" onclick="sendAI()">Send →</button>
        </div>
      </div>
    </div>

    <!-- MOVEABLE: DIGITAL TWIN -->
    <div class="moveable-section" id="twinSection" draggable="true">
      <div class="panel-header" ondragstart="dragStart(event,'twinSection')" ondragover="dragOver(event)" ondrop="dragDrop(event,'twinSection')" ondragleave="dragLeave(event)" ondragend="dragEnd(event)">
        <div class="panel-header-left">
          <div class="panel-icon" style="background:rgba(124,58,237,0.2)">👤</div>
          <div>
            <div class="panel-title">Digital Twin Profile</div>
            <div class="panel-meta">Inferred behavioral and demographic profile from your app ecosystem</div>
          </div>
        </div>
        <div class="panel-header-right">
          <span class="tag tag-estimate">Estimate</span>
          <div class="drag-handle" title="Drag to reorder">⠿</div>
        </div>
      </div>
      <div class="panel-body">
        <div class="twin-grid">
          <div class="twin-avatar-panel">
            <div class="avatar-ring" id="twinEmoji">🧑‍💻</div>

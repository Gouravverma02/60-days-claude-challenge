// ══════════════════════════════════════════════
// USER SETUP
// ══════════════════════════════════════════════
function addApp() {
  const input = document.getElementById('appInput');
  const val = input.value.trim();
  if (!val) return;
  input.value = '';
  const key = val.toLowerCase();
  let info = APP_RISK_DB[key] || { company: 'Unknown', icon: '📱', risk: 2, category: 'App' };
  // Check if already exists
  if (USER_APPS.find(a => a.name.toLowerCase() === key)) { showToast('App already in list'); return; }
  USER_APPS.push({ name: val, ...info });
  renderAppTags();
}

function removeApp(name) {
  USER_APPS = USER_APPS.filter(a => a.name !== name);
  renderAppTags();
}

function renderAppTags() {
  const tags = document.getElementById('appsTags');
  tags.innerHTML = USER_APPS.map(a => `
    <div class="app-tag selected">
      <span>${a.icon} ${a.name}</span>
      <span class="remove" onclick="removeApp('${a.name.replace(/'/g,"\\'")}')">✕</span>
    </div>
  `).join('');
  document.getElementById('appInput').addEventListener('keydown', e => { if(e.key==='Enter') addApp(); }, {once:true});
}

function runAnalysis() {
  USER_NAME = document.getElementById('userName').value.trim() || 'You';
  recalcScores();
  refreshAll();
  showToast(`✅ Analysis complete for ${USER_NAME} — ${USER_APPS.length} apps analyzed`);
  document.getElementById('setupPanel').style.opacity = '0.7';
}

function recalcScores() {
  const n = USER_APPS.length;
  DFS = Math.min(100, 40 + n * 3 + USER_APPS.reduce((s,a) => s + a.risk, 0) * 1.2);
  DFS = Math.round(DFS);
  const avgRisk = USER_APPS.reduce((s,a) => s + a.risk, 0) / n;
  PS = Math.max(5, Math.round(100 - DFS * 0.65 + Math.random() * 5));
  const companies = [...new Set(USER_APPS.map(a => a.company))];
  const topCompany = companies.reduce((top, c) => {
    const cnt = USER_APPS.filter(a => a.company === c).length;
    return cnt > (top.cnt || 0) ? { c, cnt } : top;
  }, {});
  ECO = Math.round((topCompany.cnt || 1) / n * 100);

  document.getElementById('dfsAppsLabel').textContent = n + ' services';
  document.getElementById('appCountDisplay').textContent = n;
  document.getElementById('appListPreview').innerHTML = USER_APPS.slice(0,2).map(a=>a.name).join(', ') + (n>2 ? ` + ${n-2} more` : '') + ' <span class="tag tag-fact">Fact</span>';
  document.getElementById('companiesDisplay').textContent = companies.length;
  document.getElementById('trackerCount').textContent = Math.round(n * 0.8);

  const now = new Date();
  document.getElementById('metaDate').textContent = 'Last analyzed: ' + now.toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' });
  document.getElementById('metaApps').textContent = 'Dataset: ' + n + ' apps (Fact)';
  document.getElementById('metaCompanies').textContent = companies.length + ' parent companies detected';
  document.getElementById('statusApps').textContent = n + ' APPS LOADED';

  document.getElementById('verdictDFS').textContent = DFS;
  document.getElementById('verdictPS').textContent = PS;
  document.getElementById('verdictEco').textContent = ECO + '%';

  animateCount(document.getElementById('dfsDisplay'), DFS, 1200);
  animateCount(document.getElementById('psDisplay'), PS, 1200);
  animateCount(document.getElementById('ecoDisplay'), ECO, 1400);
}


window.addEventListener('load', () => {
  runLoadBar();
  renderAppTags();
  recalcScores();
  refreshAll();

  // Clock
  updateClock();
  setInterval(updateClock, 1000);

  // Set today's date
  document.getElementById('metaDate').textContent = 'Last analyzed: ' + new Date().toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' });

  // Setup app input listener
  document.getElementById('appInput').addEventListener('keydown', e => { if(e.key==='Enter') addApp(); });
});

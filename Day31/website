<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Supply Chain Control Tower</title>
<style>
  /* ============================================================
     TOKENS
     ============================================================ */
  :root{
    --bg-0:#060a12;
    --bg-1:#0a111c;
    --bg-2:#101a2a;
    --panel:#0d1626;
    --panel-border:#1c2c44;
    --cyan:#33d6f0;
    --cyan-dim:#1a5b6b;
    --blue:#3b7dff;
    --green:#2fd67e;
    --orange:#ff9d3d;
    --red:#ff4d5e;
    --red-dim:#5a1b23;
    --text-hi:#eaf2ff;
    --text-mid:#93a4c2;
    --text-low:#5c6b88;
    --font-display: 'Segoe UI', -apple-system, 'Inter', Arial, sans-serif;
    --font-mono: 'Consolas', 'SFMono-Regular', Menlo, monospace;
  }

  *{box-sizing:border-box;}
  html,body{
    margin:0;padding:0;height:100%;
    background:
      radial-gradient(1200px 600px at 15% -10%, rgba(59,125,255,0.12), transparent 60%),
      radial-gradient(1000px 500px at 100% 0%, rgba(51,214,240,0.08), transparent 55%),
      var(--bg-0);
    color:var(--text-hi);
    font-family:var(--font-display);
    overflow-x:hidden;
  }

  ::selection{background:var(--cyan);color:#001217;}

  ::-webkit-scrollbar{width:8px;height:8px;}
  ::-webkit-scrollbar-track{background:transparent;}
  ::-webkit-scrollbar-thumb{background:var(--panel-border);border-radius:8px;}

  button{font-family:inherit;cursor:pointer;}
  button:focus-visible, .clickable:focus-visible{
    outline:2px solid var(--cyan); outline-offset:2px;
  }

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}
  }

  /* ============================================================
     LAYOUT SHELL
     ============================================================ */
  #app{ max-width:1400px; margin:0 auto; padding:18px 22px 60px; }

  header.topbar{
    display:flex; align-items:center; justify-content:space-between;
    gap:16px; margin-bottom:18px; flex-wrap:wrap;
  }
  .brand{ display:flex; align-items:center; gap:12px; }
  .brand-mark{
    width:38px;height:38px;border-radius:9px;
    background:linear-gradient(135deg, var(--blue), var(--cyan));
    display:flex;align-items:center;justify-content:center;
    font-weight:800; font-size:16px; color:#001018;
    box-shadow:0 0 24px rgba(51,214,240,0.35);
    flex-shrink:0;
  }
  .brand-text h1{
    margin:0; font-size:17px; letter-spacing:0.4px; font-weight:700;
  }
  .brand-text span{
    font-size:11px; color:var(--text-mid); letter-spacing:1.5px; text-transform:uppercase;
  }

  .topbar-actions{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
  .icon-btn{
    background:var(--panel); border:1px solid var(--panel-border);
    color:var(--text-mid); border-radius:8px; padding:9px 14px;
    font-size:13px; font-weight:600; display:flex; align-items:center; gap:6px;
    transition:all .15s ease;
  }
  .icon-btn:hover{ color:var(--text-hi); border-color:var(--cyan); box-shadow:0 0 12px rgba(51,214,240,0.15); }
  .icon-btn.active{ color:var(--cyan); border-color:var(--cyan); }

  /* ============================================================
     KPI STRIP
     ============================================================ */
  .kpi-strip{
    display:grid;
    grid-template-columns:repeat(8, 1fr);
    gap:10px;
    margin-bottom:18px;
  }
  @media (max-width:1100px){ .kpi-strip{ grid-template-columns:repeat(4,1fr);} }
  @media (max-width:600px){ .kpi-strip{ grid-template-columns:repeat(2,1fr);} }

  .kpi-card{
    background:linear-gradient(180deg, var(--panel), var(--bg-1));
    border:1px solid var(--panel-border);
    border-radius:12px;
    padding:12px 14px;
    position:relative;
    overflow:hidden;
    transition:border-color .2s ease, transform .2s ease;
  }
  .kpi-card::before{
    content:''; position:absolute; inset:0;
    background:radial-gradient(120px 60px at 0% 0%, rgba(51,214,240,0.10), transparent 70%);
    pointer-events:none;
  }
  .kpi-card:hover{ transform:translateY(-2px); }
  .kpi-label{
    font-size:10px; text-transform:uppercase; letter-spacing:1px;
    color:var(--text-mid); margin-bottom:6px; font-weight:700;
  }
  .kpi-value{
    font-size:21px; font-weight:800; font-family:var(--font-mono);
    letter-spacing:-0.5px;
    transition:color .3s ease;
  }
  .kpi-value.good{ color:var(--green); }
  .kpi-value.warn{ color:var(--orange); }
  .kpi-value.bad{ color:var(--red); }
  .kpi-value.neutral{ color:var(--cyan); }
  .kpi-delta{
    font-size:11px; margin-left:6px; font-weight:600;
  }
  .kpi-delta.up{ color:var(--green); }
  .kpi-delta.down{ color:var(--red); }

  .kpi-bar-track{
    height:4px; border-radius:3px; background:var(--bg-2); margin-top:8px; overflow:hidden;
  }
  .kpi-bar-fill{ height:100%; border-radius:3px; transition:width .4s ease, background .4s ease; }

  .flash{ animation:flashPulse .5s ease; }
  @keyframes flashPulse{
    0%{ box-shadow:0 0 0 0 rgba(255,255,255,0.0); }
    30%{ box-shadow:0 0 0 3px rgba(255,255,255,0.25); }
    100%{ box-shadow:0 0 0 0 rgba(255,255,255,0.0); }
  }

  /* Timer + score bar */
  .status-bar{
    display:flex; align-items:center; justify-content:space-between;
    background:var(--panel); border:1px solid var(--panel-border);
    border-radius:12px; padding:12px 18px; margin-bottom:18px;
    flex-wrap:wrap; gap:12px;
  }
  .timer-block{ display:flex; align-items:center; gap:10px; }
  .timer-value{
    font-family:var(--font-mono); font-size:26px; font-weight:800;
    color:var(--cyan); letter-spacing:1px;
    text-shadow:0 0 18px rgba(51,214,240,0.4);
  }
  .timer-value.critical{ color:var(--red); text-shadow:0 0 18px rgba(255,77,94,0.5); animation:tick 1s infinite; }
  @keyframes tick{ 50%{ opacity:0.5; } }
  .timer-label{ font-size:10px; text-transform:uppercase; color:var(--text-mid); letter-spacing:1px; }

  .score-block{ text-align:right; }
  .score-value{ font-family:var(--font-mono); font-size:26px; font-weight:800; color:var(--text-hi); }
  .score-label{ font-size:10px; text-transform:uppercase; color:var(--text-mid); letter-spacing:1px; }

  .difficulty-tag{
    font-size:11px; padding:5px 10px; border-radius:20px;
    border:1px solid var(--panel-border); color:var(--text-mid);
    text-transform:uppercase; letter-spacing:0.5px; font-weight:700;
  }
  .difficulty-tag.ramping{ color:var(--orange); border-color:var(--orange); }
  .difficulty-tag.critical{ color:var(--red); border-color:var(--red); }

  /* ============================================================
     MAIN GRID: Alerts + Log
     ============================================================ */
  .main-grid{
    display:grid;
    grid-template-columns:1fr 340px;
    gap:18px;
    align-items:start;
  }
  @media (max-width:900px){ .main-grid{ grid-template-columns:1fr; } }

  .panel-heading{
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom:10px;
  }
  .panel-heading h2{
    font-size:13px; text-transform:uppercase; letter-spacing:1.5px;
    color:var(--text-mid); margin:0; font-weight:700;
  }
  .panel-heading .count-badge{
    background:var(--bg-2); border:1px solid var(--panel-border);
    color:var(--cyan); font-size:11px; font-weight:700;
    padding:2px 9px; border-radius:12px; font-family:var(--font-mono);
  }

  #alertsColumn{ display:flex; flex-direction:column; gap:14px; min-height:200px; }

  .empty-state{
    border:1px dashed var(--panel-border); border-radius:12px;
    padding:40px 20px; text-align:center; color:var(--text-low);
    font-size:13px;
  }

  /* Alert card */
  .alert-card{
    background:linear-gradient(180deg, var(--panel), var(--bg-1));
    border:1px solid var(--panel-border);
    border-radius:14px; padding:16px 18px;
    animation:slideIn .35s ease;
    position:relative;
    overflow:hidden;
  }
  @keyframes slideIn{ from{ opacity:0; transform:translateY(-10px); } to{ opacity:1; transform:translateY(0);} }
  @keyframes cardExit{ to{ opacity:0; transform:translateX(30px) scale(0.97); } }
  .alert-card.exiting{ animation:cardExit .3s ease forwards; }

  .alert-card.priority-critical{ border-left:4px solid var(--red); }
  .alert-card.priority-high{ border-left:4px solid var(--orange); }
  .alert-card.priority-medium{ border-left:4px solid var(--cyan); }

  .alert-card.priority-critical::after{
    content:''; position:absolute; inset:0; border-radius:14px;
    box-shadow:0 0 0 0 rgba(255,77,94,0.5);
    animation:critPulse 1.6s infinite;
    pointer-events:none;
  }
  @keyframes critPulse{
    0%{ box-shadow:0 0 0 0 rgba(255,77,94,0.35); }
    70%{ box-shadow:0 0 0 10px rgba(255,77,94,0); }
    100%{ box-shadow:0 0 0 0 rgba(255,77,94,0); }
  }

  .alert-top{ display:flex; align-items:flex-start; justify-content:space-between; gap:10px; margin-bottom:8px; }
  .alert-title-wrap{ display:flex; align-items:center; gap:8px; }
  .alert-icon{ font-size:20px; line-height:1; }
  .alert-title{ font-size:15px; font-weight:700; }
  .alert-priority-chip{
    font-size:10px; font-weight:800; letter-spacing:0.5px; text-transform:uppercase;
    padding:3px 8px; border-radius:6px; white-space:nowrap;
  }
  .alert-priority-chip.priority-critical{ background:rgba(255,77,94,0.15); color:var(--red); }
  .alert-priority-chip.priority-high{ background:rgba(255,157,61,0.15); color:var(--orange); }
  .alert-priority-chip.priority-medium{ background:rgba(51,214,240,0.15); color:var(--cyan); }

  .alert-desc{ font-size:13px; color:var(--text-mid); line-height:1.5; margin-bottom:10px; }
  .alert-meta{ display:flex; gap:16px; margin-bottom:12px; flex-wrap:wrap; }
  .alert-meta-item{ font-size:11px; color:var(--text-low); }
  .alert-meta-item b{ color:var(--text-mid); font-family:var(--font-mono); }

  .alert-timer-track{ height:4px; background:var(--bg-2); border-radius:3px; margin-bottom:14px; overflow:hidden; }
  .alert-timer-fill{ height:100%; background:var(--cyan); transition:width 0.2s linear, background .3s ease; }

  .action-grid{ display:flex; flex-wrap:wrap; gap:8px; }
  .action-btn{
    background:var(--bg-2); border:1px solid var(--panel-border);
    color:var(--text-hi); border-radius:8px; padding:8px 12px;
    font-size:12.5px; font-weight:600; transition:all .15s ease;
  }
  .action-btn:hover{ border-color:var(--cyan); background:rgba(51,214,240,0.08); transform:translateY(-1px); }
  .action-btn.best{ }
  .action-btn.ignore, .action-btn.delay{ color:var(--text-mid); }

  /* Event log */
  .log-panel{
    background:var(--panel); border:1px solid var(--panel-border);
    border-radius:14px; padding:14px; height:640px; display:flex; flex-direction:column;
  }
  #logList{
    overflow-y:auto; flex:1; display:flex; flex-direction:column-reverse; gap:8px;
    padding-right:4px;
  }
  .log-entry{
    font-size:12px; padding:8px 10px; border-radius:8px;
    background:var(--bg-1); border-left:3px solid var(--panel-border);
    line-height:1.4; animation:slideIn .25s ease;
  }
  .log-entry .log-time{ color:var(--text-low); font-family:var(--font-mono); font-size:10px; margin-right:6px; }
  .log-entry.good{ border-left-color:var(--green); }
  .log-entry.bad{ border-left-color:var(--red); }
  .log-entry.info{ border-left-color:var(--cyan); }
  .log-entry.neutral{ border-left-color:var(--text-low); }

  /* ============================================================
     MODALS / OVERLAYS
     ============================================================ */
  .overlay{
    position:fixed; inset:0; background:rgba(3,6,12,0.78);
    backdrop-filter:blur(6px);
    display:flex; align-items:center; justify-content:center;
    z-index:100; padding:20px;
    animation:fadeIn .2s ease;
  }
  @keyframes fadeIn{ from{opacity:0;} to{opacity:1;} }
  .hidden{ display:none !important; }

  .modal-box{
    background:linear-gradient(180deg, var(--panel), var(--bg-1));
    border:1px solid var(--panel-border);
    border-radius:16px; padding:30px 32px; max-width:520px; width:100%;
    max-height:85vh; overflow-y:auto;
    box-shadow:0 20px 60px rgba(0,0,0,0.5);
  }
  .modal-box h2{ margin-top:0; font-size:20px; }
  .modal-box h3{ font-size:13px; color:var(--cyan); text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;}
  .modal-box p, .modal-box li{ font-size:13.5px; color:var(--text-mid); line-height:1.6; }
  .modal-box ul{ padding-left:18px; }
  .modal-close-btn{
    margin-top:18px; background:linear-gradient(135deg, var(--blue), var(--cyan));
    border:none; color:#001018; font-weight:700; padding:11px 22px; border-radius:9px;
    font-size:14px; width:100%;
  }

  .legend-row{ display:flex; align-items:center; gap:8px; margin:4px 0; font-size:13px; color:var(--text-mid); }
  .legend-dot{ width:10px; height:10px; border-radius:50%; }

  /* Start screen */
  #startScreen .modal-box{ max-width:640px; text-align:center; }
  #startScreen .brand-mark-lg{
    width:64px;height:64px;border-radius:16px;margin:0 auto 18px;
    background:linear-gradient(135deg, var(--blue), var(--cyan));
    display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:800;color:#001018;
    box-shadow:0 0 40px rgba(51,214,240,0.4);
  }
  #startScreen p.tagline{ color:var(--text-mid); margin-bottom:20px; }
  .start-grid{ display:grid; grid-template-columns:1fr 1fr; gap:10px; text-align:left; margin-bottom:22px; }
  .start-stat{ background:var(--bg-2); border:1px solid var(--panel-border); border-radius:10px; padding:10px 12px; }
  .start-stat b{ display:block; color:var(--cyan); font-size:13px; }
  .start-stat span{ font-size:11px; color:var(--text-low); }
  .primary-btn{
    background:linear-gradient(135deg, var(--blue), var(--cyan));
    border:none; color:#001018; font-weight:800; padding:14px 30px; border-radius:10px;
    font-size:15px; letter-spacing:0.3px; box-shadow:0 8px 26px rgba(51,214,240,0.3);
    transition:transform .15s ease;
  }
  .primary-btn:hover{ transform:translateY(-2px); }

  /* End screen */
  #endScreen .modal-box{ max-width:600px; }
  .grade-display{ text-align:center; margin:12px 0 20px; }
  .grade-letter{
    font-size:64px; font-weight:900; font-family:var(--font-mono);
    line-height:1; text-shadow:0 0 30px currentColor;
  }
  .grade-letter.grade-A{ color:var(--green); }
  .grade-letter.grade-B{ color:var(--cyan); }
  .grade-letter.grade-C{ color:var(--orange); }
  .grade-letter.grade-D{ color:var(--red); }
  .end-score{ font-size:15px; color:var(--text-mid); margin-top:4px; }
  .end-summary{
    background:var(--bg-2); border-left:3px solid var(--cyan); border-radius:8px;
    padding:12px 14px; font-size:13px; color:var(--text-mid); margin:16px 0; line-height:1.6;
  }
  .end-kpi-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin:16px 0;
  }
  .end-kpi-grid .item{ background:var(--bg-2); border-radius:8px; padding:8px; text-align:center; }
  .end-kpi-grid .item b{ display:block; font-family:var(--font-mono); font-size:15px; color:var(--cyan); }
  .end-kpi-grid .item span{ font-size:10px; color:var(--text-low); text-transform:uppercase; }
  .end-tally{ display:flex; gap:12px; justify-content:center; margin-bottom:6px; }
  .end-tally div{ font-size:12px; color:var(--text-mid); }
  .end-tally b{ color:var(--text-hi); }

  /* Pause overlay */
  #pauseScreen .modal-box{ text-align:center; max-width:360px; }

  footer.foot-note{
    text-align:center; color:var(--text-low); font-size:11px; margin-top:26px;
  }
</style>
</head>
<body>

<div id="app">

  <!-- ===================== TOP BAR ===================== -->
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">CT</div>
      <div class="brand-text">
        <h1>AI Supply Chain Control Tower</h1>
        <span>Global Operations Command</span>
      </div>
    </div>
    <div class="topbar-actions">
      <span class="difficulty-tag" id="difficultyTag">Stable</span>
      <button class="icon-btn" id="soundBtn">🔊 Sound On</button>
      <button class="icon-btn" id="pauseBtn">⏸ Pause</button>
      <button class="icon-btn" id="helpBtn">❓ Help</button>
    </div>
  </header>

  <!-- ===================== STATUS BAR ===================== -->
  <div class="status-bar">
    <div class="timer-block">
      <div>
        <div class="timer-value" id="timerValue">3:00</div>
        <div class="timer-label">Time Remaining</div>
      </div>
    </div>
    <div class="score-block">
      <div class="score-value" id="scoreValue">0</div>
      <div class="score-label">Operations Score</div>
    </div>
  </div>

  <!-- ===================== KPI STRIP ===================== -->
  <div class="kpi-strip" id="kpiStrip"><!-- populated by JS --></div>

  <!-- ===================== MAIN GRID ===================== -->
  <div class="main-grid">
    <div>
      <div class="panel-heading">
        <h2>Active Incidents</h2>
        <span class="count-badge" id="activeCount">0</span>
      </div>
      <div id="alertsColumn">
        <div class="empty-state" id="emptyState">All quiet on the network. Incoming alerts will appear here.</div>
      </div>
    </div>

    <div>
      <div class="panel-heading">
        <h2>Live Event Log</h2>
        <span class="count-badge" id="logCount">0</span>
      </div>
      <div class="log-panel">
        <div id="logList"></div>
      </div>
    </div>
  </div>

  <footer class="foot-note">Single-file simulation — no data leaves your browser.</footer>
</div>

<!-- ===================== START SCREEN ===================== -->
<div class="overlay" id="startScreen">
  <div class="modal-box">
    <div class="brand-mark-lg">CT</div>
    <h2>You are the new Head of Operations.</h2>
    <p class="tagline">A wave of disruptions is about to hit your global supply chain. Every decision moves your KPIs — choose fast, choose well.</p>
    <div class="start-grid">
      <div class="start-stat"><b>3:00</b><span>Total mission time</span></div>
      <div class="start-stat"><b>10</b><span>Alert types in rotation</span></div>
      <div class="start-stat"><b>8</b><span>Actions at your disposal</span></div>
      <div class="start-stat"><b>A+ → D</b><span>Performance grading</span></div>
    </div>
    <button class="primary-btn" id="startBtn">Start Shift</button>
  </div>
</div>

<!-- ===================== HELP MODAL ===================== -->
<div class="overlay hidden" id="helpScreen">
  <div class="modal-box">
    <h2>Command Briefing</h2>
    <h3>Objective</h3>
    <p>Resolve incoming operational alerts before their timers expire. Pick the best action for each situation to protect your KPIs and grow your score.</p>
    <h3>Priority Colors</h3>
    <div class="legend-row"><span class="legend-dot" style="background:var(--red)"></span> Critical — resolve immediately, pulses on screen</div>
    <div class="legend-row"><span class="legend-dot" style="background:var(--orange)"></span> High — resolve soon</div>
    <div class="legend-row"><span class="legend-dot" style="background:var(--cyan)"></span> Medium — manageable, but don't ignore</div>
    <h3>KPIs</h3>
    <p>Service Level, Customer Satisfaction, Inventory Health and Transportation Efficiency are percentages you want high. Operating Cost is an index you want low. Revenue Protected accumulates in your favor. Score is your overall performance.</p>
    <h3>Tips</h3>
    <ul>
      <li>The right action depends on the alert — read the description before reacting.</li>
      <li>Ignoring or delaying can be the correct call sometimes, but often carries a hidden cost later.</li>
      <li>As the timer runs down, alerts arrive faster and can stack up — triage matters.</li>
    </ul>
    <button class="modal-close-btn" id="closeHelpBtn">Back to the floor</button>
  </div>
</div>

<!-- ===================== PAUSE SCREEN ===================== -->
<div class="overlay hidden" id="pauseScreen">
  <div class="modal-box">
    <h2>⏸ Operations Paused</h2>
    <p>The floor is frozen. Take a breath, then jump back in.</p>
    <button class="modal-close-btn" id="resumeBtn">Resume Shift</button>
  </div>
</div>

<!-- ===================== END SCREEN ===================== -->
<div class="overlay hidden" id="endScreen">
  <div class="modal-box">
    <h2 style="text-align:center;">Shift Complete</h2>
    <div class="grade-display">
      <div class="grade-letter" id="gradeLetter">A</div>
      <div class="end-score" id="finalScoreLine">Final Score: 0</div>
    </div>
    <div class="end-tally">
      <div>Resolved: <b id="tallyResolved">0</b></div>
      <div>Correct: <b id="tallyCorrect">0</b></div>
      <div>Wrong: <b id="tallyWrong">0</b></div>
    </div>
    <div class="end-kpi-grid" id="endKpiGrid"><!-- JS --></div>
    <div class="end-summary" id="endSummaryText"></div>
    <button class="primary-btn" id="playAgainBtn" style="width:100%;">Play Again</button>
  </div>
</div>

<script>
(function(){
  "use strict";

  /* ============================================================
     CONFIG / DATA
     ============================================================ */

  const GAME_DURATION = 180; // seconds

  const KPI_DEFS = [
    { key:'service',      label:'Service Level',        unit:'%',  start:92 },
    { key:'satisfaction',  label:'Customer Satisfaction', unit:'%',  start:88 },
    { key:'inventory',    label:'Inventory Health',     unit:'%',  start:85 },
    { key:'transport',    label:'Transport Efficiency', unit:'%',  start:90 },
    { key:'cost',         label:'Operating Cost',       unit:'idx', start:100, invert:true },
    { key:'revenue',      label:'Revenue Protected',    unit:'k',  start:500 },

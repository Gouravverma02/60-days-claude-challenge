  /* ============================================================
     STATE
     ============================================================ */

  let state = null;

  function freshState(){
    const kpis = {};
    KPI_DEFS.forEach(d => kpis[d.key] = d.start);
    return {
      kpis,
      score:0,
      timeLeft:GAME_DURATION,
      running:false,
      paused:false,
      soundOn:true,
      activeAlerts:[],   // {id, template, action data, life, maxLife, resolved}
      alertIdSeq:1,
      spawnTimer:0,
      spawnInterval:6,   // seconds between spawns, decreases over time
      tickHandle:null,
      resolvedCount:0,
      correctCount:0,
      wrongCount:0,
      logCount:0
    };
  }

  /* ============================================================
     DOM REFS
     ============================================================ */

  const $ = sel => document.querySelector(sel);
  const kpiStrip = $('#kpiStrip');
  const alertsColumn = $('#alertsColumn');
  const emptyState = $('#emptyState');
  const logList = $('#logList');
  const timerValueEl = $('#timerValue');
  const scoreValueEl = $('#scoreValue');
  const activeCountEl = $('#activeCount');
  const logCountEl = $('#logCount');
  const difficultyTag = $('#difficultyTag');

  /* ============================================================
     KPI RENDERING
     ============================================================ */

  function kpiStatusClass(def, value){
    if(def.key === 'time' || def.key === 'score' || def.key === 'revenue') return 'neutral';
    let effective = def.invert ? (100 - (value - 100)) : value; // cost: lower better
    if(def.invert){
      // cost index: 100 baseline, lower is good
      if(value <= 90) return 'good';
      if(value <= 110) return 'warn';
      return 'bad';
    }
    if(value >= 80) return 'good';
    if(value >= 60) return 'warn';
    return 'bad';
  }

  function formatKpi(def, value){
    if(def.key === 'time'){
      const m = Math.floor(value/60), s = Math.floor(value%60);
      return `${m}:${s.toString().padStart(2,'0')}`;
    }
    if(def.key === 'score') return Math.round(value).toLocaleString();
    if(def.key === 'revenue') return `$${Math.round(value).toLocaleString()}k`;
    if(def.unit === '%') return `${Math.round(value)}%`;
    if(def.unit === 'idx') return Math.round(value);
    return Math.round(value);
  }

  function buildKpiStrip(){
    kpiStrip.innerHTML = '';
    KPI_DEFS.forEach(def => {
      const card = document.createElement('div');
      card.className = 'kpi-card';
      card.id = `kpi-card-${def.key}`;
      card.innerHTML = `
        <div class="kpi-label">${def.label}</div>
        <div class="kpi-value neutral" id="kpi-value-${def.key}">--</div>
        <div class="kpi-bar-track"><div class="kpi-bar-fill" id="kpi-bar-${def.key}" style="width:0%;background:var(--cyan);"></div></div>
      `;
      kpiStrip.appendChild(card);
    });
  }

  function renderKpis(prevKpis){
    KPI_DEFS.forEach(def => {
      const value = state.kpis[def.key];
      const valEl = document.getElementById(`kpi-value-${def.key}`);
      const barEl = document.getElementById(`kpi-bar-${def.key}`);
      const cardEl = document.getElementById(`kpi-card-${def.key}`);
      const statusClass = def.key==='time'||def.key==='score'||def.key==='revenue' ? 'neutral' : kpiStatusClass(def, value);
      valEl.className = `kpi-value ${statusClass}`;
      valEl.textContent = formatKpi(def, value);

      // bar fill percentage (bounded views)
      let pct = 0, barColor = 'var(--cyan)';
      if(def.key === 'time'){ pct = (value/GAME_DURATION)*100; barColor='var(--cyan)'; }
      else if(def.key === 'score'){ pct = Math.min(100, value/20); barColor='var(--cyan)'; }
      else if(def.key === 'revenue'){ pct = Math.min(100, value/10); barColor='var(--green)'; }
      else if(def.invert){ pct = Math.max(0, Math.min(100, 100 - (value-70))); barColor = statusClass==='good'?'var(--green)':statusClass==='warn'?'var(--orange)':'var(--red)'; }
      else { pct = Math.max(0,Math.min(100,value)); barColor = statusClass==='good'?'var(--green)':statusClass==='warn'?'var(--orange)':'var(--red)'; }
      barEl.style.width = pct + '%';
      barEl.style.background = barColor;

      if(prevKpis && Math.round(prevKpis[def.key]) !== Math.round(value)){
        cardEl.classList.remove('flash');
        void cardEl.offsetWidth;
        cardEl.classList.add('flash');
      }
    });
    timerValueEl.textContent = formatKpi(KPI_DEFS.find(d=>d.key==='time'), state.timeLeft);
    timerValueEl.classList.toggle('critical', state.timeLeft <= 20);
    scoreValueEl.textContent = Math.round(state.score).toLocaleString();
  }

  function clampKpis(){
    KPI_DEFS.forEach(def => {
      if(['service','satisfaction','inventory','transport'].includes(def.key)){
        state.kpis[def.key] = Math.max(0, Math.min(100, state.kpis[def.key]));
      }
      if(def.key === 'cost'){
        state.kpis[def.key] = Math.max(40, Math.min(220, state.kpis[def.key]));
      }
      if(def.key === 'revenue'){
        state.kpis[def.key] = Math.max(0, state.kpis[def.key]);
      }
    });
  }

  /* ============================================================
     LOGGING
     ============================================================ */

  function addLog(message, kind){
    state.logCount++;
    logCountEl.textContent = state.logCount;
    const entry = document.createElement('div');
    entry.className = `log-entry ${kind || 'neutral'}`;
    const now = new Date();
    const t = now.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit', second:'2-digit'});
    entry.innerHTML = `<span class="log-time">${t}</span>${message}`;
    logList.appendChild(entry);
    // limit log length
    while(logList.children.length > 60){ logList.removeChild(logList.firstChild); }
  }

  /* ============================================================
     ALERT SPAWNING
     ============================================================ */

  function pickTemplate(){
    return ALERT_TEMPLATES[Math.floor(Math.random()*ALERT_TEMPLATES.length)];
  }

  function spawnAlert(){
    const template = pickTemplate();
    const id = state.alertIdSeq++;
    const alertObj = {
      id,
      template,
      life: template.life,
      maxLife: template.life,
      resolved:false
    };
    state.activeAlerts.push(alertObj);
    renderAlertCard(alertObj);
    addLog(`New alert: <b>${template.type}</b> (${template.priority}).`, 'info');
    updateActiveCount();
  }

  function updateActiveCount(){
    activeCountEl.textContent = state.activeAlerts.length;
    emptyState.classList.toggle('hidden', state.activeAlerts.length > 0);
  }

  /* ============================================================
     ALERT RENDERING
     ============================================================ */

  function renderAlertCard(alertObj){
    const t = alertObj.template;
    const card = document.createElement('div');
    card.className = `alert-card priority-${t.priority}`;
    card.id = `alert-${alertObj.id}`;

    const metaHtml = `
      <div class="alert-meta">
        <div class="alert-meta-item">Priority: <b>${t.priority.toUpperCase()}</b></div>
        <div class="alert-meta-item">Impact: <b>${impactLabel(t.priority)}</b></div>
      </div>`;

    const actionsHtml = t.actions.map((a, idx) => `
      <button class="action-btn" data-alert-id="${alertObj.id}" data-action-idx="${idx}">${a.label}</button>
    `).join('');

    card.innerHTML = `
      <div class="alert-top">
        <div class="alert-title-wrap">
          <span class="alert-icon">${t.icon}</span>
          <span class="alert-title">${t.type}</span>
        </div>
        <span class="alert-priority-chip priority-${t.priority}">${t.priority}</span>
      </div>
      <div class="alert-desc">${t.desc}</div>
      ${metaHtml}
      <div class="alert-timer-track"><div class="alert-timer-fill" id="alert-timer-${alertObj.id}" style="width:100%;"></div></div>
      <div class="action-grid">${actionsHtml}</div>
    `;
    alertsColumn.prepend(card);

    card.querySelectorAll('.action-btn').forEach(btn => {
      btn.addEventListener('click', onActionClick);
    });
  }

  function impactLabel(priority){
    if(priority === 'critical') return 'Severe';
    if(priority === 'high') return 'Significant';
    return 'Moderate';
  }

  function updateAlertTimers(dt){
    for(let i = state.activeAlerts.length - 1; i >= 0; i--){
      const a = state.activeAlerts[i];
      a.life -= dt;
      const fillEl = document.getElementById(`alert-timer-${a.id}`);
      if(fillEl){
        const pct = Math.max(0, (a.life / a.maxLife) * 100);
        fillEl.style.width = pct + '%';
        fillEl.style.background = pct < 25 ? 'var(--red)' : pct < 55 ? 'var(--orange)' : 'var(--cyan)';
      }
      if(a.life <= 0){
        expireAlert(a);
      }
    }
  }

  function expireAlert(alertObj){
    // Treat expiry like "Ignore" outcome but harsher, and count as wrong.
    const t = alertObj.template;
    applyEffects({ service:-6, satisfaction:-5, inventory: t.type.includes('Inventory')||t.type.includes('Stock')?-6:0 });
    state.wrongCount++;
    addLog(`⏱ <b>${t.type}</b> expired unresolved — impact absorbed by operations.`, 'bad');
    removeAlertCard(alertObj.id);
    state.activeAlerts = state.activeAlerts.filter(a => a.id !== alertObj.id);
    updateActiveCount();
  }

  function removeAlertCard(id){
    const card = document.getElementById(`alert-${id}`);
    if(card){
      card.classList.add('exiting');
      setTimeout(()=> card.remove(), 300);
    }
  }

  /* ============================================================
     ACTION HANDLING
     ============================================================ */

  function onActionClick(e){
    if(!state.running || state.paused) return;
    const btn = e.currentTarget;
    const alertId = Number(btn.dataset.alertId);
    const actionIdx = Number(btn.dataset.actionIdx);
    const alertObj = state.activeAlerts.find(a => a.id === alertId);
    if(!alertObj) return;

    const t = alertObj.template;
    const action = t.actions[actionIdx];

    // disable all buttons on this card immediately to prevent double click
    const card = document.getElementById(`alert-${alertId}`);
    if(card){ card.querySelectorAll('.action-btn').forEach(b => b.disabled = true); }

    applyEffects(action.effect);

    let scoreDelta = action.best ? 120 : (action.label === 'Ignore' ? -60 : (action.label === 'Delay Decision' ? -20 : 30));
    state.score = Math.max(0, state.score + scoreDelta);

    if(action.best){
      state.correctCount++;
      addLog(`✅ <b>${t.type}</b>: chose "${action.label}" — ${action.log}`, 'good');
    } else if(action.label === 'Ignore'){
      state.wrongCount++;
      addLog(`❌ <b>${t.type}</b>: ignored — ${action.log}`, 'bad');
    } else {
      state.wrongCount++;
      addLog(`⚠ <b>${t.type}</b>: chose "${action.label}" — ${action.log}`, 'neutral');
    }

    state.resolvedCount++;

    if(action.delayed && action.delayedEffect){
      const delaySeconds = 5 + Math.random()*4;
      setTimeout(() => {
        if(!state.running) return;
        applyEffects(action.delayedEffect);
        addLog(`⏳ Delayed consequence — ${action.delayedLog}`, 'bad');
      }, delaySeconds * 1000);
    }

    removeAlertCard(alertId);
    state.activeAlerts = state.activeAlerts.filter(a => a.id !== alertId);
    updateActiveCount();
  }

  function applyEffects(effect){
    const prev = Object.assign({}, state.kpis);
    Object.keys(effect || {}).forEach(k => {
      if(state.kpis.hasOwnProperty(k)){
        state.kpis[k] += effect[k];
      }
    });
    clampKpis();
    renderKpis(prev);
  }

  /* ============================================================
     GAME LOOP
     ============================================================ */

  const TICK_MS = 200;

  function startGameLoop(){
    state.tickHandle = setInterval(gameTick, TICK_MS);
  }

  function stopGameLoop(){
    if(state.tickHandle){ clearInterval(state.tickHandle); state.tickHandle = null; }
  }

  function gameTick(){
    if(!state.running || state.paused) return;
    const dt = TICK_MS/1000;
    state.timeLeft -= dt;
    state.spawnTimer -= dt;

    // Difficulty ramp: spawn interval shrinks and floor rises as time passes
    const elapsed = GAME_DURATION - state.timeLeft;
    const rampFactor = Math.min(1, elapsed / GAME_DURATION);
    state.spawnInterval = 6.5 - rampFactor * 4.2; // from ~6.5s down to ~2.3s
    updateDifficultyTag(rampFactor);

    if(state.spawnTimer <= 0 && state.activeAlerts.length < maxConcurrent(rampFactor)){
      spawnAlert();
      state.spawnTimer = state.spawnInterval + Math.random()*1.5;
    }

    updateAlertTimers(dt);

    // passive cost drift makes the game feel alive
    if(Math.random() < 0.01){
      applyEffects({ cost: (Math.random()-0.5)*1 });
    }

    renderKpis();

    if(state.timeLeft <= 0){
      state.timeLeft = 0;
      endGame();
    }
  }

  function maxConcurrent(rampFactor){
    return 2 + Math.floor(rampFactor * 4); // 2 up to 6 simultaneous
  }

  function updateDifficultyTag(rampFactor){
    if(rampFactor > 0.66){
      difficultyTag.textContent = 'Critical Surge';
      difficultyTag.className = 'difficulty-tag critical';
    } else if(rampFactor > 0.3){
      difficultyTag.textContent = 'Ramping Up';
      difficultyTag.className = 'difficulty-tag ramping';
    } else {
      difficultyTag.textContent = 'Stable';
      difficultyTag.className = 'difficulty-tag';
    }
  }

  /* ============================================================
     GAME LIFECYCLE
     ============================================================ */

  function initGame(){
    state = freshState();
    buildKpiStrip();
    renderKpis();
    alertsColumn.innerHTML = '';
    alertsColumn.appendChild(emptyState);
    updateActiveCount();
    logList.innerHTML = '';
    logCountEl.textContent = '0';
    addLog('Shift started. Operations floor is live.', 'info');
    difficultyTag.textContent = 'Stable';
    difficultyTag.className = 'difficulty-tag';
  }

  function startGame(){
    initGame();
    state.running = true;
    state.paused = false;
    startGameLoop();
  }

  function endGame(){
    state.running = false;
    stopGameLoop();
    // resolve remaining active alerts as "expired" quietly (no more penalty double count needed, just clear)
    state.activeAlerts.forEach(a => removeAlertCard(a.id));
    state.activeAlerts = [];
    showEndScreen();
  }

  function computeGrade(){
    const avgKpi = (state.kpis.service + state.kpis.satisfaction + state.kpis.inventory + state.kpis.transport) / 4;
    const costPenalty = Math.max(0, state.kpis.cost - 100);
    const composite = avgKpi - costPenalty*0.5 + (state.score/50);
    if(composite >= 95) return 'A+';
    if(composite >= 85) return 'A';
    if(composite >= 70) return 'B';
    if(composite >= 55) return 'C';
    return 'D';
  }

  function gradeSummary(grade){
    const summaries = {
      'A+': 'An exceptional shift. Every major disruption was neutralized before it could touch the customer, and the network is in better shape than when you started.',
      'A': 'A strong shift. You kept the network resilient under pressure and protected most of your service commitments.',
      'B': 'A solid shift with some rough patches. Several disruptions were handled well, but a few decisions cost you KPIs.',
      'C': 'A rocky shift. The network held together, but customers and costs both took noticeable hits.',
      'D': 'A difficult shift. Multiple disruptions went unresolved or were mishandled, and the network is worse off than when you started.'
    };
    return summaries[grade] || summaries['C'];
  }

  function showEndScreen(){
    const grade = computeGrade();
    const letterEl = $('#gradeLetter');
    letterEl.textContent = grade;
    letterEl.className = `grade-letter grade-${grade[0]}`;
    $('#finalScoreLine').textContent = `Final Score: ${Math.round(state.score).toLocaleString()}`;
    $('#tallyResolved').textContent = state.resolvedCount;
    $('#tallyCorrect').textContent = state.correctCount;
    $('#tallyWrong').textContent = state.wrongCount;

    const grid = $('#endKpiGrid');
    grid.innerHTML = '';
    KPI_DEFS.filter(d => !['score','time'].includes(d.key)).forEach(def => {
      const div = document.createElement('div');
      div.className = 'item';
      div.innerHTML = `<b>${formatKpi(def, state.kpis[def.key])}</b><span>${def.label}</span>`;
      grid.appendChild(div);
    });

    $('#endSummaryText').textContent = gradeSummary(grade);
    $('#endScreen').classList.remove('hidden');
  }

  /* ============================================================
     UI WIRING
     ============================================================ */

  $('#startBtn').addEventListener('click', () => {
    $('#startScreen').classList.add('hidden');
    startGame();
  });

  $('#playAgainBtn').addEventListener('click', () => {
    $('#endScreen').classList.add('hidden');
    startGame();
  });

  $('#helpBtn').addEventListener('click', () => {
    if(state && state.running){ pauseForModal(); }
    $('#helpScreen').classList.remove('hidden');
  });
  $('#closeHelpBtn').addEventListener('click', () => {
    $('#helpScreen').classList.add('hidden');
    resumeFromModal();
  });

  let pausedByModal = false;
  function pauseForModal(){
    if(state.running && !state.paused){ state.paused = true; pausedByModal = true; }
  }
  function resumeFromModal(){
    if(pausedByModal){ state.paused = false; pausedByModal = false; }
  }

  $('#pauseBtn').addEventListener('click', () => {
    if(!state || !state.running) return;
    state.paused = true;
    $('#pauseScreen').classList.remove('hidden');
  });
  $('#resumeBtn').addEventListener('click', () => {
    state.paused = false;
    $('#pauseScreen').classList.add('hidden');
  });

  $('#soundBtn').addEventListener('click', function(){
    if(!state) { state = freshState(); }
    state.soundOn = !state.soundOn;
    this.textContent = state.soundOn ? '🔊 Sound On' : '🔇 Sound Off';
    this.classList.toggle('active', state.soundOn);
  });

  /* ============================================================
     BOOTSTRAP
     ============================================================ */

  buildKpiStrip();
  state = freshState();
  renderKpis();

})();
</script>
</body>
</html>

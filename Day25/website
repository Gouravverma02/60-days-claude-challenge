//  LEADERBOARD
// ══════════════════════════════════════════════════════════════
function saveToLeaderboard() {
  const p = state.pitch;
  const entry = {
    name: p.name,
    ask: p.ask,
    score: state.totalScore,
    outcome: state.decision.outcome,
    valuation: state.decision.valuation,
    date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
    ts: Date.now()
  };
  const lb = getLB();
  lb.push(entry);
  lb.sort((a, b) => b.score - a.score);
  localStorage.setItem('shark_lb_v2', JSON.stringify(lb.slice(0, 25)));
}

function getLB() {
  try { return JSON.parse(localStorage.getItem('shark_lb_v2') || '[]'); } catch { return []; }
}

function clearLeaderboard() {
  if (!confirm('Clear all leaderboard entries?')) return;
  localStorage.removeItem('shark_lb_v2');
  renderLBFull();
  showToast('🗑 Leaderboard cleared.');
}

function renderLBTable(entries, containerId) {
  const el = document.getElementById(containerId);
  if (!el) return;
  if (!entries.length) {
    el.innerHTML = `<div class="lb-table-wrap"><div class="lb-empty"><strong>🦈</strong>No pitches yet. Be the first to enter the tank!</div></div>`;
    return;
  }
  const rankClasses = ['gold-r', 'silver-r', 'bronze-r'];
  const medals = ['🥇', '🥈', '🥉'];
  el.innerHTML = `
    <div class="lb-table-wrap">
      <div class="lb-row header">
        <div>#</div><div>Startup</div><div>Score</div><div>Outcome</div>
      </div>
      ${entries.map((e, i) => `
        <div class="lb-row">
          <div class="lb-rank ${rankClasses[i] || ''}">${i < 3 ? medals[i] : i + 1}</div>
          <div class="lb-name-cell">
            <div class="lb-startup-name">${esc(e.name)}</div>
            <div class="lb-date">${e.date}</div>
          </div>
          <div class="lb-score">${e.score}</div>
          <div><span class="lb-chip ${e.outcome}">${e.outcome}</span></div>
        </div>
      `).join('')}
    </div>
  `;
}

function renderLBLanding() { renderLBTable(getLB().slice(0, 5), 'lb-landing'); }
function renderLBFull()    { renderLBTable(getLB(), 'lb-full'); }


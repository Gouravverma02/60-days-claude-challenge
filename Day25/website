<script>
// ══════════════════════════════════════════════════════════════
//  APP STATE
// ══════════════════════════════════════════════════════════════
const state = {
  pitch: {},
  judgeQA: {},
  completedJudges: new Set(),
  scores: {},
  totalScore: 0,
  decision: {},
};

// ══════════════════════════════════════════════════════════════
//  JUDGE DEFINITIONS
// ══════════════════════════════════════════════════════════════
const JUDGES = [
  {
    id: 'vc',
    name: 'Victoria Chen',
    role: 'Venture Capitalist',
    emoji: '💼',
    color: '#00d4ff',
    focus: 'market size and scalability',
    persona: `You are Victoria Chen, a sharp Partner at a top-tier VC firm who has backed 40+ startups and manages $800M AUM. You speak with cool authority, use industry terminology naturally, and laser-focus on TAM/SAM/SOM, compounding growth mechanics, defensible moats, network effects, and exit multiples. You probe hard on market assumptions. You are direct, occasionally cutting, but professionally fair. Keep responses to 2-3 punchy sentences.`
  },
  {
    id: 'founder',
    name: 'Marcus Reid',
    role: 'Serial Founder',
    emoji: '🚀',
    color: '#2ed573',
    focus: 'execution capability, team strength, and product-market fit signals',
    persona: `You are Marcus Reid, a 3x founder who has built and sold companies (most recently for $240M). You know the grit it takes to execute. You probe specifically on team background, what's been built so far, early traction signals, how they've responded to setbacks, and realistic timelines. You respect hustle and call out vague hand-waving immediately. Conversational, direct, no fluff. 2-3 sentences max.`
  },
  {
    id: 'customer',
    name: 'Priya Nair',
    role: 'Customer Advocate',
    emoji: '👥',
    color: '#f5a623',
    focus: 'real-world usefulness, stickiness, and whether real people will actually pay',
    persona: `You are Priya Nair, a consumer behavior expert and product strategist. You speak for real users. You ask whether this solves a felt need, how sticky the product is week-over-week, what the onboarding experience looks like, and whether people will pay what's being asked. You use plain, concrete language and think in real user scenarios. Skeptical but kind. 2-3 sentences max.`
  },
  {
    id: 'angel',
    name: 'Damon Wells',
    role: 'Angel Investor',
    emoji: '💰',
    color: '#a55eea',
    focus: 'unit economics, profitability path, and realistic ROI',
    persona: `You are Damon Wells, a prolific angel investor with 80+ portfolio companies. You are laser-focused on unit economics: CAC, LTV, gross margins, burn rate, and the realistic path to profitability. You've seen 1,000 pitches and spotted patterns that signal winners from pretenders. You are crisp, analytical, and blunt about risk. Numbers over stories, always. 2-3 sentences max.`
  }
];

// ══════════════════════════════════════════════════════════════
//  NAVIGATION
// ══════════════════════════════════════════════════════════════
function goTo(name) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(`screen-${name}`).classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
  if (name === 'landing') renderLBLanding();
  if (name === 'leaderboard') renderLBFull();
}

function confirmBack() {
  if (state.completedJudges.size > 0) {
    if (!confirm('Going back will reset your Q&A progress. Are you sure?')) return;
  }
  goTo('form');
}

// ══════════════════════════════════════════════════════════════
//  FORM → START PITCH
// ══════════════════════════════════════════════════════════════
function startPitch() {
  const name     = document.getElementById('f-name').value.trim();
  const ask      = document.getElementById('f-ask').value.trim();
  const problem  = document.getElementById('f-problem').value.trim();
  const solution = document.getElementById('f-solution').value.trim();
  const revenue  = document.getElementById('f-revenue').value.trim();
  const audience = document.getElementById('f-audience').value.trim();

  if (!name || !problem || !solution || !revenue || !audience || !ask) {
    showToast('⚠️ Please fill in all fields before entering the tank!');
    return;
  }

  state.pitch = { name, ask, problem, solution, revenue, audience };
  state.judgeQA = {};
  state.completedJudges = new Set();
  JUDGES.forEach(j => { state.judgeQA[j.id] = []; });

  renderPitchScreen();
  goTo('pitch');
}

// ══════════════════════════════════════════════════════════════
//  RENDER PITCH SCREEN
// ══════════════════════════════════════════════════════════════
function renderPitchScreen() {
  const p = state.pitch;

  document.getElementById('pitch-summary').innerHTML = `
    <div class="pitch-startup-name">${esc(p.name)}</div>
    <div class="pitch-ask">Asking: ${esc(p.ask)}</div>
    <div class="pitch-grid">
      <div class="pitch-item">
        <span class="pitch-item-label">🔥 Problem</span>
        <p class="pitch-item-text">${esc(p.problem)}</p>
      </div>
      <div class="pitch-item">
        <span class="pitch-item-label">💡 Solution</span>
        <p class="pitch-item-text">${esc(p.solution)}</p>
      </div>
      <div class="pitch-item">
        <span class="pitch-item-label">💰 Revenue Model</span>
        <p class="pitch-item-text">${esc(p.revenue)}</p>
      </div>
      <div class="pitch-item">
        <span class="pitch-item-label">🎯 Target Audience</span>
        <p class="pitch-item-text">${esc(p.audience)}</p>
      </div>
    </div>
  `;

  document.getElementById('judges-panel').innerHTML = JUDGES.map(j => `
    <div class="judge-card" id="jcard-${j.id}" onclick="selectJudge('${j.id}')">
      <span class="judge-avatar">${j.emoji}</span>
      <span class="judge-name">${j.name}</span>
      <span class="judge-role">${j.role}</span>
      <div class="judge-color-bar" style="background:linear-gradient(90deg,${j.color},${j.color}66)"></div>
    </div>
  `).join('');

  document.getElementById('qa-container').innerHTML = `
    <div style="text-align:center;padding:32px 24px;color:var(--muted);font-size:.9rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);">
      <div style="font-size:1.8rem;margin-bottom:10px;">👆</div>
      Select a shark above to begin your Q&amp;A session.<br>
      <span style="font-size:.78rem;color:var(--muted);">You must face all 4 sharks before scoring.</span>
    </div>
  `;
  document.getElementById('btn-get-scores').style.display = 'none';
}

let activeJudge = null;

function selectJudge(judgeId) {
  if (state.completedJudges.has(judgeId)) {
    showToast('✅ You already faced this shark!');
    // Show their completed exchange
    renderCompletedExchange(judgeId);
    return;
  }
  activeJudge = JUDGES.find(j => j.id === judgeId);

  document.querySelectorAll('.judge-card').forEach(c => c.classList.remove('active'));
  document.getElementById(`jcard-${judgeId}`).classList.add('active');

  askQuestion(judgeId, 1);
}

// ══════════════════════════════════════════════════════════════
//  Q&A ENGINE
// ══════════════════════════════════════════════════════════════
async function askQuestion(judgeId, qNum) {
  const judge = JUDGES.find(j => j.id === judgeId);
  const p = state.pitch;
  const qa = state.judgeQA[judgeId];

  document.getElementById('pitch-phase').textContent = `⚡ Q&A — ${judge.name.toUpperCase()} (Q${qNum}/2)`;

  const prevHTML = renderPastQA(qa);
  const container = document.getElementById('qa-container');

  container.innerHTML = `
    <div class="qa-section">
      ${buildQAHead(judge, qNum)}
      ${prevHTML}
      <div class="loading-dots"><span></span><span></span><span></span></div>
    </div>
  `;

  // Build context prompt
  const prevContext = qa.map(x => `Q: ${x.q}\nA: ${x.a}\nReaction: ${x.reaction}`).join('\n\n');
  const prompt = `${judge.persona}

Startup being pitched:
- Name: ${p.name}
- Problem: ${p.problem}
- Solution: ${p.solution}
- Revenue Model: ${p.revenue}
- Target Audience: ${p.audience}
- Funding Ask: ${p.ask}

${prevContext ? 'Previous exchange:\n' + prevContext + '\n\n' : ''}Ask question #${qNum} from your perspective. Focus area: ${judge.focus}. Ask ONE sharp, pointed, specific question. Output ONLY the question text — no preamble, no label, no quotes. Maximum 2 sentences.`;

  const q = await callClaude(prompt);
  qa.push({ q, a: '', reaction: '' });

  const prevHTML2 = renderPastQA(qa.slice(0, -1));
  container.innerHTML = `
    <div class="qa-section">
      ${buildQAHead(judge, qNum)}
      ${prevHTML2}
      <div class="question-bubble">${esc(q)}</div>
      <div class="answer-area">
        <textarea id="answer-input" placeholder="Your answer…" rows="3"></textarea>
        <button class="btn-submit" onclick="submitAnswer('${judgeId}', ${qNum}, ${JSON.stringify(q).replace(/"/g,'&quot;')})">Submit Answer →</button>
      </div>
    </div>
  `;
}

async function submitAnswer(judgeId, qNum, question) {
  const answer = document.getElementById('answer-input').value.trim();
  if (!answer) { showToast('Please type an answer first!'); return; }

  const judge = JUDGES.find(j => j.id === judgeId);
  const p = state.pitch;
  const qa = state.judgeQA[judgeId];
  const lastItem = qa[qa.length - 1];
  lastItem.a = answer;

  const container = document.getElementById('qa-container');
  const prevHTML = renderPastQA(qa.slice(0, -1));

  container.innerHTML = `
    <div class="qa-section">
      ${buildQAHead(judge, qNum)}
      ${prevHTML}
      <div class="question-bubble">${esc(question)}</div>
      <div class="answer-label">Your Answer</div>
      <div class="answer-bubble">${esc(answer)}</div>
      <div class="loading-dots"><span></span><span></span><span></span></div>
    </div>
  `;

  const reactionPrompt = `${judge.persona}

Startup: ${p.name} — ${p.solution}
Your question: ${question}
Their answer: ${answer}

React authentically in 2-3 sentences. Can be skeptical, impressed, a follow-up observation, or sharp critique. Stay in character. No labels, just your reaction text.`;

  const reaction = await callClaude(reactionPrompt);
  lastItem.reaction = reaction;

  if (qNum === 1) {
    askQuestion(judgeId, 2);
  } else {
    // Done with this judge
    state.completedJudges.add(judgeId);
    const jcard = document.getElementById(`jcard-${judgeId}`);
    jcard.classList.remove('active');
    jcard.classList.add('done');

    renderCompletedExchange(judgeId);

    const count = state.completedJudges.size;
    document.getElementById('pitch-phase').textContent =
      count < 4 ? `⚡ Q&A — ${count}/4 SHARKS DONE` : '⚡ ALL SHARKS DONE — GET YOUR SCORES';

    if (count === 4) {
      document.getElementById('btn-get-scores').style.display = 'block';
      document.getElementById('btn-get-scores').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }
}

function renderCompletedExchange(judgeId) {
  const judge = JUDGES.find(j => j.id === judgeId);
  const qa = state.judgeQA[judgeId];
  document.getElementById('qa-container').innerHTML = `
    <div class="qa-section">
      ${buildQAHead(judge, 'Done')}
      ${renderPastQA(qa)}
      <div style="text-align:center;padding:10px 0 4px;font-size:.8rem;color:var(--emerald);font-weight:700;letter-spacing:1px;">
        ✓ Session complete — select another shark above
      </div>
    </div>
  `;
}

function buildQAHead(judge, qNum) {
  return `
    <div class="qa-head">
      <div class="qa-avatar" style="border-color:${judge.color}33;background:${judge.color}10;">${judge.emoji}</div>
      <div class="qa-meta">
        <div class="qa-judge-name">${judge.name}</div>
        <div class="qa-judge-role">${judge.role}</div>
      </div>
      <div class="qa-progress-label">${qNum === 'Done' ? '✓ DONE' : `Q${qNum} of 2`}</div>
    </div>
  `;
}

function renderPastQA(qaArr) {
  if (!qaArr || !qaArr.length) return '';
  return qaArr.map(item => `
    <div class="question-bubble">${esc(item.q)}</div>
    ${item.a ? `<div class="answer-label">Your Answer</div><div class="answer-bubble">${esc(item.a)}</div>` : ''}
    ${item.reaction ? `<div class="reaction-bubble">${esc(item.reaction)}</div>` : ''}
    <div class="qa-divider"></div>
  `).join('');
}

// ══════════════════════════════════════════════════════════════
//  SCORING
// ══════════════════════════════════════════════════════════════
async function goToScoring() {
  goTo('scoring');

  document.getElementById('scores-grid').innerHTML = `
    <div style="grid-column:1/-1;display:flex;align-items:center;gap:14px;padding:40px;color:var(--muted2);font-size:.9rem;">
      <div class="loading-dots"><span></span><span></span><span></span></div>
      The sharks are deliberating…
    </div>
  `;
  document.getElementById('total-score-display').innerHTML = '–<span>/100</span>';
  document.getElementById('score-grade-text').textContent = '';

  const p = state.pitch;
  const allQA = JUDGES.map(j => {
    const qa = state.judgeQA[j.id];
    return `${j.name} (${j.role}):\n${qa.map(x => `  Q: ${x.q}\n  A: ${x.a}`).join('\n')}`;
  }).join('\n\n');

  const scorePrompt = `You are the scoring committee for a high-stakes Shark Tank competition.

Startup Pitch:
- Name: ${p.name}
- Problem: ${p.problem}
- Solution: ${p.solution}
- Revenue Model: ${p.revenue}
- Target Audience: ${p.audience}
- Funding Ask: ${p.ask}

Q&A Exchanges:
${allQA}

Score this startup on 5 dimensions, each 0–100. Be realistic and differentiated — avoid clustering scores. Return ONLY valid JSON with no markdown fencing:
{
  "marketPotential": <number 0-100>,
  "innovation": <number 0-100>,
  "businessModel": <number 0-100>,
  "execution": <number 0-100>,
  "investmentWorthiness": <number 0-100>,
  "commentary": {
    "marketPotential": "<one crisp, specific sentence>",
    "innovation": "<one crisp, specific sentence>",
    "businessModel": "<one crisp, specific sentence>",
    "execution": "<one crisp, specific sentence>",
    "investmentWorthiness": "<one crisp, specific sentence>"
  }
}`;

  const raw = await callClaude(scorePrompt, 600);
  let scores;
  try {
    scores = JSON.parse(raw.replace(/```json|```/g, '').trim());
  } catch {
    scores = {
      marketPotential: 65, innovation: 62, businessModel: 60, execution: 68, investmentWorthiness: 63,
      commentary: {
        marketPotential: 'Solid target market with room to scale.',
        innovation: 'Differentiated but faces some established alternatives.',
        businessModel: 'Revenue model is viable with the right execution.',
        execution: 'Team shows awareness of challenges ahead.',
        investmentWorthiness: 'Moderate return potential with manageable risk profile.'
      }
    };
  }

  state.scores = scores;
  state.totalScore = Math.round(
    (scores.marketPotential + scores.innovation + scores.businessModel + scores.execution + scores.investmentWorthiness) / 5
  );

  renderScores(scores);
}

function renderScores(scores) {
  const dims = [
    { key: 'marketPotential',     label: '📈 Market Potential',     color: '#00d4ff' },
    { key: 'innovation',          label: '🔬 Innovation',           color: '#2ed573' },
    { key: 'businessModel',       label: '💰 Business Model',       color: '#f5a623' },
    { key: 'execution',           label: '⚡ Execution',            color: '#a55eea' },
    { key: 'investmentWorthiness',label: '🎯 Investment Worthiness', color: '#ff4757' },
  ];

  document.getElementById('scores-grid').innerHTML = dims.map((d, i) => `
    <div class="score-card" style="animation-delay:${i * .07}s">
      <div class="score-top">
        <div class="score-label-text">${d.label}</div>
        <div class="score-value-num" style="color:${d.color}">${scores[d.key]}<span style="font-size:1rem;color:var(--muted)">/100</span></div>
      </div>
      <div class="score-bar-track">
        <div class="score-bar-fill" id="bar-${d.key}" style="background:${d.color};"></div>
      </div>
      <div class="score-comment">${esc(scores.commentary[d.key])}</div>
    </div>
  `).join('');

  setTimeout(() => {
    dims.forEach(d => {
      const bar = document.getElementById(`bar-${d.key}`);
      if (bar) bar.style.width = scores[d.key] + '%';
    });
    animateCount('total-score-display', 0, state.totalScore, 1600);
    const grade = getGrade(state.totalScore);
    document.getElementById('score-grade-text').textContent = grade;
  }, 250);
}

function getGrade(score) {
  if (score >= 88) return '🏆 Exceptional — Top-tier pitch';
  if (score >= 76) return '🌟 Strong — Sharks are interested';
  if (score >= 62) return '📊 Promising — Needs refinement';
  if (score >= 48) return '⚠️ Weak — Significant gaps remain';
  return '❌ Poor — Back to the drawing board';
}

function animateCount(id, from, to, duration) {
  const el = document.getElementById(id);
  if (!el) return;
  const start = performance.now();
  function frame(now) {
    const t = Math.min((now - start) / duration, 1);
    const ease = t < .5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
    const val = Math.round(from + (to - from) * ease);
    el.innerHTML = `${val}<span>/100</span>`;
    if (t < 1) requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
}

// ══════════════════════════════════════════════════════════════
//  DECISION
// ══════════════════════════════════════════════════════════════
async function goToDecision() {
  goTo('decision');

  document.getElementById('decision-hero').innerHTML = `
    <div style="display:flex;align-items:center;justify-content:center;gap:14px;color:var(--muted2);font-size:.9rem;padding:30px 0;">
      <div class="loading-dots"><span></span><span></span><span></span></div>
      The sharks are making their final decision…
    </div>
  `;
  document.getElementById('deal-row').innerHTML = '';
  document.getElementById('verdicts-card').innerHTML = '';
  document.getElementById('action-row').innerHTML = '';

  const p = state.pitch;
  const s = state.scores;
  const total = state.totalScore;

  const decisionPrompt = `You are the final decision panel for a Shark Tank competition.

Startup: ${p.name}
Funding Ask: ${p.ask}
Total Score: ${total}/100
Scores — Market: ${s.marketPotential}, Innovation: ${s.innovation}, Business Model: ${s.businessModel}, Execution: ${s.execution}, Investment Worthiness: ${s.investmentWorthiness}
Problem: ${p.problem}
Solution: ${p.solution}
Revenue: ${p.revenue}
Audience: ${p.audience}

Provide the final panel decision. Be bold — scores below 50 are rejections, 50-65 comeback, 66-78 invest, 79+ acquire or invest with high terms. Return ONLY valid JSON, no markdown:
{
  "outcome": "invest" | "reject" | "acquire" | "comeback",
  "tagline": "<dramatic, memorable one-liner about this specific startup, 10-16 words>",
  "valuation": "<specific dollar amount, e.g. $1.8M>",
  "fundingAmount": "<specific dollar amount matching or countering their ask, or 'N/A' if reject>",
  "equityOffered": "<e.g. '15% equity' or 'N/A'>",
  "reasoning": "<2-3 specific sentences about why this decision was made, referencing the startup>",
  "judgeVerdicts": [
    {"judgeId":"vc","vote":"in"|"out"|"maybe","comment":"<1 specific sentence from their perspective>"},
    {"judgeId":"founder","vote":"in"|"out"|"maybe","comment":"<1 specific sentence from their perspective>"},
    {"judgeId":"customer","vote":"in"|"out"|"maybe","comment":"<1 specific sentence from their perspective>"},
    {"judgeId":"angel","vote":"in"|"out"|"maybe","comment":"<1 specific sentence from their perspective>"}
  ]
}`;

  const raw = await callClaude(decisionPrompt, 900);
  let dec;
  try {
    dec = JSON.parse(raw.replace(/```json|```/g, '').trim());
  } catch {
    const invested = total >= 65;
    dec = {
      outcome: invested ? 'invest' : total >= 50 ? 'comeback' : 'reject',
      tagline: invested ? `${p.name} is exactly what this market needs right now.` : `The vision is there, but the execution plan needs serious work.`,
      valuation: `$${Math.round(total * 28000).toLocaleString()}`,
      fundingAmount: invested ? p.ask : 'N/A',
      equityOffered: invested ? '12% equity' : 'N/A',
      reasoning: invested ? `${p.name} demonstrated strong fundamentals and a credible path to scale. The team showed conviction and the market opportunity is compelling.` : `While the concept has merit, there are too many unresolved questions about execution and unit economics to move forward at this stage.`,
      judgeVerdicts: JUDGES.map(j => ({
        judgeId: j.id,
        vote: invested ? 'in' : total >= 50 ? 'maybe' : 'out',
        comment: invested ? `Impressed by the clarity of vision and market understanding.` : `Needs more validation before this becomes a fundable opportunity.`
      }))
    };
  }

  state.decision = dec;
  renderDecision(dec);
  saveToLeaderboard();

  if (dec.outcome === 'invest' || dec.outcome === 'acquire') {
    setTimeout(launchConfetti, 500);
  }
}

function renderDecision(dec) {
  const labels = {
    invest:   '🎉 DEAL!',
    reject:   '❌ NO DEAL',
    acquire:  '🤝 ACQUIRE',
    comeback: '🔄 NOT YET'
  };

  document.getElementById('decision-hero').innerHTML = `
    <div class="decision-badge ${dec.outcome}">${labels[dec.outcome] || dec.outcome.toUpperCase()}</div>
    <p class="decision-tagline">"${esc(dec.tagline)}"</p>
  `;

  document.getElementById('deal-row').innerHTML = `
    <div class="deal-card">
      <div class="deal-card-label">Suggested Valuation</div>
      <div class="deal-card-value">${esc(dec.valuation)}</div>
    </div>
    <div class="deal-card">
      <div class="deal-card-label">Funding Amount</div>
      <div class="deal-card-value">${esc(dec.fundingAmount)}</div>
    </div>
    <div class="deal-card">
      <div class="deal-card-label">Equity / Score</div>
      <div class="deal-card-value">${esc(dec.equityOffered || 'N/A')}<span style="display:block;font-size:.9rem;color:var(--muted);font-family:var(--font-b);font-weight:600;margin-top:4px;">${state.totalScore}/100</span></div>
    </div>
  `;

  const verdictsHTML = (dec.judgeVerdicts || []).map((v, i) => {
    const judge = JUDGES.find(j => j.id === v.judgeId);
    if (!judge) return '';
    return `
      <div class="verdict-item" style="animation-delay:${i * .08}s">
        <div class="verdict-av" style="border-color:${judge.color}33;background:${judge.color}10;">${judge.emoji}</div>
        <div class="verdict-body">
          <div class="verdict-judge-name">${judge.name} <span style="font-weight:400;color:var(--muted);font-size:.75rem;">· ${judge.role}</span></div>
          <div class="verdict-comment">${esc(v.comment)}</div>
        </div>
        <div class="verdict-vote ${v.vote}">${v.vote === 'in' ? '✅ IN' : v.vote === 'out' ? '❌ OUT' : '🤔 MAYBE'}</div>
      </div>
    `;
  }).join('');

  document.getElementById('verdicts-card').innerHTML = `
    <div class="verdict-section-title">JUDGE VERDICTS</div>
    <div class="verdict-reasoning">${esc(dec.reasoning)}</div>
    ${verdictsHTML}
  `;

  document.getElementById('action-row').innerHTML = `
    <button class="btn-action gold" onclick="downloadPDF()">📄 Download Report</button>
    <button class="btn-action" onclick="shareResult()">🔗 Share Result</button>
    <button class="btn-action green" onclick="startOver()">🦈 Pitch Again</button>
    <button class="btn-action" onclick="goTo('leaderboard')">🏆 Leaderboard</button>
  `;
}


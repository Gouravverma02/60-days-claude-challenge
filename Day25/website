<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Shark Tank Simulator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
:root {
  --bg:       #06080e;
  --bg2:      #080b14;
  --surface:  #0c1020;
  --surface2: #111628;
  --surface3: #161d35;
  --border:   #1a2238;
  --border2:  #222d4a;
  --cyan:     #00d4ff;
  --cyan-dim: #0099bb;
  --gold:     #f5a623;
  --gold-dim: #b87a10;
  --coral:    #ff4757;
  --emerald:  #2ed573;
  --purple:   #a55eea;
  --blue:     #3b82f6;
  --text:     #dde2f0;
  --muted:    #5a6580;
  --muted2:   #8491b0;
  --font-d:   'Bebas Neue', sans-serif;
  --font-b:   'Inter', sans-serif;
  --r-sm:     6px;
  --r-md:     10px;
  --r-lg:     16px;
}
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { font-size: 16px; scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-b);
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ══ SCREENS ══════════════════════════════════════════════ */
.screen { display: none; min-height: 100vh; flex-direction: column; }
.screen.active { display: flex; }

/* ══ HEADER ════════════════════════════════════════════════ */
.hdr {
  background: rgba(6,8,14,.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 0 40px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 200;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.logo {
  font-family: var(--font-d);
  font-size: 1.6rem;
  letter-spacing: 3px;
  background: linear-gradient(120deg, var(--cyan) 0%, #60a5fa 50%, var(--gold) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  user-select: none;
}
.hdr-right { display: flex; align-items: center; gap: 12px; }
.live-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,71,87,.12);
  border: 1px solid rgba(255,71,87,.3);
  color: var(--coral);
  font-size: 0.65rem;
  font-weight: 700;
  padding: 5px 12px;
  border-radius: 20px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}
.live-dot {
  width: 6px; height: 6px;
  background: var(--coral);
  border-radius: 50%;
  animation: blink 1.4s infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.2} }

/* ══ BACK BUTTON ═══════════════════════════════════════════ */
.btn-back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: 1px solid var(--border2);
  color: var(--muted2);
  font-family: var(--font-b);
  font-size: 0.8rem;
  font-weight: 600;
  padding: 7px 14px;
  border-radius: var(--r-sm);
  cursor: pointer;
  transition: all .2s;
  letter-spacing: .3px;
}
.btn-back:hover { border-color: var(--cyan-dim); color: var(--cyan); background: rgba(0,212,255,.05); }
.btn-back svg { transition: transform .2s; }
.btn-back:hover svg { transform: translateX(-2px); }

/* ══ STEPPER ═══════════════════════════════════════════════ */
.stepper {
  display: flex;
  align-items: center;
  gap: 0;
}
.step {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: .8px;
  text-transform: uppercase;
  color: var(--muted);
}
.step .dot {
  width: 24px; height: 24px;
  border-radius: 50%;
  border: 1.5px solid var(--border2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.65rem;
  font-weight: 700;
  background: var(--bg);
  transition: all .3s;
  flex-shrink: 0;
}
.step.active { color: var(--cyan); }
.step.active .dot { border-color: var(--cyan); color: var(--cyan); box-shadow: 0 0 10px rgba(0,212,255,.3); }
.step.done { color: var(--emerald); }
.step.done .dot { background: var(--emerald); border-color: var(--emerald); color: #000; }
.step-line { width: 32px; height: 1px; background: var(--border); margin: 0 6px; flex-shrink: 0; }
@media (max-width: 500px) {
  .step .label { display: none; }
  .step-line { width: 18px; }
}

/* ══ PRIMARY BUTTON ════════════════════════════════════════ */
.btn-primary {
  background: linear-gradient(135deg, var(--cyan) 0%, #0ea5e9 100%);
  color: #000;
  font-family: var(--font-b);
  font-weight: 800;
  font-size: 0.95rem;
  letter-spacing: .8px;
  padding: 14px 40px;
  border: none;
  border-radius: var(--r-sm);
  cursor: pointer;
  text-transform: uppercase;
  transition: transform .15s, box-shadow .2s, opacity .2s;
  box-shadow: 0 0 28px rgba(0,212,255,.25);
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 4px 40px rgba(0,212,255,.4); }
.btn-primary:active { transform: translateY(0); }
.btn-ghost {
  background: transparent;
  border: 1px solid var(--border2);
  color: var(--muted2);
  font-family: var(--font-b);
  font-size: 0.88rem;
  font-weight: 600;
  padding: 12px 28px;
  border-radius: var(--r-sm);
  cursor: pointer;
  transition: all .2s;
}
.btn-ghost:hover { border-color: var(--text); color: var(--text); }

/* ══ LANDING ═══════════════════════════════════════════════ */
#screen-landing {
  background:
    radial-gradient(ellipse 80% 50% at 50% -10%, rgba(0,100,180,.18) 0%, transparent 70%),
    var(--bg);
}
.landing-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 70px 24px 40px;
  position: relative;
}
.shark-icon {
  font-size: 4.5rem;
  margin-bottom: 18px;
  animation: swim 5s ease-in-out infinite;
  filter: drop-shadow(0 0 30px rgba(0,212,255,.3));
}
@keyframes swim {
  0%,100%{ transform: translateX(-6px) rotate(-2deg); }
  50%{ transform: translateX(6px) rotate(2deg); }
}
.hero-eyebrow {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--cyan);
  margin-bottom: 16px;
  border: 1px solid rgba(0,212,255,.2);
  padding: 5px 16px;
  border-radius: 20px;
  background: rgba(0,212,255,.06);
  display: inline-block;
}
.hero-title {
  font-family: var(--font-d);
  font-size: clamp(3.2rem, 9vw, 6.5rem);
  letter-spacing: 3px;
  line-height: .95;
  margin-bottom: 20px;
}
.hero-title .line1 {
  background: linear-gradient(135deg, #fff 0%, var(--muted2) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
}
.hero-title .line2 {
  background: linear-gradient(135deg, var(--cyan) 0%, var(--gold) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
}
.hero-sub {
  font-size: 1.05rem;
  color: var(--muted2);
  max-width: 520px;
  margin-bottom: 44px;
  line-height: 1.7;
}
.judges-row {
  display: flex;
  gap: 12px;
  margin-bottom: 48px;
  flex-wrap: wrap;
  justify-content: center;
}
.judge-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 40px;
  padding: 7px 16px;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--muted2);
  transition: all .2s;
}
.judge-pill:hover { border-color: var(--cyan-dim); color: var(--text); }
.hero-cta { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; justify-content: center; }
.btn-outline-gold {
  background: transparent;
  border: 1px solid rgba(245,166,35,.4);
  color: var(--gold);
  font-family: var(--font-b);
  font-size: 0.88rem;
  font-weight: 600;
  padding: 14px 28px;
  border-radius: var(--r-sm);
  cursor: pointer;
  transition: all .2s;
}
.btn-outline-gold:hover { background: rgba(245,166,35,.08); border-color: var(--gold); }

/* ── Stats row ─────────────────────────────────────────── */
.landing-stats {
  display: flex;
  gap: 48px;
  margin-top: 60px;
  padding-top: 40px;
  border-top: 1px solid var(--border);
  flex-wrap: wrap;
  justify-content: center;
}
.stat-item { text-align: center; }
.stat-num {
  font-family: var(--font-d);
  font-size: 2.2rem;
  letter-spacing: 2px;
  color: var(--cyan);
  display: block;
}
.stat-label { font-size: 0.7rem; color: var(--muted); text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600; margin-top: 2px; }

/* ── LB Preview ─────────────────────────────────────────── */
.lb-preview-wrap {
  width: 100%;
  max-width: 760px;
  margin: 0 auto;
  padding: 0 24px 60px;
}
.section-eyebrow {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--muted);
  text-align: center;
  margin-bottom: 20px;
  position: relative;
}
.section-eyebrow::before, .section-eyebrow::after {
  content: '';
  position: absolute;
  top: 50%;
  width: calc(50% - 80px);
  height: 1px;
  background: var(--border);
}
.section-eyebrow::before { left: 0; }
.section-eyebrow::after { right: 0; }

/* ══ FORM SCREEN ═══════════════════════════════════════════ */
#screen-form { background: var(--bg); }
.form-wrap {
  flex: 1;
  max-width: 860px;
  margin: 0 auto;
  padding: 40px 28px 60px;
  width: 100%;
}
.page-title {
  font-family: var(--font-d);
  font-size: 2.2rem;
  letter-spacing: 3px;
  color: var(--text);
  margin-bottom: 4px;
}
.page-title span { color: var(--cyan); }
.page-sub { color: var(--muted2); font-size: 0.9rem; margin-bottom: 36px; line-height: 1.6; }

.progress-bar {
  height: 3px;
  background: var(--border);
  border-radius: 2px;
  margin-bottom: 40px;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--cyan), var(--gold));
  border-radius: 2px;
  transition: width .6s ease;
}

.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
.form-group { display: flex; flex-direction: column; gap: 8px; }
.form-group.full { grid-column: 1/-1; }
.form-label {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--muted2);
}
.form-label .icon {
  width: 20px; height: 20px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
}
.form-label .req { color: var(--coral); margin-left: 2px; }
.form-group input,
.form-group textarea,
.form-group select {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  color: var(--text);
  font-family: var(--font-b);
  font-size: 0.92rem;
  padding: 12px 16px;
  outline: none;
  transition: border-color .2s, box-shadow .2s, background .2s;
  resize: vertical;
  line-height: 1.5;
}
.form-group input::placeholder,
.form-group textarea::placeholder { color: var(--muted); }
.form-group input:focus,
.form-group textarea:focus {
  border-color: var(--cyan-dim);
  background: var(--surface2);
  box-shadow: 0 0 0 3px rgba(0,212,255,.08);
}
.form-group textarea { min-height: 88px; }
.form-hint { font-size: 0.72rem; color: var(--muted); line-height: 1.5; }
.form-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 36px;
  gap: 12px;
}
.form-actions-right { display: flex; gap: 12px; align-items: center; }

/* ══ PITCH SCREEN ══════════════════════════════════════════ */
#screen-pitch {
  background:
    radial-gradient(ellipse 60% 40% at 50% 0%, rgba(0,70,140,.12) 0%, transparent 60%),
    var(--bg);
}
.pitch-wrap {
  flex: 1;
  max-width: 1120px;
  margin: 0 auto;
  padding: 24px 28px 60px;
  width: 100%;
}
.pitch-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  flex-wrap: wrap;
  gap: 12px;
}
.phase-label {
  font-family: var(--font-d);
  font-size: 0.85rem;
  letter-spacing: 4px;
  color: var(--cyan);
}

/* Pitch Summary Card */
.pitch-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: 28px 32px;
  margin-bottom: 22px;
  position: relative;
  overflow: hidden;
}
.pitch-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, var(--cyan), var(--gold));
}
.pitch-startup-name {
  font-family: var(--font-d);
  font-size: 2.4rem;
  letter-spacing: 2px;
  color: var(--gold);
  margin-bottom: 4px;
}
.pitch-ask {
  font-size: 0.78rem;
  color: var(--cyan);
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.pitch-ask::before { content: ''; width: 16px; height: 1px; background: var(--cyan); display: inline-block; }
.pitch-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.pitch-item {}
.pitch-item-label {
  font-size: 0.65rem;
  color: var(--muted);
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  display: block;
  margin-bottom: 6px;
}
.pitch-item-text { font-size: 0.88rem; line-height: 1.6; color: var(--text); }

/* Judges Panel */
.judges-panel {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 22px;
}
.judge-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: 20px 14px 16px;
  text-align: center;
  cursor: pointer;
  transition: border-color .2s, transform .2s, box-shadow .2s;
  position: relative;
  overflow: hidden;
  user-select: none;
}
.judge-card:hover { border-color: var(--border2); transform: translateY(-3px); }
.judge-card.active {
  border-color: var(--cyan);
  box-shadow: 0 0 24px rgba(0,212,255,.18);
  transform: translateY(-4px);
}
.judge-card.done { border-color: var(--emerald); }
.judge-card.done::after {
  content: '✓';
  position: absolute;
  top: 8px; right: 10px;
  color: var(--emerald);
  font-size: 0.72rem;
  font-weight: 800;
  background: rgba(46,213,115,.12);
  border: 1px solid rgba(46,213,115,.3);
  width: 18px; height: 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 18px;
}
.judge-avatar {
  font-size: 2rem;
  margin-bottom: 10px;
  display: block;
}
.judge-name {
  font-weight: 700;
  font-size: 0.78rem;
  margin-bottom: 3px;
  display: block;
  color: var(--text);
}
.judge-role { font-size: 0.65rem; color: var(--muted); text-transform: uppercase; letter-spacing: .5px; }
.judge-color-bar {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 2px;
  transition: opacity .3s;
  opacity: 0;
}
.judge-card.active .judge-color-bar { opacity: 1; }

/* Q&A Section */
.qa-section {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: 26px 28px;
  margin-bottom: 22px;
  animation: fadeUp .3s ease both;
}
.qa-head {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 22px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
}
.qa-avatar {
  width: 40px; height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  flex-shrink: 0;
  border: 1px solid var(--border2);
}
.qa-meta { flex: 1; }
.qa-judge-name { font-weight: 700; font-size: 0.88rem; color: var(--text); }
.qa-judge-role { font-size: 0.7rem; color: var(--muted2); margin-top: 1px; }
.qa-progress-label {
  margin-left: auto;
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--muted);
  background: var(--surface2);
  border: 1px solid var(--border);
  padding: 4px 12px;
  border-radius: 20px;
  letter-spacing: .5px;
}
.question-bubble {
  background: var(--surface2);
  border-left: 3px solid var(--cyan);
  border-radius: 0 var(--r-sm) var(--r-sm) 0;
  padding: 14px 18px;
  margin-bottom: 14px;
  font-size: 0.92rem;
  line-height: 1.65;
  animation: slideIn .3s ease;
  color: var(--text);
}
@keyframes slideIn { from{opacity:0;transform:translateX(-8px)} to{opacity:1;transform:translateX(0)} }
.answer-label {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--muted);
  padding: 0 0 6px 4px;
}
.answer-bubble {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  padding: 12px 16px;
  margin-bottom: 14px;
  font-size: 0.88rem;
  color: var(--text);
  line-height: 1.6;
}
.reaction-bubble {
  background: rgba(245,166,35,.05);
  border-left: 3px solid var(--gold);
  border-radius: 0 var(--r-sm) var(--r-sm) 0;
  padding: 13px 18px;
  font-size: 0.88rem;
  line-height: 1.65;
  color: var(--muted2);
  animation: slideIn .3s ease;
  font-style: italic;
  margin-bottom: 6px;
}
.qa-divider { height: 12px; }
.answer-area { display: flex; flex-direction: column; gap: 10px; }
.answer-area textarea {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  color: var(--text);
  font-family: var(--font-b);
  font-size: 0.9rem;
  padding: 13px 16px;
  min-height: 80px;
  outline: none;
  resize: vertical;
  transition: border-color .2s, box-shadow .2s;
  line-height: 1.55;
}
.answer-area textarea::placeholder { color: var(--muted); }
.answer-area textarea:focus {
  border-color: var(--cyan-dim);
  box-shadow: 0 0 0 3px rgba(0,212,255,.08);
}
.btn-submit {
  align-self: flex-end;
  background: var(--surface2);
  border: 1px solid var(--cyan-dim);
  color: var(--cyan);
  font-family: var(--font-b);
  font-size: 0.82rem;
  font-weight: 700;
  padding: 10px 26px;
  border-radius: var(--r-sm);
  cursor: pointer;
  transition: all .2s;
  letter-spacing: .5px;
}
.btn-submit:hover { background: var(--cyan); color: #000; border-color: var(--cyan); }

/* Loading dots */
.loading-dots {
  display: inline-flex;
  gap: 5px;
  padding: 12px 4px;
  align-items: center;
}
.loading-dots span {
  width: 7px; height: 7px;
  background: var(--cyan);
  border-radius: 50%;
  animation: dot 1.2s infinite;
  opacity: .3;
}
.loading-dots span:nth-child(2) { animation-delay: .2s; }
.loading-dots span:nth-child(3) { animation-delay: .4s; }
@keyframes dot { 0%,80%,100%{transform:scale(.8);opacity:.3} 40%{transform:scale(1);opacity:1} }

/* Get Scores button */
.btn-get-scores {
  display: none;
  background: linear-gradient(135deg, var(--gold) 0%, #e07b00 100%);
  color: #000;
  font-family: var(--font-b);
  font-weight: 800;
  font-size: 0.95rem;
  letter-spacing: .8px;
  padding: 15px 50px;
  border: none;
  border-radius: var(--r-sm);
  cursor: pointer;
  text-transform: uppercase;
  margin: 0 auto;
  transition: transform .15s, box-shadow .2s;
  box-shadow: 0 0 28px rgba(245,166,35,.25);
}
.btn-get-scores:hover { transform: translateY(-2px); box-shadow: 0 4px 40px rgba(245,166,35,.4); }

/* ══ SCORING SCREEN ════════════════════════════════════════ */
#screen-scoring {
  background:
    radial-gradient(ellipse 60% 40% at 50% 0%, rgba(10,40,10,.2) 0%, transparent 60%),
    var(--bg);
}
.scoring-wrap {
  flex: 1;
  max-width: 940px;
  margin: 0 auto;
  padding: 40px 28px 60px;
  width: 100%;
}
.scoring-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32px;
  flex-wrap: wrap;
  gap: 12px;
}
.page-title-block {}
.scores-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-bottom: 28px;
}
.score-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: 22px;
  animation: fadeUp .5s ease both;
}
.score-card:nth-child(2) { animation-delay: .07s; }
.score-card:nth-child(3) { animation-delay: .14s; }
.score-card:nth-child(4) { animation-delay: .21s; }
.score-card:nth-child(5) { animation-delay: .28s; }
@keyframes fadeUp { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }
.score-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 14px;
}
.score-label-text {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--muted2);
}
.score-value-num {
  font-family: var(--font-d);
  font-size: 2rem;
  letter-spacing: 1px;
  line-height: 1;
}
.score-bar-track {
  height: 6px;
  background: var(--bg);
  border-radius: 3px;
  overflow: hidden;
  margin-bottom: 10px;
}
.score-bar-fill {
  height: 100%;
  border-radius: 3px;
  width: 0;
  transition: width 1.4s cubic-bezier(.4,0,.2,1);
}
.score-comment {
  font-size: 0.78rem;
  color: var(--muted2);
  line-height: 1.5;
}

/* Total score card */
.total-card {
  background: linear-gradient(135deg, rgba(20,40,20,.6), rgba(8,20,10,.9));
  border: 1px solid rgba(46,213,115,.3);
  border-radius: var(--r-lg);
  padding: 36px;
  text-align: center;
  margin-bottom: 32px;
  box-shadow: 0 0 50px rgba(46,213,115,.1);
  animation: fadeUp .5s ease .35s both;
  position: relative;
  overflow: hidden;
}
.total-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, transparent, var(--emerald), transparent);
}
.total-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--emerald);
  margin-bottom: 10px;
}
.total-num {
  font-family: var(--font-d);
  font-size: 5.5rem;
  color: var(--emerald);
  line-height: 1;
  letter-spacing: 2px;
}
.total-num span { font-size: 2rem; color: var(--muted); }
.total-grade {
  margin-top: 8px;
  font-size: 0.78rem;
  color: var(--muted2);
  font-weight: 500;
}
.btn-reveal {
  display: block;
  margin: 0 auto;
  background: linear-gradient(135deg, var(--coral) 0%, #c92030 100%);
  color: #fff;
  font-family: var(--font-b);
  font-weight: 800;
  font-size: 0.95rem;
  letter-spacing: .8px;
  padding: 15px 50px;
  border: none;
  border-radius: var(--r-sm);
  cursor: pointer;
  text-transform: uppercase;
  transition: transform .15s, box-shadow .2s;
  box-shadow: 0 0 28px rgba(255,71,87,.25);
}
.btn-reveal:hover { transform: translateY(-2px); box-shadow: 0 4px 40px rgba(255,71,87,.4); }

/* ══ DECISION SCREEN ═══════════════════════════════════════ */
#screen-decision { background: var(--bg); }
.decision-wrap {
  flex: 1;
  max-width: 940px;
  margin: 0 auto;
  padding: 40px 28px 60px;
  width: 100%;
}
.decision-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36px;
  flex-wrap: wrap;
  gap: 12px;
}
.decision-hero {
  text-align: center;
  margin-bottom: 44px;
  animation: decisionIn .7s cubic-bezier(.175,.885,.32,1.275) both;
}
@keyframes decisionIn { from{opacity:0;transform:scale(.6) rotate(-5deg)} to{opacity:1;transform:scale(1) rotate(0)} }
.decision-badge {
  display: inline-block;
  font-family: var(--font-d);
  font-size: 2.8rem;
  letter-spacing: 5px;
  padding: 18px 52px;
  border-radius: var(--r-md);
  margin-bottom: 18px;
  position: relative;
  overflow: hidden;
}
.decision-badge::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,.06) 0%, transparent 60%);
}
.decision-badge.invest { background: linear-gradient(135deg,#062010,#0a2e14); border: 1.5px solid rgba(46,213,115,.6); color: var(--emerald); box-shadow: 0 0 60px rgba(46,213,115,.2); }
.decision-badge.reject { background: linear-gradient(135deg,#200608,#2e0a0a); border: 1.5px solid rgba(255,71,87,.6); color: var(--coral); box-shadow: 0 0 60px rgba(255,71,87,.2); }
.decision-badge.acquire { background: linear-gradient(135deg,#201006,#2e1a0a); border: 1.5px solid rgba(245,166,35,.6); color: var(--gold); box-shadow: 0 0 60px rgba(245,166,35,.2); }
.decision-badge.comeback { background: linear-gradient(135deg,#0a0620,#100a2e); border: 1.5px solid rgba(165,94,234,.6); color: var(--purple); box-shadow: 0 0 60px rgba(165,94,234,.2); }
.decision-tagline {
  font-size: 1.05rem;
  color: var(--muted2);
  max-width: 520px;
  margin: 0 auto;
  line-height: 1.6;
  font-style: italic;
}

/* Deal cards row */
.deal-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-bottom: 28px;
}
.deal-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: 22px 20px;
  text-align: center;
  animation: fadeUp .45s ease both;
}
.deal-card:nth-child(2) { animation-delay: .08s; }
.deal-card:nth-child(3) { animation-delay: .16s; }
.deal-card-label {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 10px;
}
.deal-card-value {
  font-family: var(--font-d);
  font-size: 1.9rem;
  letter-spacing: 1px;
  color: var(--gold);
}

/* Reasoning + Verdicts */
.verdicts-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: 28px 30px;
  margin-bottom: 28px;
  animation: fadeUp .45s ease .2s both;
}
.verdict-section-title {
  font-family: var(--font-d);
  font-size: 1.1rem;
  letter-spacing: 3px;
  color: var(--cyan);
  margin-bottom: 6px;
}
.verdict-reasoning {
  font-size: 0.9rem;
  color: var(--muted2);
  line-height: 1.7;
  margin-bottom: 24px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
}
.verdict-item {
  display: flex;
  gap: 16px;
  padding: 14px 0;
  border-bottom: 1px solid var(--border);
  animation: fadeUp .4s ease both;
  align-items: flex-start;
}
.verdict-item:last-child { border-bottom: none; padding-bottom: 0; }
.verdict-av {
  width: 38px; height: 38px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  flex-shrink: 0;
  border: 1px solid var(--border2);
  background: var(--surface2);
}
.verdict-body { flex: 1; }
.verdict-judge-name {
  font-weight: 700;
  font-size: 0.83rem;
  color: var(--gold);
  margin-bottom: 4px;
}
.verdict-comment { font-size: 0.85rem; color: var(--text); line-height: 1.6; }
.verdict-vote {
  flex-shrink: 0;
  font-weight: 700;
  font-size: 0.72rem;
  padding: 5px 13px;
  border-radius: 20px;
  letter-spacing: .5px;
  margin-top: 2px;
}
.verdict-vote.in { background: rgba(46,213,115,.12); color: var(--emerald); border: 1px solid rgba(46,213,115,.3); }
.verdict-vote.out { background: rgba(255,71,87,.12); color: var(--coral); border: 1px solid rgba(255,71,87,.3); }
.verdict-vote.maybe { background: rgba(245,166,35,.12); color: var(--gold); border: 1px solid rgba(245,166,35,.3); }

/* Action row */
.action-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
  animation: fadeUp .4s ease .3s both;
}
.btn-action {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--surface);
  border: 1px solid var(--border2);
  color: var(--text);
  font-family: var(--font-b);
  font-size: 0.82rem;
  font-weight: 600;
  padding: 12px 22px;
  border-radius: var(--r-sm);
  cursor: pointer;
  transition: all .2s;
  letter-spacing: .3px;
}
.btn-action:hover { border-color: var(--cyan-dim); color: var(--cyan); background: rgba(0,212,255,.04); }
.btn-action.gold:hover { border-color: var(--gold-dim); color: var(--gold); background: rgba(245,166,35,.04); }
.btn-action.green:hover { border-color: var(--emerald); color: var(--emerald); background: rgba(46,213,115,.04); }

/* ══ LEADERBOARD SCREEN ════════════════════════════════════ */
#screen-leaderboard { background: var(--bg); }
.lb-wrap {
  flex: 1;
  max-width: 820px;
  margin: 0 auto;
  padding: 40px 28px 60px;
  width: 100%;
}
.lb-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 32px;
  flex-wrap: wrap;
  gap: 12px;
}
.lb-table-wrap {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  overflow: hidden;
}
.lb-row {
  display: grid;
  grid-template-columns: 48px 1fr 80px 100px;
  gap: 16px;
  padding: 14px 22px;
  border-bottom: 1px solid var(--border);
  align-items: center;
  transition: background .2s;
}
.lb-row:last-child { border-bottom: none; }
.lb-row.header {
  background: var(--surface2);
  padding: 10px 22px;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--muted);
}
.lb-row:not(.header):hover { background: rgba(255,255,255,.02); }
.lb-rank {
  font-family: var(--font-d);
  font-size: 1.3rem;
  color: var(--muted);
}
.lb-rank.gold-r { color: var(--gold); }
.lb-rank.silver-r { color: #9ba8c0; }
.lb-rank.bronze-r { color: #c07830; }
.lb-name-cell {}
.lb-startup-name { font-weight: 600; font-size: 0.92rem; color: var(--text); }
.lb-date { font-size: 0.7rem; color: var(--muted); margin-top: 2px; }
.lb-score { font-family: var(--font-d); font-size: 1.3rem; color: var(--cyan); }
.lb-chip { font-size: 0.7rem; font-weight: 700; padding: 4px 11px; border-radius: 20px; text-transform: uppercase; letter-spacing: .5px; }
.lb-chip.invest { background: rgba(46,213,115,.12); color: var(--emerald); border: 1px solid rgba(46,213,115,.25); }
.lb-chip.reject { background: rgba(255,71,87,.12); color: var(--coral); border: 1px solid rgba(255,71,87,.25); }
.lb-chip.acquire { background: rgba(245,166,35,.12); color: var(--gold); border: 1px solid rgba(245,166,35,.25); }
.lb-chip.comeback { background: rgba(165,94,234,.12); color: var(--purple); border: 1px solid rgba(165,94,234,.25); }
.lb-empty { padding: 48px 24px; text-align: center; color: var(--muted2); font-size: 0.92rem; }
.lb-empty strong { display: block; font-size: 2rem; margin-bottom: 8px; }
.lb-actions { margin-top: 28px; display: flex; gap: 14px; justify-content: center; }

/* ══ CONFETTI ══════════════════════════════════════════════ */
#confetti-canvas {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9999;
}

/* ══ TOAST ═════════════════════════════════════════════════ */
.toast {
  position: fixed;
  bottom: 32px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: var(--surface3);
  border: 1px solid var(--border2);
  border-radius: var(--r-md);
  padding: 13px 24px;
  font-size: 0.88rem;
  color: var(--text);
  z-index: 9000;
  opacity: 0;
  transition: all .3s ease;
  white-space: nowrap;
  box-shadow: 0 8px 40px rgba(0,0,0,.6);
  pointer-events: none;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ══ RESPONSIVE ════════════════════════════════════════════ */
@media (max-width: 768px) {
  .hdr { padding: 0 20px; }
  .form-grid { grid-template-columns: 1fr; }
  .form-group.full { grid-column: 1; }
  .judges-panel { grid-template-columns: repeat(2,1fr); }
  .scores-grid { grid-template-columns: 1fr; }
  .deal-row { grid-template-columns: 1fr; }
  .pitch-grid { grid-template-columns: 1fr; }
  .landing-stats { gap: 28px; }
  .decision-badge { font-size: 2rem; padding: 14px 32px; letter-spacing: 3px; }
  .lb-row { grid-template-columns: 36px 1fr 60px 80px; gap: 10px; padding: 12px 16px; }
  .btn-back { padding: 6px 10px; font-size: 0.75rem; }
  .btn-back .back-label { display: none; }
}
@media (max-width: 480px) {
  .hero-sub { font-size: 0.92rem; }
  .deal-row { grid-template-columns: 1fr 1fr; }
  .deal-card:last-child { grid-column: 1/-1; }
  .pitch-wrap, .scoring-wrap, .decision-wrap, .form-wrap, .lb-wrap { padding-left: 16px; padding-right: 16px; }
}

/* ══ UTILITY ════════════════════════════════════════════════ */
.text-cyan { color: var(--cyan); }
.text-gold { color: var(--gold); }
.text-muted { color: var(--muted2); }
.mt-4 { margin-top: 4px; }
.mt-8 { margin-top: 8px; }
.mt-16 { margin-top: 16px; }
</style>
</head>

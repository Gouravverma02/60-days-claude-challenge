function ScoreRing({ score, size=140 }) {
  const r = (size-20)/2;
  const circ = 2*Math.PI*r;
  const dashOffset = circ * (1 - score/100);
  const color = score >= 75 ? 'var(--accent-green)' : score >= 50 ? 'var(--accent-amber)' : 'var(--accent-red)';
  return (
    <div className="score-ring-wrap" style={{width:size,height:size}}>
      <svg width={size} height={size} style={{transform:'rotate(-90deg)'}}>
        <circle cx={size/2} cy={size/2} r={r} fill="none" stroke="var(--border)" strokeWidth={10} />
        <circle cx={size/2} cy={size/2} r={r} fill="none" stroke={color} strokeWidth={10}
          strokeDasharray={circ} strokeDashoffset={dashOffset}
          style={{transition:'stroke-dashoffset 1.5s cubic-bezier(.4,0,.2,1)',strokeLinecap:'round'}} />
      </svg>
      <div className="score-ring-label">
        <div className="score-big" style={{color}}>{score}</div>
        <div className="fs-xs text-muted">/100</div>
      </div>
    </div>
  );
}


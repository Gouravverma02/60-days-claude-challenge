function NegotiationScreen({ onNext }) {
  const [round, setRound] = useState(0);
  const [stats, setStats] = useState({ trust:5, price:50, lead:60 });
  const [choices, setChoices] = useState([]);
  const [selected, setSelected] = useState(null);
  const [locked, setLocked] = useState(false);
  const [showFeedback, setShowFeedback] = useState(false);
  const [score, setScore] = useState(0);

  const current = NEG_ROUNDS[round];
  const maxTrust = 10;

  const handleSelect = (optIdx) => {
    if (locked) return;
    setSelected(optIdx);
  };

  const confirmChoice = () => {
    if (selected === null) return;
    const opt = current.options[selected];
    const newStats = {
      trust: clamp(stats.trust + opt.trust, 0, maxTrust),
      price: clamp(stats.price + opt.price, 0, 100),
      lead: clamp(stats.lead + opt.lead, 0, 100),
    };
    setStats(newStats);
    setChoices([...choices, { round: round+1, choice: opt.text, effect: opt.effect }]);
    setLocked(true);
    setShowFeedback(true);
  };

  const nextRound = () => {
    setShowFeedback(false);
    setLocked(false);
    setSelected(null);
    if (round < 3) {
      setRound(round+1);
    } else {
      const finalScore = Math.round(
        (stats.trust/maxTrust)*40 + (stats.price/100)*30 + (1 - stats.lead/100)*30
      );
      setScore(finalScore);
      onNext({ trust:stats.trust, price:stats.price, lead:stats.lead, score:Math.round(finalScore*100), choices });
    }
  };

  return (
    <div className="app-shell fade-in">
      <StepStrip current={3} total={7} />
      <div className="mb-24">
        <div className="label mb-8">Step 4 of 7 — Supplier Negotiation</div>
        <h1 className="heading-1 mb-8">🤝 Negotiation Room</h1>
        <p className="text-secondary fs-sm">

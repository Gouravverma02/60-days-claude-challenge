          <li>Supply chain resilience is built <em>before</em> the crisis, not during it.</li>
          <li>Supplier relationships are strategic assets — trust is worth more than a 5% price reduction.</li>
          <li>Early, transparent customer communication prevents relationship damage more than discounts.</li>
          <li>AI tools like demand forecasting and risk monitoring can predict crises weeks in advance.</li>
          <li>The best supply chain leaders balance short-term crisis response with long-term structural fixes.</li>
        </ul>
      </div>

      <div style={{display:'flex',gap:12,flexWrap:'wrap'}}>
        <button className="btn btn-primary btn-lg" style={{flex:1}} onClick={onReplay}>
          🔄 Play Again (New Scenario)
        </button>
        <button className="btn btn-ghost" onClick={() => {
          const text = `I scored ${overall}/100 (${grade}: ${gradeLabel}) on Operation Lifeline — Supply Chain Crisis Lab. Crisis: ${crisis.type}. Try it yourself!`;
          if(navigator.clipboard) navigator.clipboard.writeText(text);
          alert('Score copied to clipboard!');
        }}>
          📋 Share Score
        </button>
      </div>
    </div>
  );
}

/* ──────────────────────────── APP ──────────────────────────── */

function App() {
  const [screen, setScreen] = useState('welcome');
  const [company, setCompany] = useState(null);
  const [crisis, setCrisis] = useState(null);
  const [warRoomResults, setWarRoomResults] = useState(null);
  const [negotiationResults, setNegotiationResults] = useState(null);
  const [boardroomResults, setBoardroomResults] = useState(null);
  const [aiResults, setAiResults] = useState(null);

  const startGame = () => {
    const c = generateCompany();
    const cr = generateCrisis(c);
    setCompany(c);
    setCrisis(cr);
    setScreen('company');
  };

  const replay = () => {
    setCompany(null); setCrisis(null);
    setWarRoomResults(null); setNegotiationResults(null);
    setBoardroomResults(null); setAiResults(null);
    startGame();
  };

  if (screen === 'welcome') return <WelcomeScreen onStart={startGame} />;
  if (screen === 'company') return <CompanyScreen company={company} crisis={crisis} onNext={() => setScreen('crisis')} />;
  if (screen === 'crisis') return <CrisisScreen company={company} crisis={crisis} onNext={() => setScreen('warroom')} />;
  if (screen === 'warroom') return <WarRoomScreen actions={ACTIONS} crisis={crisis} onNext={r => { setWarRoomResults(r); setScreen('negotiation'); }} />;
  if (screen === 'negotiation') return <NegotiationScreen onNext={r => { setNegotiationResults(r); setScreen('boardroom'); }} />;
  if (screen === 'boardroom') return <BoardroomScreen onNext={r => { setBoardroomResults(r); setScreen('ai'); }} />;
  if (screen === 'ai') return <AIStrategyScreen onNext={r => { setAiResults(r); setScreen('results'); }} />;
  if (screen === 'results') return (
    <FinalDashboard
      warRoom={warRoomResults}
      negotiation={negotiationResults}
      boardroom={boardroomResults}
      aiStrategy={aiResults}
      company={company}
      crisis={crisis}
      onReplay={replay}
    />
  );
  return null;
}

ReactDOM.createRoot(document.getElementById('root')).render(<App />);
</script>
</body>
</html>

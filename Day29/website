          <div>
            <div className="metric-header mb-4">
              <span className="metric-name">🤝 Trust</span>
              <span className="metric-val text-cyan">{stats.trust}/{maxTrust}</span>
            </div>
            <div className="trust-meter gap-4" style={{display:'flex',gap:5}}>
              {Array.from({length:maxTrust}).map((_,i) => (
                <div key={i} className={`trust-dot ${i < stats.trust?'trust-filled':'trust-empty'}`} />
              ))}
            </div>
          </div>
          <div>
            <ProgressBar value={stats.price} color="amber" label="💰 Price Index" />

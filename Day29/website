function rng(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }
function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
function clamp(v, min=0, max=100) { return Math.max(min, Math.min(max, v)); }

function generateCompany() {
  const industry = pick(INDUSTRIES);
  const name = pick(COMPANY_NAMES);
  const revenue = rng(120, 950);
  const factories = rng(2, 8);
  const warehouses = rng(3, 12);
  const suppliers = rng(40, 220);
  const inventoryDays = rng(14, 60);
  const leadTime = rng(21, 84);
  const numCountries = rng(4, 9);
  const countries = [];
  const allC = [...COUNTRIES];
  for (let i = 0; i < numCountries; i++) {
    const idx = Math.floor(Math.random() * allC.length);
    countries.push(allC.splice(idx, 1)[0]);
  }
  const resilience = rng(30, 75);
  return { name, industry, revenue, factories, warehouses, suppliers,
           inventoryDays, leadTime, countries, resilience };
}

function generateCrisis(company) {
  const crisis = { ...pick(CRISES) };
  const c = pick(company.countries);
  crisis.description = crisis.description.replace('{country}', c);
  crisis.country = c;
  return crisis;
}

function ProgressBar({ value, max=100, color='blue', animate=true, height=8, label=null }) {
  const pct = clamp((value/max)*100);
  const colorMap = { blue:'progress-blue', green:'progress-green', amber:'progress-amber', red:'progress-red', purple:'progress-purple' };
  return (
    <div className="metric-row">
      {label && (
        <div className="metric-header">
          <span className="metric-name">{label}</span>
          <span className="metric-val" style={{color:`var(--accent-${color})`}}>{Math.round(pct)}%</span>
        </div>
      )}
      <div className="progress-track" style={{height}}>
        <div className={`progress-fill ${colorMap[color]||'progress-blue'}`}
          style={{width: animate ? `${pct}%` : '0%', transition: animate ? `width 1.2s cubic-bezier(.4,0,.2,1)` : 'none'}} />
      </div>
    </div>
  );
}

function StepStrip({ current, total }) {
  const labels = ['Company','Crisis','War Room','Negotiate','Boardroom','AI Strategy','Results'];
  return (
    <div className="step-strip">
      {Array.from({length:total}).map((_,i) => (
        <div key={i} className="step-node" style={{flex: i < total-1 ? '1' : '0'}}>
          <div className={`step-dot ${i < current?'done':i===current?'active':''}`}>
            {i < current ? '✓' : i+1}
          </div>
          {i < total-1 && <div className={`step-line ${i < current ? 'done' : ''}`} />}
        </div>
      ))}
    </div>
  );
}


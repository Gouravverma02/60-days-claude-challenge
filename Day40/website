<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bridge — Interview Coaching for Career Changers</title>
<style>
  :root{
    --navy: #1c1733;
    --navy-2: #262043;
    --gold: #e2b768;
    --gold-soft: #f1ddad;
    --paper: #120f1c;
    --paper-2: rgba(255,255,255,0.05);
    --ink: #f4f1ec;
    --ink-soft: #b3aac2;
    --sage: #4fbf9a;
    --rust: #e58a63;
    --rule: rgba(255,255,255,0.12);
    --card: rgba(255,255,255,0.045);
    --card-hover: rgba(255,255,255,0.085);
    --aurora-1: #7c5cff;
    --aurora-2: #21d4b4;
    --aurora-3: #f2b84b;
    --radius: 14px;
    --shadow: 0 20px 55px -18px rgba(10,8,20,0.65);
    --glow: 0 0 0 1px rgba(226,183,104,0.18), 0 12px 40px -12px rgba(124,92,255,0.35);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  html{ background:var(--paper); }
  body{
    background:var(--paper);
    color:var(--ink);
    font-family: Georgia, 'Iowan Old Style', 'Palatino Linotype', serif;
    -webkit-font-smoothing:antialiased;
    position:relative;
    min-height:100vh;
    overflow-x:hidden;
  }

  /* ---------- Aurora motion background (signature element) ---------- */
  .aurora{
    position:fixed; inset:-10%; z-index:0; pointer-events:none;
    filter: blur(70px) saturate(130%);
    opacity:0.55;
  }
  .aurora span{
    position:absolute; border-radius:50%;
    will-change: transform;
  }
  .aurora span:nth-child(1){
    width:46vw; height:46vw; left:-8%; top:-6%;
    background: var(--aurora-1);
    animation: drift1 26s ease-in-out infinite;
  }
  .aurora span:nth-child(2){
    width:38vw; height:38vw; right:-10%; top:8%;
    background: var(--aurora-2);
    animation: drift2 32s ease-in-out infinite;
  }
  .aurora span:nth-child(3){
    width:42vw; height:42vw; left:22%; bottom:-16%;
    background: var(--aurora-3);
    animation: drift3 30s ease-in-out infinite;
  }
  @keyframes drift1{
    0%,100%{ transform: translate(0,0) scale(1); }
    50%{ transform: translate(6vw,8vh) scale(1.12); }
  }
  @keyframes drift2{
    0%,100%{ transform: translate(0,0) scale(1); }
    50%{ transform: translate(-7vw,6vh) scale(0.92); }
  }
  @keyframes drift3{
    0%,100%{ transform: translate(0,0) scale(1); }
    50%{ transform: translate(5vw,-7vh) scale(1.08); }
  }
  .grain-veil{
    position:fixed; inset:0; z-index:1; pointer-events:none;
    background: radial-gradient(ellipse at 50% 0%, rgba(18,15,28,0) 0%, rgba(18,15,28,0.75) 70%);
  }
  .app{ position:relative; z-index:2; }
  .sans{ font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; }
  .mono{ font-family: 'Courier New', Courier, monospace; letter-spacing:0.02em; }

  a{color:var(--gold);}

  /* ---------- Shell ---------- */
  .app{
    max-width:1180px;
    margin:0 auto;
    padding: 28px 24px 80px;
  }
  header.top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding-bottom:22px;
    border-bottom:1px solid var(--rule);
    margin-bottom:28px;
    animation: fadeDown .6s ease both;
  }
  @keyframes fadeDown{ from{ opacity:0; transform:translateY(-10px);} to{ opacity:1; transform:none; } }
  .brand{
    display:flex;
    align-items:center;
    gap:12px;
  }
  .brand-mark{
    width:34px;height:34px;
    border-radius:50%;
    background: conic-gradient(from 200deg, var(--gold), var(--aurora-1) 40%, var(--aurora-2) 70%, var(--gold));
    display:flex;align-items:center;justify-content:center;
    box-shadow: var(--glow);
    animation: spin-slow 8s linear infinite;
  }
  @keyframes spin-slow{ to{ transform:rotate(360deg); } }
  .brand-mark span{
    width:14px;height:14px;background:var(--paper);border-radius:50%;
  }
  .brand h1{
    font-size:1.35rem;
    margin:0;
    letter-spacing:0.01em;
    font-weight:600;
    background: linear-gradient(100deg, var(--ink) 30%, var(--gold) 50%, var(--ink) 70%);
    background-size:220% auto;
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    animation: shine 6s ease-in-out infinite;
  }
  @keyframes shine{ 0%{ background-position:0% center;} 50%{ background-position:100% center;} 100%{ background-position:0% center;} }
  .brand p{
    margin:2px 0 0;
    font-size:0.78rem;
    color:var(--ink-soft);
    font-family: inherit;
  }
  .stage-pill{
    font-family: inherit;
    font-size:0.72rem;
    text-transform:uppercase;
    letter-spacing:0.08em;
    color:#1c1424;
    background: linear-gradient(120deg, var(--gold-soft), var(--gold));
    padding:6px 14px;
    border-radius:100px;
    font-weight:600;
    transition: all .3s ease;
  }

  #screen-setup, #screen-interview, #screen-report{
    animation: screenIn .55s cubic-bezier(.2,.8,.2,1) both;
  }
  @keyframes screenIn{
    from{ opacity:0; transform: translateY(14px) scale(0.99); }
    to{ opacity:1; transform:none; }
  }
  .setup-wrap{
    display:grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap:36px;
    align-items:start;
  }
  @media (max-width: 900px){ .setup-wrap{ grid-template-columns: 1fr; } }

  .panel{
    background:var(--card);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    border:1px solid var(--rule);
    border-radius: var(--radius);
    padding: 28px;
    box-shadow: var(--shadow);
  }
  .eyebrow{
    font-family: inherit;
    text-transform:uppercase;
    font-size:0.7rem;
    letter-spacing:0.14em;
    color:var(--gold);
    margin:0 0 8px;
  }
  h2.title{
    font-size:1.7rem;
    margin:0 0 10px;
    line-height:1.25;
  }
  .lede{
    color:var(--ink-soft);
    font-size:0.98rem;
    line-height:1.6;
    margin:0 0 26px;
  }

  label.field-label{
    display:block;
    font-family: inherit;
    font-size:0.78rem;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color:var(--ink-soft);
    margin-bottom:6px;
    margin-top:20px;
  }
  label.field-label:first-of-type{ margin-top:0; }
  input[type=text], textarea, select{
    width:100%;
    font-family: inherit;
    font-size:0.95rem;
    padding:11px 13px;
    border:1px solid var(--rule);
    border-radius:6px;
    background:var(--paper);
    color:var(--ink);
    resize:vertical;
  }
  input[type=text]:focus, textarea:focus, select:focus{
    outline:2px solid var(--gold);
    outline-offset:1px;
    background: rgba(255,255,255,0.07);
  }
  textarea{ min-height:110px; line-height:1.5; }
  .row2{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  @media (max-width:560px){ .row2{ grid-template-columns:1fr; } }

  .upload-zone{
    margin-top:8px;
    border:1.5px dashed var(--rule);
    border-radius:8px;
    padding:16px;
    text-align:center;
    font-family: inherit;
    font-size:0.85rem;
    color:var(--ink-soft);
    cursor:pointer;
    transition: border-color .15s, background .15s;
  }
  .upload-zone:hover{ border-color:var(--gold); background:var(--card-hover); }
  .upload-zone.has-file{ border-color:var(--sage); color:var(--sage); border-style:solid; }
  .upload-zone input{ display:none; }

  button.primary{
    font-family: inherit;
    position:relative;
    overflow:hidden;
    background: linear-gradient(135deg, var(--gold) 0%, #c9954f 100%);
    color:#1c1424;
    border:none;
    padding:14px 26px;
    border-radius:8px;
    font-size:0.95rem;
    font-weight:700;
    letter-spacing:0.01em;
    cursor:pointer;
    box-shadow: 0 10px 30px -10px rgba(226,183,104,0.55);
    transition: transform .15s ease, box-shadow .15s ease;
    margin-top:26px;
  }
  button.primary::before{
    content:'';
    position:absolute; top:0; left:-60%; width:40%; height:100%;
    background: linear-gradient(115deg, transparent, rgba(255,255,255,0.55), transparent);
    transform: skewX(-18deg);
    transition: left .6s ease;
  }
  button.primary:hover::before{ left:130%; }
  button.primary:hover{ transform: translateY(-2px); box-shadow: 0 16px 38px -10px rgba(226,183,104,0.7); }
  button.primary:active{ transform: translateY(0); }
  button.primary:disabled{ background:#4a465a; color:#9791a8; box-shadow:none; cursor:not-allowed; transform:none; }
  button.primary:disabled::before{ display:none; }

  button.ghost{
    font-family: inherit;
    background:var(--card);
    backdrop-filter: blur(10px);
    color:var(--ink);
    border:1px solid var(--rule);
    padding:10px 18px;
    border-radius:8px;
    font-size:0.85rem;
    cursor:pointer;
    transition: border-color .15s, background .15s, transform .15s;
  }
  button.ghost:hover{ border-color:var(--gold); background:var(--card-hover); transform: translateY(-1px); }

  /* ---------- Bridge signature visual ---------- */
  .bridge-card{
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-2) 100%);
    color:#f2efe8;
    border-radius: var(--radius);
    padding:26px 24px;
    box-shadow: var(--shadow);
  }
  .bridge-card h3{
    font-family: inherit;
    font-size:0.72rem;
    text-transform:uppercase;
    letter-spacing:0.14em;
    color:var(--gold-soft);
    margin:0 0 18px;
  }
  .bridge-svg-wrap{ width:100%; }
  .bridge-thread{
    margin-top:14px;
    font-size:0.92rem;
    line-height:1.55;
    color:#e7e2d5;
    font-style:italic;
    border-left:2px solid var(--gold);
    padding-left:14px;
  }
  .bridge-node-label{ font-family: -apple-system, sans-serif; font-size:11px; fill:#cfd6e4; }
  .bridge-node-title{ font-family: Georgia, serif; font-size:13px; fill:#fdfaf3; font-weight:bold; }

  /* ---------- Interview screen ---------- */
  .interview-wrap{
    display:grid;
    grid-template-columns: 320px 1fr;
    gap:28px;
    align-items:start;
  }
  @media (max-width:900px){ .interview-wrap{ grid-template-columns:1fr; } }

  .side-sticky{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }

  .progress-card{
    background:var(--card); backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px); border:1px solid var(--rule); border-radius:var(--radius); padding:20px;
  }
  .progress-card h4{
    font-family: inherit; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.1em;
    color:var(--ink-soft); margin:0 0 14px;
  }
  .progress-dots{ display:flex; gap:8px; }
  .dot{ width:26px; height:26px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-family: inherit; font-size:0.72rem; border:1.5px solid var(--rule); color:var(--ink-soft); }
  .dot.done{ background:var(--sage); border-color:var(--sage); color:#fff; }
  .dot.current{ border-color:var(--gold); color:var(--gold); font-weight:bold; }

  .transcript{
    display:flex; flex-direction:column; gap:18px;
  }
  .msg-block{
    background:var(--card); backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px); border:1px solid var(--rule); border-radius:var(--radius);
    padding:22px 24px; box-shadow: var(--shadow);
    animation: rise .35s ease both;
  }
  @keyframes rise{ from{ opacity:0; transform:translateY(8px);} to{opacity:1; transform:none;} }

  .q-tag{
    font-family: inherit; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em;
    color:var(--gold); margin:0 0 8px;
  }
  .q-text{ font-size:1.12rem; line-height:1.5; margin:0; }

  .feedback-row{
    display:flex; gap:18px; margin-top:16px; padding-top:16px; border-top:1px solid var(--rule);
  }
  .dial{ flex:none; }
  .feedback-copy{ flex:1; font-family: -apple-system, sans-serif; font-size:0.9rem; line-height:1.55; }
  .feedback-copy .label{ font-weight:700; color:var(--gold); display:block; margin-bottom:2px; font-size:0.78rem; text-transform:uppercase; letter-spacing:0.05em;}
  .feedback-copy .strength{ color:var(--sage); }
  .feedback-copy .improve{ color:var(--rust); }
  .feedback-copy p{ margin:0 0 10px; }

  .answer-box{ margin-top:16px; }
  textarea.answer-input{ min-height:100px; }
  .answer-actions{ display:flex; justify-content:flex-end; gap:10px; margin-top:10px; }

  .your-answer{
    background:var(--paper-2);
    border-radius:8px;
    padding:14px 16px;
    margin-top:14px;
    font-family: -apple-system, sans-serif;
    font-size:0.9rem;
    color:var(--ink);
    line-height:1.5;
    white-space:pre-wrap;
  }
  .your-answer .who{ font-size:0.7rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--ink-soft); display:block; margin-bottom:6px; font-family:inherit;}

  .loading-row{ display:flex; align-items:center; gap:10px; color:var(--ink-soft); font-family:-apple-system,sans-serif; font-size:0.88rem; padding:6px 2px;}
  .spinner{
    width:18px; height:18px; border-radius:50%;
    background: conic-gradient(var(--gold), transparent 65%);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 3px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 3px));
    animation:spin .8s linear infinite;
  }
  @keyframes spin{ to{ transform:rotate(360deg);} }

  .finish-bar{
    display:flex; justify-content:space-between; align-items:center;
    background:var(--gold-soft); border-radius:var(--radius); padding:16px 22px; margin-top:6px;
    font-family:-apple-system, sans-serif;
  }
  .finish-bar span{ font-size:0.88rem; color:var(--navy); }

  .error-box{
    background:#fdecea; border:1px solid #e5b9b0; color:#8a3324; border-radius:8px; padding:14px 16px;
    font-family:-apple-system, sans-serif; font-size:0.88rem;
  }

  /* ---------- Report screen ---------- */
  .report-wrap{ display:flex; flex-direction:column; gap:26px; }
  .report-hero{
    display:grid; grid-template-columns: 220px 1fr; gap:30px; align-items:center;
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%);
    color:#f2efe8; border-radius:var(--radius); padding:32px; box-shadow:var(--shadow);
  }
  @media (max-width:700px){ .report-hero{ grid-template-columns:1fr; text-align:center; } }
  .report-hero h2{ font-size:1.6rem; margin:0 0 10px; color:#fff; }
  .report-hero p{ margin:0; color:#d8dce6; font-family:-apple-system,sans-serif; font-size:0.95rem; line-height:1.6; }

  .grid-2{ display:grid; grid-template-columns:1fr 1fr; gap:20px; }
  @media (max-width:700px){ .grid-2{ grid-template-columns:1fr; } }
  .report-card{ background:var(--card); backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px); border:1px solid var(--rule); border-radius:var(--radius); padding:22px; }
  .report-card h4{ margin:0 0 12px; font-family:inherit; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--ink-soft); }
  .report-card ul{ margin:0; padding-left:18px; font-family:-apple-system,sans-serif; font-size:0.9rem; line-height:1.65; color:var(--ink); }
  .report-card.strengths h4{ color:var(--sage); }
  .report-card.gaps h4{ color:var(--rust); }

  table.breakdown{ width:100%; border-collapse:collapse; font-family:-apple-system,sans-serif; font-size:0.87rem; }
  table.breakdown th, table.breakdown td{ text-align:left; padding:10px 8px; border-bottom:1px solid var(--rule); vertical-align:top; }
  table.breakdown th{ font-size:0.7rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--ink-soft); }

  .narrative-box{
    background:var(--paper-2); border-radius:8px; padding:18px 20px; font-style:italic; line-height:1.6;
    border-left:3px solid var(--gold);
  }

  .cta-row{ display:flex; gap:12px; justify-content:center; }

  /* ---------- Docs panel ---------- */
  .docs-toggle{
    margin-top:50px; border-top:1px solid var(--rule); padding-top:22px;
  }
  .docs-toggle > summary{
    cursor:pointer; list-style:none; font-family:-apple-system, sans-serif;
    font-size:0.85rem; font-weight:600; color:var(--ink);
    display:flex; align-items:center; gap:8px;
  }
  .docs-toggle > summary::-webkit-details-marker{ display:none; }
  .docs-toggle > summary:before{ content:'▸'; color:var(--gold); transition:transform .15s; }
  .docs-toggle[open] > summary:before{ transform:rotate(90deg); }
  .docs-body{
    font-family:-apple-system, sans-serif; font-size:0.88rem; line-height:1.7; color:var(--ink-soft);
    margin-top:18px; display:flex; flex-direction:column; gap:16px;
  }
  .docs-body h5{ margin:0 0 4px; color:var(--ink); font-size:0.85rem; }
  .docs-body code{ background:var(--paper-2); padding:1px 6px; border-radius:4px; font-family:'Courier New',monospace; font-size:0.85em; }

  .visually-hidden{ position:absolute; width:1px;height:1px; overflow:hidden; clip:rect(0 0 0 0); }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.001ms !important; transition-duration:0.001ms !important; }
  }

  /* ---------- Fresher toggle & skills ---------- */
  .toggle-row{
    display:flex; align-items:center; gap:12px; margin-top:20px;
    background:var(--paper-2); border-radius:8px; padding:12px 14px;
  }
  .switch{ position:relative; width:42px; height:24px; flex:none; }
  .switch input{ opacity:0; width:0; height:0; position:absolute; }
  .switch-track{
    position:absolute; inset:0; background:#c9c2b0; border-radius:100px; cursor:pointer; transition:background .15s;
  }
  .switch-track:before{
    content:''; position:absolute; width:18px; height:18px; left:3px; top:3px; background:#fff; border-radius:50%; transition:transform .15s;
  }
  .switch input:checked + .switch-track{ background:var(--sage); }
  .switch input:checked + .switch-track:before{ transform:translateX(18px); }
  .toggle-row label{ font-family:inherit; font-size:0.86rem; color:var(--ink); cursor:pointer; margin:0; }
  .toggle-row .sub{ display:block; font-size:0.76rem; color:var(--ink-soft); margin-top:1px; }

  .skills-input-row{ display:flex; gap:8px; }
  .skills-input-row input{ flex:1; }
  .skills-input-row button{
    font-family:inherit; background:var(--navy); color:#fff; border:none; border-radius:6px; padding:0 16px; cursor:pointer; font-size:0.85rem;
  }
  .skills-tags{ display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }
  .skill-tag{
    background:var(--gold-soft); color:var(--navy); font-family:inherit; font-size:0.8rem;
    padding:5px 10px 5px 12px; border-radius:100px; display:flex; align-items:center; gap:6px;
  }
  .skill-tag button{
    background:none; border:none; color:var(--navy); cursor:pointer; font-size:0.85rem; line-height:1; opacity:0.6; padding:0;
  }
  .skill-tag button:hover{ opacity:1; }

  /* ---------- Interview stage: AI interviewer + webcam ---------- */
  .stage-row{
    display:grid; grid-template-columns: 1fr 1fr; gap:20px; margin-bottom:26px;
  }
  @media (max-width:700px){ .stage-row{ grid-template-columns:1fr; } }

  .stage-card{
    background: linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 100%);
    border-radius: var(--radius); overflow:hidden; box-shadow:var(--shadow);
    border:1px solid var(--rule);
    position:relative; aspect-ratio: 4/3;
    display:flex; flex-direction:column;
    transition: box-shadow .3s ease;
  }
  .stage-card .stage-label{
    position:absolute; top:12px; left:14px; z-index:2;
    font-family:-apple-system,sans-serif; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em;
    color:#fff; background:rgba(0,0,0,0.35); backdrop-filter:blur(6px); padding:4px 10px; border-radius:100px;
    display:flex; align-items:center; gap:6px;
  }
  .live-dot{ width:7px; height:7px; border-radius:50%; background:#e2554b; box-shadow:0 0 8px #e2554b; animation:pulse-dot 1.4s infinite; }
  @keyframes pulse-dot{ 0%,100%{opacity:1;} 50%{opacity:0.35;} }

  .avatar-stage{
    flex:1; display:flex; align-items:center; justify-content:center;
    background: radial-gradient(circle at 50% 30%, #322a56 0%, #1c1733 75%);
    position:relative;
  }
  .avatar-stage::before{
    content:''; position:absolute; width:64%; max-width:220px; aspect-ratio:1;
    border-radius:50%; border:2px solid var(--gold); opacity:0; transform:scale(0.85);
    transition: opacity .3s ease;
  }
  .avatar-stage[data-state="speaking"]::before{
    opacity:0.55; animation: ringPulse 1.1s ease-out infinite;
  }
  @keyframes ringPulse{
    0%{ transform:scale(0.82); opacity:0.6; }
    100%{ transform:scale(1.15); opacity:0; }
  }
  .avatar-caption{
    position:absolute; bottom:0; left:0; right:0; z-index:2;
    background:linear-gradient(to top, rgba(0,0,0,0.6), transparent);
    color:#f2efe8; font-family:-apple-system,sans-serif; font-size:0.82rem; padding:22px 14px 12px; text-align:center;
    min-height:20px;
  }

  .cam-stage{

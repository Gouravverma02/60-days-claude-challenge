function DecisionScreen({step,decision,metrics,onChoose,choice}){
  const [selected,setSelected]=useState(choice||null);
  const [locked,setLocked]=useState(!!choice);
  const [preview,setPreview]=useState(null);
  const [showEffect,setShowEffect]=useState(false);

  const confirm=()=>{
    if(!selected)return;
    setLocked(true);
    setShowEffect(true);
  };

  const proceed=()=>{
    const opt=decision.options.find(o=>o.id===selected);
    onChoose(decision.key,opt);
  };

  const previewMetrics=(opt)=>{
    if(locked)return;
    const p={};
    Object.keys(metrics).forEach(k=>{
      p[k]=clamp(metrics[k]+(opt.metrics[k]||0));
    });
    setPreview(p);
  };

  const activeMetrics=preview||(locked&&selected?{...metrics}:metrics);
  // compute post-choice metrics for display after lock
  const postMetrics=locked&&selected?
    Object.fromEntries(Object.keys(metrics).map(k=>[k,clamp(metrics[k]+(decision.options.find(o=>o.id===selected)?.metrics[k]||0))]))
    :metrics;

  const displayMetrics=locked?postMetrics:(preview||metrics);

  return(
    <div className="shell fade">
      <StepStrip current={step} total={7}/>
      <div style={{display:'grid',gridTemplateColumns:'1fr 260px',gap:20,alignItems:'start'}}>
        <div>
          <div className="t-label mb8">Step {step} of 6 — {decision.title}</div>
          <h1 className="t-h1 mb16">{decision.emoji} {decision.title}</h1>

          <div className="note note-blue mb16">
            <strong>📖 What is this?</strong><br/>{decision.concept}
          </div>
          <div className="note note-amber mb20">
            <strong>💡 Why does it matter?</strong><br/>{decision.why}
          </div>

          {!locked&&(
            <p className="t-small c-2 mb12">Hover over an option to preview how it affects your metrics. Click to select, then confirm.</p>
          )}

          <div style={{display:'flex',flexDirection:'column',gap:10,marginBottom:16}}>
            {decision.options.map(opt=>(
              <div key={opt.id}
                className={`opt${selected===opt.id?' sel':''}`}
                onClick={()=>{if(!locked){setSelected(opt.id);setPreview(null);}}}
                onMouseEnter={()=>previewMetrics(opt)}
                onMouseLeave={()=>setPreview(null)}>
                {selected===opt.id&&<div className="tick">✓</div>}
                <div className="flex aic g10 mb8">
                  <span style={{fontSize:'1.5rem'}}>{opt.emoji}</span>
                  <strong className="t-h3">{opt.label}</strong>
                </div>
                <p className="t-small c-2 mb8" style={{lineHeight:1.6}}>{opt.desc}</p>
                <div className="note note-purple" style={{padding:'8px 12px'}}>
                  <span className="t-xs"><strong>Trade-off:</strong> {opt.tradeoffs}</span>
                </div>
              </div>
            ))}
          </div>

          {showEffect&&selected&&(
            <div className="note note-green mb16 fade">
              <strong>✅ Great choice!</strong> Here's what {decision.options.find(o=>o.id===selected)?.label} does to your business:
              <div className="flex fwrap g6 mt8">
                {Object.entries(decision.options.find(o=>o.id===selected)?.metrics||{}).map(([k,v])=>(
                  <span key={k} className={`badge ${v>0?'b-green':'b-red'}`}>
                    {k==='cost'?'💰 Cost':k==='speed'?'⚡ Speed':k==='risk'?'🛡️ Risk':k==='satisfaction'?'😊 Satisfaction':'🌿 Sustainability'} {v>0?'+':''}{v}
                  </span>
                ))}
              </div>
            </div>
          )}

          {!locked?(
            <button className="btn btn-primary btn-full" disabled={!selected} onClick={confirm}>
              Confirm Choice
            </button>
          ):(
            <button className="btn btn-secondary btn-full" onClick={proceed}>
              Continue to Next Decision →
            </button>
          )}
        </div>

        <div style={{minWidth:0}}>
          <LiveMetrics metrics={displayMetrics} animate={locked||!!preview}/>
          {preview&&!locked&&(
            <div className="note note-blue mt8" style={{fontSize:'.72rem',lineHeight:1.5}}>
              Preview: metrics if you pick this option.
            </div>
          )}
        </div>
      </div>
      <style>{`@media(max-width:680px){.shell>div{grid-template-columns:1fr!important}}`}</style>
    </div>
  );
}

function ResultsScreen({company,choices,finalMetrics,onReplay}){
  const [anim,setAnim]=useState(false);
  useEffect(()=>{setTimeout(()=>setAnim(true),300);},[]);

  const overall=Math.round(
    (finalMetrics.cost*0.2+finalMetrics.speed*0.2+finalMetrics.risk*0.25+
     finalMetrics.satisfaction*0.25+finalMetrics.sustainability*0.1)
  );
  const grade=overall>=80?'A':overall>=65?'B':overall>=50?'C':overall>=35?'D':'F';
  const gradeLabel={A:'Excellent Supply Chain',B:'Solid Design',C:'Adequate — Room to Grow',D:'Needs Rethinking',F:'Critical Weaknesses'}[grade];

  const metItems=[
    {icon:'💰',label:'Cost Health',key:'cost',color:'green'},
    {icon:'⚡',label:'Delivery Speed',key:'speed',color:'blue'},
    {icon:'🛡️',label:'Risk Score',key:'risk',color:'purple'},
    {icon:'😊',label:'Customer Satisfaction',key:'satisfaction',color:'cyan'},
    {icon:'🌿',label:'Sustainability',key:'sustainability',color:'teal'},
  ];

  const strengths=metItems.filter(m=>finalMetrics[m.key]>=65).map(m=>m.label);
  const weaknesses=metItems.filter(m=>finalMetrics[m.key]<45).map(m=>m.label);
  const biggestRisk=metItems.reduce((a,b)=>finalMetrics[a.key]<finalMetrics[b.key]?a:b);

  const improvements=[
    weaknesses.includes('Delivery Speed')?
      'Consider regional warehouses to cut last-mile delivery time significantly.':null,
    weaknesses.includes('Risk Score')?
      'Switch to dual or multi-supplier sourcing to reduce single-point-of-failure exposure.':null,
    weaknesses.includes('Customer Satisfaction')?
      'Invest in a customer-facing order tracking system — visibility drives satisfaction.':null,
    weaknesses.includes('Cost Health')?
      'Renegotiate freight contracts and consider intermodal (rail+road) to reduce transport spend.':null,
    weaknesses.includes('Sustainability')?
      'Move to sea freight for bulk shipments and set up green-certified warehouse operations.':null,
    strengths.length>=3?
      'Your supply chain is well-balanced. Focus on adding digital visibility tools (AI demand forecasting) for the next level.':null,
    'Run quarterly supply chain risk reviews — the biggest disruptions come from risks that were visible but ignored.',
  ].filter(Boolean).slice(0,3);

  const choiceSummary=choices.map(c=>{
    const dec=DECISIONS.find(d=>d.key===c.key);
    return{decision:dec?.title,choice:c.option.label,emoji:c.option.emoji};
  });

  return(
    <div className="shell fade">
      <StepStrip current={6} total={7}/>
      <div className="mb24">
        <div className="t-label mb8">Final Results</div>
        <h1 className="t-h1 mb8">📊 Your Supply Chain Report</h1>
        <p className="c-2 t-small">{company.name} • {company.industry.name} • {company.product}</p>
      </div>

      {/* Score hero */}
      <div className="card glow-blue mb24 tc" style={{padding:'32px 20px'}}>
        <div className="t-label mb16">Overall Supply Chain Score</div>
        <div className="flex jcc mb16">
          {anim&&<ScoreRing score={overall} size={160}/>}
        </div>
        <div style={{fontSize:'1.5rem',fontWeight:800,marginBottom:6}}>
          Grade: <span style={{color:overall>=80?'var(--green)':overall>=65?'var(--cyan)':overall>=50?'var(--amber)':'var(--red)'}}>
            {grade} — {gradeLabel}
          </span>
        </div>
        <div className="c-2 t-small">{company.name} • {company.demand} demand market</div>
      </div>

      {/* Breakdown */}
      <div className="card mb20">
        <div className="t-h2 mb16">Metric Breakdown</div>
        <div style={{display:'flex',flexDirection:'column',gap:14}}>
          {metItems.map(m=>(
            <div key={m.key}>
              <MetricRow icon={m.icon} label={m.label} value={finalMetrics[m.key]} color={m.color} animate={anim}/>
              <div className="t-xs c-3 mt4">
                {finalMetrics[m.key]>=70?'✅ Strong':finalMetrics[m.key]>=50?'⚠️ Adequate':'❌ Needs attention'}
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Strengths & Weaknesses */}
      <div className="g2 mb20">
        <div className="card">
          <div className="t-h3 mb12 c-green">🌟 Strengths</div>
          {strengths.length>0
            ?strengths.map(s=><div key={s} className="note note-green mb8 t-small">✅ {s}</div>)
            :<p className="t-small c-2">No standout strengths yet — aim for 65+ in each metric.</p>}
        </div>
        <div className="card">
          <div className="t-h3 mb12 c-red">⚠️ Weaknesses</div>
          {weaknesses.length>0
            ?weaknesses.map(s=><div key={s} className="note note-red mb8 t-small">❌ {s}</div>)
            :<div className="note note-green t-small">✅ No critical weaknesses!</div>}
        </div>
      </div>

      {/* Biggest risk */}
      <div className="card glow-amber mb20">
        <div className="t-h3 mb8">🔥 Biggest Risk Right Now</div>
        <p className="t-small" style={{lineHeight:1.7}}>
          Your weakest metric is <strong>{biggestRisk.icon} {biggestRisk.label}</strong> at{' '}
          <strong>{Math.round(finalMetrics[biggestRisk.key])}/100</strong>.{' '}
          {biggestRisk.key==='risk'
            ?"Your supply chain is heavily dependent on single points of failure. One disruption (supplier bankruptcy, port strike, or natural disaster) could halt operations."
            :biggestRisk.key==='cost'
            ?"Your cost structure is under pressure. Tight margins mean any unforeseen expense (tariffs, fuel spike) could eliminate profitability."
            :biggestRisk.key==='speed'
            ?"Slow delivery is your biggest competitive vulnerability. In today's market, customers switch brands after one bad delivery experience."
            :biggestRisk.key==='satisfaction'
            ?"Low customer satisfaction is a leading indicator of churn. This is often a symptom of late deliveries, stockouts, or poor communication."
            :"High carbon footprint is increasingly a business risk — regulation, customer pressure, and ESG investor requirements are all tightening."}

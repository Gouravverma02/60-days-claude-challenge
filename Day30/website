      {/* Choices recap */}
      <div className="card mb24">
        <div className="t-h2 mb12">🗂️ Your Decisions</div>
        <div className="ga">
          {choiceSummary.map((c,i)=>(
            <div key={i} className="stat">
              <div className="stat-lbl">{c.decision}</div>
              <div style={{fontSize:'1.5rem',margin:'4px 0'}}>{c.emoji}</div>
              <div className="t-h3">{c.choice}</div>
            </div>
          ))}
        </div>
      </div>

      {/* Key lesson */}
      <div className="note note-teal mb24">
        <strong>🎓 The Core Lesson:</strong><br/>
        Every supply chain decision involves trade-offs. There is no perfect supply chain — only the right trade-offs for your specific business, market, and risk tolerance.
        The best supply chain leaders think in systems: changing one part always affects the others.
      </div>

      <div className="flex g12 fwrap">
        <button className="btn btn-primary btn-lg" style={{flex:1}} onClick={onReplay}>
          🔄 Play Again (New Company)
        </button>
        <button className="btn btn-ghost" onClick={()=>{
          try{navigator.clipboard.writeText(`I scored ${overall}/100 (${grade}: ${gradeLabel}) on Supply Chain Builder!`);alert('Score copied!');}catch(e){}
        }}>📋 Share Score</button>
      </div>
    </div>
  );
}

/* ─────────────── APP ROOT ─────────────── */
const BASE_METRICS={cost:50,speed:50,risk:50,satisfaction:50,sustainability:50};

function App(){
  const [screen,setScreen]=useState('welcome');
  const [company,setCompany]=useState(null);
  const [decisionIdx,setDecisionIdx]=useState(0);
  const [metrics,setMetrics]=useState({...BASE_METRICS});
  const [choices,setChoices]=useState([]);

  const start=()=>{
    const c=genCompany();
    setCompany(c);
    setDecisionIdx(0);
    setMetrics({...BASE_METRICS});
    setChoices([]);
    setScreen('company');
  };

  const handleChoice=(key,opt)=>{
    const newM={};
    Object.keys(metrics).forEach(k=>{
      newM[k]=clamp(metrics[k]+(opt.metrics[k]||0));
    });
    setMetrics(newM);
    setChoices(prev=>[...prev.filter(c=>c.key!==key),{key,option:opt}]);
    if(decisionIdx<DECISIONS.length-1){
      setDecisionIdx(decisionIdx+1);
      setScreen('decision_'+(decisionIdx+1));
    } else {
      setScreen('results');
    }
  };

  const replay=()=>{
    setScreen('welcome');
    setCompany(null);
    setDecisionIdx(0);
    setMetrics({...BASE_METRICS});
    setChoices([]);
  };

  if(screen==='welcome') return <WelcomeScreen onStart={start}/>;
  if(screen==='company') return <CompanyScreen company={company} onNext={()=>setScreen('decision_0')}/>;
  if(screen.startsWith('decision_')){
    const idx=parseInt(screen.split('_')[1]);
    const dec=DECISIONS[idx];
    const existing=choices.find(c=>c.key===dec.key);
    return(
      <DecisionScreen
        step={idx+1}
        decision={dec}
        metrics={metrics}
        onChoose={handleChoice}
        choice={existing?.option.id||null}
        key={idx}
      />
    );
  }
  if(screen==='results') return <ResultsScreen company={company} choices={choices} finalMetrics={metrics} onReplay={replay}/>;
  return null;
}

ReactDOM.createRoot(document.getElementById('root')).render(<App/>);
</script>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Supply Chain Builder</title>
<script src="https://unpkg.com/react@18/umd/react.development.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#07090f;
  --bg-card:#0d1120;
  --bg-card2:#111827;
  --bg-lift:#18243a;
  --border:#1e2d44;
  --border-hi:#283f5e;
  --text:#deeaf8;
  --text2:#7fa3c4;
  --text3:#3d5a78;
  --blue:#3b82f6;
  --cyan:#06b6d4;
  --green:#10b981;
  --amber:#f59e0b;
  --red:#ef4444;
  --purple:#8b5cf6;
  --orange:#f97316;
  --teal:#14b8a6;
  --r:12px;
  --r2:18px;
  --t:.25s cubic-bezier(.4,0,.2,1);
}
html{font-size:16px}
body{font-family:'Segoe UI',system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;-webkit-font-smoothing:antialiased;line-height:1.6}
#root{min-height:100vh}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--border-hi);border-radius:3px}

/* ── Shell ── */
.shell{max-width:900px;margin:0 auto;padding:24px 16px 80px}

/* ── Type scale ── */
.t-display{font-size:clamp(1.9rem,5vw,3rem);font-weight:900;letter-spacing:-.03em;line-height:1.1}
.t-h1{font-size:clamp(1.4rem,3vw,1.9rem);font-weight:800;letter-spacing:-.025em}
.t-h2{font-size:1.15rem;font-weight:700}
.t-h3{font-size:.95rem;font-weight:600}
.t-label{font-size:.68rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text3)}
.t-small{font-size:.82rem}
.t-xs{font-size:.74rem}
.mono{font-family:'JetBrains Mono','Fira Code','Courier New',monospace}

/* ── Cards ── */
.card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--r2);padding:20px;transition:border-color var(--t)}
.card:hover{border-color:var(--border-hi)}
.card-lift{background:var(--bg-lift);border:1px solid var(--border-hi);border-radius:var(--r2);padding:20px}
.glow-blue{box-shadow:0 0 0 1px var(--blue),0 6px 28px rgba(59,130,246,.18)}
.glow-green{box-shadow:0 0 0 1px var(--green),0 6px 24px rgba(16,185,129,.15)}
.glow-amber{box-shadow:0 0 0 1px var(--amber),0 6px 24px rgba(245,158,11,.15)}
.glow-red{box-shadow:0 0 0 1px var(--red),0 6px 24px rgba(239,68,68,.15)}

/* ── Buttons ── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:11px 22px;border:none;border-radius:var(--r);cursor:pointer;font-family:inherit;font-size:.88rem;font-weight:600;letter-spacing:.01em;transition:all var(--t);user-select:none;white-space:nowrap}
.btn-primary{background:linear-gradient(135deg,var(--blue),var(--cyan));color:#fff;box-shadow:0 4px 14px rgba(59,130,246,.35)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(59,130,246,.45)}
.btn-secondary{background:var(--bg-lift);color:var(--text);border:1px solid var(--border-hi)}
.btn-secondary:hover{border-color:var(--blue);color:var(--text)}
.btn-ghost{background:transparent;color:var(--text2);border:1px solid var(--border)}
.btn-ghost:hover{border-color:var(--border-hi);color:var(--text)}
.btn-lg{padding:15px 34px;font-size:1rem;border-radius:var(--r2)}
.btn-full{width:100%}
.btn:disabled{opacity:.35;cursor:not-allowed;transform:none!important}

/* ── Selectable option ── */
.opt{position:relative;cursor:pointer;border:2px solid var(--border);border-radius:var(--r2);padding:16px;background:var(--bg-card);transition:all var(--t);overflow:hidden}
.opt::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(59,130,246,.07),transparent);opacity:0;transition:opacity var(--t)}
.opt:hover{border-color:var(--blue);transform:translateY(-2px)}
.opt:hover::before{opacity:1}
.opt.sel{border-color:var(--cyan);background:#0b1a2c;box-shadow:0 0 0 1px var(--cyan),0 4px 18px rgba(6,182,212,.18)}
.opt.sel::before{opacity:1}
.opt .tick{position:absolute;top:10px;right:10px;width:20px;height:20px;border-radius:50%;background:var(--cyan);display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:700;color:#000}

/* ── Progress ── */
.bar-track{background:#12203a;border-radius:99px;overflow:hidden}
.bar-fill{height:100%;border-radius:99px;transition:width 1.1s cubic-bezier(.4,0,.2,1)}
.bar-blue{background:linear-gradient(90deg,var(--blue),var(--cyan))}
.bar-green{background:linear-gradient(90deg,#064e3b,var(--green))}
.bar-amber{background:linear-gradient(90deg,#78350f,var(--amber))}
.bar-red{background:linear-gradient(90deg,#7f1d1d,var(--red))}
.bar-purple{background:linear-gradient(90deg,#4c1d95,var(--purple))}
.bar-teal{background:linear-gradient(90deg,#134e4a,var(--teal))}

/* ── Badges ── */
.badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:99px;font-size:.7rem;font-weight:700;letter-spacing:.04em}
.b-blue{background:rgba(59,130,246,.14);color:#93c5fd;border:1px solid rgba(59,130,246,.28)}
.b-green{background:rgba(16,185,129,.14);color:#6ee7b7;border:1px solid rgba(16,185,129,.28)}
.b-amber{background:rgba(245,158,11,.14);color:#fcd34d;border:1px solid rgba(245,158,11,.28)}
.b-red{background:rgba(239,68,68,.14);color:#fca5a5;border:1px solid rgba(239,68,68,.28)}
.b-purple{background:rgba(139,92,246,.14);color:#c4b5fd;border:1px solid rgba(139,92,246,.28)}
.b-cyan{background:rgba(6,182,212,.14);color:#67e8f9;border:1px solid rgba(6,182,212,.28)}
.b-teal{background:rgba(20,184,166,.14);color:#5eead4;border:1px solid rgba(20,184,166,.28)}

/* ── Callouts ── */
.note{border-radius:var(--r);padding:13px 16px;font-size:.85rem;line-height:1.6;border-left:3px solid}
.note-blue{background:rgba(59,130,246,.07);border-color:var(--blue);color:#bfdbfe}
.note-green{background:rgba(16,185,129,.07);border-color:var(--green);color:#a7f3d0}
.note-amber{background:rgba(245,158,11,.07);border-color:var(--amber);color:#fde68a}
.note-red{background:rgba(239,68,68,.07);border-color:var(--red);color:#fecaca}
.note-purple{background:rgba(139,92,246,.07);border-color:var(--purple);color:#ddd6fe}
.note-teal{background:rgba(20,184,166,.07);border-color:var(--teal);color:#99f6e4}

/* ── Stat box ── */
.stat{background:var(--bg-card2);border:1px solid var(--border);border-radius:var(--r);padding:14px;display:flex;flex-direction:column;gap:5px}
.stat-val{font-size:1.55rem;font-weight:800;line-height:1;font-family:'JetBrains Mono','Courier New',monospace}
.stat-lbl{font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text3)}

/* ── Step strip ── */
.steps{display:flex;align-items:center;margin-bottom:30px;overflow-x:auto;padding-bottom:2px}
.step-node{display:flex;align-items:center;flex-shrink:0}
.step-dot{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700;border:2px solid var(--border);background:var(--bg-card);color:var(--text3);transition:all var(--t)}
.step-dot.act{background:var(--blue);border-color:var(--blue);color:#fff;box-shadow:0 0 0 3px rgba(59,130,246,.28)}
.step-dot.done{background:var(--green);border-color:var(--green);color:#fff}
.step-line{flex:1;height:2px;min-width:14px;background:var(--border);transition:background var(--t)}
.step-line.done{background:var(--green)}

/* ── Grid ── */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.ga{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
@media(max-width:580px){.g2,.g3,.ga{grid-template-columns:1fr}}

/* ── Metric row ── */
.mrow{display:flex;flex-direction:column;gap:5px}
.mhead{display:flex;justify-content:space-between;align-items:center}
.mname{font-size:.8rem;font-weight:600;color:var(--text2)}
.mval{font-family:'JetBrains Mono','Courier New',monospace;font-size:.8rem;font-weight:700}

/* ── Divider ── */
hr{border:none;border-top:1px solid var(--border);margin:18px 0}

/* ── Animations ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes shimmer{0%,100%{opacity:1}50%{opacity:.5}}
.fade{animation:fadeUp .38s ease both}

/* ── Welcome ── */
.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 20px;position:relative;overflow:hidden}
.hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 65% 45% at 30% 20%,rgba(59,130,246,.08) 0%,transparent 60%),radial-gradient(ellipse 55% 40% at 75% 80%,rgba(6,182,212,.06) 0%,transparent 55%);pointer-events:none}
.grid-lines{position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(30,45,66,.35) 1px,transparent 1px),linear-gradient(90deg,rgba(30,45,66,.35) 1px,transparent 1px);background-size:52px 52px;mask-image:radial-gradient(ellipse 85% 75% at 50% 50%,black,transparent)}
.accent-text{color:transparent;background:linear-gradient(90deg,var(--blue),var(--cyan));-webkit-background-clip:text;background-clip:text}

/* ── Score ring ── */
.ring-wrap{position:relative;display:inline-block}
.ring-label{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.ring-score{font-size:2.6rem;font-weight:900;font-family:'JetBrains Mono','Courier New',monospace;line-height:1}

/* ── Live sidebar ── */
.sidebar-metrics{display:flex;flex-direction:column;gap:10px}

/* ── Tag ── */
.tag{display:inline-flex;align-items:center;gap:4px;background:var(--bg-lift);border:1px solid var(--border-hi);border-radius:6px;padding:3px 8px;font-size:.73rem;font-weight:600;color:var(--text2)}

/* utils */
.flex{display:flex}.fcol{flex-direction:column}.fwrap{flex-wrap:wrap}.aic{align-items:center}.jcb{justify-content:space-between}.jcc{justify-content:center}
.g4{gap:4px}.g6{gap:6px}.g8{gap:8px}.g10{gap:10px}.g12{gap:12px}.g16{gap:16px}.g20{gap:20px}.g24{gap:24px}
.mb4{margin-bottom:4px}.mb8{margin-bottom:8px}.mb12{margin-bottom:12px}.mb16{margin-bottom:16px}.mb20{margin-bottom:20px}.mb24{margin-bottom:24px}.mb32{margin-bottom:32px}
.mt8{margin-top:8px}.mt12{margin-top:12px}.mt16{margin-top:16px}.mt20{margin-top:20px}
.w100{width:100%}.tc{text-align:center}.tr{text-align:right}
.c-blue{color:var(--blue)}.c-cyan{color:var(--cyan)}.c-green{color:var(--green)}.c-amber{color:var(--amber)}.c-red{color:var(--red)}.c-purple{color:var(--purple)}.c-teal{color:var(--teal)}
.c-2{color:var(--text2)}.c-3{color:var(--text3)}
</style>
</head>
<body>
<div id="root"></div>
<script type="text/babel">
const {useState,useEffect,useRef} = React;

/* ─────────────── SEED DATA ─────────────── */
const INDUSTRIES=[
  {name:'Consumer Electronics',emoji:'📱',products:['Smartphones','Laptops','Smartwatches'],baseMargin:.18},
  {name:'Food & Beverage',emoji:'🍃',products:['Packaged Snacks','Beverages','Frozen Meals'],baseMargin:.10},
  {name:'Apparel & Fashion',emoji:'👗',products:['Clothing','Footwear','Accessories'],baseMargin:.13},
  {name:'Medical Devices',emoji:'💊',products:['Diagnostic Tools','Surgical Equipment','Wearables'],baseMargin:.24},
  {name:'Automotive Parts',emoji:'🚗',products:['Engine Components','Braking Systems','Sensors'],baseMargin:.14},
  {name:'Home Appliances',emoji:'🏠',products:['Refrigerators','Washing Machines','Air Conditioners'],baseMargin:.12},
  {name:'Industrial Machinery',emoji:'⚙️',products:['Pumps','Conveyor Systems','CNC Machines'],baseMargin:.17},
  {name:'Cosmetics & Beauty',emoji:'💄',products:['Skincare','Makeup','Hair Care'],baseMargin:.21},
];
const NAMES=['NovaBrand','Meridian Co.','Apex Group','Stratos Inc.','Velox Industries','Orion Corp.','Summit Global','Nexus Co.','Atlas Brands','Pinnacle Goods'];
const MARKETS=['North America','Europe','Southeast Asia','South Asia','Middle East','Latin America','East Africa','Oceania'];
const FACTORY_LOCS=[
  {name:'Vietnam',emoji:'🇻🇳',cost:'Very Low',risk:'Medium'},
  {name:'Germany',emoji:'🇩🇪',cost:'High',risk:'Low'},
  {name:'Mexico',emoji:'🇲🇽',cost:'Low',risk:'Medium'},
  {name:'India',emoji:'🇮🇳',cost:'Low',risk:'Medium'},
  {name:'USA',emoji:'🇺🇸',cost:'Very High',risk:'Very Low'},
  {name:'China',emoji:'🇨🇳',cost:'Low',risk:'Medium'},
  {name:'Poland',emoji:'🇵🇱',cost:'Medium',risk:'Low'},
  {name:'Brazil',emoji:'🇧🇷',cost:'Medium',risk:'Medium'},
];
const DEMAND_LEVELS=['Low','Medium','High','Very High'];

/* ─────────────── HELPERS ─────────────── */
const rng=(a,b)=>Math.floor(Math.random()*(b-a+1))+a;
const pick=a=>a[Math.floor(Math.random()*a.length)];
const clamp=(v,mn=0,mx=100)=>Math.max(mn,Math.min(mx,v));
function pickN(arr,n){const s=[...arr];const r=[];while(r.length<n){const i=Math.floor(Math.random()*s.length);r.push(s.splice(i,1)[0]);}return r;}

function genCompany(){
  const ind=pick(INDUSTRIES);
  return{
    name:pick(NAMES),
    industry:ind,
    product:pick(ind.products),
    markets:pickN(MARKETS,rng(2,4)),
    demand:pick(DEMAND_LEVELS),
    employees:rng(500,8000),
    founded:rng(1985,2018),
  };
}

/* ─────────────── DECISIONS ─────────────── */
const DECISIONS=[
  {
    key:'suppliers',
    title:'Supplier Strategy',
    emoji:'🔗',
    concept:'A supplier is a company that gives you the raw materials or parts you need to make your product.',
    why:'Your supplier strategy decides how vulnerable your business is if something goes wrong — like a factory fire, a strike, or a natural disaster.',
    options:[
      {id:'single',label:'Single Supplier',emoji:'🎯',
        desc:'Source everything from one carefully chosen supplier. Simpler to manage and often gets you better pricing.',
        tradeoffs:'Great price, but one failure shuts you down completely.',
        metrics:{cost:+12,speed:+5,risk:-20,satisfaction:+3,sustainability:+2}},
      {id:'dual',label:'Dual Sourcing',emoji:'⚖️',
        desc:'Use two suppliers for your key materials. One is primary, one is backup.',
        tradeoffs:'More resilient than single, slightly more expensive to coordinate.',
        metrics:{cost:+3,speed:+5,risk:+8,satisfaction:+8,sustainability:0}},
      {id:'multi',label:'Multi-Supplier Network',emoji:'🌐',
        desc:'Source from 4–6 different suppliers across multiple countries.',
        tradeoffs:'Maximum resilience and negotiating power, but complex and costly to manage.',
        metrics:{cost:-10,speed:-3,risk:+18,satisfaction:+12,sustainability:-5}},
    ]
  },
  {
    key:'factory',
    title:'Factory Location',
    emoji:'🏭',
    concept:'Where you manufacture your products determines your costs, speed, and quality — and how close you are to your customers.',
    why:'Factory location is one of the most important long-term decisions. Once built, it\'s expensive to move. It affects labour costs, shipping time, and political risk.',
    options:FACTORY_LOCS.map(f=>({
      id:f.name.toLowerCase(),
      label:f.name,
      emoji:f.emoji,
      desc:`Labour cost: ${f.cost}. Political stability: ${f.risk}.`,
      tradeoffs:f.cost==='Very Low'||f.cost==='Low'
        ?'Low production cost but longer shipping distances to Western markets.'
        :f.cost==='High'||f.cost==='Very High'
        ?'High labour costs but close to key markets and very stable.'
        :'Balanced cost and risk profile.',
      metrics:f.cost==='Very Low'
        ?{cost:+18,speed:-12,risk:-5,satisfaction:-3,sustainability:-8}
        :f.cost==='Low'
        ?{cost:+12,speed:-6,risk:-5,satisfaction:0,sustainability:-4}
        :f.cost==='Medium'
        ?{cost:+3,speed:+3,risk:+5,satisfaction:+5,sustainability:+2}
        :f.cost==='High'
        ?{cost:-10,speed:+10,risk:+12,satisfaction:+10,sustainability:+6}
        :{cost:-18,speed:+15,risk:+18,satisfaction:+14,sustainability:+8},
    }))
  },
  {
    key:'warehouse',
    title:'Warehouse Strategy',
    emoji:'📦',
    concept:'A warehouse is where you store your finished goods before they reach customers. Where and how many you have dramatically changes how fast customers receive orders.',
    why:'Warehousing is a trade-off between speed and cost. More warehouses = faster delivery but higher rent and labour. One central hub = cheaper but slower for distant customers.',
    options:[
      {id:'central',label:'Central Hub',emoji:'🏢',
        desc:'One large, efficient warehouse in a central location. Cheaper to run and easier to manage inventory.',
        tradeoffs:'Low cost, but deliveries take longer to reach customers far from the hub.',
        metrics:{cost:+12,speed:-10,risk:-5,satisfaction:-5,sustainability:+8}},
      {id:'regional',label:'Regional Hubs (3)',emoji:'🗂️',
        desc:'Three warehouses placed near your main market regions.',
        tradeoffs:'Faster delivery, more flexibility, but higher total running costs.',
        metrics:{cost:-5,speed:+12,risk:+8,satisfaction:+12,sustainability:-2}},
      {id:'local',label:'Local Fulfilment Network',emoji:'📍',
        desc:'Many small warehouses close to customers — like a delivery-app model.',
        tradeoffs:'Very fast delivery and great satisfaction, but expensive and complex.',
        metrics:{cost:-18,speed:+20,risk:+5,satisfaction:+18,sustainability:-12}},
      {id:'dropship',label:'3rd-Party Logistics (3PL)',emoji:'🚚',
        desc:'Outsource warehousing entirely to a specialist logistics provider.',
        tradeoffs:'Low upfront cost, flexible scaling, but less control over quality and timing.',
        metrics:{cost:+6,speed:+5,risk:-3,satisfaction:+3,sustainability:+4}},
    ]
  },
  {
    key:'transport',
    title:'Transportation Method',
    emoji:'🚢',
    concept:'How you move products — from your factory to the warehouse, and from the warehouse to the customer — shapes delivery speed, cost, and your environmental footprint.',
    why:'Transportation is typically the largest single cost in a supply chain. Your choice also sends a signal to customers: air freight is fast but expensive; sea freight is cheap but slow.',
    options:[
      {id:'air',label:'Air Freight',emoji:'✈️',
        desc:'Fastest option for international shipments. Used for high-value or time-sensitive products.',
        tradeoffs:'5–8× more expensive than sea freight. Very high carbon emissions.',
        metrics:{cost:-22,speed:+22,risk:+5,satisfaction:+12,sustainability:-20}},
      {id:'sea',label:'Sea Freight',emoji:'🚢',
        desc:'The standard for international bulk shipping. Slow but very cost-effective.',
        tradeoffs:'Cheapest per unit, but transit times of 2–6 weeks.',
        metrics:{cost:+20,speed:-18,risk:-5,satisfaction:-8,sustainability:+15}},
      {id:'rail',label:'Rail & Intermodal',emoji:'🚂',
        desc:'A mix of train and road transport. Good balance for continental distances.',
        tradeoffs:'Cheaper than road for long distances, more reliable than sea, lower emissions.',
        metrics:{cost:+8,speed:+5,risk:+3,satisfaction:+5,sustainability:+10}},
      {id:'road',label:'Road (Truck Network)',emoji:'🚛',
        desc:'Flexible door-to-door delivery. Best for regional distribution.',
        tradeoffs:'Fast and flexible but congestion-prone and costlier per km than rail.',
        metrics:{cost:-2,speed:+10,risk:0,satisfaction:+8,sustainability:-5}},
    ]
  },
  {
    key:'inventory',
    title:'Inventory Strategy',
    emoji:'🗃️',
    concept:'Inventory is the stock of products you hold ready to sell. How much you keep is a fundamental trade-off between being ready for demand surges vs. wasting money on unsold goods.',
    why:'Too little inventory = stockouts, unhappy customers, lost sales. Too much = cash tied up, products expiring or going out of style, extra warehouse costs. Getting it right is one of supply chain\'s hardest problems.',
    options:[
      {id:'lean',label:'Lean / Just-in-Time',emoji:'🎯',
        desc:'Hold minimal stock — order from suppliers only when needed. Saves space and cash.',
        tradeoffs:'Highly efficient in normal conditions, but one disruption can cause stockouts.',
        metrics:{cost:+18,speed:+5,risk:-15,satisfaction:-8,sustainability:+12}},
      {id:'balanced',label:'Balanced Safety Stock',emoji:'⚖️',
        desc:'Hold 3–4 weeks of safety stock as a buffer against demand spikes or supply delays.',
        tradeoffs:'The most common strategy. Moderate costs, good resilience.',
        metrics:{cost:+5,speed:+5,risk:+8,satisfaction:+8,sustainability:0}},
      {id:'high',label:'High-Buffer Inventory',emoji:'🏗️',
        desc:'Hold 8–12 weeks of stock. Rarely run out, and you can negotiate supplier bulk discounts.',
        tradeoffs:'Great service levels and buying power, but high holding costs and obsolescence risk.',
        metrics:{cost:-15,speed:0,risk:+15,satisfaction:+12,sustainability:-10}},
    ]
  },
];

/* ─────────────── SUBCOMPONENTS ─────────────── */
function ProgressBar({value,max=100,color='blue',height=7,animate=true}){
  const pct=clamp((value/max)*100);
  const cmap={blue:'bar-blue',green:'bar-green',amber:'bar-amber',red:'bar-red',purple:'bar-purple',teal:'bar-teal'};
  return(
    <div className="bar-track" style={{height}}>
      <div className={`bar-fill ${cmap[color]||'bar-blue'}`}
        style={{width:animate?`${pct}%`:'0%',transition:animate?'width 1.1s cubic-bezier(.4,0,.2,1)':'none'}}/>
    </div>
  );
}

function MetricRow({icon,label,value,color='blue',animate}){
  const cmap={blue:'c-blue',green:'c-green',amber:'c-amber',red:'c-red',purple:'c-purple',teal:'c-teal'};
  return(
    <div className="mrow">
      <div className="mhead">
        <span className="mname">{icon} {label}</span>
        <span className={`mval ${cmap[color]||'c-blue'}`}>{Math.round(value)}</span>
      </div>
      <ProgressBar value={value} color={color} animate={animate}/>
    </div>
  );
}

function StepStrip({current,total}){
  const labels=['Company','Suppliers','Factory','Warehouse','Transport','Inventory','Results'];
  return(
    <div className="steps">
      {Array.from({length:total}).map((_,i)=>(
        <div key={i} className="step-node" style={{flex:i<total-1?'1':'0'}}>
          <div className={`step-dot${i<current?' done':i===current?' act':''}`}>
            {i<current?'✓':i+1}
          </div>
          {i<total-1&&<div className={`step-line${i<current?' done':''}`}/>}
        </div>
      ))}
    </div>
  );
}

function ScoreRing({score,size=150}){
  const r=(size-18)/2;
  const circ=2*Math.PI*r;
  const off=circ*(1-score/100);
  const col=score>=75?'var(--green)':score>=50?'var(--amber)':'var(--red)';
  return(
    <div className="ring-wrap" style={{width:size,height:size}}>
      <svg width={size} height={size} style={{transform:'rotate(-90deg)'}}>
        <circle cx={size/2} cy={size/2} r={r} fill="none" stroke="var(--border)" strokeWidth={9}/>
        <circle cx={size/2} cy={size/2} r={r} fill="none" stroke={col} strokeWidth={9}
          strokeDasharray={circ} strokeDashoffset={off}
          style={{transition:'stroke-dashoffset 1.5s cubic-bezier(.4,0,.2,1)',strokeLinecap:'round'}}/>
      </svg>
      <div className="ring-label">
        <div className="ring-score" style={{color:col}}>{score}</div>
        <div className="t-xs c-3">/100</div>
      </div>
    </div>
  );
}


      {/* Improvements */}
      <div className="card mb20">
        <div className="t-h2 mb12">📈 Three Practical Improvements</div>
        <div style={{display:'flex',flexDirection:'column',gap:10}}>
          {improvements.map((imp,i)=>(
            <div key={i} className="flex g12 aic" style={{padding:'10px 14px',background:'var(--bg-card2)',borderRadius:8}}>
              <div style={{width:26,height:26,borderRadius:'50%',background:'var(--blue)',display:'flex',alignItems:'center',justifyContent:'center',fontWeight:700,fontSize:'.75rem',flexShrink:0}}>{i+1}</div>
              <p className="t-small c-2">{imp}</p>

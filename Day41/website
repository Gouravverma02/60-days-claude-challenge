  /* ---------- Ruler simulator (signature interactive component) ---------- */
  function createRuler(container, opts){
    opts = opts || {};
    const min = opts.min || 320, max = opts.max || 1200, initial = opts.initial || 900;
    const zones = opts.zones || [
      {max:575, label:"Mobile", color:"var(--danger)"},
      {max:991, label:"Tablet", color:"var(--amber)"},
      {max:Infinity, label:"Desktop", color:"var(--teal)"}
    ];
    const ticks = opts.ticks || [320,576,768,992,1200];
    const label = opts.label || "Frame width";
    const ruleText = opts.ruleText || "";

    container.innerHTML =
      '<div class="ruler-label"><span>'+escapeHtml(label)+'</span><span class="mono">drag ↔</span></div>'+
      '<div class="ruler-scale">'+ ticks.map(t=>{
        const pct = ((t-min)/(max-min))*100;
        return '<span class="tick" style="left:'+pct+'%;">'+t+'</span>';
      }).join("") + '</div>'+
      '<input type="range" class="ruler-range" min="'+min+'" max="'+max+'" value="'+initial+'">'+
      '<div class="ruler-readout"><span class="rr-value">'+initial+'</span><span class="rr-unit">px</span><span class="rr-zone"></span>'+
      (ruleText ? '<span class="rr-rule mono">'+escapeHtml(ruleText)+'</span>' : '')+
      '</div>'+
      '<div class="ruler-stage"><div class="ruler-frame" id="'+container.id+'-frame"></div></div>';

    const frame = $('#'+container.id+'-frame');
    if(opts.frameHTML) frame.innerHTML = opts.frameHTML;

    const range = $(".ruler-range", container);
    const valueEl = $(".rr-value", container);
    const zoneEl = $(".rr-zone", container);
    const ruleEl = $(".rr-rule", container);

    function update(v){
      const stageWidth = $(".ruler-stage", container).clientWidth - 30;
      frame.style.width = Math.min(v, Math.max(stageWidth, 140)) + "px";
      valueEl.textContent = v;
      const zone = zones.find(z=> v <= z.max);
      if(zone){
        zoneEl.textContent = zone.label;
        zoneEl.style.color = zone.color;
        zoneEl.style.borderColor = zone.color;
      }
      if(ruleEl && opts.ruleFor) ruleEl.textContent = opts.ruleFor(v, zone);
      if(opts.onChange) opts.onChange(v, zone, frame);
    }
    range.addEventListener("input", (e)=> update(parseInt(e.target.value,10)));
    window.addEventListener("resize", ()=> update(parseInt(range.value,10)));
    update(initial);
    return { update, frame };
  }


<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Responsive Web Design · Interactive Learning Studio</title>
<style>
  :root{
    --bg:#0c1016;
    --bg-panel:#131923;
    --bg-panel-2:#171f2c;
    --grid-line: rgba(94,196,209,0.10);
    --ink:#eef2f7;
    --ink-soft:#95a3b8;
    --ink-faint:#5c6a80;
    --teal:#5ec4d1;
    --teal-dim:#2d5b63;
    --amber:#f0a83c;
    --amber-dim:#7a5a26;
    --success:#5cc98a;
    --danger:#e2685a;
    --rule: rgba(255,255,255,0.08);
    --radius:14px;
    --radius-sm:8px;
    --shadow: 0 20px 50px -20px rgba(0,0,0,0.55);
    --font-display: 'Century Gothic','Avenir Next','Segoe UI',-apple-system,sans-serif;
    --font-body: -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    --font-mono: ui-monospace,'SF Mono','Cascadia Code','Roboto Mono','Courier New',monospace;
  }
  html[data-theme="light"]{
    --bg:#f3f5f8;
    --bg-panel:#ffffff;
    --bg-panel-2:#eef1f5;
    --grid-line: rgba(20,26,35,0.05);
    --ink:#161c26;
    --ink-soft:#4d5768;
    --ink-faint:#8892a0;
    --teal:#1c8a97;
    --teal-dim:#bfe6ea;
    --amber:#b9741c;
    --amber-dim:#f4dcb3;
    --rule: rgba(20,26,35,0.10);
    --shadow: 0 20px 45px -22px rgba(20,26,35,0.25);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0/38px 38px,
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0/38px 38px,
      var(--bg);
    color:var(--ink);
    font-family:var(--font-body);
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
  }
  a{color:var(--teal);}
  ::selection{ background:var(--amber); color:#1a1206; }
  :focus-visible{ outline:2px solid var(--amber); outline-offset:2px; border-radius:4px; }
  h1,h2,h3,h4{ font-family:var(--font-display); margin:0; letter-spacing:0.01em; }
  code, .mono{ font-family:var(--font-mono); }
  button{ font-family:inherit; }
  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.001ms !important; transition-duration:0.001ms !important; scroll-behavior:auto !important; }
  }
  html{ scroll-behavior:smooth; }

  /* ---------- Shell ---------- */
  .app-shell{
    display:grid;
    grid-template-columns: 268px 1fr;
    grid-template-rows: 64px 1fr;
    min-height:100vh;
  }
  .topbar{
    grid-column:1/-1;
    display:flex; align-items:center; gap:22px;
    padding:0 22px;
    background:var(--bg-panel);
    border-bottom:1px solid var(--rule);
    position:sticky; top:0; z-index:40;
  }
  .topbar-left{ display:flex; flex-direction:column; justify-content:center; gap:1px; min-width:0; }
  .logo{ font-family:var(--font-display); font-weight:700; font-size:1.02rem; letter-spacing:0.02em; display:flex; align-items:center; gap:8px;}
  .logo .mark{ color:var(--amber); }
  .crumbs{ font-size:0.72rem; color:var(--ink-faint); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .topbar-progress{ flex:1; display:flex; align-items:center; gap:12px; max-width:420px; }
  .progress-track{ flex:1; height:8px; border-radius:100px; background:var(--bg-panel-2); overflow:hidden; border:1px solid var(--rule); }
  .progress-fill{ height:100%; width:0%; background:linear-gradient(90deg, var(--teal), var(--amber)); transition:width .5s cubic-bezier(.2,.8,.2,1); }
  #progressLabel{ font-size:0.72rem; color:var(--ink-soft); white-space:nowrap; font-family:var(--font-mono); }
  .topbar-right{ display:flex; align-items:center; gap:8px; margin-left:auto; }
  .xp-pill{
    font-family:var(--font-mono); font-size:0.78rem; background:var(--bg-panel-2); border:1px solid var(--rule);
    padding:6px 12px; border-radius:100px; color:var(--amber); display:flex; align-items:center; gap:6px;
  }
  .icon-btn{
    width:34px; height:34px; border-radius:50%; border:1px solid var(--rule); background:var(--bg-panel-2);
    color:var(--ink); cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:0.95rem;
    transition: background .15s, transform .15s;
  }
  .icon-btn:hover{ background:var(--bg-panel); transform:translateY(-1px); }
  .sidebar-toggle{
    display:none; position:fixed; top:14px; right:14px; z-index:60; width:40px; height:40px; border-radius:10px;
    border:1px solid var(--rule); background:var(--bg-panel); color:var(--ink); font-size:1.1rem; cursor:pointer;
  }

  /* ---------- Sidebar ---------- */
  .sidebar{
    background:var(--bg-panel); border-right:1px solid var(--rule);
    padding:20px 14px; display:flex; flex-direction:column; gap:22px;
    position:sticky; top:64px; height:calc(100vh - 64px); overflow-y:auto;
  }
  .module-nav{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:4px; }
  .nav-item{
    display:flex; align-items:center; gap:10px; padding:10px 12px; border-radius:var(--radius-sm);
    font-size:0.86rem; color:var(--ink-soft); cursor:pointer; transition: background .15s, color .15s;
    border:1px solid transparent;
  }
  .nav-item:hover{ background:var(--bg-panel-2); }
  .nav-item.active{ background:var(--bg-panel-2); color:var(--ink); border-color:var(--rule); }
  .nav-item .nav-num{
    width:22px; height:22px; border-radius:50%; background:var(--bg-panel-2); border:1px solid var(--rule);
    display:flex; align-items:center; justify-content:center; font-family:var(--font-mono); font-size:0.68rem; flex:none;
    color:var(--ink-faint);
  }
  .nav-item.unlocked .nav-num{ border-color:var(--teal); color:var(--teal); }
  .nav-item.complete .nav-num{ background:var(--teal); border-color:var(--teal); color:#04262a; }
  .nav-item.locked{ opacity:0.55; cursor:not-allowed; }
  .nav-item.locked .nav-num{ color:var(--ink-faint); }
  .nav-item .nav-dot{ width:22px; text-align:center; color:var(--amber); flex:none; }
  .badge-shelf{ margin-top:auto; padding-top:16px; border-top:1px solid var(--rule); }
  .badge-shelf-label{ font-size:0.68rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--ink-faint); margin:0 0 10px; }
  .badges{ display:flex; flex-wrap:wrap; gap:8px; min-height:34px; }
  .badge-chip{
    font-size:0.7rem; padding:6px 10px; border-radius:100px; background:var(--bg-panel-2); border:1px solid var(--amber-dim);
    color:var(--amber); display:flex; align-items:center; gap:5px; animation:badgeIn .4s ease both;
  }
  @keyframes badgeIn{ from{ opacity:0; transform:scale(0.8);} to{ opacity:1; transform:none;} }
  .badge-empty{ font-size:0.72rem; color:var(--ink-faint); font-style:italic; }

  /* ---------- Content shell ---------- */
  .content{ padding:34px clamp(18px, 4vw, 56px) 90px; max-width:980px; }
  .section{ margin-bottom:56px; scroll-margin-top:80px; }
  .eyebrow{
    font-family:var(--font-mono); font-size:0.72rem; text-transform:uppercase; letter-spacing:0.14em;
    color:var(--teal); margin:0 0 8px; display:flex; align-items:center; gap:8px;
  }
  .section h2.section-title{ font-size:1.7rem; margin-bottom:10px; }
  .lede{ color:var(--ink-soft); line-height:1.65; font-size:0.98rem; max-width:64ch; }

  /* ---------- Ruler simulator (signature component) ---------- */
  .ruler-widget{
    background:var(--bg-panel); border:1px solid var(--rule); border-radius:var(--radius);
    padding:18px 20px 20px; box-shadow:var(--shadow); margin:18px 0 8px;
  }
  .ruler-widget .ruler-label{ font-size:0.78rem; color:var(--ink-soft); margin-bottom:10px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:6px; }
  .ruler-scale{ position:relative; height:22px; margin-bottom:2px; }
  .ruler-scale .tick{ position:absolute; top:0; font-family:var(--font-mono); font-size:0.62rem; color:var(--ink-faint); transform:translateX(-50%); }
  .ruler-scale .tick::after{ content:''; display:block; width:1px; height:6px; background:var(--rule); margin:2px auto 0; }
  .ruler-range{
    -webkit-appearance:none; appearance:none; width:100%; height:6px; border-radius:100px;
    background:linear-gradient(90deg, var(--teal), var(--amber)); cursor:pointer; margin:6px 0 2px;
  }
  .ruler-range::-webkit-slider-thumb{
    -webkit-appearance:none; width:18px; height:18px; border-radius:50%; background:var(--ink);
    border:3px solid var(--amber); cursor:grab; margin-top:-6px;
  }
  .ruler-range::-moz-range-thumb{ width:18px; height:18px; border-radius:50%; background:var(--ink); border:3px solid var(--amber); cursor:grab; }
  .ruler-readout{ display:flex; align-items:baseline; gap:8px; margin-top:8px; font-family:var(--font-mono); }
  .ruler-readout .rr-value{ font-size:1.15rem; font-weight:700; color:var(--ink); }
  .ruler-readout .rr-unit{ font-size:0.78rem; color:var(--ink-faint); }
  .ruler-readout .rr-zone{ margin-left:auto; font-size:0.76rem; padding:3px 10px; border-radius:100px; background:var(--bg-panel-2); border:1px solid var(--rule); }
  .ruler-readout .rr-rule{ width:100%; font-size:0.72rem; color:var(--ink-faint); margin-top:4px; }
  .ruler-stage{
    margin-top:14px; background:var(--bg); border:1px dashed var(--rule); border-radius:var(--radius-sm);
    padding:14px; overflow-x:auto;
  }
  .ruler-frame{
    margin:0 auto; min-width:140px; border:1px solid var(--rule); border-radius:8px; background:var(--bg-panel-2);
    padding:12px; transition:width .08s linear; container-type:inline-size;
  }

  /* ---------- Demo widgets living inside a ruler-frame ---------- */
  .demo-fixed-fluid{ display:flex; flex-direction:column; gap:8px; }
  .demo-box{ padding:10px; border-radius:6px; font-family:var(--font-mono); font-size:0.72rem; color:#0c1016; white-space:nowrap; overflow:hidden; }
  .demo-box.fixed{ width:230px; background:var(--danger); max-width:none; }
  .demo-box.fluid{ width:100%; background:var(--success); }

  .demo-mq{ text-align:center; padding:22px 8px; border-radius:6px; font-family:var(--font-mono); font-size:0.8rem; background:var(--bg-panel-2); color:var(--ink-soft); transition:background .1s, color .1s; }
  @container (max-width: 575px){ .demo-mq{ background:rgba(226,104,90,0.18); color:var(--danger); } }
  @container (min-width: 576px) and (max-width: 991px){ .demo-mq{ background:rgba(240,168,60,0.18); color:var(--amber); } }
  @container (min-width: 992px){ .demo-mq{ background:rgba(94,196,209,0.18); color:var(--teal); } }

  .demo-grid{ display:grid; grid-template-columns:repeat(auto-fit, minmax(120px,1fr)); gap:8px; }
  .demo-card{ background:var(--bg-panel); border:1px solid var(--rule); border-radius:6px; padding:10px 8px; font-size:0.7rem; color:var(--ink-soft); text-align:center; }

  .demo-nav{ display:flex; align-items:center; justify-content:space-between; background:var(--bg-panel); border:1px solid var(--rule); border-radius:6px; padding:8px 10px; }
  .demo-nav .demo-logo{ font-weight:700; font-size:0.78rem; }
  .demo-nav .demo-links{ display:flex; gap:12px; font-size:0.7rem; color:var(--ink-soft); }
  .demo-nav .demo-burger{ display:none; font-size:0.95rem; }
  @container (max-width: 360px){
    .demo-nav .demo-links{ display:none; }
    .demo-nav .demo-burger{ display:block; }
  }
  .demo-cardwrap{ margin-top:8px; display:grid; grid-template-columns:repeat(auto-fit,minmax(110px,1fr)); gap:8px; }

  /* ---------- Content blocks ---------- */
  .callout{ border-radius:var(--radius-sm); padding:16px 18px; margin:16px 0; border:1px solid var(--rule); background:var(--bg-panel); }
  .callout.analogy{ border-left:3px solid var(--amber); }
  .callout.analogy .callout-label{ color:var(--amber); }
  .callout-label{ font-family:var(--font-mono); font-size:0.68rem; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:6px; display:block; }
  .callout p{ margin:0; line-height:1.6; color:var(--ink-soft); font-size:0.92rem; }

  .diagram-wrap{ background:var(--bg-panel); border:1px solid var(--rule); border-radius:var(--radius); padding:18px; margin:16px 0; overflow-x:auto; }
  .diagram-wrap svg{ display:block; margin:0 auto; max-width:100%; height:auto; }
  .diagram-caption{ text-align:center; font-size:0.76rem; color:var(--ink-faint); margin-top:8px; }

  table.compare{ width:100%; border-collapse:collapse; margin:16px 0; font-size:0.86rem; }
  table.compare th, table.compare td{ text-align:left; padding:10px 12px; border-bottom:1px solid var(--rule); vertical-align:top; }
  table.compare th{ font-family:var(--font-mono); font-size:0.68rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--ink-faint); }
  table.compare td{ color:var(--ink-soft); line-height:1.5; }
  table.compare tr td:first-child{ color:var(--ink); font-weight:600; }

  .exercise-box{ background:var(--bg-panel); border:1px solid var(--teal-dim); border-left:3px solid var(--teal); border-radius:var(--radius-sm); padding:16px 18px; margin:16px 0; }
  .exercise-box .callout-label{ color:var(--teal); }

  .two-col{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  @media (max-width:700px){ .two-col{ grid-template-columns:1fr; } }

  ul.tidy{ margin:8px 0; padding-left:20px; color:var(--ink-soft); line-height:1.65; font-size:0.92rem; }
  ul.tidy li{ margin-bottom:6px; }
  ul.tidy.misconceptions li b{ color:var(--danger); }
  ul.tidy.takeaways li::marker{ color:var(--teal); }

  pre.code-block{
    background:#0a0d12; border:1px solid var(--rule); border-radius:var(--radius-sm); padding:14px 16px;
    overflow-x:auto; font-family:var(--font-mono); font-size:0.8rem; color:#c9e8ec; line-height:1.55; position:relative;
  }
  html[data-theme="light"] pre.code-block{ background:#111722; }
  .copy-btn{
    position:absolute; top:8px; right:8px; font-size:0.68rem; padding:4px 9px; border-radius:6px;
    background:var(--bg-panel-2); color:var(--ink-soft); border:1px solid var(--rule); cursor:pointer;
  }
  .copy-btn:hover{ color:var(--ink); }

  /* ---------- Module chrome ---------- */
  .module-header{ display:flex; align-items:center; gap:12px; margin-bottom:6px; flex-wrap:wrap; }
  .diff-badge{ font-family:var(--font-mono); font-size:0.68rem; text-transform:uppercase; letter-spacing:0.08em; padding:4px 10px; border-radius:100px; border:1px solid var(--rule); color:var(--ink-soft); }
  .module-num{ font-family:var(--font-display); font-size:2.2rem; color:var(--teal-dim); }
  html[data-theme="light"] .module-num{ color:var(--teal); opacity:0.35; }
  .module-block{ position:relative; }
  .module-body{ transition:filter .3s ease; }
  .lock-overlay{
    position:absolute; inset:0; z-index:5; display:flex; align-items:center; justify-content:center;
    flex-direction:column; gap:10px; text-align:center; padding:20px;
    background:rgba(12,16,22,0.72); backdrop-filter:blur(6px); border-radius:var(--radius);
  }
  html[data-theme="light"] .lock-overlay{ background:rgba(243,245,248,0.82); }
  .lock-overlay .lock-icon{ font-size:1.6rem; }
  .lock-overlay p{ color:var(--ink-soft); font-size:0.88rem; max-width:34ch; margin:0; }
  [data-locked="true"] .module-body{ filter:blur(2px); pointer-events:none; user-select:none; }
  [data-locked="true"] .lock-overlay{ display:flex; }
  [data-locked="false"] .lock-overlay{ display:none; }

  /* ---------- Quiz ---------- */
  .quiz{ margin-top:34px; background:var(--bg-panel); border:1px solid var(--rule); border-radius:var(--radius); padding:22px 24px; }
  .quiz h3{ font-size:1.05rem; margin-bottom:4px; }
  .quiz .quiz-sub{ color:var(--ink-faint); font-size:0.8rem; margin-bottom:18px; }
  .quiz-question{ margin-bottom:20px; padding-bottom:18px; border-bottom:1px solid var(--rule); }
  .quiz-question:last-of-type{ border-bottom:none; }
  .quiz-q-text{ font-size:0.92rem; margin-bottom:10px; font-weight:600; }
  .quiz-options{ display:flex; flex-direction:column; gap:8px; }
  .quiz-option{
    display:flex; align-items:flex-start; gap:10px; padding:10px 12px; border-radius:var(--radius-sm);
    border:1px solid var(--rule); cursor:pointer; font-size:0.87rem; color:var(--ink-soft); transition:background .15s, border-color .15s;
  }
  .quiz-option:hover{ background:var(--bg-panel-2); }
  .quiz-option input{ margin-top:2px; accent-color:var(--teal); }
  .quiz-option.chosen{ border-color:var(--teal); background:var(--bg-panel-2); color:var(--ink); }
  .quiz-option.correct-answer{ border-color:var(--success); background:rgba(92,201,138,0.08); }
  .quiz-option.wrong-answer{ border-color:var(--danger); background:rgba(226,104,90,0.08); }
  .quiz-feedback{ display:none; margin-top:10px; padding:10px 12px; border-radius:var(--radius-sm); font-size:0.83rem; line-height:1.5; background:var(--bg-panel-2); color:var(--ink-soft); }
  .quiz-feedback.show{ display:block; }
  .quiz-feedback b{ color:var(--ink); }
  .quiz-actions{ display:flex; align-items:center; gap:14px; margin-top:6px; flex-wrap:wrap; }
  .quiz-summary{ display:none; margin-top:18px; padding:18px; border-radius:var(--radius-sm); background:var(--bg-panel-2); border:1px solid var(--rule); text-align:center; }
  .quiz-summary.show{ display:block; animation:screenIn .4s ease both; }
  @keyframes screenIn{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;} }
  .quiz-summary .score-big{ font-family:var(--font-display); font-size:2rem; color:var(--teal); }
  .quiz-summary p{ color:var(--ink-soft); font-size:0.86rem; margin:6px 0 14px; }

  button.primary{
    font-family:inherit; background:linear-gradient(135deg, var(--amber), #c97f1f); color:#1c1206; border:none;
    padding:12px 22px; border-radius:8px; font-size:0.9rem; font-weight:700; cursor:pointer;
    box-shadow:0 10px 26px -12px rgba(240,168,60,0.55); transition:transform .15s, box-shadow .15s;
  }
  button.primary:hover{ transform:translateY(-1px); }
  button.primary:disabled{ background:var(--bg-panel-2); color:var(--ink-faint); box-shadow:none; cursor:not-allowed; transform:none; }
  button.ghost{
    font-family:inherit; background:var(--bg-panel-2); color:var(--ink); border:1px solid var(--rule);
    padding:11px 20px; border-radius:8px; font-size:0.87rem; cursor:pointer; transition:border-color .15s, transform .15s;
  }
  button.ghost:hover{ border-color:var(--teal); transform:translateY(-1px); }

  /* ---------- Final section ---------- */
  .playground{ display:grid; grid-template-columns:1fr 1fr; gap:14px; margin:16px 0; }
  @media (max-width:800px){ .playground{ grid-template-columns:1fr; } }
  .playground textarea{
    width:100%; height:280px; background:#0a0d12; color:#c9e8ec; border:1px solid var(--rule); border-radius:var(--radius-sm);
    font-family:var(--font-mono); font-size:0.8rem; padding:14px; resize:vertical; line-height:1.5;
  }
  html[data-theme="light"] .playground textarea{ background:#111722; }
  .playground iframe{ width:100%; height:280px; border:1px solid var(--rule); border-radius:var(--radius-sm); background:#fff; }
  .checklist{ display:flex; flex-direction:column; gap:8px; margin:14px 0; }
  .checklist label{ display:flex; gap:10px; align-items:flex-start; font-size:0.88rem; color:var(--ink-soft); }
  .checklist input{ margin-top:3px; accent-color:var(--teal); }

  .cheat-grid{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  @media (max-width:700px){ .cheat-grid{ grid-template-columns:1fr; } }
  .cheat-card{ background:var(--bg-panel); border:1px solid var(--rule); border-radius:var(--radius-sm); padding:16px; }
  .cheat-card h4{ font-size:0.82rem; margin-bottom:8px; color:var(--teal); }

  .resource-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px; margin:14px 0; }
  .resource-card{ background:var(--bg-panel); border:1px solid var(--rule); border-radius:var(--radius-sm); padding:16px; }
  .resource-card h4{ font-size:0.78rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--amber); margin-bottom:10px; }
  .resource-card ul{ margin:0; padding-left:18px; font-size:0.85rem; color:var(--ink-soft); line-height:1.7; }

  .keyword-pills{ display:flex; flex-wrap:wrap; gap:8px; margin:12px 0; }
  .keyword-pill{ font-family:var(--font-mono); font-size:0.76rem; background:var(--bg-panel); border:1px solid var(--rule); padding:6px 12px; border-radius:100px; color:var(--ink-soft); }

  .certificate{
    margin-top:26px; padding:34px; border-radius:var(--radius); text-align:center;
    background:linear-gradient(160deg, var(--bg-panel), var(--bg-panel-2)); border:1px solid var(--amber-dim);
    display:none;
  }
  .certificate.show{ display:block; animation:screenIn .5s ease both; }
  .certificate .cert-eyebrow{ color:var(--amber); font-family:var(--font-mono); font-size:0.7rem; letter-spacing:0.14em; text-transform:uppercase; }
  .certificate h3{ font-size:1.6rem; margin:10px 0 4px; }

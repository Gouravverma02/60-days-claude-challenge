  createRuler($("#m2Ruler"), {
    min:320, max:1200, initial:900,
    zones:[{max:575,label:"Mobile",color:"var(--danger)"},{max:991,label:"Tablet",color:"var(--amber)"},{max:Infinity,label:"Desktop",color:"var(--teal)"}],
    label:"Which breakpoint zone is active",
    ruleText:"", ruleFor:(v,z)=> z ? "min-width: " + (z.label==="Mobile"?"0":z.label==="Tablet"?"576px":"992px") + " is matching (real @container query, not JS)" : "",
    frameHTML: '<div class="demo-mq" id="mq2box">Resize me</div>',
    onChange:(v,zone)=>{
      const box = $("#mq2box");
      if(!box) return;
      box.textContent = zone.label + " layout active (" + v + "px)";
    }
  });

  // Module 3 ruler — auto-fit grid (pure CSS, no JS column logic)
  createRuler($("#m3Ruler"), {
    min:200, max:900, initial:760, label:"repeat(auto-fit, minmax(120px, 1fr))",
    frameHTML: '<div class="demo-grid">'+
      Array.from({length:6}).map((_,i)=>'<div class="demo-card">Card '+(i+1)+'</div>').join("")+
      '</div>'
  });

  // Module 4 ruler — nav + grid combined, using container queries
  createRuler($("#m4Ruler"), {
    min:280, max:1000, initial:820, label:"Nav collapses under 360px (real container query)",
    frameHTML: '<div class="demo-nav"><span class="demo-logo">◱ Brand</span><span class="demo-links"><span>Work</span><span>About</span><span>Contact</span></span><span class="demo-burger">☰</span></div>'+
      '<div class="demo-cardwrap"><div class="demo-card">Feature one</div><div class="demo-card">Feature two</div><div class="demo-card">Feature three</div></div>'
  });

  /* ---------- Copy buttons ---------- */
  $all(".copy-btn").forEach(btn=>{
    btn.addEventListener("click", ()=>{
      const target = document.getElementById(btn.dataset.copy);
      if(!target) return;
      const text = target.textContent;
      if(navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(text).then(()=>{
          const original = btn.textContent;
          btn.textContent = "Copied!";
          setTimeout(()=> btn.textContent = original, 1400);
        }).catch(()=>{ btn.textContent = "Select & copy"; });
      }
    });
  });

  /* ---------- Quiz engine ---------- */
  const QUIZZES = {
    "quiz-1": {
      section:"module-1", badgeKey:"m1", unlocks:"module-2",
      questions:[
        { q:"What is the primary purpose of the viewport meta tag?", options:[
            "To set the page's background color",
            "To tell the browser to render the page at the device's actual width instead of a scaled-down desktop layout",
            "To enable JavaScript on mobile devices",
            "To load a mobile-specific stylesheet"
          ], correct:1, explain:"Without it, mobile browsers assume a ~980px desktop layout and zoom out. width=device-width tells it to use the real screen width as the layout width."
        },
        { q:"Which CSS unit is relative to the root element's font size?", options:["em","rem","vw","px"], correct:1,
          explain:"rem = \"root em\" — always relative to the <html> element's font size, regardless of nesting, which makes spacing far more predictable than em."
        },
        { q:"In fluid grid design, widths are typically expressed in:", options:[
            "Fixed pixels","Percentages relative to the parent container","Points","Inches"
          ], correct:1, explain:"Percentage widths resize automatically as their parent container resizes — the core mechanism behind a fluid grid."
        },
        { q:"What does \"mobile-first\" mean in responsive design?", options:[
            "Designing exclusively for mobile devices and ignoring desktop",
            "Writing your base CSS for small screens, then adding complexity for larger screens via min-width media queries",
            "Building a separate mobile app",
            "Using only mobile-specific HTML tags"
          ], correct:1, explain:"Mobile-first means your unqueried CSS is the small-screen version, and you progressively layer on min-width media queries as space increases."
        }
      ]
    },
    "quiz-2": {
      section:"module-2", badgeKey:"m2", unlocks:"module-3",
      questions:[
        { q:"Which media feature would you use to write mobile-first CSS?", options:["max-width","min-width","max-device-width","orientation"], correct:1,
          explain:"min-width media queries layer styles on top of your base (mobile) CSS as the viewport grows — the definition of mobile-first."
        },
        { q:"What determines a good breakpoint, according to best practice?", options:[
            "Matching every popular phone's exact screen width",
            "Wherever the content itself starts to look broken or awkward",
            "Always using 480/768/1024 regardless of content",
            "Whatever number the client picks"
          ], correct:1, explain:"Content-based breakpoints adapt to your actual layout's needs, not an arbitrary or quickly-outdated list of device sizes."
        },
        { q:"@media (min-width: 768px) and (max-width: 1023px) targets:", options:[
            "Any screen under 768px","Any screen above 1023px","A specific range between 768px and 1023px, inclusive","Only exactly 768px"
          ], correct:2, explain:"Combining min-width and max-width with \"and\" creates a bounded range — here, anything from 768px through 1023px."
        },
        { q:"Which media feature lets you detect if a user prefers dark mode?", options:["prefers-color-scheme","prefers-contrast","color-gamut","forced-colors"], correct:0,
          explain:"prefers-color-scheme: dark/light reflects the user's OS-level preference, letting you auto-theme without a manual toggle."
        }
      ]
    },
    "quiz-3": {
      section:"module-3", badgeKey:"m3", unlocks:"module-4",
      questions:[
        { q:"grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); will:", options:[
            "Always create exactly 3 columns",
            "Create as many 200px+ columns as fit the container, stretching to fill leftover space",
            "Break the layout on small screens",
            "Only work with Flexbox"
          ], correct:1, explain:"auto-fit fits as many minmax(200px,1fr) tracks as the container allows, then stretches them to use all available space — fully self-adjusting."
        },
        { q:"Which property makes flex items wrap onto multiple lines when space runs out?", options:["flex-direction","flex-wrap: wrap","flex-grow","align-items"], correct:1,
          explain:"By default flex items try to fit on one line, shrinking to do so. flex-wrap: wrap lets them drop to new lines instead."
        },
        { q:"What does clamp(1rem, 2vw + 0.5rem, 2rem) do?", options:[
            "Sets a font-size that's always exactly 2vw",
            "Produces a fluid value that scales with viewport width but never goes below 1rem or above 2rem",
            "Clamps the element's width, not font size",
            "Is invalid CSS"
          ], correct:1, explain:"clamp(min, preferred, max) picks the preferred value but never lets it go below the min or above the max — fluid with guardrails."
        },
        { q:"The srcset attribute on an <img> is used to:", options:[
            "Add multiple alt texts",
            "Let the browser choose the most appropriate image file for the current screen size/resolution",
            "Preload all images at once",
            "Replace the src attribute entirely, ignoring browser support"
          ], correct:1, explain:"srcset (with sizes) gives the browser several image candidates and lets it pick the best fit for the actual rendered size and pixel density."
        }
      ]
    },
    "quiz-4": {
      section:"module-4", badgeKey:"m4", unlocks:"final",
      questions:[
        { q:"Which is a common accessibility mistake in responsive design?", options:[
            "Making touch targets at least 44×44px",
            "Shrinking tap targets below ~44px on mobile, making them hard to tap",
            "Supporting pinch-to-zoom",
            "Using relative units for text"
          ], correct:1, explain:"Small tap targets are a frequent, easily-avoidable accessibility failure on mobile — 44×44px is a widely used minimum guideline."
        },
        { q:"When testing responsive designs, what's the most reliable approach?", options:[
            "Only checking in one browser's device toolbar",
            "Resizing the desktop browser window and also checking a few real devices",
            "Assuming if it looks fine at 1440px it works everywhere",
            "Testing only on your own phone"
          ], correct:1, explain:"Emulators are a fast first pass, but real devices reveal real rendering, input, and performance differences — use both."
        },
        { q:"Which technique helps avoid loading unnecessarily large images on mobile?", options:[
            "Fixed-size images for every screen",
            "srcset/sizes or <picture> to serve smaller images to smaller viewports",
            "Loading the highest-resolution image everywhere",
            "Disabling images on mobile entirely"
          ], correct:1, explain:"Responsive images let the browser choose an appropriately-sized file per device, saving real bandwidth without sacrificing quality where it matters."
        },
        { q:"A common responsive navigation pattern collapses the menu into what on small screens?", options:[
            "A second full navbar",
            "A hamburger/toggle menu that reveals links on demand",
            "Removing navigation entirely",
            "An always-visible sidebar taking 50% of the screen"
          ], correct:1, explain:"The hamburger pattern hides links behind a toggle to reclaim space on small screens, while keeping every destination reachable."
        }
      ]
    }
  };

  function renderQuiz(quizId){
    const cfg = QUIZZES[quizId];
    const root = document.getElementById(quizId);
    const body = $(".quiz-body", root);
    const checkBtn = $(".quiz-check-btn", root);
    const summary = $(".quiz-summary", root);
    const answers = new Array(cfg.questions.length).fill(null);

    body.innerHTML = cfg.questions.map((item, qi)=>{
      const opts = item.options.map((opt, oi)=>
        '<label class="quiz-option" data-qi="'+qi+'" data-oi="'+oi+'">'+
          '<input type="radio" name="'+quizId+'-q'+qi+'" value="'+oi+'">'+
          '<span>'+escapeHtml(opt)+'</span>'+
        '</label>'
      ).join("");
      return '<div class="quiz-question" data-qi="'+qi+'">'+
        '<div class="quiz-q-text">'+(qi+1)+'. '+escapeHtml(item.q)+'</div>'+
        '<div class="quiz-options">'+opts+'</div>'+
        '<div class="quiz-feedback"></div>'+
      '</div>';
    }).join("");

    function checkAllAnswered(){
      checkBtn.disabled = answers.some(a=> a===null);
    }

    $all(".quiz-option", body).forEach(opt=>{
      opt.addEventListener("click", ()=>{
        const qi = parseInt(opt.dataset.qi,10);
        const oi = parseInt(opt.dataset.oi,10);
        answers[qi] = oi;
        $all('.quiz-option[data-qi="'+qi+'"]', body).forEach(o=> o.classList.remove("chosen"));
        opt.classList.add("chosen");
        checkAllAnswered();
      });
    });

    checkBtn.addEventListener("click", ()=>{
      let score = 0;
      cfg.questions.forEach((item, qi)=>{
        const chosen = answers[qi];
        if(chosen === item.correct) score++;
        addXp(10);
        const qBlock = $('.quiz-question[data-qi="'+qi+'"]', body);
        $all(".quiz-option", qBlock).forEach(o=>{
          const oi = parseInt(o.dataset.oi,10);
          o.style.pointerEvents = "none";
          if(oi === item.correct) o.classList.add("correct-answer");
          else if(oi === chosen) o.classList.add("wrong-answer");
        });
        const fb = $(".quiz-feedback", qBlock);
        const verdict = chosen === item.correct ? "Correct. " : "Not quite. ";
        fb.innerHTML = "<b>"+verdict+"</b>" + escapeHtml(item.explain);
        fb.classList.add("show");
      });
      checkBtn.disabled = true;
      checkBtn.textContent = "Answers checked";

      const pct = Math.round((score/cfg.questions.length)*100);
      let msg = pct === 100 ? "Perfect score — you've fully got this." :
                pct >= 50 ? "Solid grasp — review the explanations above for the rest." :
                "Worth a re-read of the module above before moving on.";
      summary.innerHTML =
        '<div class="score-big">'+score+' / '+cfg.questions.length+'</div>'+
        '<p>'+msg+' +'+(cfg.questions.length*10)+' XP earned.</p>'+
        '<button class="primary" id="'+quizId+'-unlock">Unlock next section →</button>';
      summary.classList.add("show");

      $("#"+quizId+"-unlock").addEventListener("click", ()=>{
        state.completed[cfg.badgeKey] = true;
        awardBadge(cfg.badgeKey);
        markComplete(cfg.section);
        unlockSection(cfg.unlocks);
        updateProgress();
        const nextEl = document.getElementById(cfg.unlocks);
        if(nextEl) nextEl.scrollIntoView({behavior:"smooth", block:"start"});
      });
    });
  }

  Object.keys(QUIZZES).forEach(renderQuiz);

  /* ---------- Final challenge: code playground ---------- */
  function runPlayground(){
    const code = $("#playgroundCode").value;
    $("#playgroundPreview").srcdoc = code;
  }
  $("#runCodeBtn").addEventListener("click", runPlayground);
  runPlayground();

  $all('#challengeChecklist input[type="checkbox"]').forEach(cb=>{
    cb.addEventListener("change", ()=>{
      const allChecked = $all('#challengeChecklist input[type="checkbox"]').every(c=>c.checked);
      $("#challengeCompleteBtn").disabled = !allChecked;
    });
  });
  $("#challengeCompleteBtn").addEventListener("click", ()=>{
    state.completed.final = true;
    markComplete("final");
    updateProgress();
    addXp(50);
    const cert = $("#certificate");
    $("#certDate").textContent = new Date().toLocaleDateString(undefined, { year:"numeric", month:"long", day:"numeric" });
    cert.classList.add("show");
    cert.scrollIntoView({behavior:"smooth", block:"center"});
  });

  updateProgress();
})();
</script>
</body>
</html>

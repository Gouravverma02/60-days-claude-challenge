  function handleAction(action, el){
    if (action === "goto"){
      state.step = el.getAttribute("data-step");
    } else if (action === "choice"){
      state.clickChoice = el.getAttribute("data-value");
    } else if (action === "feeling"){
      state.feeling = el.getAttribute("data-value");
    } else if (action === "toggle-word"){
      var challenge = el.getAttribute("data-challenge");
      var idx = el.getAttribute("data-idx");
      var map = challenge === "headline" ? state.headlineSelected : state.emotionSelected;
      map[idx] = !map[idx];
    } else if (action === "reveal1"){
      state.step = "reveal1";
    } else if (action === "reveal2"){
      state.step = "reveal2";
    } else if (action === "replay"){
      state.currentHeadline = null;
      state.currentEmotion = null;
      state.headlineWords = [];
      state.emotionWords = [];
      state.headlineSelected = {};
      state.emotionSelected = {};
      state.clickChoice = null;
      state.feeling = null;
      state.metrics = { headlineAccuracy:null, sourceReliability:null, emotionalManipulation:null, audienceTargeting:null };
      state.takeaways = [];
      state.step = "challenge1";
    } else if (action === "noop"){
      return;
    }
    render();
  }

  document.getElementById("app").addEventListener("click", function(e){
    var el = e.target.closest("[data-action]");
    if (!el) return;
    handleAction(el.getAttribute("data-action"), el);
  });

  render();
})();
</script>
</body>
</html>

/* ---- WIN ---- */
function handleWin(){
  Timer.stop();const ms=Timer.getMs(),cfg=curCfg;
  const stats={ms,parMs:cfg.parMs,moves:eng.moves,parMoves:cfg.parMoves,hints:hintsUsed,stars:0};
  stats.stars=computeStars(stats);
  const fast=ms<cfg.parMs*.7;
  const coins=computeCoins(stats,cfg,Rewards.d.streak+1);
  const xp=computeXP(stats,cfg);
  if(isDaily)Daily.markDone();
  const newBadges=Rewards.recordWin({level:cfg.level,stars:stats.stars,usedHint:hintsUsed>0,isDaily,fast});
  Rewards.addCoins(coins);Rewards.addXP(xp);
  if(cfg.level===Rewards.d.curLevel)Rewards.advLevel();
  refreshStatus();
  document.getElementById('res-stars').innerHTML='<span style="color:var(--coin)">'+'★'.repeat(stats.stars)+'</span>'+'☆'.repeat(3-stats.stars);
  document.getElementById('res-time').textContent=Timer.fmt(ms);
  document.getElementById('res-moves').textContent=String(eng.moves);
  document.getElementById('res-level').textContent=String(cfg.level);
  document.getElementById('coin-banner').textContent='+'+coins+(isDaily?' (3× Daily!) ':'')+' coins earned 🪙';
  document.getElementById('xp-banner').textContent='+'+xp+' XP earned ⭐';
  if(newBadges.length){const b=newBadges[0];document.getElementById('badge-icon').textContent=b.icon;document.getElementById('badge-text').textContent='Badge: '+b.name+(newBadges.length>1?' (+'+( newBadges.length-1)+' more)':'');document.getElementById('badge-banner').hidden=false;Voice.speak('Badge unlocked: '+b.name);}
  else document.getElementById('badge-banner').hidden=true;
  const nb=LB.addResult({ms,moves:eng.moves,grid:cfg.gridSize,level:cfg.level,date:new Date().toISOString(),user:curUser?.name||'Guest'});
  document.getElementById('res-new-best').hidden=!nb;
  popFloat('+'+coins+' 🪙','coin-pop');popFloat('+'+xp+' XP','xp-pop');
  document.getElementById('results-overlay').hidden=false;
  document.getElementById('btn-next-level').focus();
  Confetti.burst();SFX.win();
  Voice.speak('Level '+cfg.level+' complete! '+stats.stars+' stars. '+coins+' coins earned!');
  document.getElementById('res-ai-note').textContent='Analyzing…';
  AI.coachNote(stats).then(n=>{document.getElementById('res-ai-note').textContent=n;Chat.notify(n,{ping:true});});
  if(cfg.level>=Rewards.d.curLevel-1)showLvlBurst(Rewards.d.curLevel);
  renderBadges();renderFrames();renderPUShop();LB.render();
}

function computeStars(s){if(s.ms<=s.parMs&&s.moves<=s.parMoves)return 3;if(s.ms<=s.parMs*1.3&&s.moves<=s.parMoves*1.3)return 2;return 1;}
function computeCoins(s,cfg,streak){let c=10+cfg.level*2;if(s.ms<=s.parMs)c+=15;if(s.moves<=s.parMoves)c+=10;c+=Math.min(streak,10)*2;if(isDaily)c=Math.round(c*3);return c;}
function computeXP(s,cfg){let x=cfg.xpReward;if(s.stars===3)x+=20;if(s.stars>=2)x+=10;if(s.hints===0)x+=15;if(isDaily)x+=30;return x;}
function popFloat(txt,cls){const el=document.createElement('div');el.className=cls;el.textContent=txt;el.style.left=(window.innerWidth/2-40)+'px';el.style.top=(window.innerHeight*.45)+'px';document.body.appendChild(el);setTimeout(()=>el.remove(),1200);}
function showLvlBurst(lvl){const b=document.getElementById('lvl-burst');document.getElementById('lvl-burst-text').textContent='LEVEL '+lvl+'!';b.hidden=false;Voice.speak('Level '+lvl+' unlocked!');setTimeout(()=>b.hidden=true,1900);}

/* ---- RESULTS BUTTONS ---- */
document.getElementById('btn-next-level').onclick=()=>{document.getElementById('results-overlay').hidden=true;buildPuzzle(Math.min(Rewards.d.curLevel,Levels.MAX),false);renderLevelMap();showStage('puzzle');};
document.getElementById('btn-replay').onclick=()=>{document.getElementById('results-overlay').hidden=true;buildPuzzle(curCfg.level,isDaily);};
document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.getElementById('results-overlay').hidden=true;document.getElementById('profile-overlay').hidden=true;document.getElementById('settings-overlay').hidden=true;}});

/* ---- BADGES ---- */
function renderBadges(){
  const shelf=document.getElementById('badges-shelf'),owned=Rewards.d.badges;shelf.innerHTML='';
  Rewards.BADGES.forEach(b=>{const el=document.createElement('div');el.className='badge-item '+(owned.includes(b.id)?'unlocked':'locked');el.title=b.name+(owned.includes(b.id)?' ✅':' 🔒');el.innerHTML='<span class="b-icon">'+b.icon+'</span><span class="b-name">'+b.name+'</span>';shelf.appendChild(el);});
}

/* ---- FRAMES ---- */
function renderFrames(){
  const shop=document.getElementById('frame-shop');shop.innerHTML='';
  const p=Rewards.d;
  Rewards.FRAMES.forEach(f=>{
    const owned=p.frames.includes(f.id),active=p.activeFrame===f.id;
    const el=document.createElement('div');el.className='frame-item'+(active?' active':'');el.tabIndex=0;
    el.innerHTML=`<div class="frame-swatch ${f.css}"></div><div class="f-name">${f.name}</div><div class="f-cost">${owned?(active?'Active':'Owned'):f.cost+' 🪙'}</div>`;
    const act=()=>{
      if(owned){Rewards.setFrame(f.id);const b=document.getElementById('board');if(b)b.className='board '+f.id;renderFrames();SFX.click();}
      else{const r=Rewards.unlockFrame(f.id);if(r.ok){Rewards.setFrame(f.id);const b=document.getElementById('board');if(b)b.className='board '+f.id;refreshStatus();renderFrames();SFX.coin();toast('🖼 '+f.name+' unlocked!');Voice.speak(f.name+' frame unlocked!');}else if(r.r==='coins'){toast('Not enough coins for '+f.name+'!');SFX.err();}}
    };
    el.onclick=act;el.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();act();}};
    shop.appendChild(el);
  });
}

/* ---- POWERUP SHOP ---- */
function renderPUShop(){
  const shop=document.getElementById('powerup-shop');if(!shop)return;shop.innerHTML='';
  Rewards.POWERUPS.forEach(p=>{
    const cur=Rewards.d.pu[p.id]||0;
    const el=document.createElement('div');el.className='frame-item';el.style.width='110px';
    el.innerHTML=`<div style="font-size:1.6rem">${p.icon}</div><div class="f-name">${p.name}</div><div style="font-size:.65rem;color:var(--paper-dim);margin:2px 0">${p.desc}</div><div class="f-cost">${p.cost} 🪙 · Have: ${cur}</div>`;
    el.onclick=()=>{if(Rewards.buyPU(p.id)){refreshStatus();renderPUShop();SFX.coin();toast(p.icon+' Bought '+p.name+'!');}else{toast('Need '+p.cost+' coins!');SFX.err();}};
    shop.appendChild(el);
  });
}

/* ---- PROFILE ---- */
function openProfile(){
  const d=Rewards.d,rank=Levels.rankFor(d.xp);
  document.getElementById('profile-avatar').textContent=(curUser?.name||'G')[0].toUpperCase();
  document.getElementById('profile-name').textContent=curUser?.name||'Guest Player';
  document.getElementById('profile-rank').textContent=rank.icon+' '+rank.name;
  document.getElementById('ps-wins').textContent=d.wins;
  document.getElementById('ps-streak').textContent=d.bestStreak;
  document.getElementById('ps-stars').textContent=Object.values(d.stars).reduce((a,b)=>a+b,0);
  document.getElementById('ps-maxlvl').textContent=d.maxLevel;
  document.getElementById('ps-coins').textContent=d.coins;
  document.getElementById('ps-xp').textContent=d.xp;
  const pb=document.getElementById('profile-badges');pb.innerHTML='';
  if(!d.badges.length)pb.innerHTML='<span style="color:var(--paper-dim);font-size:.82rem">No badges yet!</span>';
  else d.badges.forEach(id=>{const b=Rewards.BADGES.find(x=>x.id===id);if(b){const s=document.createElement('span');s.style.fontSize='1.4rem';s.title=b.name;s.textContent=b.icon;pb.appendChild(s);}});
  document.getElementById('profile-overlay').hidden=false;
}
function resetProgress(){if(!confirm('Reset all progress?'))return;Rewards.resetAll();Rewards.load(curUser?.id);refreshStatus();renderBadges();renderFrames();renderPUShop();LB.render();document.getElementById('profile-overlay').hidden=true;toast('Progress reset!');}

/* ---- SETTINGS ---- */
function openSettings(){
  document.getElementById('set-voice').checked=Voice.isOn();
  document.getElementById('set-sfx').checked=SFX.isOn();
  document.getElementById('set-motion').checked=S.get('fsp.noMotion',false);
  document.getElementById('set-ai').checked=S.get('fsp.aicoach',true);
  document.getElementById('set-apikey').value=S.get('fsp.apikey','');
  document.getElementById('settings-overlay').hidden=false;
}
function saveSettings(){
  Voice.setOn(document.getElementById('set-voice').checked);
  SFX.setOn(document.getElementById('set-sfx').checked);
  S.set('fsp.noMotion',document.getElementById('set-motion').checked);
  S.set('fsp.aicoach',document.getElementById('set-ai').checked);
  S.set('fsp.apikey',document.getElementById('set-apikey').value.trim());
  document.getElementById('settings-overlay').hidden=true;toast('Settings saved!');
}

/* ---- AUTH FLOW ---- */
function switchAuthTab(t){
  document.getElementById('login-form').hidden=t!=='login';
  document.getElementById('signup-form').hidden=t==='login';
  document.getElementById('tab-login').classList.toggle('active',t==='login');
  document.getElementById('tab-signup').classList.toggle('active',t!=='login');
}
function doLogin(){
  const u=document.getElementById('login-user').value.trim(),p=document.getElementById('login-pass').value;
  if(!u||!p){document.getElementById('login-error').textContent='Fill in all fields.';return;}
  const r=Auth.login(u,p);if(!r.ok){document.getElementById('login-error').textContent=r.error;SFX.err();return;}
  Auth.startSession(r.user);startGame(r.user);
}
function doSignup(){
  const n=document.getElementById('signup-name').value.trim(),e=document.getElementById('signup-email').value.trim(),p=document.getElementById('signup-pass').value;
  const r=Auth.register(n,e,p);if(!r.ok){document.getElementById('signup-error').textContent=r.error;SFX.err();return;}
  Auth.startSession(r.user);startGame(r.user);
}
function doGuest(){startGame(Auth.guestSession());}
function checkExistingSession(){const s=Auth.getSession();if(s)startGame(s);else toast('No session found. Please sign in.');}
function doLogout(){
  if(!confirm('Sign out?'))return;
  Auth.endSession();
  Timer.stop();Timer.reset();
  Camera.stop();
  eng=null;bv=null;img=null;curUser=null;curCfg=null;
  document.getElementById('main-app').hidden=true;
  document.getElementById('auth-screen').hidden=false;
  document.getElementById('results-overlay').hidden=true;
  document.getElementById('profile-overlay').hidden=true;
  document.getElementById('settings-overlay').hidden=true;
  document.getElementById('login-error').textContent='';
  document.getElementById('signup-error').textContent='';
  switchAuthTab('login');
  toast('Signed out successfully!');
}

/* ---- START GAME ---- */
function startGame(user){
  curUser=user;Rewards.load(user.id);
  document.getElementById('auth-screen').hidden=true;document.getElementById('main-app').hidden=false;
  refreshStatus();renderBadges();renderFrames();renderPUShop();LB.render();
  Chat.init(()=>{const d=Rewards.d;return{inPuzzle:eng!==null&&!document.getElementById('puzzle-stage').hidden,level:curCfg?.level||d.curLevel,grid:curCfg?.gridSize||Levels.cfgFor(d.curLevel).gridSize,coins:d.coins,streak:d.streak,badges:d.badges.length};});
  initCamera();
  Voice.speak('Welcome, '+user.name+'! Ready to puzzle?');
}

/* ---- BOOT ---- */
(()=>{
  const s=Auth.getSession();
  // Only auto-resume real (non-guest) accounts
  if(s && !s.guest){
    startGame(s);
  } else {
    // Always show auth screen fresh for guests or no session
    Auth.endSession();
    document.getElementById('auth-screen').hidden=false;
    document.getElementById('main-app').hidden=true;
  }
})();

/* ---- EXPOSE GLOBALS (called from onclick attributes) ---- */
window.switchAuthTab=switchAuthTab;
window.doLogin=doLogin;
window.doSignup=doSignup;
window.doGuest=doGuest;
window.doLogout=doLogout;
window.checkExistingSession=checkExistingSession;
window.openProfile=openProfile;
window.openSettings=openSettings;
window.saveSettings=saveSettings;
window.resetProgress=resetProgress;
window.usePowerup=usePowerup;
window.startDailyChallenge=startDailyChallenge;
window.initCamera=initCamera;
window.showStage=showStage;
window.buildPuzzle=buildPuzzle;

})();
</script>
</body>
</html>

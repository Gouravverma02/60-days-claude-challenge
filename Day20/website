<script>
(function(){
'use strict';

/* ---- STORAGE ---- */
const S={
  get:(k,d)=>{try{const r=localStorage.getItem(k);return r!==null?JSON.parse(r):d}catch(e){return d}},
  set:(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}},
  del:(k)=>{try{localStorage.removeItem(k)}catch(e){}}
};

/* ---- AUTH ---- */
const Auth=(()=>{
  const UK='fsp.users.v1', SK='fsp.session.v1';
  const getUsers=()=>S.get(UK,{});
  const saveUsers=u=>S.set(UK,u);
  function register(name,email,pass){
    const u=getUsers(), id=email.toLowerCase().trim();
    if(!name||name.length<2)return{ok:false,error:'Name must be at least 2 chars.'};
    if(!id.includes('@'))return{ok:false,error:'Enter a valid email.'};
    if(pass.length<6)return{ok:false,error:'Password must be 6+ chars.'};
    if(u[id])return{ok:false,error:'Email already registered.'};
    u[id]={id,name:name.trim(),password:btoa(pass),created:Date.now()};
    saveUsers(u);
    return{ok:true,user:{id,name:name.trim()}};
  }
  function login(emailOrName,pass){
    const u=getUsers(), id=emailOrName.toLowerCase().trim();
    const user=u[id]||Object.values(u).find(x=>x.name.toLowerCase()===id);
    if(!user)return{ok:false,error:'Account not found.'};
    if(user.password!==btoa(pass))return{ok:false,error:'Wrong password.'};
    return{ok:true,user:{id:user.id,name:user.name}};
  }
  const startSession=u=>S.set(SK,u);
  const endSession=()=>S.del(SK);
  const getSession=()=>S.get(SK,null);
  const guestSession=()=>{const g={id:'guest_'+Date.now(),name:'Guest Player',guest:true};S.set(SK,g);return g;};
  return{register,login,startSession,endSession,getSession,guestSession};
})();

/* ---- VOICE ---- */
const Voice=(()=>{
  const sup='speechSynthesis'in window;
  let on=S.get('fsp.voice',true);
  const isOn=()=>sup&&on;
  const setOn=v=>{on=!!v;S.set('fsp.voice',on);};
  function speak(txt){
    if(!isOn())return;
    try{window.speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(txt);u.rate=1.02;u.pitch=1;u.volume=.9;window.speechSynthesis.speak(u);}catch(e){}
  }
  return{isOn,setOn,speak};
})();

/* ---- SFX ---- */
const SFX=(()=>{
  let on=S.get('fsp.sfx',true);
  const AC=window.AudioContext?new AudioContext():null;
  function tone(f,d,t='sine',v=.15){
    if(!on||!AC)return;
    try{
      if(AC.state==='suspended')AC.resume();
      const o=AC.createOscillator(),g=AC.createGain();
      o.connect(g);g.connect(AC.destination);
      o.type=t;o.frequency.setValueAtTime(f,AC.currentTime);
      g.gain.setValueAtTime(v,AC.currentTime);
      g.gain.exponentialRampToValueAtTime(.001,AC.currentTime+d);
      o.start(AC.currentTime);o.stop(AC.currentTime+d);
    }catch(e){}
  }
  const swap=()=>tone(440,.08,'sine',.1);
  const correct=()=>tone(660,.12,'sine',.15);
  const win=()=>[523,659,784,1047].forEach((f,i)=>setTimeout(()=>tone(f,.2,'sine',.2),i*100));
  const coin=()=>tone(880,.1,'triangle',.12);
  const err=()=>tone(220,.15,'sawtooth',.08);
  const click=()=>tone(600,.05,'sine',.05);
  const setOn=v=>{on=!!v;S.set('fsp.sfx',on);};
  const isOn=()=>on;
  return{swap,correct,win,coin,err,click,setOn,isOn};
})();

/* ---- TOAST ---- */
function toast(msg,dur=3000){
  const t=document.createElement('div');
  t.className='toast';t.textContent=msg;
  document.body.appendChild(t);
  setTimeout(()=>t.remove(),dur+300);
}

/* ---- TIMER ---- */
const Timer=(()=>{
  let startAt=null,raf=null,frozen=false,elapsed=0,running=false;
  const el=document.getElementById('hud-time');
  const fmt=(ms)=>{const t=Math.floor(ms/100),s=Math.floor(ms/1000)%60,m=Math.floor(ms/60000);return`${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}.${t%10}`;};
  function tick(){if(!running||frozen)return;el.textContent=fmt(performance.now()-startAt);raf=requestAnimationFrame(tick);}
  function start(){if(running)return;startAt=performance.now()-elapsed;running=true;raf=requestAnimationFrame(tick);}
  function stop(){if(!running)return;elapsed=performance.now()-startAt;running=false;if(raf)cancelAnimationFrame(raf);el.textContent=fmt(elapsed);}
  function reset(){running=false;frozen=false;if(raf)cancelAnimationFrame(raf);startAt=null;elapsed=0;el.textContent=fmt(0);}
  function freeze(ms){frozen=true;if(raf)cancelAnimationFrame(raf);setTimeout(()=>{frozen=false;startAt=performance.now()-elapsed;if(running)raf=requestAnimationFrame(tick);},ms);}
  const getMs=()=>running&&!frozen?performance.now()-startAt:elapsed;
  return{start,stop,reset,freeze,getMs,fmt};
})();

/* ---- LEVELS ---- */
const Levels=(()=>{
  const MAX=20;
  function gridFor(l){if(l<=2)return 3;if(l<=5)return 4;if(l<=10)return 5;if(l<=15)return 6;return 7;}
  function tierStart(g){if(g===3)return 1;if(g===4)return 3;if(g===5)return 6;if(g===6)return 11;return 16;}
  function cfgFor(l){
    l=Math.max(1,Math.min(l,MAX));
    const g=gridFor(l),total=g*g,idx=l-tierStart(g),tight=Math.max(.7,1-idx*.07);
    return{level:l,gridSize:g,total,parMs:Math.round(total*4200*tight),parMoves:Math.round(total*1.7*tight),xpReward:10+l*5};
  }
  const RANKS=[
    {xp:0,name:'Rookie',icon:'🌱'},{xp:100,name:'Solver',icon:'🧩'},
    {xp:300,name:'Sharp Eye',icon:'👁'},{xp:600,name:'Pro Face',icon:'🎯'},
    {xp:1000,name:'Expert',icon:'⚡'},{xp:2000,name:'Master',icon:'🏆'},
    {xp:5000,name:'Legend',icon:'👑'},
  ];
  function rankFor(xp){for(let i=RANKS.length-1;i>=0;i--)if(xp>=RANKS[i].xp)return RANKS[i];return RANKS[0];}
  function nextXp(xp){for(let i=0;i<RANKS.length;i++)if(xp<RANKS[i].xp)return RANKS[i].xp;return null;}
  return{cfgFor,MAX,rankFor,nextXp};
})();

/* ---- REWARDS ---- */
const Rewards=(()=>{
  let uid='guest';
  const key=()=>'fsp.prog.'+uid+'.v2';
  const BADGES=[
    {id:'first-win',icon:'🎉',name:'First Solve',check:p=>p.wins>=1},
    {id:'five-wins',icon:'🧩',name:'5 Wins',check:p=>p.wins>=5},
    {id:'ten-wins',icon:'🏆',name:'10 Wins',check:p=>p.wins>=10},
    {id:'twenty-wins',icon:'🥇',name:'20 Wins',check:p=>p.wins>=20},
    {id:'streak-3',icon:'🔥',name:'3 Streak',check:p=>p.bestStreak>=3},
    {id:'streak-7',icon:'⚡',name:'7 Streak',check:p=>p.bestStreak>=7},
    {id:'streak-15',icon:'💥',name:'15 Streak',check:p=>p.bestStreak>=15},
    {id:'three-star',icon:'🌟',name:'3-Star Win',check:p=>Object.values(p.stars).some(s=>s>=3)},
    {id:'all-stars-5',icon:'✨',name:'5× Perfect',check:p=>Object.keys(p.stars).filter(k=>p.stars[k]>=3).length>=5},
    {id:'level-5',icon:'🚀',name:'Level 5',check:p=>p.maxLevel>=5},
    {id:'level-10',icon:'🌙',name:'Level 10',check:p=>p.maxLevel>=10},
    {id:'level-20',icon:'👑',name:'Level 20',check:p=>p.maxLevel>=20},
    {id:'no-hint',icon:'🧠',name:'No-Hint Win',check:p=>p.noHintWins>=1},
    {id:'speed',icon:'⚡',name:'Speed Demon',check:p=>p.fastWins>=1},
    {id:'coins-100',icon:'💰',name:'100 Coins',check:p=>p.coins>=100},
    {id:'coins-500',icon:'💎',name:'500 Coins',check:p=>p.coins>=500},
    {id:'daily',icon:'📅',name:'Daily Solver',check:p=>p.dailyWins>=1},
    {id:'power-user',icon:'⚙',name:'Power User',check:p=>p.puUsed>=10},
  ];
  const FRAMES=[
    {id:'frame-classic',name:'Classic',cost:0,css:'frame-classic'},
    {id:'frame-gold',name:'Gold Edge',cost:60,css:'frame-gold'},
    {id:'frame-violet',name:'Violet Glow',cost:90,css:'frame-violet'},
    {id:'frame-neon',name:'Neon Win',cost:120,css:'frame-neon'},
    {id:'frame-fire',name:'Fire Ring',cost:160,css:'frame-fire'},
    {id:'frame-ice',name:'Ice Crystal',cost:160,css:'frame-ice'},
    {id:'frame-rainbow',name:'Rainbow',cost:300,css:'frame-rainbow'},
  ];
  const POWERUPS=[
    {id:'freeze',name:'Freeze Timer',icon:'❄️',cost:30,desc:'Stops timer 10s'},
    {id:'reveal',name:'Reveal',icon:'👁️',cost:25,desc:'Shows solution briefly'},
    {id:'autopair',name:'Auto-Place',icon:'🎯',cost:40,desc:'Places one piece'},
    {id:'shuffle',name:'Re-mix',icon:'🔀',cost:20,desc:'Gentle reshuffle'},
  ];
  function def(){return{coins:0,curLevel:1,maxLevel:1,streak:0,bestStreak:0,wins:0,noHintWins:0,fastWins:0,dailyWins:0,puUsed:0,stars:{},badges:[],frames:['frame-classic'],activeFrame:'frame-classic',xp:0,pu:{freeze:1,reveal:1,autopair:0,shuffle:2}};}
  let d=null;
  function load(id){uid=id||'guest';d=Object.assign(def(),S.get(key(),{}));if(!d.stars)d.stars={};if(!d.badges)d.badges=[];if(!d.frames||!d.frames.length)d.frames=['frame-classic'];if(!d.activeFrame)d.activeFrame='frame-classic';if(!d.pu)d.pu=def().pu;}
  const save=()=>S.set(key(),d);
  const addCoins=n=>{d.coins+=n;save();};
  const addXP=n=>{d.xp+=n;save();};
  const spend=n=>{if(d.coins<n)return false;d.coins-=n;save();return true;};
  function recordWin({level,stars,usedHint,isDaily,fast}){
    d.wins++;if(!usedHint)d.noHintWins++;if(fast)d.fastWins++;if(isDaily)d.dailyWins++;
    d.streak++;d.bestStreak=Math.max(d.bestStreak,d.streak);d.maxLevel=Math.max(d.maxLevel,level);
    const prev=d.stars[level]||0;d.stars[level]=Math.max(prev,stars);save();
    return checkBadges();
  }
  function checkBadges(){const n=[];BADGES.forEach(b=>{if(!d.badges.includes(b.id)&&b.check(d)){d.badges.push(b.id);n.push(b);}});if(n.length)save();return n;}
  function unlockFrame(id){const f=FRAMES.find(x=>x.id===id);if(!f)return{ok:false,r:'unknown'};if(d.frames.includes(id))return{ok:false,r:'owned'};if(!spend(f.cost))return{ok:false,r:'coins'};d.frames.push(id);save();return{ok:true};}
  function setFrame(id){if(!d.frames.includes(id))return false;d.activeFrame=id;save();return true;}
  function buyPU(id,qty=1){const p=POWERUPS.find(x=>x.id===id);if(!p)return false;if(!spend(p.cost))return false;d.pu[id]=(d.pu[id]||0)+qty;save();return true;}
  function usePU(id){if(!d.pu[id])return false;d.pu[id]--;d.puUsed=(d.puUsed||0)+1;save();return true;}
  const advLevel=()=>{d.curLevel=Math.min(d.curLevel+1,Levels.MAX);save();};
  const resetAll=()=>{S.del(key());d=def();};
  return{get d(){return d;},BADGES,FRAMES,POWERUPS,load,addCoins,addXP,spend,recordWin,checkBadges,unlockFrame,setFrame,buyPU,usePU,advLevel,resetAll};
})();

/* ---- AI PROVIDER ---- */
const AI=(()=>{
  async function callAPI(sys,msg){
    const key=S.get('fsp.apikey','');if(!key)return null;
    try{
      const r=await fetch('https://api.anthropic.com/v1/messages',{
        method:'POST',
        headers:{'Content-Type':'application/json','x-api-key':key,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},
        body:JSON.stringify({model:'claude-sonnet-4-6',max_tokens:200,system:sys,messages:[{role:'user',content:msg}]})
      });
      if(!r.ok)return null;
      const j=await r.json();return j.content?.[0]?.text||null;
    }catch(e){return null;}
  }
  function suggestHint(eng){
    for(let c=0;c<eng.total;c++){
      const t=eng.tileAt(c);if(t===c)continue;
      const tc=eng.cellOf(t),st=eng.tileAt(tc);
      const gain=(t===tc?1:0)+(st===c?1:0);
      if(gain>=1)return{cellA:c,cellB:tc,gain};
    }
    for(let i=0;i<eng.total;i++)if(eng.tileAt(i)!==i)return{cellA:i,cellB:eng.cellOf(eng.tileAt(i)),gain:0};
    return null;
  }
  async function coachNote(stats){
    const sys='You are a brief encouraging puzzle coach. ONE sentence of personalized feedback under 20 words. Be warm and specific.';
    const msg=`Stars:${stats.stars}/3 Time:${Math.round(stats.ms/1000)}s(par:${Math.round(stats.parMs/1000)}s) Moves:${stats.moves}(par:${stats.parMoves}) Hints:${stats.hints}`;
    const r=await callAPI(sys,msg);if(r)return r;
    if(stats.ms<=stats.parMs&&stats.moves<=stats.parMoves)return'Flawless! You nailed both time and move targets. 🏆';
    if(stats.ms<=stats.parMs)return'Lightning fast! A few extra moves but what a time. ⚡';
    if(stats.moves<=stats.parMoves)return'Perfectly efficient — every move counted. 🎯';
    if(stats.hints>0)return'Good effort! Next run, trust your instincts and skip the hint.';
    return'Solid solve! Keep chasing those par targets.';
  }
  async function chatReply(msg,ctx){
    const aiOn=S.get('fsp.aicoach',true);
    if(aiOn){
      const sys=`You are an encouraging AI puzzle coach for "Face Slice Pro", a selfie-scramble puzzle game. Keep answers SHORT (1-2 sentences). Be friendly. Game: Level ${ctx.level}, Coins ${ctx.coins}, Streak ${ctx.streak}, Badges ${ctx.badges}. Grid: ${ctx.grid}×${ctx.grid}. Playing: ${ctx.inPuzzle?'yes':'no'}.`;
      const r=await callAPI(sys,msg);if(r)return r;
    }
    return localReply(msg,ctx);
  }
  function localReply(msg,ctx){
    const m=msg.toLowerCase();
    if(m.match(/hi|hello|hey/))return"Hey! I'm your AI Puzzle Coach 👋 Ask about hints, coins, badges or strategy!";
    if(m.match(/hint|help|stuck/))return ctx.inPuzzle?'Click ✨ AI Hint on the board — I\'ll highlight the best swap!':'Start a puzzle first, then ask for hints!';
    if(m.match(/coin/))return`You have ${ctx.coins} coins. Win fast for bonuses — shop frames and powerups below!`;
    if(m.match(/badge/))return`You've earned ${ctx.badges} badges. Try no-hint wins, high streaks, and all 20 levels!`;
    if(m.match(/level/))return`You're on level ${ctx.level}. Grid grows: 3×3→4×4→5×5→6×6→7×7!`;
    if(m.match(/powerup|power.up/))return'Powerups live in the Rewards panel below. Freeze stops the timer, Reveal shows the solution!';
    if(m.match(/daily/))return'The Daily Challenge gives 3× coin bonus! Check the level select screen.';
    if(m.match(/streak/))return`Current streak: ${ctx.streak}. Keep winning to unlock streak badges!`;
    if(m.match(/frame/))return'Buy board frames with coins in the Rewards panel. Rainbow costs 300 coins but looks stunning!';
    if(m.match(/xp|rank/))return'Win puzzles to earn XP. Rank up from Rookie→Solver→Expert→Master→Legend!';
    if(m.match(/strategy|tip/)){
      const t=['Start with corners — they have fewest neighbors to confuse you.','Look for pairs: if A belongs where B is and vice versa, one swap solves both!','Use Freeze when you\'re in great flow — bank those extra seconds.','No-hint wins earn bonus XP and unlock the Brain badge!'];
      return t[Math.floor(Math.random()*t.length)];
    }
    const d=["Ask me about strategy, coins, powerups, or your progress!","Try: 'Give me a tip' or 'How do I earn more coins?'"];
    return d[Math.floor(Math.random()*d.length)];
  }
  return{suggestHint,coachNote,chatReply};
})();

/* ---- CONFETTI ---- */
const Confetti=(()=>{
  const colors=['#ff9f1c','#ffd34d','#4caf6a','#9c7bd6','#f3ece0','#ff69b4'];
  function burst(){
    if(S.get('fsp.noMotion',false))return;
    const canvas=document.getElementById('confetti-canvas');
    canvas.hidden=false;canvas.width=window.innerWidth;canvas.height=window.innerHeight;
    const ctx=canvas.getContext('2d');
    const P=Array.from({length:120},()=>({x:canvas.width/2+(Math.random()-.5)*160,y:canvas.height*.35,vx:(Math.random()-.5)*10,vy:-Math.random()*10-3,sz:5+Math.random()*6,color:colors[Math.floor(Math.random()*colors.length)],rot:Math.random()*Math.PI,vrot:(Math.random()-.5)*.3,g:.3,life:0,max:80+Math.random()*30}));
    function tick(){
      ctx.clearRect(0,0,canvas.width,canvas.height);let alive=false;
      P.forEach(p=>{if(p.life>=p.max)return;alive=true;p.life++;p.vy+=p.g;p.x+=p.vx;p.y+=p.vy;p.rot+=p.vrot;
        const fade=1-p.life/p.max;ctx.save();ctx.globalAlpha=Math.max(0,fade);ctx.translate(p.x,p.y);ctx.rotate(p.rot);ctx.fillStyle=p.color;ctx.fillRect(-p.sz/2,-p.sz/2,p.sz,p.sz*.6);ctx.restore();});
      if(alive)requestAnimationFrame(tick);else{ctx.clearRect(0,0,canvas.width,canvas.height);canvas.hidden=true;}
    }
    requestAnimationFrame(tick);
  }
  return{burst};
})();

/* ---- CAMERA ---- */
const Camera=(()=>{
  let stream=null;
  const elV=document.getElementById('video'),elImg=document.getElementById('snapshot-img');
  const elGuide=document.getElementById('face-guide'),elFlash=document.getElementById('flash-overlay');
  const elStatus=document.getElementById('camera-status'),elTake=document.getElementById('btn-take-photo');
  const elRetake=document.getElementById('btn-retake-photo'),elRetry=document.getElementById('btn-retry-camera');
  const elCanvas=document.getElementById('capture-canvas');
  async function start(){
    elStatus.classList.remove('error');elStatus.textContent='Requesting camera access…';
    elTake.disabled=true;elRetry.hidden=true;elImg.hidden=true;elV.hidden=false;elGuide.hidden=false;elRetake.hidden=true;elTake.hidden=false;
    if(!navigator.mediaDevices?.getUserMedia){showErr('Camera API not supported in this browser. Try Chrome over HTTPS.');return;}
    try{stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user',width:{ideal:720},height:{ideal:720}},audio:false});}
    catch(e){
      try{stream=await navigator.mediaDevices.getUserMedia({video:true,audio:false});}
      catch(e2){
        const n=e2?.name||'Error';
        if(n==='NotAllowedError'||n==='PermissionDeniedError')showErr('Camera denied. Allow permission in browser settings then retry.');
        else if(n==='NotFoundError')showErr('No camera found on this device.');
        else showErr('Camera error: '+n);return;
      }
    }
    elV.srcObject=stream;elV.classList.add('mirrored');
    await elV.play().catch(()=>{});
    elStatus.textContent='Center your face in the circle, then tap Take Photo.';
    elTake.disabled=false;elRetry.hidden=true;
    Voice.speak('Camera ready. Center your face and take a photo.');
  }
  function showErr(msg){elStatus.classList.add('error');elStatus.textContent=msg;elTake.disabled=true;elRetry.hidden=false;}
  function stop(){if(stream){stream.getTracks().forEach(t=>t.stop());stream=null;}}
  function capture(){
    const vw=elV.videoWidth,vh=elV.videoHeight,side=Math.min(vw,vh),sx=(vw-side)/2,sy=(vh-side)/2,SZ=720;
    elCanvas.width=SZ;elCanvas.height=SZ;
    const ctx=elCanvas.getContext('2d');
    ctx.save();ctx.translate(SZ,0);ctx.scale(-1,1);ctx.drawImage(elV,sx,sy,side,side,0,0,SZ,SZ);ctx.restore();
    elFlash.classList.add('fire');elFlash.addEventListener('animationend',()=>elFlash.classList.remove('fire'),{once:true});
    return elCanvas.toDataURL('image/png');
  }
  return{start,stop,capture};
})();

/* ---- LEADERBOARD ---- */
const LB=(()=>{
  const KEY='fsp.lb.v2';
  const load=()=>S.get(KEY,[]);
  const save=e=>S.set(KEY,e);

/* ---- PUZZLE ENGINE ---- */
function createEngine(gs){
  const N=gs,total=N*N;let order=[],moves=0;
  function scramble(){
    order=Array.from({length:total},(_,i)=>i);
    do{for(let i=order.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[order[i],order[j]]=[order[j],order[i]];}}
    while(isSolved()||order.filter((v,i)=>v!==i).length<Math.max(4,Math.floor(total*.5)));
    moves=0;
  }
  function isSolved(){return order.every((v,i)=>v===i);}
  function swap(a,b){if(a===b)return;const t=order[a];order[a]=order[b];order[b]=t;moves++;}
  function tileAt(c){return order[c];}
  function cellOf(t){return order.indexOf(t);}
  function isCorrect(c){return order[c]===c;}
  function correctCount(){return order.filter((v,i)=>v===i).length;}
  return{get N(){return N;},get total(){return total;},get moves(){return moves;},scramble,isSolved,swap,tileAt,cellOf,isCorrect,correctCount};
}

/* ---- BOARD VIEW ---- */
function createBoardView(boardEl,eng,imgUrl){
  const N=eng.N;let cs=0;const tiles=new Map();
  function getBoardSize(){
    // Force layout recalc; use offsetWidth as fallback
    const r=boardEl.getBoundingClientRect();
    return r.width>0?r.width:boardEl.offsetWidth||480;
  }
  function layout(){if(tiles.size>0)makeTiles();}
  function applySize(el){el.style.width=el.style.height=cs+'px';}
  function pos(el,cell,anim){const row=Math.floor(cell/N),col=cell%N;if(!anim){el.style.transition='none';}el.style.left=(col*cs)+'px';el.style.top=(row*cs)+'px';if(!anim){el.offsetHeight;el.style.transition='';}}
  function makeTiles(){
    cs=getBoardSize()/N;
    tiles.forEach((el,id)=>{
      const row=Math.floor(id/N),col=id%N;
      // Use pixel offsets for background-position — works for any N
      el.style.backgroundSize=(cs*N)+'px '+(cs*N)+'px';
      el.style.backgroundPosition=(-col*cs)+'px '+(-row*cs)+'px';
      applySize(el);pos(el,eng.cellOf(id),false);
    });
  }
  function build(){
    boardEl.innerHTML='';tiles.clear();
    for(let id=0;id<eng.total;id++){
      const el=document.createElement('div');
      el.className='tile';el.dataset.tileId=String(id);
      el.setAttribute('role','button');el.setAttribute('tabindex','0');el.setAttribute('aria-label','Piece '+(id+1));
      el.style.backgroundImage='url('+imgUrl+')';
      boardEl.appendChild(el);tiles.set(id,el);
    }
    // Use requestAnimationFrame so board has real dimensions
    requestAnimationFrame(()=>{
      requestAnimationFrame(()=>{
        makeTiles();
        refresh();
      });
    });
  }
  function move(id,anim){pos(tiles.get(id),eng.cellOf(id),anim!==false);}
  function refresh(){tiles.forEach((el,id)=>{el.classList.toggle('correct',eng.isCorrect(eng.cellOf(id)));});}
  function size(el){applySize(el);}
  function cellPx(){return cs;}
  function getTile(id){return tiles.get(id);}
  function allTiles(){return tiles;}
  function pointToCell(cx,cy){const r=boardEl.getBoundingClientRect();return Math.max(0,Math.min(N-1,Math.floor((cy-r.top)/cs)))*N+Math.max(0,Math.min(N-1,Math.floor((cx-r.left)/cs)));}
  function revealSolved(dur){
    const ov=document.createElement('div');
    ov.style.cssText='position:absolute;inset:0;z-index:90;background-image:url('+imgUrl+');background-size:cover;opacity:0;transition:opacity .3s;pointer-events:none;border-radius:inherit;';
    boardEl.appendChild(ov);requestAnimationFrame(()=>ov.style.opacity='1');
    setTimeout(()=>{ov.style.opacity='0';setTimeout(()=>ov.remove(),300);},dur);
  }
  return{build,layout,move,refresh,cellPx,getTile,allTiles,pointToCell,revealSolved};
}

/* ---- DRAG ---- */
function createDrag(boardEl,eng,bv,cbs){
  let drag=null;
  function clearGlow(){bv.allTiles().forEach(t=>t.classList.remove('hint-glow'));}
  function pt(e){if(e.touches?.length)return{x:e.touches[0].clientX,y:e.touches[0].clientY};if(e.changedTouches?.length)return{x:e.changedTouches[0].clientX,y:e.changedTouches[0].clientY};return{x:e.clientX,y:e.clientY};}
  function onDown(e,el){
    if(e.button!==undefined&&e.button!==0)return;
    cbs.onStart();clearGlow();
    const p=pt(e),r=el.getBoundingClientRect();
    drag={id:Number(el.dataset.tileId),el,origin:eng.cellOf(Number(el.dataset.tileId)),ox:p.x-r.left,oy:p.y-r.top};
    el.classList.add('dragging');el.style.zIndex='50';
    moveTo(p);
    window.addEventListener('mousemove',onMove);window.addEventListener('mouseup',onUp);
    window.addEventListener('touchmove',onMove,{passive:false});window.addEventListener('touchend',onUp);window.addEventListener('touchcancel',onUp);
    e.preventDefault();
  }
  function moveTo(p){
    if(!drag)return;const r=boardEl.getBoundingClientRect(),cs=bv.cellPx(),oh=cs*.5;
    drag.el.style.left=Math.max(-oh,Math.min(r.width-cs+oh,p.x-r.left-drag.ox))+'px';
    drag.el.style.top=Math.max(-oh,Math.min(r.height-cs+oh,p.y-r.top-drag.oy))+'px';
  }
  function onMove(e){if(!drag)return;if(e.cancelable)e.preventDefault();const p=pt(e);moveTo(p);bv.allTiles().forEach(t=>t.classList.remove('swap-target'));const tgt=bv.pointToCell(p.x,p.y);const tId=eng.tileAt(tgt);if(tId!==drag.id){const te=bv.getTile(tId);if(te)te.classList.add('swap-target');}}
  function onUp(e){
    if(!drag)return;const p=pt(e),dc=bv.pointToCell(p.x,p.y);
    bv.allTiles().forEach(t=>t.classList.remove('swap-target'));
    drag.el.classList.remove('dragging');drag.el.style.zIndex='';
    if(dc!==drag.origin){eng.swap(drag.origin,dc);cbs.onMove();SFX.swap();}
    bv.allTiles().forEach((_,id)=>bv.move(id,true));bv.refresh();drag=null;
    window.removeEventListener('mousemove',onMove);window.removeEventListener('mouseup',onUp);
    window.removeEventListener('touchmove',onMove);window.removeEventListener('touchend',onUp);window.removeEventListener('touchcancel',onUp);
    cbs.onSettle();
  }
  let kbSel=null;
  function onKey(e,el){
    const id=Number(el.dataset.tileId);
    if(e.key==='Escape'){clearKb();return;}
    if(!['Enter',' '].includes(e.key))return;e.preventDefault();
    cbs.onStart();clearGlow();
    if(kbSel===null){kbSel=id;el.classList.add('dragging');return;}
    if(kbSel===id){clearKb();return;}
    eng.swap(eng.cellOf(kbSel),eng.cellOf(id));cbs.onMove();SFX.swap();
    bv.allTiles().forEach((_,tid)=>bv.move(tid,true));bv.refresh();clearKb();cbs.onSettle();
  }
  function clearKb(){if(kbSel!==null){const e=bv.getTile(kbSel);if(e)e.classList.remove('dragging');}kbSel=null;}
  boardEl.addEventListener('mousedown',e=>{const t=e.target.closest('.tile');if(t)onDown(e,t);});
  boardEl.addEventListener('touchstart',e=>{const t=e.target.closest('.tile');if(t)onDown(e,t);},{passive:false});
  boardEl.addEventListener('keydown',e=>{const t=e.target.closest('.tile');if(t)onKey(e,t);});
  return{clearGlow};
}

/* ---- CHATBOT ---- */
const Chat=(()=>{
  const elFab=document.getElementById('chatbot-fab'),elPanel=document.getElementById('chatbot-panel');
  const elPing=document.getElementById('chat-ping'),elMsgs=document.getElementById('chat-msgs');
  const elSugg=document.getElementById('chat-sugg'),elInput=document.getElementById('chat-input');
  let ctxFn=()=>({});
  function addMsg(txt,role){
    const d=document.createElement('div');d.className='chat-msg '+role;
    if(role==='bot'){
      d.textContent=txt;
      const sb=document.createElement('button');sb.className='speak-btn';sb.textContent='🔊';
      sb.onclick=()=>Voice.speak(txt);d.appendChild(sb);
    }else d.textContent=txt;
    elMsgs.appendChild(d);elMsgs.scrollTop=elMsgs.scrollHeight;return d;
  }
  function showTyping(){const d=document.createElement('div');d.className='chat-msg bot';d.innerHTML='<div class="typing-indicator"><span></span><span></span><span></span></div>';elMsgs.appendChild(d);elMsgs.scrollTop=elMsgs.scrollHeight;return d;}
  async function send(msg){
    if(!msg.trim())return;addMsg(msg,'user');elInput.value='';
    const t=showTyping();
    try{const r=await AI.chatReply(msg,ctxFn());t.remove();addMsg(r,'bot');if(Voice.isOn())Voice.speak(r);}
    catch(e){t.remove();addMsg('Hmm, something went wrong. Try again!','bot');}
    setSugg([]);
  }
  function setSugg(list){elSugg.innerHTML='';list.forEach(txt=>{const b=document.createElement('button');b.className='chip-suggest';b.textContent=txt;b.onclick=()=>send(txt);elSugg.appendChild(b);});}
  function notify(txt,opts={}){if(opts.ping)elPing.classList.add('show');if(!elPanel.hidden){addMsg(txt,'bot');}if(opts.speak&&Voice.isOn())Voice.speak(txt);}
  function init(getCtx){
    if(getCtx)ctxFn=getCtx;
    elFab.onclick=()=>{elPanel.hidden=!elPanel.hidden;elFab.setAttribute('aria-expanded',String(!elPanel.hidden));elPing.classList.remove('show');if(!elPanel.hidden&&elMsgs.children.length===0){addMsg('Hey! 👋 I\'m your AI Puzzle Coach. Ask me anything!','bot');setSugg(['Give me a strategy tip','How do coins work?','What are powerups?','Tell me about badges']);}};
    document.getElementById('btn-close-chat').onclick=()=>{elPanel.hidden=true;elFab.setAttribute('aria-expanded','false');};
    document.getElementById('btn-chat-send').onclick=()=>send(elInput.value);
    elInput.addEventListener('keydown',e=>{if(e.key==='Enter')send(elInput.value);});
  }
  return{init,send,notify,setSugg};
})();


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no">
<title>Face Slice Pro — Selfie Puzzle Game</title>
<style>
:root{
  --ink:#120f0d;--ink-2:#1c1815;--ink-3:#2a2420;--ink-4:#352e28;
  --paper:#f3ece0;--paper-dim:#b8aea0;
  --flash:#ff9f1c;--flash-dim:#c97d12;
  --good:#4caf6a;--good-dim:#4caf6a33;
  --warn:#e0544a;
  --coin:#ffd34d;--coin-dim:#b8902f;
  --violet:#9c7bd6;
  --shadow:0 12px 32px rgba(0,0,0,0.45);
  --radius-lg:18px;--radius-md:12px;--radius-sm:8px;
  --font-display:Georgia,'Times New Roman',serif;
  --font-body:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
  --font-mono:ui-monospace,SFMono-Regular,'SF Mono',Consolas,'Liberation Mono',Menlo,monospace;
}
*,*::before,*::after{box-sizing:border-box;}
html,body{margin:0;padding:0;background:radial-gradient(ellipse at top,#221c18 0%,var(--ink) 60%);color:var(--paper);font-family:var(--font-body);min-height:100vh;-webkit-tap-highlight-color:transparent;}
@media(prefers-reduced-motion:reduce){*{animation-duration:0.01ms!important;animation-iteration-count:1!important;transition-duration:0.01ms!important;}}
body{display:flex;flex-direction:column;align-items:center;padding:28px 16px 100px;}

/* AUTH */
.auth-screen{width:100%;max-width:420px;display:flex;flex-direction:column;align-items:center;padding:40px 0;}
.auth-logo{font-family:var(--font-display);font-size:2.4rem;font-weight:700;color:var(--paper);margin-bottom:4px;}
.auth-logo em{color:var(--flash);font-style:italic;}
.auth-tagline{color:var(--paper-dim);font-size:0.9rem;margin-bottom:32px;text-align:center;}
.auth-card{width:100%;background:linear-gradient(180deg,var(--ink-2),#19140f);border:1px solid var(--ink-3);border-radius:var(--radius-lg);padding:28px 24px;box-shadow:var(--shadow);}
.auth-card h2{font-family:var(--font-display);font-size:1.5rem;margin:0 0 20px;text-align:center;}
.auth-tabs{display:flex;gap:0;margin-bottom:24px;border-radius:var(--radius-md);overflow:hidden;border:1px solid var(--ink-3);}
.auth-tab{flex:1;padding:10px;font-family:var(--font-body);font-size:0.88rem;font-weight:600;background:transparent;border:none;color:var(--paper-dim);cursor:pointer;transition:background 0.15s,color 0.15s;}
.auth-tab.active{background:var(--flash);color:#1a1206;}
.auth-field{margin-bottom:16px;}
.auth-field label{display:block;font-size:0.78rem;color:var(--paper-dim);margin-bottom:6px;font-family:var(--font-mono);letter-spacing:0.06em;text-transform:uppercase;}
.auth-field input{width:100%;background:var(--ink-3);border:1px solid #3a322b;border-radius:var(--radius-sm);padding:11px 14px;color:var(--paper);font-family:var(--font-body);font-size:0.92rem;}
.auth-field input:focus{outline:2px solid var(--flash);outline-offset:1px;}
.auth-field input::placeholder{color:var(--paper-dim);}
.auth-error{color:var(--warn);font-size:0.82rem;margin-bottom:12px;text-align:center;min-height:18px;}
.auth-divider{text-align:center;color:var(--paper-dim);font-size:0.8rem;margin:16px 0;position:relative;}
.auth-divider::before,.auth-divider::after{content:'';position:absolute;top:50%;width:38%;height:1px;background:var(--ink-3);}
.auth-divider::before{left:0;}.auth-divider::after{right:0;}
.btn-social{width:100%;display:flex;align-items:center;justify-content:center;gap:10px;padding:11px 20px;background:var(--ink-3);border:1px solid #3a322b;border-radius:999px;color:var(--paper);font-family:var(--font-body);font-size:0.9rem;font-weight:600;cursor:pointer;margin-bottom:10px;transition:background 0.15s;}
.btn-social:hover{background:var(--ink-4);}
.guest-note{text-align:center;font-size:0.78rem;color:var(--paper-dim);margin-top:14px;cursor:pointer;}
.guest-note span{color:var(--flash);text-decoration:underline;}

/* MAIN */
.main-app{width:100%;max-width:760px;display:flex;flex-direction:column;align-items:center;}
.masthead{width:100%;max-width:760px;text-align:center;margin-bottom:18px;}
.masthead .eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:var(--flash);margin:0 0 6px;}
.masthead h1{font-family:var(--font-display);font-weight:700;font-size:clamp(2rem,6vw,3.1rem);margin:0 0 8px;letter-spacing:-0.01em;color:var(--paper);}
.masthead h1 em{font-style:italic;color:var(--flash);}
.masthead p.sub{margin:0;color:var(--paper-dim);font-size:0.98rem;max-width:46ch;margin-inline:auto;line-height:1.5;}

/* STATUS BAR */
.status-bar{width:100%;max-width:760px;display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:18px;}
.status-chip{display:flex;align-items:center;gap:7px;background:var(--ink-3);border:1px solid #3a322b;border-radius:999px;padding:7px 14px;font-family:var(--font-mono);font-size:0.82rem;color:var(--paper);}
.status-chip strong{color:var(--coin);font-weight:700;}
.status-chip.streak strong{color:var(--flash);}
.chip-btn{background:none;border:1px solid #3a322b;color:var(--paper-dim);font-family:var(--font-mono);font-size:0.78rem;cursor:pointer;padding:6px 12px;border-radius:999px;transition:color 0.15s,border-color 0.15s;}
.chip-btn:hover{color:var(--paper);border-color:var(--flash-dim);}

/* XP BAR */
.xp-bar-wrap{width:100%;max-width:760px;margin-bottom:14px;}
.xp-label{display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--paper-dim);margin-bottom:5px;}
.xp-bar{width:100%;height:6px;background:var(--ink-3);border-radius:999px;overflow:hidden;}
.xp-fill{height:100%;background:linear-gradient(90deg,var(--flash),var(--coin));border-radius:999px;transition:width 0.6s ease;}

/* PANEL */
.panel{width:100%;max-width:760px;background:linear-gradient(180deg,var(--ink-2),#19140f);border:1px solid var(--ink-3);border-radius:var(--radius-lg);box-shadow:var(--shadow);padding:22px;margin-bottom:18px;}
.stage-label{display:flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--paper-dim);margin:0 0 14px;}
.stage-label .dot{width:8px;height:8px;border-radius:50%;background:var(--flash);box-shadow:0 0 0 3px #c97d1244;flex-shrink:0;}

/* BUTTONS */
.btn{font-family:var(--font-body);font-size:0.95rem;font-weight:600;padding:11px 20px;border-radius:999px;border:1px solid var(--ink-3);background:var(--ink-3);color:var(--paper);cursor:pointer;transition:transform 0.12s ease,background 0.15s ease;display:inline-flex;align-items:center;gap:8px;line-height:1;}
.btn:hover{background:var(--ink-4);}
.btn:active{transform:scale(0.97);}
.btn:disabled{opacity:0.4;cursor:not-allowed;transform:none;}
.btn-primary{background:var(--flash);border-color:var(--flash);color:#1a1206;}
.btn-primary:hover{background:#ffb347;}
.btn-ghost{background:transparent;}
.btn-gold{background:var(--coin);border-color:var(--coin);color:#2a1f06;}
.btn-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;}
.btn-row.center{justify-content:center;}

/* CAMERA */
.camera-frame{position:relative;width:100%;max-width:480px;margin:0 auto;aspect-ratio:1/1;border-radius:var(--radius-md);overflow:hidden;background:#000;border:1px solid var(--ink-3);}
.camera-frame video,.camera-frame canvas,.camera-frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
.camera-frame video.mirrored{transform:scaleX(-1);}
.camera-frame .face-guide{position:absolute;inset:10%;border:2px dashed var(--flash);border-radius:50%;opacity:0.55;pointer-events:none;}
.camera-frame .flash-overlay{position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none;}
.camera-frame .flash-overlay.fire{animation:flashpop 350ms ease-out;}
@keyframes flashpop{0%{opacity:0.9;}100%{opacity:0;}}
.camera-status{text-align:center;margin-top:12px;font-size:0.9rem;color:var(--paper-dim);}
.camera-status.error{color:var(--warn);}
.camera-status.muted{font-size:0.82rem;}

/* LEVEL MAP */
.level-map{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:12px;margin-top:14px;}
.level-node{position:relative;background:var(--ink-3);border:1.5px solid #4a4038;border-radius:var(--radius-md);padding:14px 8px 10px;text-align:center;cursor:pointer;color:var(--paper);transition:border-color 0.15s,transform 0.12s,background 0.15s;}
.level-node:hover:not(.locked){transform:translateY(-2px);border-color:var(--flash-dim);}
.level-node.current{border-color:var(--flash);background:#3a2c18;}
.level-node.locked{opacity:0.42;cursor:not-allowed;}
.level-node .lvl-num{font-family:var(--font-display);font-size:1.4rem;font-weight:700;}
.level-node .lvl-grid{font-size:0.68rem;color:var(--paper-dim);text-transform:uppercase;letter-spacing:0.05em;margin-top:2px;}
.level-node .lvl-stars{margin-top:6px;font-size:0.8rem;letter-spacing:1px;color:var(--coin-dim);}
.level-node .lvl-stars.earned{color:var(--coin);}
.level-node .lock-icon{font-size:1.1rem;}
.level-node .lvl-badge{position:absolute;top:-6px;right:-6px;font-size:0.65rem;background:var(--flash);color:#1a1206;border-radius:999px;padding:2px 6px;font-family:var(--font-mono);font-weight:700;}

/* DAILY CARD */
.daily-card{background:linear-gradient(135deg,#2a1f08,#1a1530);border:1px solid #4a3f20;border-radius:var(--radius-md);padding:16px;margin-bottom:12px;position:relative;overflow:hidden;}
.daily-card::before{content:'⭐ DAILY';position:absolute;top:8px;right:12px;font-family:var(--font-mono);font-size:0.65rem;color:var(--coin);letter-spacing:0.12em;}
.daily-card h4{font-family:var(--font-display);font-size:1.05rem;margin:0 0 6px;color:var(--coin);}
.daily-card p{font-size:0.82rem;color:var(--paper-dim);margin:0 0 12px;}
.daily-timer{font-family:var(--font-mono);font-size:0.78rem;color:var(--flash);}

/* HUD */
.hud{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:16px;}
.hud-stat{flex:1 1 120px;background:var(--ink-3);border:1px solid #3a322b;border-radius:var(--radius-md);padding:12px 14px;}
.hud-stat .label{font-family:var(--font-mono);font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--paper-dim);margin-bottom:4px;}
.hud-stat .value{font-family:var(--font-mono);font-size:1.4rem;font-weight:600;color:var(--flash);font-variant-numeric:tabular-nums;}
.hud-stat .value.small{font-size:1.1rem;color:var(--paper);}
.hud-stat.par-warn .value{color:var(--warn);}

/* POWERUPS */
.powerup-bar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;justify-content:center;}
.powerup-btn{display:flex;flex-direction:column;align-items:center;gap:3px;background:var(--ink-3);border:1px solid #3a322b;border-radius:var(--radius-sm);padding:8px 12px;cursor:pointer;font-size:1.3rem;transition:border-color 0.15s,transform 0.1s;}
.powerup-btn:hover:not(:disabled){border-color:var(--flash);transform:translateY(-1px);}
.powerup-btn:disabled{opacity:0.3;cursor:not-allowed;}
.powerup-btn .pu-label{font-family:var(--font-mono);font-size:0.6rem;color:var(--paper-dim);text-transform:uppercase;}
.powerup-btn .pu-count{font-family:var(--font-mono);font-size:0.72rem;color:var(--coin);font-weight:700;}

/* BOARD */
.board-wrap{display:flex;justify-content:center;}
.board{position:relative;width:100%;max-width:480px;aspect-ratio:1/1;background:#000;border-radius:var(--radius-md);overflow:hidden;border:1px solid var(--ink-3);touch-action:none;user-select:none;}
.board.frame-classic{border:4px solid #4a4038;}
.board.frame-gold{border:4px solid var(--coin);box-shadow:0 0 0 1px #2a1f06,0 0 24px #ffd34d33;}
.board.frame-violet{border:4px solid var(--violet);box-shadow:0 0 24px #9c7bd633;}
.board.frame-neon{border:4px solid var(--good);box-shadow:0 0 24px #4caf6a44;}
.board.frame-fire{border:4px solid #ff4500;box-shadow:0 0 24px #ff450044;}
.board.frame-ice{border:4px solid #00bfff;box-shadow:0 0 24px #00bfff44;}
.board.frame-rainbow{border:4px solid #ff69b4;animation:rbBorder 2s linear infinite;}
@keyframes rbBorder{0%{border-color:#ff0000;}16%{border-color:#ff9f1c;}32%{border-color:#ffd34d;}48%{border-color:#4caf6a;}64%{border-color:#9c7bd6;}80%{border-color:#ff69b4;}100%{border-color:#ff0000;}}
.tile{position:absolute;background-size:cover;background-repeat:no-repeat;border:2px solid rgba(0,0,0,0.35);cursor:grab;transition:top 0.18s ease,left 0.18s ease,border-color 0.15s,box-shadow 0.15s;will-change:top,left;}
.tile:focus-visible{outline:2px solid var(--flash);outline-offset:-2px;}
.tile.dragging{cursor:grabbing;border-color:var(--flash);box-shadow:0 8px 24px rgba(0,0,0,0.5);z-index:50;transition:none;}
.tile.correct{border-color:var(--good);box-shadow:0 0 0 2px var(--good-dim);}
.tile.swap-target{border-color:var(--flash);filter:brightness(1.15);}
.tile.hint-glow{animation:hintpulse 1.1s ease-in-out infinite;}
@keyframes hintpulse{0%,100%{box-shadow:0 0 0 2px #9c7bd6aa;}50%{box-shadow:0 0 0 5px #9c7bd644;}}

/* COIN/XP POP */
.coin-pop,.xp-pop{position:fixed;font-family:var(--font-mono);font-weight:700;pointer-events:none;z-index:300;animation:coinrise 1.1s ease-out forwards;text-shadow:0 2px 6px rgba(0,0,0,0.6);}
.coin-pop{color:var(--coin);}
.xp-pop{color:var(--good);}
@keyframes coinrise{0%{opacity:0;transform:translateY(0) scale(0.8);}15%{opacity:1;transform:translateY(-6px) scale(1.05);}100%{opacity:0;transform:translateY(-70px) scale(1);}}
#confetti-canvas{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:250;}

/* OVERLAYS */
.overlay{position:fixed;inset:0;background:rgba(10,8,6,0.78);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;padding:20px;z-index:200;}
.overlay[hidden]{display:none;}
.results-card{background:linear-gradient(180deg,#221b14,#161009);border:1px solid var(--ink-3);border-radius:var(--radius-lg);max-width:480px;width:100%;padding:30px 28px 26px;box-shadow:var(--shadow);text-align:center;animation:rise 0.35s ease;max-height:90vh;overflow-y:auto;}
@keyframes rise{from{opacity:0;transform:translateY(14px) scale(0.98);}to{opacity:1;transform:translateY(0) scale(1);}}
.results-card .eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:var(--flash);margin:0 0 6px;}
.results-card h2{font-family:var(--font-display);font-size:1.9rem;margin:0 0 14px;}
.stars-row{font-size:2.2rem;letter-spacing:6px;margin-bottom:14px;color:var(--coin-dim);}
.stars-row .star-on{color:var(--coin);}
.results-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px;}
.results-grid .stat{background:var(--ink-3);border-radius:var(--radius-sm);padding:12px 8px;}
.results-grid .stat .v{font-family:var(--font-mono);font-size:1.15rem;color:var(--flash);font-weight:700;}
.results-grid .stat .l{font-size:0.68rem;color:var(--paper-dim);text-transform:uppercase;letter-spacing:0.06em;margin-top:2px;}
.coin-banner{display:flex;align-items:center;justify-content:center;gap:8px;background:#2a2008;border:1px solid var(--coin-dim);border-radius:var(--radius-sm);padding:10px;margin-bottom:10px;font-family:var(--font-mono);color:var(--coin);font-size:0.95rem;}
.xp-banner{display:flex;align-items:center;justify-content:center;gap:8px;background:#0d2218;border:1px solid var(--good);border-radius:var(--radius-sm);padding:10px;margin-bottom:10px;font-family:var(--font-mono);color:var(--good);font-size:0.95rem;}
.badge-unlock{display:flex;align-items:center;gap:10px;justify-content:center;background:#1f1a30;border:1px solid var(--violet);border-radius:var(--radius-sm);padding:10px;margin-bottom:14px;font-size:0.85rem;}
.badge-unlock .badge-icon{font-size:1.4rem;}
.new-best{color:var(--good);font-size:0.85rem;margin:0 0 12px;font-weight:600;}
.ai-note{font-size:0.85rem;color:var(--paper-dim);font-style:italic;margin:0 0 16px;padding:10px 12px;background:var(--ink-3);border-radius:var(--radius-sm);border-left:3px solid var(--violet);text-align:left;}

/* LEADERBOARD */
.leaderboard table{width:100%;border-collapse:collapse;font-size:0.85rem;}
.leaderboard th{text-align:left;font-family:var(--font-mono);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:var(--paper-dim);padding:6px 8px;border-bottom:1px solid var(--ink-3);}
.leaderboard td{padding:7px 8px;border-bottom:1px solid #2a241f;color:var(--paper);font-family:var(--font-mono);}
.leaderboard tr:last-child td{border-bottom:none;}
.leaderboard .empty{color:var(--paper-dim);font-size:0.88rem;font-style:italic;padding:10px 4px;}

/* BADGES & FRAMES */
.badges-shelf{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px;}
.badge-item{display:flex;flex-direction:column;align-items:center;gap:4px;width:76px;padding:10px 4px;border-radius:var(--radius-sm);background:var(--ink-3);border:1px solid #3a322b;text-align:center;}
.badge-item.locked{opacity:0.35;}
.badge-item.unlocked{border-color:var(--coin-dim);}
.badge-item .b-icon{font-size:1.5rem;}
.badge-item .b-name{font-size:0.62rem;color:var(--paper-dim);text-transform:uppercase;letter-spacing:0.03em;line-height:1.3;}
.frame-shop,.powerup-shop{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px;}
.frame-item{display:flex;flex-direction:column;align-items:center;gap:6px;width:100px;padding:10px;border-radius:var(--radius-sm);background:var(--ink-3);border:1.5px solid #3a322b;cursor:pointer;text-align:center;transition:border-color 0.15s;}
.frame-item:hover{border-color:var(--flash-dim);}
.frame-item.active{border-color:var(--flash);background:#3a2c18;}
.frame-swatch{width:44px;height:44px;border-radius:8px;background:#000;}
.frame-swatch.frame-classic{border:4px solid #4a4038;}
.frame-swatch.frame-gold{border:4px solid var(--coin);}
.frame-swatch.frame-violet{border:4px solid var(--violet);}
.frame-swatch.frame-neon{border:4px solid var(--good);}
.frame-swatch.frame-fire{border:4px solid #ff4500;}
.frame-swatch.frame-ice{border:4px solid #00bfff;}
.frame-swatch.frame-rainbow{border:4px solid #ff69b4;}
.frame-item .f-name{font-size:0.68rem;color:var(--paper);}
.frame-item .f-cost{font-size:0.62rem;color:var(--coin);font-family:var(--font-mono);}

/* CHATBOT */
.chatbot-fab{position:fixed;right:18px;bottom:18px;z-index:150;width:58px;height:58px;border-radius:50%;background:var(--violet);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.6rem;box-shadow:0 8px 20px rgba(0,0,0,0.4);transition:transform 0.15s;}
.chatbot-fab:hover{transform:scale(1.06);}
.chatbot-fab .ping{position:absolute;top:-3px;right:-3px;width:14px;height:14px;border-radius:50%;background:var(--coin);border:2px solid var(--ink);display:none;}
.chatbot-fab .ping.show{display:block;}
.chatbot-panel{position:fixed;right:18px;bottom:88px;z-index:160;width:min(360px,calc(100vw - 36px));max-height:min(520px,calc(100vh - 140px));background:linear-gradient(180deg,#221b30,#15101f);border:1px solid #3a2f52;border-radius:var(--radius-lg);box-shadow:var(--shadow);display:flex;flex-direction:column;overflow:hidden;}
.chatbot-panel[hidden]{display:none;}
.chatbot-header{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid #3a2f52;}
.chatbot-header .ch-title{display:flex;align-items:center;gap:8px;font-weight:600;font-size:0.9rem;}
.chatbot-header .ch-dot{width:8px;height:8px;border-radius:50%;background:var(--good);}
.chatbot-header button{background:none;border:none;color:var(--paper-dim);font-size:1.1rem;cursor:pointer;padding:4px;}
.chatbot-header button:hover{color:var(--paper);}
.chatbot-messages{flex:1;overflow-y:auto;padding:12px 14px;display:flex;flex-direction:column;gap:10px;font-size:0.86rem;line-height:1.45;}
.chat-msg{max-width:88%;padding:9px 12px;border-radius:14px;}
.chat-msg.bot{background:var(--ink-3);align-self:flex-start;border-bottom-left-radius:4px;}
.chat-msg.user{background:var(--flash-dim);color:#1a1206;align-self:flex-end;border-bottom-right-radius:4px;font-weight:600;}
.chat-msg.bot .speak-btn{display:inline-flex;align-items:center;gap:4px;margin-top:6px;background:none;border:none;color:var(--violet);font-size:0.72rem;cursor:pointer;padding:0;}
.chat-msg.bot .speak-btn:hover{color:var(--coin);}
.typing-indicator{display:inline-flex;gap:4px;align-items:center;}
.typing-indicator span{width:6px;height:6px;background:var(--paper-dim);border-radius:50%;animation:tdot 1.2s infinite;}
.typing-indicator span:nth-child(2){animation-delay:0.2s;}
.typing-indicator span:nth-child(3){animation-delay:0.4s;}
@keyframes tdot{0%,80%,100%{transform:scale(0.8);opacity:0.4;}40%{transform:scale(1.1);opacity:1;}}
.chatbot-suggestions{display:flex;flex-wrap:wrap;gap:6px;padding:0 14px 10px;}
.chip-suggest{font-size:0.74rem;padding:6px 11px;border-radius:999px;border:1px solid #3a2f52;background:transparent;color:var(--paper-dim);cursor:pointer;}
.chip-suggest:hover{color:var(--paper);border-color:var(--violet);}
.chatbot-input-row{display:flex;gap:8px;padding:10px 14px;border-top:1px solid #3a2f52;}
.chatbot-input-row input{flex:1;background:var(--ink-3);border:1px solid #3a322b;border-radius:999px;padding:9px 14px;color:var(--paper);font-family:var(--font-body);font-size:0.85rem;}
.chatbot-input-row input:focus{outline:2px solid var(--violet);}
.chatbot-input-row button{background:var(--violet);border:none;border-radius:50%;width:38px;height:38px;color:#fff;cursor:pointer;font-size:1rem;flex-shrink:0;}

/* PROFILE */
.profile-card{max-width:520px;text-align:left;}
.profile-header{display:flex;align-items:center;gap:16px;margin-bottom:20px;}
.avatar-circle{width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--flash),var(--coin));display:flex;align-items:center;justify-content:center;font-size:1.8rem;font-weight:700;color:#1a1206;flex-shrink:0;font-family:var(--font-display);}
.profile-info h3{font-family:var(--font-display);font-size:1.3rem;margin:0 0 4px;}
.profile-info .rank-label{font-family:var(--font-mono);font-size:0.75rem;color:var(--flash);letter-spacing:0.1em;text-transform:uppercase;}
.profile-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:20px;}
.profile-stat{background:var(--ink-3);border-radius:var(--radius-sm);padding:12px 8px;text-align:center;}
.profile-stat .ps-v{font-family:var(--font-mono);font-size:1.2rem;color:var(--coin);font-weight:700;}
.profile-stat .ps-l{font-size:0.65rem;color:var(--paper-dim);text-transform:uppercase;letter-spacing:0.06em;margin-top:2px;}

/* SETTINGS */
.settings-card{max-width:440px;text-align:left;}
.settings-row{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--ink-3);}
.settings-row:last-of-type{border-bottom:none;}
.settings-row .s-label{font-size:0.88rem;color:var(--paper);}
.settings-row .s-desc{font-size:0.75rem;color:var(--paper-dim);margin-top:2px;}
.toggle-switch{position:relative;width:42px;height:24px;flex-shrink:0;}
.toggle-switch input{opacity:0;width:0;height:0;}
.toggle-slider{position:absolute;inset:0;background:var(--ink-3);border-radius:999px;border:1px solid #3a322b;cursor:pointer;transition:background 0.2s;}
.toggle-slider::after{content:'';position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:var(--paper-dim);transition:transform 0.2s,background 0.2s;}
.toggle-switch input:checked+.toggle-slider{background:var(--flash);}
.toggle-switch input:checked+.toggle-slider::after{transform:translateX(18px);background:#fff;}
.settings-input{width:100%;background:var(--ink-3);border:1px solid #3a322b;border-radius:var(--radius-sm);padding:10px 12px;color:var(--paper);font-family:var(--font-mono);font-size:0.85rem;margin-bottom:6px;}
.settings-input:focus{outline:2px solid var(--violet);}
.hint-text{font-size:0.76rem;color:var(--paper-dim);margin-bottom:14px;line-height:1.5;}

/* LEVEL-UP BURST */
.level-up-burst{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:400;pointer-events:none;}
.level-up-burst[hidden]{display:none;}
.level-up-text{font-family:var(--font-display);font-size:clamp(2rem,8vw,4rem);font-weight:700;color:var(--coin);text-shadow:0 0 40px #ffd34d88;animation:lvlBurst 1.8s ease forwards;}
@keyframes lvlBurst{0%{opacity:0;transform:scale(0.5);}20%{opacity:1;transform:scale(1.1);}60%{opacity:1;transform:scale(1);}100%{opacity:0;}}

/* TOAST */
.toast{position:fixed;top:20px;left:50%;transform:translateX(-50%);background:var(--ink-2);border:1px solid var(--flash);border-radius:999px;padding:10px 20px;font-family:var(--font-mono);font-size:0.82rem;color:var(--paper);z-index:500;animation:toastIn 0.3s ease,toastOut 0.3s ease 2.5s forwards;white-space:nowrap;max-width:90vw;}
@keyframes toastIn{from{opacity:0;transform:translateX(-50%) translateY(-10px);}to{opacity:1;transform:translateX(-50%) translateY(0);}}
@keyframes toastOut{from{opacity:1;}to{opacity:0;}}

.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0;}
[hidden]{display:none!important;}
footer.credit{color:var(--paper-dim);font-size:0.78rem;margin-top:10px;text-align:center;}
@media(max-width:480px){.panel{padding:16px;}.results-card{padding:24px 18px 20px;}.chatbot-panel{right:10px;bottom:80px;}.chatbot-fab{right:14px;bottom:14px;}}
</style>
</head>
<body>


<!-- ============ AUTH SCREEN ============ -->
<div id="auth-screen" class="auth-screen">
  <div class="auth-logo">Face <em>Slice</em> Pro</div>
  <p class="auth-tagline">Snap a selfie · Scramble it · Solve it</p>
  <div class="auth-card">
    <div class="auth-tabs">
      <button class="auth-tab active" id="tab-login" onclick="switchAuthTab('login')">Sign In</button>
      <button class="auth-tab" id="tab-signup" onclick="switchAuthTab('signup')">Sign Up</button>
    </div>
    <div id="login-form">
      <div class="auth-field"><label>Email or Username</label><input type="text" id="login-user" placeholder="your@email.com" autocomplete="username"></div>
      <div class="auth-field"><label>Password</label><input type="password" id="login-pass" placeholder="••••••••" autocomplete="current-password"></div>
      <p class="auth-error" id="login-error"></p>
      <button class="btn btn-primary" style="width:100%;justify-content:center;" onclick="doLogin()">Sign In →</button>
    </div>
    <div id="signup-form" hidden>
      <div class="auth-field"><label>Display Name</label><input type="text" id="signup-name" placeholder="PuzzlePro42"></div>
      <div class="auth-field"><label>Email</label><input type="email" id="signup-email" placeholder="your@email.com" autocomplete="email"></div>
      <div class="auth-field"><label>Password</label><input type="password" id="signup-pass" placeholder="6+ characters" autocomplete="new-password"></div>
      <p class="auth-error" id="signup-error"></p>
      <button class="btn btn-primary" style="width:100%;justify-content:center;" onclick="doSignup()">Create Account →</button>
    </div>
    <div class="auth-divider">or</div>
    <button class="btn-social" onclick="doGuest()">🎮 Continue as Guest</button>
  </div>
  <p class="guest-note">Have a session? <span onclick="checkExistingSession()">Restore it</span></p>
</div>

<!-- ============ MAIN APP ============ -->
<div id="main-app" class="main-app" hidden>

  <div class="masthead">
    <p class="eyebrow">Face Slice Pro</p>
    <h1>Put your <em>face</em> back together</h1>
    <p class="sub">Snap a selfie, scramble it across 20 levels, and solve it against the clock.</p>
  </div>

  <div class="status-bar">
    <div class="status-chip"><span>🪙</span><strong id="status-coins">0</strong></div>
    <div class="status-chip"><span>🎯</span>Level <strong id="status-level">1</strong></div>
    <div class="status-chip streak"><span>🔥</span><strong id="status-streak">0</strong> streak</div>
    <div class="status-chip"><span>⭐</span><strong id="status-xp">0</strong> XP</div>
    <button class="chip-btn" onclick="openProfile()">👤 Profile</button>
    <button class="chip-btn" onclick="openSettings()">⚙ Settings</button>
    <button class="chip-btn" id="btn-logout" onclick="doLogout()">↩ Sign out</button>
  </div>

  <div class="xp-bar-wrap">
    <div class="xp-label"><span id="xp-rank-label">🌱 Rookie</span><span id="xp-next-label">0 / 100 XP</span></div>
    <div class="xp-bar"><div class="xp-fill" id="xp-fill" style="width:0%"></div></div>
  </div>

  <!-- STAGE 1: CAMERA -->
  <section class="panel" id="camera-stage">
    <p class="stage-label"><span class="dot"></span>Step 1 — Strike a pose</p>
    <div class="camera-frame" id="camera-frame">
      <video id="video" autoplay playsinline muted hidden></video>
      <canvas id="capture-canvas" hidden></canvas>
      <img id="snapshot-img" alt="Your captured photo" hidden>
      <div class="face-guide" id="face-guide" hidden></div>
      <div class="flash-overlay" id="flash-overlay"></div>
    </div>
    <p class="camera-status" id="camera-status">Requesting camera…</p>
    <div class="btn-row center">
      <button class="btn btn-primary" id="btn-take-photo" disabled>📸 Take Photo</button>
      <button class="btn btn-ghost" id="btn-retake-photo" hidden>↺ Retake</button>
      <button class="btn btn-ghost" id="btn-retry-camera" hidden>↻ Retry camera</button>
    </div>
  </section>

  <!-- STAGE 2: LEVELS -->
  <section class="panel" id="level-stage" hidden>
    <p class="stage-label"><span class="dot"></span>Step 2 — Pick your level</p>
    <div class="daily-card" id="daily-card">
      <h4>🌟 Daily Challenge</h4>
      <p>Today's special puzzle — complete for <strong style="color:var(--coin)">3× coin bonus</strong> + exclusive XP!</p>
      <div class="daily-timer" id="daily-timer">Resets in: --:--:--</div>
      <div class="btn-row" style="margin-top:10px">
        <button class="btn btn-gold" onclick="startDailyChallenge()">Play Daily Challenge →</button>
      </div>
    </div>
    <div class="level-map" id="level-map"></div>
    <div class="btn-row center" style="margin-top:8px">
      <button class="btn btn-ghost" onclick="initCamera()">↺ New photo</button>
    </div>
  </section>

  <!-- STAGE 3: PUZZLE -->
  <section class="panel" id="puzzle-stage" hidden>
    <p class="stage-label"><span class="dot"></span><span id="puzzle-stage-label">Step 3 — Solve it!</span></p>
    <div class="hud">
      <div class="hud-stat" id="hud-time-card"><div class="label">Time <span id="hud-par-time"></span></div><div class="value" id="hud-time">00:00.0</div></div>
      <div class="hud-stat" id="hud-moves-card"><div class="label">Moves <span id="hud-par-moves"></span></div><div class="value" id="hud-moves">0</div></div>
      <div class="hud-stat"><div class="label">Placed</div><div class="value small" id="hud-progress">0/9</div></div>
      <div class="hud-stat"><div class="label">XP Bonus</div><div class="value small" id="hud-xp-bonus">+0</div></div>
    </div>
    <div class="powerup-bar">
      <button class="powerup-btn" id="pu-freeze" onclick="usePowerup('freeze')" title="Freeze timer 10s">❄️<span class="pu-label">Freeze</span><span class="pu-count" id="pu-freeze-c">×0</span></button>
      <button class="powerup-btn" id="pu-reveal" onclick="usePowerup('reveal')" title="Peek at solution">👁️<span class="pu-label">Reveal</span><span class="pu-count" id="pu-reveal-c">×0</span></button>
      <button class="powerup-btn" id="pu-autopair" onclick="usePowerup('autopair')" title="Auto-place one piece">🎯<span class="pu-label">Auto</span><span class="pu-count" id="pu-autopair-c">×0</span></button>
      <button class="powerup-btn" id="pu-shuffle" onclick="usePowerup('shuffle')" title="Re-scramble">🔀<span class="pu-label">Re-mix</span><span class="pu-count" id="pu-shuffle-c">×0</span></button>
    </div>
    <div class="board-wrap">
      <div class="board frame-classic" id="board" role="region" aria-label="Puzzle board"></div>
    </div>
    <p class="camera-status" id="puzzle-hint">Drag tiles to swap — correct pieces glow green.</p>
    <div class="btn-row center">
      <button class="btn btn-ghost" id="btn-ai-hint">✨ AI Hint</button>
      <button class="btn btn-ghost" id="btn-reshuffle">🔀 Reshuffle</button>
      <button class="btn btn-ghost" onclick="initCamera()">↺ New photo</button>
    </div>
  </section>

  <!-- REWARDS -->
  <section class="panel" id="rewards-panel">
    <p class="stage-label"><span class="dot"></span>Badges</p>
    <div id="badges-shelf" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;"></div>
    <p class="stage-label" style="margin-top:20px"><span class="dot"></span>Board Frames</p>
    <div class="frame-shop" id="frame-shop"></div>
    <p class="stage-label" style="margin-top:20px"><span class="dot"></span>Power-up Shop</p>
    <div class="powerup-shop" id="powerup-shop"></div>
  </section>

  <!-- LEADERBOARD -->
  <section class="panel" id="lb-panel">
    <p class="stage-label"><span class="dot"></span>Best Times</p>
    <div id="lb-body"><p style="color:var(--paper-dim);font-size:0.88rem;font-style:italic">Finish a puzzle to set a record!</p></div>
  </section>

  <footer class="credit">Runs entirely in your browser · Your photo never leaves this device</footer>
</div>

<!-- RESULTS OVERLAY -->
<div class="overlay" id="results-overlay" hidden role="dialog" aria-modal="true" style="position:fixed;inset:0;background:rgba(10,8,6,.8);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;padding:20px;z-index:200;">
  <div class="results-card" style="background:linear-gradient(180deg,#221b14,#161009);border:1px solid var(--ink-3);border-radius:var(--radius-lg);max-width:480px;width:100%;padding:28px 24px;box-shadow:var(--shadow);text-align:center;max-height:90vh;overflow-y:auto;animation:rise .35s ease;">
    <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--flash);margin:0 0 4px">Solved!</p>
    <h2 id="res-heading" style="font-family:var(--font-display);font-size:1.9rem;margin:0 0 12px">Face restored 🎉</h2>
    <div id="res-stars" style="font-size:2.2rem;letter-spacing:6px;margin-bottom:12px;color:var(--coin-dim)">☆☆☆</div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px">
      <div style="background:var(--ink-3);border-radius:var(--radius-sm);padding:12px 8px"><div style="font-family:var(--font-mono);font-size:1.15rem;color:var(--flash);font-weight:700" id="res-time">-</div><div style="font-size:.68rem;color:var(--paper-dim);text-transform:uppercase;margin-top:2px">Time</div></div>
      <div style="background:var(--ink-3);border-radius:var(--radius-sm);padding:12px 8px"><div style="font-family:var(--font-mono);font-size:1.15rem;color:var(--flash);font-weight:700" id="res-moves">-</div><div style="font-size:.68rem;color:var(--paper-dim);text-transform:uppercase;margin-top:2px">Moves</div></div>
      <div style="background:var(--ink-3);border-radius:var(--radius-sm);padding:12px 8px"><div style="font-family:var(--font-mono);font-size:1.15rem;color:var(--flash);font-weight:700" id="res-level">-</div><div style="font-size:.68rem;color:var(--paper-dim);text-transform:uppercase;margin-top:2px">Level</div></div>
    </div>
    <div id="coin-banner" style="display:flex;align-items:center;justify-content:center;gap:8px;background:#2a2008;border:1px solid var(--coin-dim);border-radius:var(--radius-sm);padding:10px;margin-bottom:10px;font-family:var(--font-mono);color:var(--coin);font-size:.95rem">+0 coins</div>
    <div id="xp-banner" style="display:flex;align-items:center;justify-content:center;gap:8px;background:#0d2218;border:1px solid var(--good);border-radius:var(--radius-sm);padding:10px;margin-bottom:10px;font-family:var(--font-mono);color:var(--good);font-size:.95rem">+0 XP</div>
    <div id="badge-banner" hidden style="display:flex;align-items:center;gap:10px;justify-content:center;background:#1f1a30;border:1px solid var(--violet);border-radius:var(--radius-sm);padding:10px;margin-bottom:10px;font-size:.85rem;color:var(--paper)"><span id="badge-icon" style="font-size:1.4rem">🏅</span><span id="badge-text">Badge unlocked!</span></div>
    <p id="res-new-best" hidden style="color:var(--good);font-size:.85rem;margin:0 0 10px;font-weight:600">★ New personal best!</p>
    <p id="res-ai-note" style="font-size:.85rem;color:var(--paper-dim);font-style:italic;margin:0 0 16px;padding:10px 12px;background:var(--ink-3);border-radius:var(--radius-sm);border-left:3px solid var(--violet);text-align:left">Nice work!</p>
    <div class="btn-row center">
      <button class="btn btn-primary" id="btn-next-level">Next Level →</button>
      <button class="btn btn-ghost" id="btn-replay">↺ Replay</button>
      <button class="btn btn-ghost" onclick="document.getElementById('results-overlay').hidden=true;initCamera()">📸 New Photo</button>
    </div>
  </div>
</div>

<!-- PROFILE OVERLAY -->
<div class="overlay" id="profile-overlay" hidden role="dialog" style="position:fixed;inset:0;background:rgba(10,8,6,.8);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;padding:20px;z-index:200;">
  <div class="results-card profile-card" style="background:linear-gradient(180deg,#221b14,#161009);border:1px solid var(--ink-3);border-radius:var(--radius-lg);max-width:520px;width:100%;padding:28px 24px;box-shadow:var(--shadow);max-height:90vh;overflow-y:auto;animation:rise .35s ease;">
    <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--flash);margin:0 0 4px">Player Profile</p>
    <div class="profile-header">
      <div class="avatar-circle" id="profile-avatar">?</div>
      <div class="profile-info"><h3 id="profile-name">Player</h3><div class="rank-label" id="profile-rank">Rookie</div></div>
    </div>
    <div class="profile-stats">
      <div class="profile-stat"><div class="ps-v" id="ps-wins">0</div><div class="ps-l">Wins</div></div>
      <div class="profile-stat"><div class="ps-v" id="ps-streak">0</div><div class="ps-l">Best Streak</div></div>
      <div class="profile-stat"><div class="ps-v" id="ps-stars">0</div><div class="ps-l">Stars</div></div>
      <div class="profile-stat"><div class="ps-v" id="ps-maxlvl">1</div><div class="ps-l">Max Level</div></div>
      <div class="profile-stat"><div class="ps-v" id="ps-coins">0</div><div class="ps-l">Coins</div></div>
      <div class="profile-stat"><div class="ps-v" id="ps-xp">0</div><div class="ps-l">Total XP</div></div>
    </div>
    <p style="font-family:var(--font-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--paper-dim);margin:0 0 10px">Earned Badges</p>
    <div id="profile-badges" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px"></div>
    <div class="btn-row center">
      <button class="btn btn-ghost" onclick="document.getElementById('profile-overlay').hidden=true">Close</button>
      <button class="btn btn-ghost" style="color:var(--warn);border-color:var(--warn)" onclick="resetProgress()">Reset Progress</button>
    </div>
  </div>
</div>

<!-- SETTINGS OVERLAY -->
<div class="overlay" id="settings-overlay" hidden role="dialog" style="position:fixed;inset:0;background:rgba(10,8,6,.8);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;padding:20px;z-index:200;">
  <div class="results-card settings-card" style="background:linear-gradient(180deg,#221b14,#161009);border:1px solid var(--ink-3);border-radius:var(--radius-lg);max-width:440px;width:100%;padding:28px 24px;box-shadow:var(--shadow);max-height:90vh;overflow-y:auto;animation:rise .35s ease;">
    <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--flash);margin:0 0 4px">Settings</p>
    <h2 style="font-family:var(--font-display);font-size:1.5rem;margin:0 0 20px">Game Settings</h2>
    <div class="settings-row"><div><div class="s-label">🔊 Voice notifications</div><div class="s-desc">Spoken hints and win announcements</div></div><label class="toggle-switch"><input type="checkbox" id="set-voice" checked><span class="toggle-slider"></span></label></div>
    <div class="settings-row"><div><div class="s-label">🎵 Sound effects</div><div class="s-desc">Tile clicks and win sounds</div></div><label class="toggle-switch"><input type="checkbox" id="set-sfx" checked><span class="toggle-slider"></span></label></div>
    <div class="settings-row"><div><div class="s-label">🌈 Reduce motion</div><div class="s-desc">Disable confetti and animations</div></div><label class="toggle-switch"><input type="checkbox" id="set-motion"><span class="toggle-slider"></span></label></div>
    <div class="settings-row"><div><div class="s-label">🤖 AI Coach</div><div class="s-desc">Real-time coaching from Claude AI</div></div><label class="toggle-switch"><input type="checkbox" id="set-ai" checked><span class="toggle-slider"></span></label></div>
    <div style="margin-top:16px">
      <label style="display:block;font-family:var(--font-mono);font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;color:var(--paper-dim);margin-bottom:6px">Anthropic API Key (for live AI)</label>
      <input class="settings-input" type="password" id="set-apikey" placeholder="sk-ant-… (optional)">
      <p class="hint-text">Key stored only in this browser. Unlocks real Claude AI in the chatbot.</p>
    </div>
    <div class="btn-row center">
      <button class="btn btn-primary" onclick="saveSettings()">Save</button>
      <button class="btn btn-ghost" onclick="document.getElementById('settings-overlay').hidden=true">Cancel</button>
    </div>
  </div>
</div>

<!-- LEVEL-UP BURST -->
<div class="level-up-burst" id="lvl-burst" hidden><div class="level-up-text" id="lvl-burst-text">LEVEL UP!</div></div>

<!-- CHATBOT FAB -->
<button class="chatbot-fab" id="chatbot-fab" aria-label="Open AI coach" aria-expanded="false">💬<span class="ping" id="chat-ping"></span></button>

<div class="chatbot-panel" id="chatbot-panel" hidden>
  <div class="chatbot-header"><span class="ch-title"><span class="ch-dot"></span>AI Puzzle Coach</span><button id="btn-close-chat">✕</button></div>
  <div class="chatbot-messages" id="chat-msgs"></div>
  <div class="chatbot-suggestions" id="chat-sugg"></div>

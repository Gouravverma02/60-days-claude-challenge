<script>
// ──────────────────────────────────────────
// PARTICLES
// ──────────────────────────────────────────
(function(){
  const c = document.getElementById('bg-canvas');
  const ctx = c.getContext('2d');
  let W, H, particles = [];

  function resize(){
    W = c.width = window.innerWidth;
    H = c.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  for(let i=0;i<60;i++){
    particles.push({
      x: Math.random()*2000,
      y: Math.random()*2000,
      r: Math.random()*1.2+0.3,
      vx: (Math.random()-0.5)*0.15,
      vy: (Math.random()-0.5)*0.15,
      alpha: Math.random()*0.4+0.1,
      color: ['#3b82f6','#06b6d4','#8b5cf6'][Math.floor(Math.random()*3)]
    });
  }

  function draw(){
    ctx.clearRect(0,0,W,H);
    particles.forEach(p=>{
      p.x += p.vx; p.y += p.vy;
      if(p.x<0) p.x=W; if(p.x>W) p.x=0;
      if(p.y<0) p.y=H; if(p.y>H) p.y=0;
      ctx.beginPath();
      ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
      ctx.fillStyle = p.color;
      ctx.globalAlpha = p.alpha;
      ctx.fill();
    });
    ctx.globalAlpha = 1;
    requestAnimationFrame(draw);
  }
  draw();
})();

// ──────────────────────────────────────────
// WAVEFORM
// ──────────────────────────────────────────
(function(){
  const wf = document.getElementById('waveform');
  const bars = 100;
  const hitIndices = [12,13,38,39,40,64];
  const riskIndices = [28,29,62,63];
  let html = '';
  for(let i=0;i<bars;i++){
    const h = 6 + Math.abs(Math.sin(i*0.42))*44 + Math.abs(Math.cos(i*0.18))*10;
    let cls = '';
    if(hitIndices.includes(i)) cls = 'hit';
    else if(riskIndices.includes(i)) cls = 'risk';
    html += `<span class="${cls}" style="height:${h.toFixed(1)}px"></span>`;
  }
  wf.innerHTML = html;
})();

// ──────────────────────────────────────────
// SCROLL REVEAL + COUNTER ANIMATION
// ──────────────────────────────────────────
(function(){
  const items = document.querySelectorAll('.reveal');
  const obs = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        e.target.classList.add('visible');

        // Animate counters
        e.target.querySelectorAll('.counter').forEach(el=>{
          const target = parseInt(el.closest('[data-count]').dataset.count);
          const ringEl = el.closest('[data-ring]');
          const pct = parseInt(ringEl ? ringEl.dataset.ring : 0);
          let start = null;
          const dur = 1200;
          function step(ts){
            if(!start) start = ts;
            const prog = Math.min((ts-start)/dur, 1);
            const ease = 1 - Math.pow(1-prog, 3);
            el.textContent = Math.round(ease * target);
            if(prog < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);

          // Ring animation
          const ringFill = ringEl.querySelector('.ring-fill');
          if(ringFill){
            const circ = 125.66;
            const offset = circ - (pct/100)*circ;
            setTimeout(()=>{ ringFill.style.strokeDashoffset = offset; }, 200);
          }
        });

        obs.unobserve(e.target);
      }
    });
  }, {threshold: 0.15});
  items.forEach(i=>obs.observe(i));
})();

// ──────────────────────────────────────────
// 3D CARD TILT
// ──────────────────────────────────────────
document.querySelectorAll('.metric').forEach(card=>{
  card.addEventListener('mousemove', e=>{
    const r = card.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width - 0.5;
    const y = (e.clientY - r.top) / r.height - 0.5;
    card.style.transform = `translateY(-6px) rotateX(${-y*8}deg) rotateY(${x*8}deg) scale(1.02)`;
  });
  card.addEventListener('mouseleave', ()=>{
    card.style.transform = '';
  });
});

// ──────────────────────────────────────────
// COMMAND PALETTE
// ──────────────────────────────────────────
const palette = document.getElementById('commandPalette');
const input = document.getElementById('commandInput');
const results = document.getElementById('commandResults');

const sections = [
  { label: 'At a glance — metrics', id: 'sec-metrics' },
  { label: 'Executive summary', id: 'sec-summary' },
  { label: 'Timeline intelligence', id: 'sec-timeline' },
  { label: 'Knowledge graph', id: 'sec-graph' },
];

function openPalette(){ palette.classList.add('open'); input.value=''; renderResults(''); setTimeout(()=>input.focus(),50); }
function closePalette(){ palette.classList.remove('open'); }

function renderResults(q){
  const filtered = sections.filter(s=>s.label.toLowerCase().includes(q.toLowerCase()));
  if(!filtered.length){ results.innerHTML=`<div class="command-empty">No results for "${q}"</div>`; return; }
  results.innerHTML = filtered.map((s,i)=>`
    <div class="command-item${i===0?' active-result':''}" data-id="${s.id}">
      <span>${s.label}</span>
      <span class="ci-section">section</span>
    </div>`).join('');
  results.querySelectorAll('.command-item').forEach(item=>{
    item.addEventListener('click',()=>{
      const el = document.getElementById(item.dataset.id);
      if(el){ el.scrollIntoView({behavior:'smooth',block:'start'}); }
      closePalette();
    });
  });
}

document.getElementById('paletteTrigger').addEventListener('click', openPalette);
input.addEventListener('input', ()=>renderResults(input.value));
palette.addEventListener('click', e=>{ if(e.target===palette) closePalette(); });
document.addEventListener('keydown', e=>{
  if((e.ctrlKey||e.metaKey) && e.key==='k'){ e.preventDefault(); openPalette(); }
  if(e.key==='Escape') closePalette();
});
</script>
</body>

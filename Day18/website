<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Command Center · Transcript Intelligence</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
/* =========================================
   ROOT TOKENS
========================================= */
:root {
  --bg: #020408;
  --bg1: #050a12;
  --bg2: #0a1120;
  --glass: rgba(10,20,40,0.6);
  --glass-border: rgba(80,160,255,0.15);
  --glow-blue: #3b82f6;
  --glow-cyan: #06b6d4;
  --glow-violet: #8b5cf6;
  --glow-amber: #f59e0b;
  --glow-red: #ef4444;
  --glow-green: #10b981;
  --text: #e2e8f0;
  --text-dim: #64748b;
  --text-faint: #1e2d45;
  --mono: 'JetBrains Mono', monospace;
  --sans: 'Space Grotesk', sans-serif;
  --radius: 16px;
  --radius-lg: 24px;
}

* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  min-height: 100vh;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* =========================================
   BACKGROUND — ANIMATED GRID + PARTICLES
========================================= */
#bg-canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}

.bg-grid {
  position: fixed;
  inset: 0;
  z-index: 0;
  background-image:
    linear-gradient(rgba(59,130,246,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(59,130,246,0.04) 1px, transparent 1px);
  background-size: 48px 48px;
  pointer-events: none;
  animation: gridDrift 20s linear infinite;
}
@keyframes gridDrift {
  from { background-position: 0 0; }
  to { background-position: 48px 48px; }
}

.bg-radial {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 60% 50% at 20% 30%, rgba(59,130,246,0.06) 0%, transparent 70%),
    radial-gradient(ellipse 40% 40% at 80% 70%, rgba(139,92,246,0.05) 0%, transparent 70%),
    radial-gradient(ellipse 50% 50% at 50% 0%, rgba(6,182,212,0.04) 0%, transparent 60%);
}

/* =========================================
   LAYOUT
========================================= */
.wrap {
  position: relative;
  z-index: 1;
  max-width: 1340px;
  margin: 0 auto;
  padding: 0 32px 120px;
}

/* =========================================
   TOPBAR
========================================= */
.topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 32px;
  background: rgba(2,4,8,0.85);
  backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1px solid rgba(59,130,246,0.1);
  box-shadow: 0 1px 0 rgba(59,130,246,0.05), 0 8px 32px rgba(0,0,0,0.4);
}

.topbar-left { display: flex; align-items: center; gap: 14px; }

.mark {
  width: 34px; height: 34px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--glow-blue), var(--glow-violet));
  display: flex; align-items: center; justify-content: center;
  font-family: var(--mono); font-weight: 600; font-size: 12px;
  color: #fff;
  box-shadow: 0 0 16px rgba(59,130,246,0.4), inset 0 1px 0 rgba(255,255,255,0.2);
  animation: markPulse 4s ease-in-out infinite;
}
@keyframes markPulse {
  0%,100% { box-shadow: 0 0 16px rgba(59,130,246,0.4), inset 0 1px 0 rgba(255,255,255,0.2); }
  50% { box-shadow: 0 0 28px rgba(59,130,246,0.7), inset 0 1px 0 rgba(255,255,255,0.2); }
}

.topbar-title {
  font-family: var(--mono);
  font-size: 13px;
  color: var(--text-dim);
  letter-spacing: 0.02em;
}
.topbar-title strong { color: var(--text); font-weight: 500; }

.topbar-right {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--text-dim);
}

.live-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  border-radius: 20px;
  background: rgba(16,185,129,0.08);
  border: 1px solid rgba(16,185,129,0.2);
  color: var(--glow-green);
  font-size: 11px;
}
.live-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--glow-green);
  animation: livePulse 2s infinite;
}
@keyframes livePulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(16,185,129,0.6); }
  50% { box-shadow: 0 0 0 5px rgba(16,185,129,0); }
}

.tb-btn {
  display: flex; align-items: center; gap: 7px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 8px;
  padding: 6px 12px;
  color: var(--text-dim);
  font-family: var(--mono);
  font-size: 11px;
  cursor: pointer;
  transition: all 0.2s;
}
.tb-btn:hover {
  background: rgba(59,130,246,0.08);
  border-color: rgba(59,130,246,0.3);
  color: var(--glow-blue);
}
.tb-btn svg { width: 13px; height: 13px; }
.kbd { padding: 2px 5px; border: 1px solid rgba(255,255,255,0.12); border-radius: 4px; font-size: 9px; }

/* =========================================
   HERO
========================================= */
.hero {
  padding: 80px 0 60px;
  position: relative;
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--glow-cyan);
  padding: 6px 14px;
  border: 1px solid rgba(6,182,212,0.25);
  border-radius: 20px;
  background: rgba(6,182,212,0.06);
  margin-bottom: 28px;
}
.hero-eyebrow::before { content: "◉"; font-size: 9px; animation: eyebrowPulse 2s infinite; }
@keyframes eyebrowPulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

.hero h1 {
  font-size: clamp(40px, 5.5vw, 68px);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.1;
  max-width: 800px;
  background: linear-gradient(135deg, #e2e8f0 0%, #94a3b8 60%, #475569 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.hero h1 .accent {
  background: linear-gradient(90deg, var(--glow-blue), var(--glow-cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-sub {
  margin-top: 20px;
  max-width: 560px;
  color: var(--text-dim);
  font-size: 16px;
  line-height: 1.7;
}

.hero-meta {
  display: flex;
  gap: 0;
  margin-top: 44px;
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--glass);
  backdrop-filter: blur(12px);
  width: fit-content;
}
.hero-stat {
  padding: 18px 28px;
  border-right: 1px solid var(--glass-border);
  position: relative;
}
.hero-stat:last-child { border-right: none; }
.hero-stat-val {
  font-size: 20px;
  font-weight: 600;
  font-family: var(--mono);
  color: var(--text);
  display: block;
}
.hero-stat-label {
  font-size: 11px;
  color: var(--text-dim);
  font-family: var(--mono);
  letter-spacing: 0.05em;
  display: block;
  margin-top: 2px;
}
.confidence-val { color: var(--glow-green) !important; }

/* =========================================
   WAVEFORM
========================================= */
.waveform-wrap {
  margin-top: 48px;
  position: relative;
}
.waveform-label {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text-dim);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 10px;
}
.waveform {
  height: 80px;
  display: flex;
  align-items: center;
  gap: 2px;
  padding: 16px 20px;
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  background: var(--glass);
  backdrop-filter: blur(12px);
  overflow: hidden;
  position: relative;
}
.waveform::after {
  content: '';
  position: absolute;
  top: 0; right: 0; bottom: 0;
  width: 3px;
  background: rgba(59,130,246,0.6);
  box-shadow: 0 0 12px rgba(59,130,246,0.6);
  animation: scanLine 6s linear infinite;
}
@keyframes scanLine {
  from { right: 100%; left: 0; width: 0; opacity: 1; }
  50% { width: 3px; opacity: 1; }
  to { right: 0; left: 100%; width: 0; opacity: 0; }
}
.waveform span {
  flex: 1;
  border-radius: 2px;
  min-width: 2px;
  background: rgba(59,130,246,0.2);
  transition: height 0.3s ease;
}
.waveform span.hit { background: var(--glow-amber); box-shadow: 0 0 6px rgba(245,158,11,0.5); }
.waveform span.risk { background: var(--glow-red); box-shadow: 0 0 6px rgba(239,68,68,0.5); }

/* =========================================
   SECTION
========================================= */
.section { margin-top: 64px; }
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
}
.section-head h2 {
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-dim);
  font-family: var(--mono);
  display: flex;
  align-items: center;
  gap: 10px;
}
.section-head h2::before {
  content: '';
  width: 18px; height: 1px;
  background: linear-gradient(90deg, var(--glow-blue), transparent);
}
.section-badge {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text-dim);
  padding: 3px 10px;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 12px;
  background: rgba(255,255,255,0.02);
}

/* =========================================
   METRIC CARDS — 3D GLASS
========================================= */
.metrics {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 16px;
}

.metric {
  position: relative;
  padding: 28px 24px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--glass-border);
  background: var(--glass);
  backdrop-filter: blur(20px);
  overflow: hidden;
  cursor: default;
  transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s ease;
  transform-style: preserve-3d;
}
.metric::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(255,255,255,0.06) 0%, transparent 60%);
  pointer-events: none;
}
.metric::after {
  content: '';
  position: absolute;
  top: -50%; left: -50%;
  width: 200%; height: 200%;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}
.metric:hover { transform: translateY(-6px) rotateX(2deg) rotateY(-1deg) scale(1.02); }
.metric:hover::after { opacity: 1; }

.metric.action { border-color: rgba(59,130,246,0.25); }
.metric.action::after { background: radial-gradient(circle, rgba(59,130,246,0.08) 0%, transparent 70%); }
.metric.action:hover { box-shadow: 0 20px 60px rgba(59,130,246,0.15), 0 0 0 1px rgba(59,130,246,0.2); }

.metric.risk { border-color: rgba(239,68,68,0.25); }
.metric.risk::after { background: radial-gradient(circle, rgba(239,68,68,0.08) 0%, transparent 70%); }
.metric.risk:hover { box-shadow: 0 20px 60px rgba(239,68,68,0.15), 0 0 0 1px rgba(239,68,68,0.2); }

.metric.question { border-color: rgba(245,158,11,0.25); }
.metric.question::after { background: radial-gradient(circle, rgba(245,158,11,0.08) 0%, transparent 70%); }
.metric.question:hover { box-shadow: 0 20px 60px rgba(245,158,11,0.15), 0 0 0 1px rgba(245,158,11,0.2); }

.metric.conflict { border-color: rgba(139,92,246,0.25); }
.metric.conflict::after { background: radial-gradient(circle, rgba(139,92,246,0.08) 0%, transparent 70%); }
.metric.conflict:hover { box-shadow: 0 20px 60px rgba(139,92,246,0.15), 0 0 0 1px rgba(139,92,246,0.2); }

.metric-icon {
  width: 40px; height: 40px;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 20px;
  font-size: 18px;
}
.metric.action .metric-icon { background: rgba(59,130,246,0.1); box-shadow: 0 0 20px rgba(59,130,246,0.1); }
.metric.risk .metric-icon { background: rgba(239,68,68,0.1); box-shadow: 0 0 20px rgba(239,68,68,0.1); }
.metric.question .metric-icon { background: rgba(245,158,11,0.1); box-shadow: 0 0 20px rgba(245,158,11,0.1); }
.metric.conflict .metric-icon { background: rgba(139,92,246,0.1); box-shadow: 0 0 20px rgba(139,92,246,0.1); }

.metric-label {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-dim);
  margin-bottom: 8px;
}

.metric-value {
  font-size: 52px;
  font-weight: 700;
  font-family: var(--mono);
  letter-spacing: -0.03em;
  line-height: 1;
}
.metric.action .metric-value { color: var(--glow-blue); text-shadow: 0 0 30px rgba(59,130,246,0.4); }
.metric.risk .metric-value { color: var(--glow-red); text-shadow: 0 0 30px rgba(239,68,68,0.4); }
.metric.question .metric-value { color: var(--glow-amber); text-shadow: 0 0 30px rgba(245,158,11,0.4); }
.metric.conflict .metric-value { color: var(--glow-violet); text-shadow: 0 0 30px rgba(139,92,246,0.4); }

.metric-delta {
  margin-top: 10px;
  font-size: 12px;
  color: var(--text-dim);
  font-family: var(--mono);
}

/* Ring progress bar */
.metric-ring {
  position: absolute;
  bottom: 20px; right: 20px;
  width: 48px; height: 48px;
}
.metric-ring svg { transform: rotate(-90deg); width: 100%; height: 100%; }
.ring-bg { fill: none; stroke: rgba(255,255,255,0.05); stroke-width: 5; }
.ring-fill { fill: none; stroke-width: 5; stroke-linecap: round; transition: stroke-dashoffset 1.5s cubic-bezier(0.34,1.56,0.64,1); }
.metric.action .ring-fill { stroke: var(--glow-blue); filter: drop-shadow(0 0 4px rgba(59,130,246,0.5)); }
.metric.risk .ring-fill { stroke: var(--glow-red); filter: drop-shadow(0 0 4px rgba(239,68,68,0.5)); }
.metric.question .ring-fill { stroke: var(--glow-amber); filter: drop-shadow(0 0 4px rgba(245,158,11,0.5)); }
.metric.conflict .ring-fill { stroke: var(--glow-violet); filter: drop-shadow(0 0 4px rgba(139,92,246,0.5)); }
.ring-pct {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--mono); font-size: 9px; font-weight: 600;
  color: var(--text-dim);
}

/* =========================================
   BENTO PANELS
========================================= */
.bento {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 20px;
}

.panel {
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 30px;
  background: var(--glass);
  backdrop-filter: blur(20px);
  position: relative;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.panel::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(59,130,246,0.4), transparent);
}
.panel:hover { transform: translateY(-3px); box-shadow: 0 16px 48px rgba(0,0,0,0.3); }

.panel-title {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.04em;
  margin-bottom: 18px;
  font-family: var(--mono);
  text-transform: uppercase;
  color: var(--text-dim);
}
.panel-title-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--glow-blue);
  box-shadow: 0 0 8px rgba(59,130,246,0.6);
}

.summary-text {
  color: var(--text-dim);
  font-size: 14.5px;
  line-height: 1.75;
}
.summary-text strong { color: var(--text); font-weight: 500; }

/* Insight cards */
.insight-list { display: flex; flex-direction: column; gap: 10px; }
.insight {
  display: flex;
  gap: 12px;
  padding: 14px 16px;
  border-radius: 12px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  font-size: 13px;
  transition: all 0.2s;
  align-items: flex-start;
}
.insight:hover {
  background: rgba(59,130,246,0.04);
  border-color: rgba(59,130,246,0.15);
  transform: translateX(4px);
}
.tag {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.06em;
  padding: 3px 8px;
  border-radius: 6px;
  height: fit-content;
  white-space: nowrap;
  text-transform: uppercase;
  margin-top: 2px;
  flex-shrink: 0;
}
.tag.risk { background: rgba(239,68,68,0.12); color: var(--glow-red); border: 1px solid rgba(239,68,68,0.2); }
.tag.find { background: rgba(59,130,246,0.12); color: var(--glow-blue); border: 1px solid rgba(59,130,246,0.2); }
.tag.trend { background: rgba(16,185,129,0.12); color: var(--glow-green); border: 1px solid rgba(16,185,129,0.2); }
.insight p { color: var(--text-dim); margin: 0; line-height: 1.5; }

/* =========================================
   TIMELINE
========================================= */
.timeline-panel {
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  background: var(--glass);
  backdrop-filter: blur(20px);
  overflow: hidden;
  position: relative;
}
.timeline-panel::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(139,92,246,0.4), transparent);
}
.timeline {
  padding: 32px 40px;
  position: relative;
}
.timeline-track {
  position: absolute;
  left: 40px; top: 0; bottom: 0;
  width: 1px;
  background: linear-gradient(180deg, transparent 0%, rgba(59,130,246,0.3) 10%, rgba(59,130,246,0.3) 90%, transparent 100%);
}

.t-event {
  position: relative;
  padding: 0 0 36px 40px;
  transition: all 0.2s;
}
.t-event:last-child { padding-bottom: 0; }
.t-event::before {
  content: '';
  position: absolute;
  left: -6px; top: 4px;
  width: 13px; height: 13px;
  border-radius: 50%;
  background: var(--bg);
  border: 2px solid rgba(59,130,246,0.3);
  transition: all 0.3s;
  z-index: 1;
}
.t-event:hover::before {
  transform: scale(1.4);
  box-shadow: 0 0 12px rgba(59,130,246,0.5);
  border-color: var(--glow-blue);
}
.t-event.flag::before { border-color: var(--glow-red); background: rgba(239,68,68,0.15); }
.t-event.flag:hover::before { box-shadow: 0 0 12px rgba(239,68,68,0.5); }
.t-event.pending::before { border-color: var(--glow-amber); background: rgba(245,158,11,0.15); }
.t-event.done::before { border-color: var(--glow-green); background: rgba(16,185,129,0.15); }

.t-time {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text-dim);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 4px;
}
.t-title { font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 4px; }
.t-desc { font-size: 13px; color: var(--text-dim); max-width: 540px; line-height: 1.6; }

/* =========================================
   KNOWLEDGE GRAPH
========================================= */
.graph-panel {
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  background: var(--glass);
  backdrop-filter: blur(20px);
  overflow: hidden;
  padding: 28px;
  position: relative;
}
.graph-panel::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(6,182,212,0.4), transparent);
}
.graph-svg { width: 100%; height: auto; display: block; }
.edge {
  stroke: rgba(59,130,246,0.2);
  stroke-width: 1.5;
  stroke-dasharray: 4 4;
  animation: edgeDash 3s linear infinite;
}
@keyframes edgeDash { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -24; } }

.node-circle {
  fill: rgba(10,20,40,0.8);
  stroke: rgba(59,130,246,0.3);
  stroke-width: 1.5;
  transition: all 0.3s;
}
.node-group:hover .node-circle {
  fill: rgba(59,130,246,0.1);
  stroke: var(--glow-cyan);
  filter: drop-shadow(0 0 12px rgba(6,182,212,0.5));
}
.node-label { font-family: var(--mono); font-size: 10px; fill: #64748b; text-anchor: middle; }
.node-group:hover .node-label { fill: var(--glow-cyan); }

.center-circle {
  fill: url(#centerGrad);
  filter: drop-shadow(0 0 16px rgba(59,130,246,0.4));
  animation: centerPulse 3s ease-in-out infinite;
}
@keyframes centerPulse {
  0%,100% { filter: drop-shadow(0 0 16px rgba(59,130,246,0.4)); }
  50% { filter: drop-shadow(0 0 28px rgba(59,130,246,0.7)); }
}
.center-label { font-family: var(--mono); font-size: 11px; fill: #e2e8f0; text-anchor: middle; font-weight: 600; letter-spacing: 0.1em; }

/* =========================================
   KANBAN
========================================= */
.kanban { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }

.kcol {
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  background: var(--glass);
  backdrop-filter: blur(20px);
  padding: 20px;
  position: relative;
  overflow: hidden;
  transition: box-shadow 0.3s;
}
.kcol:hover { box-shadow: 0 8px 32px rgba(0,0,0,0.3); }

.kcol-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-dim);
  margin-bottom: 16px;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}
.kcol-n {
  width: 20px; height: 20px;
  border-radius: 6px;
  background: rgba(59,130,246,0.12);
  border: 1px solid rgba(59,130,246,0.2);
  color: var(--glow-blue);
  display: flex; align-items: center; justify-content: center;
  font-size: 10px;
}
.kcol:nth-child(2) .kcol-n { background: rgba(245,158,11,0.1); border-color: rgba(245,158,11,0.2); color: var(--glow-amber); }
.kcol:nth-child(3) .kcol-n { background: rgba(16,185,129,0.1); border-color: rgba(16,185,129,0.2); color: var(--glow-green); }

.kcard {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 10px;
  font-size: 13px;
  transition: all 0.2s;
  cursor: pointer;
}
.kcard:hover {
  background: rgba(59,130,246,0.05);
  border-color: rgba(59,130,246,0.2);
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0,0,0,0.2);
}
.kcard:last-child { margin-bottom: 0; }
.kcard .owner {
  display: block;
  margin-top: 8px;
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text-dim);
}

/* =========================================
   SCROLL REVEAL
========================================= */
.reveal {
  opacity: 0;
  transform: translateY(32px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}
.reveal.visible { opacity: 1; transform: translateY(0); }

/* =========================================
   COMMAND PALETTE
========================================= */
#commandPalette {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  backdrop-filter: blur(8px);
  display: none;
  justify-content: center;
  align-items: flex-start;
  padding-top: 15vh;
  z-index: 9999;
}
#commandPalette.open { display: flex; }
.command-box {
  width: min(580px, 88%);
  border: 1px solid rgba(59,130,246,0.2);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 32px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(59,130,246,0.05);
  background: rgba(5,10,18,0.95);
  backdrop-filter: blur(24px);
  animation: paletteIn 0.2s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes paletteIn {
  from { transform: scale(0.95) translateY(-10px); opacity: 0; }
  to { transform: scale(1) translateY(0); opacity: 1; }
}
.command-box-head {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}
.command-box-head svg { width: 15px; height: 15px; color: var(--text-dim); flex-shrink: 0; }
#commandInput {
  flex: 1;
  background: none;
  border: none;
  outline: none;
  color: var(--text);
  font-family: var(--sans);
  font-size: 15px;
}
#commandInput::placeholder { color: rgba(100,116,139,0.5); }
.command-results { max-height: 340px; overflow-y: auto; padding: 8px; }
.command-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.15s;
  font-size: 13.5px;
  color: var(--text);
  gap: 12px;
}
.command-item:hover, .command-item.active-result {
  background: rgba(59,130,246,0.08);
  border: 1px solid rgba(59,130,246,0.1);
}
.command-item .ci-section {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text-dim);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.command-empty {
  padding: 28px 16px;
  text-align: center;
  color: var(--text-dim);
  font-size: 13px;
  font-family: var(--mono);
}

/* =========================================
   MOBILE
========================================= */
@media (max-width: 900px) {

/* =========================================================
   AI BUY / SELL SIGNAL ENGINE
   Derives entry zone, target, stop-loss, risk:reward and a
   confidence score from each stock's existing fundamental +
   price data, plus a momentum component for "trending" calls.
   ========================================================= */
function seedFromTicker(ticker){
  let h = 0;
  for (let i=0;i<ticker.length;i++) h = (h*31 + ticker.charCodeAt(i)) % 100000;
  return h;
}

function getSignalData(ticker){
  const data = getMockData(ticker);
  const seed = seedFromTicker(ticker);
  const rand = (min,max) => min + ((seed % 1000) / 1000) * (max - min);

  const cmp = data.cmp;
  const low = data.low52, high = data.high52;
  const posInRange = (cmp - low) / Math.max(1,(high - low));

  let score = 50;
  if (data.roe > 15) score += 10;
  if (data.roce > 15) score += 8;
  if (data.de < 1) score += 8;
  if (data.revCAGR > 12) score += 6;
  if (data.profCAGR > 12) score += 6;
  if (data.quality === 'Strong') score += 10;
  if (data.quality === 'Weak') score -= 12;
  if (posInRange < 0.35) score += 10;
  if (posInRange > 0.85) score -= 12;
  score += Math.round(rand(-4,4));
  score = Math.max(8, Math.min(96, Math.round(score)));

  let verdict = 'hold';
  if (score >= 68) verdict = 'buy';
  else if (score <= 38) verdict = 'sell';

  const entryLow = Math.round(cmp * (verdict==='buy' ? 0.97 : 0.95));
  const entryHigh = Math.round(cmp * (verdict==='buy' ? 1.01 : 0.99));
  const target1 = Math.round(cmp * (1 + (score/100)*0.22 + 0.04));
  const target2 = Math.round(target1 * 1.08);
  const stopLoss = Math.round(cmp * (1 - (0.05 + (100-score)/100*0.07)));
  const risk = cmp - stopLoss;
  const reward = target1 - cmp;
  const rr = risk > 0 ? (reward / risk) : 0;

  const momentum = Math.round(rand(-8,22) + (score-50)/4);

  const factors = [
    {ok: data.roe>15, text:`ROE of ${data.roe}% ${data.roe>15?'supports a quality entry':'is below the comfort threshold'}`},
    {ok: data.de<1, text:`Debt/Equity ${data.de} ${data.de<1?'keeps downside risk contained':'adds balance-sheet risk'}`},
    {ok: posInRange<0.5, text:`Price is ${(posInRange*100).toFixed(0)}% up its 52-week range — ${posInRange<0.5?'room to run':'limited headroom'}`},
    {ok: data.revCAGR>12, text:`Revenue CAGR ${data.revCAGR}% ${data.revCAGR>12?'signals durable demand':'is below trend'}`},
    {ok: data.profCAGR>12, text:`Profit CAGR ${data.profCAGR}% ${data.profCAGR>12?'confirms earnings momentum':'lags expectations'}`},
    {ok: momentum>5, text:`${Math.abs(momentum)}% ${momentum>5?'positive':'negative'} price momentum over last 30 sessions`},
  ];

  return {ticker, cmp, verdict, score, entryLow, entryHigh, target1, target2, stopLoss, rr, momentum, factors, low52:low, high52:high};
}

function ringSVG(score, color){
  const r = 26, c = 2*Math.PI*r;
  const offset = c - (score/100)*c;
  return `<svg width="64" height="64" viewBox="0 0 64 64">
    <circle cx="32" cy="32" r="${r}" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="6"/>
    <circle cx="32" cy="32" r="${r}" fill="none" stroke="${color}" stroke-width="6" stroke-linecap="round"
      stroke-dasharray="${c}" stroke-dashoffset="${offset}" style="transition:stroke-dashoffset 1s cubic-bezier(.4,0,.2,1)"/>
  </svg>`;
}


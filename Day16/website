  const verdictIcon = s.verdict==='buy' ? 'ti-trending-up' : s.verdict==='sell' ? 'ti-trending-down' : 'ti-minus';
  const verdictText = s.verdict==='buy' ? 'AI suggests BUY zone' : s.verdict==='sell' ? 'AI suggests SELL / avoid' : 'AI suggests HOLD / wait';

  area.innerHTML = `
    <div class="output-header3d">
      <div class="output-title3d">${ticker} — Buy/Sell Signal</div>
      <span class="badge3d badge-blue3d">AI-generated</span>
      <span class="badge3d ${s.verdict==='buy'?'badge-green3d':s.verdict==='sell'?'badge-red3d':'badge-amber3d'}">${s.verdict.toUpperCase()}</span>

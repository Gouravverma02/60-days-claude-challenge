      <div class="disclaimer3d">This signal is AI-generated from fundamentals and price-range heuristics for educational purposes only. It is not investment advice and not a guarantee of profit. Markets carry risk — verify independently and size positions responsibly.</div>
    </div>`;

  setTimeout(() => {
    drawSignalChart('sig-chart', ticker, s);
    const fill = document.getElementById('rr-fill');
    if (fill) requestAnimationFrame(()=>{ fill.style.width = Math.min(100, s.rr*28) + '%'; });
  }, 80);
}

function drawSignalChart(canvasId, ticker, s){
  if (chartInstance) { try{chartInstance.destroy()}catch(e){} }
  const data = priceData(ticker);
  data[data.length-1] = s.cmp;
  const months = ['Jul','Aug','Sep','Oct','Nov','Dec','Jan','Feb','Mar','Apr','May','Jun'];
  const ctx = document.getElementById(canvasId);
  if (!ctx) return;
  const g = ctx.getContext('2d');
  const grad = g.createLinearGradient(0,0,0,200);
  grad.addColorStop(0,'rgba(62,230,214,0.30)');
  grad.addColorStop(1,'rgba(62,230,214,0.0)');
  chartInstance = new Chart(ctx, {
    type:'line',
    data:{
      labels:months,
      datasets:[
        {label:ticker, data:data, borderColor:'#3ee6d6', backgroundColor:grad, fill:true, tension:0.4, pointRadius:2, pointHoverRadius:5, borderWidth:2.5},
        {label:'Target', data:months.map(()=>s.target1), borderColor:'#3ee6d6', borderWidth:1.5, borderDash:[6,4], pointRadius:0, fill:false},
        {label:'Entry', data:months.map(()=>s.entryHigh), borderColor:'#4ade80', borderWidth:1.5, borderDash:[6,4], pointRadius:0, fill:false},
        {label:'Stop-loss', data:months.map(()=>s.stopLoss), borderColor:'#ff6b8b', borderWidth:1.5, borderDash:[6,4], pointRadius:0, fill:false},
      ]
    },
    options:{
      responsive:true, maintainAspectRatio:false,
      plugins:{legend:{display:true, position:'top', labels:{font:{size:10,family:'JetBrains Mono'}, boxWidth:8, color:'#aab2cc'}},
        tooltip:{backgroundColor:'#11162a', titleColor:'#eef1fb', bodyColor:'#aab2cc', borderColor:'rgba(140,170,255,0.25)', borderWidth:1, padding:10}},
      scales:{
        x:{grid:{color:'rgba(120,140,200,0.08)'}, ticks:{font:{size:10,family:'JetBrains Mono'}, color:'#6b7394'}},
        y:{grid:{color:'rgba(120,140,200,0.08)'}, ticks:{font:{size:10,family:'JetBrains Mono'}, color:'#6b7394', callback:v=>'₹'+v.toLocaleString('en-IN')}}
      },
      interaction:{intersect:false, mode:'index'}
    }
  });
}

/* =========================================================
   NOTIFICATION SYSTEM (bell panel + toasts)
   ========================================================= */
let notifications = [];
let notifUnread = 0;

function toggleNotifPanel(){
  const panel = document.getElementById('notifPanel');
  const open = panel.classList.toggle('open');
  if (open){
    notifUnread = 0;
    updateNotifCount();
  }
}
document.addEventListener('click', (e) => {
  const wrap = document.querySelector('.notif-wrap');
  const panel = document.getElementById('notifPanel');
  if (wrap && panel && !wrap.contains(e.target)) panel.classList.remove('open');
});

function updateNotifCount(){
  const el = document.getElementById('notifCount');
  if (notifUnread > 0){ el.style.display='flex'; el.textContent = notifUnread > 9 ? '9+' : notifUnread; }
  else { el.style.display = 'none'; }
}

function ringBell(){
  const bell = document.getElementById('notifBell');
  bell.classList.remove('ringing');
  requestAnimationFrame(()=> bell.classList.add('ringing'));
}

function pushNotification(type, title){
  notifications.unshift({type, title, time: new Date()});
  if (notifications.length > 25) notifications.pop();
  notifUnread++;
  updateNotifCount();
  ringBell();
  renderNotifList();
  showToast(type, title);
}

function timeAgo(date){
  const s = Math.floor((Date.now() - date.getTime())/1000);
  if (s < 5) return 'just now';
  if (s < 60) return s + 's ago';
  const m = Math.floor(s/60);
  if (m < 60) return m + 'm ago';
  return Math.floor(m/60) + 'h ago';
}

function notifIcon(type){
  if (type==='buy') return 'ti-trending-up';
  if (type==='sell') return 'ti-trending-down';
  if (type==='alert') return 'ti-alert-triangle';
  return 'ti-info-circle';
}

function renderNotifList(){
  const list = document.getElementById('notifList');
  if (!list) return;
  if (notifications.length === 0){
    list.innerHTML = `<div class="notif-empty">You're all caught up — no notifications yet.</div>`;
    return;
  }
  list.innerHTML = notifications.map(n => `
    <div class="notif-item">
      <div class="notif-ico ${n.type}"><i class="ti ${notifIcon(n.type)}" aria-hidden="true"></i></div>
      <div class="notif-body">
        <div class="notif-title">${n.title}</div>
        <div class="notif-time">${timeAgo(n.time)}</div>
      </div>
    </div>`).join('');
}
setInterval(renderNotifList, 30000);

function clearNotifs(e){
  if (e) e.stopPropagation();
  notifications = [];
  notifUnread = 0;
  updateNotifCount();
  renderNotifList();
}

function showToast(type, title){
  const stack = document.getElementById('toastStack');
  if (!stack) return;
  const el = document.createElement('div');
  el.className = 'toast';
  el.innerHTML = `<div class="toast-ico ${type}"><i class="ti ${notifIcon(type)}" aria-hidden="true"></i></div><div class="toast-text">${title}</div>`;
  stack.appendChild(el);
  setTimeout(() => {
    el.classList.add('leaving');
    setTimeout(()=> el.remove(), 320);
  }, 4200);
  while (stack.children.length > 4) stack.removeChild(stack.firstChild);
}

function notifyReportReady(ticker, mode){
  const labels = {quick:'Quick Take', deep:'Deep Dive', signal:'Buy/Sell Signal', compare:'Compare', pros:'Pros & Cons', portfolio:'Portfolio Fit'};
  pushNotification('info', `${labels[mode]||'Report'} for ${ticker} is ready to view`);
}

function setNotifWatch(ticker){
  pushNotification('alert', `Watching ${ticker} — you'll be notified near its AI entry zone`);
}


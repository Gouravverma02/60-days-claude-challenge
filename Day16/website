<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
let currentMode = 'quick';
let currentModeLabel = 'Quick Take';
let chartInstance = null;

/* ---------- ticker strip ---------- */
(function buildTicker(){
  const syms = ['RELIANCE','TCS','HDFCBANK','INFY','BAJFINANCE','WIPRO','ICICIBANK','SBIN','ITC','LT'];
  const mk = () => syms.map(s => {
    const up = Math.random() > 0.42;
    const pct = (Math.random()*2.4 + 0.05).toFixed(2);
    return `<span class="tick-item"><span class="sym">${s}</span><span class="${up?'tick-up':'tick-down'}">${up?'▲':'▼'} ${pct}%</span></span>`;
  }).join('');
  document.getElementById('tickerTrack').innerHTML = mk() + mk();
})();

/* ---------- 3D tilt on metric/compare cards ---------- */
function attachTilt(root){
  root.querySelectorAll('.metric-card3d, .compare-card3d').forEach(card => {
    if (card.dataset.tiltBound) return;
    card.dataset.tiltBound = '1';
    card.addEventListener('mousemove', e => {
      const r = card.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      card.style.transform = `translateY(-3px) rotateX(${(-y*6).toFixed(2)}deg) rotateY(${(x*8).toFixed(2)}deg)`;
    });
    card.addEventListener('mouseleave', () => { card.style.transform = ''; });
  });
}

function setMode(m, label) {
  currentMode = m;
  currentModeLabel = label;
  ['quick','deep','signal','compare','pros','portfolio'].forEach(k => {
    document.getElementById('pill-'+k).classList.toggle('active', k === m);
  });
  document.getElementById('compareTicker').style.display = (m === 'compare') ? 'block' : 'none';
}

function quickPick(ticker) {
  document.getElementById('tickerInput').value = ticker;
  runAnalysis();
}

function sendPrompt(text){
  if (typeof window.sendPrompt === 'function' && window.sendPrompt !== sendPrompt) { window.sendPrompt(text); return; }
  document.getElementById('tickerInput').value = text.replace(/^Deep Dive on /,'');
  setMode('deep','Deep Dive');
  runAnalysis();
}

function showLoading() {
  document.getElementById('emptyState').style.display = 'none';
  document.getElementById('resultArea').style.display = 'none';
  document.getElementById('loadingState').style.display = 'flex';
  ['ls1','ls2','ls3','ls4'].forEach((id,i) => {
    document.getElementById(id).classList.remove('visible');
    setTimeout(() => document.getElementById(id).classList.add('visible'), i * 750);
  });
}

function runAnalysis() {
  const ticker = document.getElementById('tickerInput').value.trim();
  if (!ticker) { document.getElementById('tickerInput').focus(); return; }
  const ticker2 = document.getElementById('ticker2') ? document.getElementById('ticker2').value.trim() : '';
  showLoading();
  setTimeout(() => {
    document.getElementById('loadingState').style.display = 'none';
    renderResult(ticker.toUpperCase(), currentMode, ticker2.toUpperCase());
  }, 3200);
}

function renderResult(ticker, mode, ticker2) {
  const area = document.getElementById('resultArea');
  area.style.display = 'block';
  if (mode === 'quick') renderQuickTake(ticker, area);
  else if (mode === 'deep') renderDeepDive(ticker, area);
  else if (mode === 'signal') renderSignal(ticker, area);
  else if (mode === 'compare') renderCompare(ticker, ticker2 || 'ICICIBANK', area);
  else if (mode === 'pros') renderPros(ticker, area);
  else if (mode === 'portfolio') renderPortfolio(ticker, area);
  attachTilt(area);
  notifyReportReady(ticker, mode);
}

function priceData(ticker) {
  const base = {'TCS':3800,'RELIANCE':2900,'HDFCBANK':1750,'INFY':1600,'BAJFINANCE':7200,'WIPRO':560}[ticker] || 1200;
  return Array.from({length:12},(_,i)=>Math.round(base*(0.88+Math.random()*0.28)));
}

function drawChart(canvasId, ticker, type='line') {
  if (chartInstance) { try{chartInstance.destroy()}catch(e){} }
  const data = priceData(ticker);
  const months = ['Jul','Aug','Sep','Oct','Nov','Dec','Jan','Feb','Mar','Apr','May','Jun'];
  const ctx = document.getElementById(canvasId);
  if (!ctx) return;
  const g = ctx.getContext('2d');
  const grad = g.createLinearGradient(0,0,0,180);
  grad.addColorStop(0,'rgba(62,230,214,0.32)');
  grad.addColorStop(1,'rgba(62,230,214,0.0)');
  chartInstance = new Chart(ctx, {
    type: 'line',
    data: {
      labels: months,
      datasets: [{
        label: ticker + ' price (₹)',
        data: data,
        borderColor: '#3ee6d6',
        backgroundColor: grad,

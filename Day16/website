function switchTab(el, targetId) {
  const tabs = el.parentElement.querySelectorAll('.tab3d');
  tabs.forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  ['dd-snapshot','dd-valuation','dd-growth','dd-health','dd-returns','dd-view'].forEach(id => {

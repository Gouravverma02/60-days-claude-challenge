<h2 class="sr-only">AI stock analyst app — search any Indian stock for Quick Take, Deep Dive, Compare, Pros & Cons, or Portfolio Fit reports powered by live AI analysis</h2>
<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap');

:root{
  --bg-0:#06070d;
  --bg-1:#0a0e1a;
  --bg-2:#0f1424;
  --panel:rgba(18,23,40,0.72);
  --panel-solid:#11162a;
  --panel-hi:rgba(28,35,58,0.85);
  --border:rgba(120,140,200,0.14);
  --border-hi:rgba(140,170,255,0.32);
  --cyan:#3ee6d6;
  --cyan-dim:rgba(62,230,214,0.18);
  --violet:#8b6bff;
  --violet-dim:rgba(139,107,255,0.18);
  --amber:#ffb454;
  --rose:#ff6b8b;
  --green:#4ade80;
  --txt-0:#eef1fb;
  --txt-1:#aab2cc;
  --txt-2:#6b7394;
  --glow-cyan:0 0 24px rgba(62,230,214,0.35);
  --glow-violet:0 0 24px rgba(139,107,255,0.35);
  --radius:16px;
  --radius-sm:10px;
}
*{box-sizing:border-box;margin:0;padding:0}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
body{font-family:'Inter',var(--font-sans),sans-serif}

.app3d{
  position:relative;
  min-height:100vh;
  background:
    radial-gradient(ellipse 900px 600px at 12% -8%, rgba(139,107,255,0.20), transparent 60%),
    radial-gradient(ellipse 900px 700px at 105% 8%, rgba(62,230,214,0.16), transparent 55%),
    radial-gradient(ellipse 1200px 900px at 50% 110%, rgba(62,230,214,0.08), transparent 60%),
    var(--bg-0);
  color:var(--txt-0);
  overflow-x:hidden;
  perspective:1800px;
}

/* ---------- animated mesh / grid backdrop ---------- */
.mesh-bg{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:0.5}
.mesh-bg svg{width:100%;height:100%}
.grid-floor{
  position:fixed;inset:0;z-index:0;pointer-events:none;
  background-image:
    linear-gradient(rgba(120,140,200,0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(120,140,200,0.06) 1px, transparent 1px);
  background-size:42px 42px;
  mask-image:radial-gradient(ellipse 80% 60% at 50% 0%, black 0%, transparent 75%);
}
@keyframes drift{0%{transform:translate(0,0) rotate(0deg)}50%{transform:translate(-2%,1.5%) rotate(1deg)}100%{transform:translate(0,0) rotate(0deg)}}
.orb{position:fixed;border-radius:50%;filter:blur(60px);z-index:0;pointer-events:none;animation:drift 18s ease-in-out infinite}
.orb1{width:420px;height:420px;top:-120px;left:-100px;background:radial-gradient(circle,rgba(139,107,255,0.35),transparent 70%)}
.orb2{width:480px;height:480px;top:10%;right:-160px;background:radial-gradient(circle,rgba(62,230,214,0.28),transparent 70%);animation-delay:-6s}
.orb3{width:380px;height:380px;bottom:-140px;left:30%;background:radial-gradient(circle,rgba(255,107,139,0.16),transparent 70%);animation-delay:-11s}

/* ---------- ticker strip ---------- */
.ticker-strip{position:relative;z-index:2;background:rgba(8,10,20,0.85);border-bottom:1px solid var(--border);overflow:hidden;backdrop-filter:blur(12px)}
.ticker-track{display:flex;gap:36px;white-space:nowrap;padding:7px 0;animation:scroll-left 32s linear infinite}
.ticker-strip:hover .ticker-track{animation-play-state:paused}
@keyframes scroll-left{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.tick-item{font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--txt-1);display:inline-flex;align-items:center;gap:6px;letter-spacing:0.02em}
.tick-item .sym{color:var(--txt-0);font-weight:600}
.tick-up{color:var(--green)}
.tick-down{color:var(--rose)}

/* ---------- topbar ---------- */
.topbar3d{
  position:relative;z-index:2;
  background:rgba(10,13,24,0.78);
  backdrop-filter:blur(18px) saturate(140%);
  border-bottom:1px solid var(--border);
  padding:16px 28px;display:flex;align-items:center;gap:18px;
}
.logo3d{display:flex;align-items:center;gap:11px;font-family:'Space Grotesk',sans-serif;font-size:17px;font-weight:600;color:var(--txt-0);letter-spacing:-0.01em}
.logo-cube{
  width:30px;height:30px;border-radius:9px;position:relative;flex-shrink:0;
  background:linear-gradient(140deg,var(--cyan),var(--violet));
  box-shadow:0 0 0 1px rgba(255,255,255,0.15) inset, var(--glow-cyan);
  transform-style:preserve-3d;
  animation:cube-spin 7s linear infinite;
}
@keyframes cube-spin{0%{transform:rotateY(0deg) rotateX(8deg)}100%{transform:rotateY(360deg) rotateX(8deg)}}
.logo-cube::after{content:'';position:absolute;inset:6px;border-radius:5px;background:rgba(6,7,13,0.55)}
.tagline3d{font-size:11.5px;color:var(--txt-2);margin-left:auto;font-family:'JetBrains Mono',monospace;letter-spacing:0.04em;display:flex;align-items:center;gap:8px}
.live-pulse{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 0 rgba(74,222,128,0.6);animation:pulse-ring 1.8s ease-out infinite}
@keyframes pulse-ring{0%{box-shadow:0 0 0 0 rgba(74,222,128,0.55)}70%{box-shadow:0 0 0 7px rgba(74,222,128,0)}100%{box-shadow:0 0 0 0 rgba(74,222,128,0)}}

/* ---------- hero ---------- */
.hero3d{position:relative;z-index:2;padding:42px 28px 30px;border-bottom:1px solid var(--border)}
.hero3d h1{
  font-family:'Space Grotesk',sans-serif;font-size:clamp(26px,3vw,38px);font-weight:700;letter-spacing:-0.02em;
  background:linear-gradient(95deg,#fff 10%,var(--cyan) 55%,var(--violet) 95%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  margin-bottom:10px;line-height:1.15;
}
.hero3d p{font-size:14.5px;color:var(--txt-1);margin-bottom:24px;line-height:1.65;max-width:640px}

.search-row3d{display:flex;gap:10px;align-items:center;flex-wrap:wrap;position:relative}
.search-box3d{
  display:flex;align-items:center;gap:10px;
  background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);
  padding:13px 18px;flex:1;min-width:240px;backdrop-filter:blur(10px);
  transition:border-color .2s, box-shadow .2s, transform .15s;
  transform-style:preserve-3d;
}
.search-box3d:hover{transform:translateY(-1px)}
.search-box3d:focus-within{border-color:var(--border-hi);box-shadow:0 0 0 1px rgba(140,170,255,0.18), var(--glow-cyan)}
.search-box3d input{border:none;background:transparent;outline:none;font-size:14.5px;color:var(--txt-0);flex:1;font-family:'Inter',sans-serif}
.search-box3d input::placeholder{color:var(--txt-2)}
.search-icon{font-size:16px;color:var(--cyan);flex-shrink:0}

.run-btn3d{
  position:relative;background:linear-gradient(135deg,var(--cyan),var(--violet));color:#06070d;border:none;
  border-radius:var(--radius);padding:13px 24px;font-size:14px;font-weight:600;cursor:pointer;
  display:flex;align-items:center;gap:8px;transition:transform .15s, box-shadow .2s;
  box-shadow:0 8px 24px -8px rgba(139,107,255,0.55);font-family:'Space Grotesk',sans-serif;
  letter-spacing:0.01em; overflow:hidden;
}
.run-btn3d::before{content:'';position:absolute;inset:0;background:linear-gradient(120deg,transparent,rgba(255,255,255,0.45),transparent);transform:translateX(-120%);transition:none}
.run-btn3d:hover::before{animation:shine 1.1s ease}
@keyframes shine{to{transform:translateX(120%)}}
.run-btn3d:hover{transform:translateY(-2px) scale(1.015);box-shadow:0 12px 30px -8px rgba(139,107,255,0.7)}
.run-btn3d:active{transform:translateY(0) scale(0.98)}

.second-ticker3d{
  border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px 14px;font-size:13.5px;
  background:var(--panel);color:var(--txt-0);outline:none;width:100%;margin-top:10px;backdrop-filter:blur(10px);
  font-family:'Inter',sans-serif;transition:border-color .2s;
}
.second-ticker3d:focus{border-color:var(--border-hi)}
.second-ticker3d::placeholder{color:var(--txt-2)}

.mode-pills3d{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}
.mode-pill3d{
  padding:8px 16px;border-radius:24px;font-size:12.5px;font-weight:500;
  border:1px solid var(--border);background:rgba(18,23,40,0.5);color:var(--txt-1);cursor:pointer;
  transition:all .18s;font-family:'Inter',sans-serif;display:flex;align-items:center;gap:6px;
  backdrop-filter:blur(8px);
}
.mode-pill3d:hover{border-color:var(--border-hi);color:var(--txt-0);transform:translateY(-1px)}
.mode-pill3d.active{
  background:linear-gradient(135deg,var(--cyan-dim),var(--violet-dim));
  border-color:var(--border-hi);color:#fff;box-shadow:0 0 0 1px rgba(140,170,255,0.15), 0 4px 16px -6px rgba(62,230,214,0.4);
}

/* ---------- layout ---------- */
.main3d{display:grid;grid-template-columns:272px 1fr;position:relative;z-index:1}
.sidebar3d{
  background:rgba(10,13,22,0.55);backdrop-filter:blur(12px);
  border-right:1px solid var(--border);padding:24px 18px;
}
.sidebar-section3d{margin-bottom:28px}
.sidebar-label3d{
  font-size:11px;font-weight:600;color:var(--txt-2);text-transform:uppercase;letter-spacing:0.08em;
  margin-bottom:12px;font-family:'JetBrains Mono',monospace;display:flex;align-items:center;gap:6px;
}
.sidebar-label3d::before{content:'';width:10px;height:1px;background:var(--cyan)}

.quick-stock3d{
  display:flex;align-items:center;gap:11px;padding:10px 11px;border-radius:var(--radius-sm);cursor:pointer;
  transition:all .18s;border:1px solid transparent;margin-bottom:3px;
  transform-style:preserve-3d;
}
.quick-stock3d:hover{
  background:rgba(62,230,214,0.06);border-color:var(--border);
  transform:translateX(3px) translateY(-1px);
}
.stock-dot3d{
  width:36px;height:36px;border-radius:11px;display:flex;align-items:center;justify-content:center;
  font-size:10.5px;font-weight:700;flex-shrink:0;font-family:'Space Grotesk',sans-serif;
  position:relative;box-shadow:0 4px 12px -4px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.06) inset;
}
.stock-dot3d.blue{background:linear-gradient(145deg,#1d4f8f,#0c2747);color:#7ec0ff}
.stock-dot3d.green{background:linear-gradient(145deg,#1f5c3a,#0d2c1c);color:#7ee8a8}
.stock-dot3d.amber{background:linear-gradient(145deg,#7a5419,#3a2607);color:#ffc97e}
.stock-dot3d.purple{background:linear-gradient(145deg,#4b3a99,#231a4d);color:#bda8ff}
.stock-dot3d.teal{background:linear-gradient(145deg,#0f6354,#062f28);color:#6fe8d2}
.stock-dot3d.coral{background:linear-gradient(145deg,#7a3520,#3a1610);color:#ffab8a}
.qs-info3d{flex:1;min-width:0}
.qs-name3d{font-size:13px;font-weight:500;color:var(--txt-0)}
.qs-sector3d{font-size:10.5px;color:var(--txt-2);margin-top:1px}

.legend-row{padding:6px 0;font-size:12px;color:var(--txt-1);display:flex;align-items:center;gap:8px;line-height:1.5}
.legend-row i{color:var(--cyan);font-size:13px;width:16px;text-align:center;flex-shrink:0}

.content3d{padding:24px 28px}
.output-area3d{
  background:var(--panel);border:1px solid var(--border);border-radius:20px;min-height:520px;
  overflow:hidden;backdrop-filter:blur(16px) saturate(140%);
  box-shadow:0 30px 60px -30px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.03) inset;
  position:relative;
}
.output-area3d::before{
  content:'';position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,rgba(140,170,255,0.4),transparent);
}
.output-header3d{
  padding:18px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;flex-wrap:wrap;
  background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);
}
.output-title3d{font-size:15px;font-weight:600;color:var(--txt-0);font-family:'Space Grotesk',sans-serif;letter-spacing:-0.01em}

.badge3d{font-size:11px;padding:4px 10px;border-radius:12px;font-weight:600;letter-spacing:0.02em;font-family:'JetBrains Mono',monospace;border:1px solid transparent}
.badge-blue3d{background:rgba(62,230,214,0.12);color:var(--cyan);border-color:rgba(62,230,214,0.25)}
.badge-green3d{background:rgba(74,222,128,0.12);color:var(--green);border-color:rgba(74,222,128,0.25)}
.badge-amber3d{background:rgba(255,180,84,0.12);color:var(--amber);border-color:rgba(255,180,84,0.25)}
.badge-red3d{background:rgba(255,107,139,0.12);color:var(--rose);border-color:rgba(255,107,139,0.25)}

.empty-state3d{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:420px;color:var(--txt-2);gap:18px}
.empty-orb{width:90px;height:90px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  background:radial-gradient(circle at 35% 30%,rgba(62,230,214,0.18),rgba(139,107,255,0.08) 60%,transparent 80%);
  border:1px solid var(--border);position:relative;
}
.empty-orb i{font-size:34px;color:var(--cyan);opacity:0.7}
.empty-orb::after{content:'';position:absolute;inset:-1px;border-radius:50%;border:1px solid var(--border-hi);opacity:0.4;animation:ring-pulse 2.4s ease-in-out infinite}
@keyframes ring-pulse{0%,100%{transform:scale(1);opacity:0.35}50%{transform:scale(1.12);opacity:0}}
.empty-state3d p{font-size:14px;text-align:center;max-width:300px;line-height:1.7;color:var(--txt-1)}

.loading-state3d{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:420px;gap:22px}
.spinner3d{width:54px;height:54px;position:relative}
.spinner3d::before,.spinner3d::after{
  content:'';position:absolute;inset:0;border-radius:50%;border:2.5px solid transparent;
}
.spinner3d::before{border-top-color:var(--cyan);border-right-color:var(--cyan);animation:spin3d 1s cubic-bezier(.6,0,.4,1) infinite}
.spinner3d::after{inset:9px;border-bottom-color:var(--violet);border-left-color:var(--violet);animation:spin3d 1.3s cubic-bezier(.6,0,.4,1) infinite reverse}
@keyframes spin3d{to{transform:rotate(360deg)}}
.loading-steps3d{display:flex;flex-direction:column;gap:8px;align-items:center}
.loading-step3d{font-size:13px;color:var(--txt-1);opacity:0;transform:translateY(4px);transition:opacity .4s, transform .4s;font-family:'JetBrains Mono',monospace;display:flex;align-items:center;gap:8px}
.loading-step3d.visible{opacity:1;transform:translateY(0)}
.loading-step3d::before{content:'▸';color:var(--cyan)}

.output-body3d{padding:22px 24px}

.result-meta3d{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:22px}
.metric-card3d{
  background:linear-gradient(160deg,rgba(255,255,255,0.04),rgba(255,255,255,0.01));
  border:1px solid var(--border);border-radius:13px;padding:14px 16px;position:relative;
  transition:transform .25s, border-color .25s, box-shadow .25s;transform-style:preserve-3d;
}
.metric-card3d:hover{transform:translateY(-3px) rotateX(2deg);border-color:var(--border-hi);box-shadow:0 12px 28px -14px rgba(62,230,214,0.3)}
.mc-label3d{font-size:10.5px;color:var(--txt-2);margin-bottom:5px;text-transform:uppercase;letter-spacing:0.05em;font-family:'JetBrains Mono',monospace}
.mc-val3d{font-size:19px;font-weight:600;color:var(--txt-0);font-family:'Space Grotesk',sans-serif;letter-spacing:-0.01em}
.mc-sub3d{font-size:11px;color:var(--txt-1);margin-top:3px}

.section-title3d{font-size:12.5px;font-weight:600;color:var(--cyan);margin:22px 0 12px;text-transform:uppercase;letter-spacing:0.06em;font-family:'JetBrains Mono',monospace;display:flex;align-items:center;gap:8px}
.section-title3d::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,var(--border),transparent)}
.prose3d{font-size:14px;color:var(--txt-1);line-height:1.75;margin-bottom:12px}
.prose3d strong{color:var(--txt-0);font-weight:600}

.tags-row3d{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}
.tag3d{font-size:11.5px;padding:5px 12px;border-radius:11px;border:1px solid var(--border-hi);color:var(--txt-0);font-weight:500;display:inline-flex;align-items:center;gap:4px;backdrop-filter:blur(6px)}

.chart-wrap3d{position:relative;width:100%;height:200px;margin:16px 0;padding:14px;background:rgba(0,0,0,0.18);border-radius:14px;border:1px solid var(--border)}

.tab-bar3d{display:flex;gap:2px;border-bottom:1px solid var(--border);padding:0 24px;overflow-x:auto}
.tab3d{
  padding:13px 18px;font-size:13px;color:var(--txt-2);cursor:pointer;border-bottom:2px solid transparent;
  margin-bottom:-1px;transition:all .18s;font-weight:500;white-space:nowrap;font-family:'Space Grotesk',sans-serif;
}
.tab3d:hover{color:var(--txt-0)}
.tab3d.active{color:var(--cyan);border-bottom-color:var(--cyan);text-shadow:0 0 12px rgba(62,230,214,0.5)}

.compare-grid3d{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:4px}
.compare-card3d{
  border:1px solid var(--border);border-radius:14px;padding:16px;
  background:linear-gradient(160deg,rgba(255,255,255,0.03),transparent);
  transition:transform .25s, border-color .25s;
}
.compare-card3d:hover{transform:translateY(-2px);border-color:var(--border-hi)}
.compare-card3d h3{font-size:15px;font-weight:600;margin-bottom:14px;font-family:'Space Grotesk',sans-serif;color:var(--txt-0)}
.compare-row3d{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border);font-size:13px}
.compare-row3d:last-child{border-bottom:none}
.compare-row3d .k{color:var(--txt-2);font-family:'JetBrains Mono',monospace;font-size:11.5px}
.compare-row3d .v{font-weight:600;color:var(--txt-0);font-family:'Space Grotesk',sans-serif}
.v.good{color:var(--green)}
.v.warn{color:var(--amber)}
.v.bad{color:var(--rose)}

.pros-cons3d{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.pc-card3d{border-radius:16px;padding:18px;position:relative;overflow:hidden}
.pc-card3d.pros{background:linear-gradient(160deg,rgba(74,222,128,0.10),rgba(74,222,128,0.02));border:1px solid rgba(74,222,128,0.25)}
.pc-card3d.cons{background:linear-gradient(160deg,rgba(255,107,139,0.10),rgba(255,107,139,0.02));border:1px solid rgba(255,107,139,0.25)}
.pc-card3d h3{font-size:13.5px;font-weight:600;margin-bottom:13px;font-family:'Space Grotesk',sans-serif;display:flex;align-items:center}
.pc-card3d.pros h3{color:var(--green)}
.pc-card3d.cons h3{color:var(--rose)}
.pc-item3d{display:flex;gap:9px;font-size:13.5px;margin-bottom:10px;line-height:1.6;color:var(--txt-1)}
.pc-dot3d{width:6px;height:6px;border-radius:50%;margin-top:7px;flex-shrink:0;box-shadow:0 0 8px currentColor}
.pc-dot3d.pro{background:var(--green);color:var(--green)}
.pc-dot3d.con{background:var(--rose);color:var(--rose)}

.disclaimer3d{font-size:11px;color:var(--txt-2);border-top:1px solid var(--border);padding-top:14px;margin-top:20px;line-height:1.7}

.send-btn3d{
  background:rgba(62,230,214,0.06);border:1px solid var(--border-hi);border-radius:11px;padding:9px 16px;
  font-size:12.5px;color:var(--cyan);cursor:pointer;display:flex;align-items:center;gap:6px;
  transition:all .18s;margin-top:14px;font-weight:500;font-family:'Inter',sans-serif;
}
.send-btn3d:hover{background:rgba(62,230,214,0.14);box-shadow:var(--glow-cyan);transform:translateY(-1px)}

.quality-pill3d{
  display:inline-flex;align-items:center;gap:7px;padding:7px 16px;border-radius:24px;font-size:13px;
  font-weight:600;margin:8px 0;font-family:'Space Grotesk',sans-serif;border:1px solid transparent;
}
.quality-pill3d.strong{background:rgba(74,222,128,0.12);color:var(--green);border-color:rgba(74,222,128,0.3)}
.quality-pill3d.moderate{background:rgba(255,180,84,0.12);color:var(--amber);border-color:rgba(255,180,84,0.3)}
.quality-pill3d.weak{background:rgba(255,107,139,0.12);color:var(--rose);border-color:rgba(255,107,139,0.3)}
.quality-pill3d .dot{width:6px;height:6px;border-radius:50%;background:currentColor;box-shadow:0 0 8px currentColor}

/* ---------- signal mode (buy/sell AI) ---------- */
.signal-banner{
  border-radius:16px;padding:20px 22px;margin-bottom:20px;position:relative;overflow:hidden;
  border:1px solid var(--border-hi);
}
.signal-banner.buy{background:linear-gradient(135deg,rgba(74,222,128,0.16),rgba(74,222,128,0.03))}

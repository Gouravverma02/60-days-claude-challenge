function animateValue(el, end, isCurrency, suffix){
  if (!el) return;
  const dur = 900; const start = performance.now();
  function step(now){
    const p = Math.min(1,(now-start)/dur);
    const eased = 1 - Math.pow(1-p,3);
    const val = end * eased;
    el.textContent = (isCurrency ? '₹' : '') + (Number.isInteger(end) ? Math.round(val).toLocaleString('en-IN') : val.toFixed(1)) + (suffix||'');
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}


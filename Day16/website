      <div class="section-title3d">Why this signal</div>
      <div class="signal-factors">
        ${s.factors.map(f=>`<div class="factor-row ${f.ok?'pos':'neg'}"><div class="fi"><i class="ti ${f.ok?'ti-check':'ti-alert-triangle'}" aria-hidden="true"></i></div><div>${f.text}</div></div>`).join('')}

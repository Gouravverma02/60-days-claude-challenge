<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Career Toolkit Generator</title>
<style>
:root{
  --bg:#0b0f1a;--surface:#131929;--surface2:#1a2236;--surface3:#212d45;
  --accent:#6366f1;--accent2:#06b6d4;--accentg:#8b5cf6;
  --text:#f0f4ff;--muted:#7a8ba8;--border:#1e2d47;
  --success:#22c55e;--danger:#ef4444;--warning:#f59e0b
}
.light-mode{
  --bg:#f4f6fb;--surface:#ffffff;--surface2:#f0f2f8;--surface3:#e8ecf4;
  --text:#0f172a;--muted:#64748b;--border:#dde3f0
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;line-height:1.6;transition:background .2s,color .2s}

nav{background:var(--surface);border-bottom:1px solid var(--border);padding:0 20px;display:flex;align-items:center;justify-content:space-between;height:58px;position:sticky;top:0;z-index:200}
.nav-brand{display:flex;align-items:center;gap:10px}
.nav-logo{width:32px;height:32px;background:var(--accent);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;color:#fff}
.nav-title{font-size:15px;font-weight:600}
.nav-sub{font-size:11px;color:var(--muted)}
.nav-right{display:flex;align-items:center;gap:8px}
.nav-badge{font-size:11px;background:rgba(99,102,241,.15);color:#a5b4fc;border:1px solid rgba(99,102,241,.3);border-radius:20px;padding:3px 10px}
.theme-toggle{width:32px;height:32px;border:1px solid var(--border);border-radius:8px;background:var(--surface2);color:var(--muted);cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.theme-toggle:hover{border-color:var(--accent);color:var(--text)}

.hero{text-align:center;padding:48px 20px 32px;max-width:680px;margin:0 auto}
.hero-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.3);color:#a5b4fc;font-size:11px;padding:4px 12px;border-radius:20px;margin-bottom:16px}
.light-mode .hero-badge{color:var(--accent);background:rgba(99,102,241,.08)}
.hero h1{font-size:32px;font-weight:700;line-height:1.2;margin-bottom:12px}
.hero h1 span{color:var(--accent)}
.hero p{font-size:15px;color:var(--muted);max-width:520px;margin:0 auto 20px}
.sc-pills{display:flex;align-items:center;justify-content:center;gap:6px;flex-wrap:wrap}
.sc-pill{background:var(--surface2);border:1px solid var(--border);border-radius:20px;padding:3px 10px;font-size:11px;color:var(--muted)}

.main{display:grid;grid-template-columns:310px 1fr;max-width:1180px;margin:0 auto}
@media(max-width:880px){.main{grid-template-columns:1fr}}

.left-panel{background:var(--surface);border-right:1px solid var(--border);padding:20px 16px;display:flex;flex-direction:column;gap:18px;overflow-y:auto;max-height:calc(100vh - 58px);position:sticky;top:58px}
@media(max-width:880px){.left-panel{position:static;max-height:none;border-right:none;border-bottom:1px solid var(--border)}}

.panel-section{display:flex;flex-direction:column;gap:8px}
.panel-title{font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}

input[type=text],input[type=password],select,textarea{
  width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:8px;
  color:var(--text);font-size:13px;font-family:inherit;padding:8px 11px;
  transition:border-color .15s;outline:none
}
input:focus,select:focus,textarea:focus{border-color:var(--accent)}
select option{background:var(--surface2)}
textarea{min-height:150px;resize:vertical;line-height:1.6}
label{font-size:11px;color:var(--muted);display:block;margin-bottom:3px}
.input-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}

.api-row{display:flex;gap:6px}
.api-row input{flex:1}
.show-btn{padding:0 10px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--muted);cursor:pointer;font-size:12px;white-space:nowrap;transition:all .15s}
.show-btn:hover{border-color:var(--accent);color:var(--text)}
.api-info{font-size:11px;color:var(--muted);background:var(--surface2);border-radius:7px;padding:8px 10px;line-height:1.6;border:1px solid var(--border)}
.api-info a{color:#a5b4fc}

.upload-zone{border:1.5px dashed var(--border);border-radius:8px;padding:14px;text-align:center;cursor:pointer;transition:all .15s;background:var(--surface2)}
.upload-zone:hover,.upload-zone.drag{border-color:var(--accent);background:rgba(99,102,241,.05)}
.upload-zone p{font-size:12px;color:var(--muted)}
.upload-zone span{font-size:11px;color:var(--accent)}
#fileInput{display:none}
.char-count{font-size:10px;color:var(--muted);text-align:right;margin-top:2px}
.char-count.warn{color:var(--warning)}

.toggles{display:flex;flex-wrap:wrap;gap:5px}
.tog{padding:4px 9px;border:1px solid var(--border);border-radius:14px;cursor:pointer;font-size:11px;color:var(--muted);background:var(--surface2);user-select:none;transition:all .15s}
.tog.on{border-color:var(--accent);color:#a5b4fc;background:rgba(99,102,241,.12)}
.tog-actions{display:flex;gap:6px;margin-top:4px}
.tog-link{font-size:11px;color:var(--accent);cursor:pointer;background:none;border:none;padding:0}
.tog-link:hover{text-decoration:underline}

.tone-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.tone-btn{padding:7px 10px;border:1px solid var(--border);border-radius:8px;cursor:pointer;background:var(--surface2);font-size:11px;color:var(--muted);text-align:center;transition:all .15s;user-select:none}
.tone-btn:hover{border-color:rgba(99,102,241,.5)}
.tone-btn.active{border-color:var(--accent);color:#a5b4fc;background:rgba(99,102,241,.12)}
.tone-btn .tone-icon{font-size:16px;display:block;margin-bottom:3px}

.gen-btn{width:100%;padding:12px;font-size:14px;font-weight:600;background:var(--accent);color:#fff;border:none;border-radius:10px;cursor:pointer;transition:opacity .15s,transform .1s;display:flex;align-items:center;justify-content:center;gap:8px}
.gen-btn:hover{opacity:.88}
.gen-btn:active{transform:scale(.99)}
.gen-btn:disabled{opacity:.4;cursor:not-allowed}
.progress-bar{height:3px;background:var(--border);border-radius:2px;overflow:hidden;display:none}
.progress-bar.visible{display:block}
.progress-fill{height:100%;background:var(--accent);width:0%;transition:width .5s ease;border-radius:2px}

.history-list{display:flex;flex-direction:column;gap:6px;max-height:120px;overflow-y:auto}
.hist-item{display:flex;align-items:center;justify-content:space-between;padding:6px 10px;background:var(--surface2);border:1px solid var(--border);border-radius:7px;font-size:11px;cursor:pointer;transition:border-color .15s}
.hist-item:hover{border-color:var(--accent)}
.hist-role{color:var(--text);font-weight:500}
.hist-date{color:var(--muted)}
.hist-del{color:var(--muted);background:none;border:none;cursor:pointer;font-size:13px;padding:0 2px}
.hist-del:hover{color:var(--danger)}

.right-panel{padding:24px;display:flex;flex-direction:column;gap:0;min-height:calc(100vh - 58px)}
@media(max-width:600px){.right-panel{padding:14px}}

.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;text-align:center;gap:12px;color:var(--muted);padding:60px 20px}
.empty-icon{font-size:44px;opacity:.25}
.empty-state h3{font-size:17px;color:var(--text);opacity:.55}
.empty-state p{font-size:13px;max-width:300px;line-height:1.6}
.feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px;text-align:left;max-width:380px}
.feature-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:12px;display:flex;gap:10px}
.feature-icon{font-size:20px;flex-shrink:0}
.feature-text h4{font-size:12px;font-weight:600;color:var(--text);margin-bottom:3px}
.feature-text p{font-size:11px;color:var(--muted);line-height:1.5}

.loading-state{display:none;flex-direction:column;align-items:center;justify-content:center;flex:1;gap:20px;padding:60px 20px}
.loading-state.visible{display:flex}
.spinner{width:36px;height:36px;border:3px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-steps{display:flex;flex-direction:column;gap:6px;min-width:260px}
.lstep{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--muted);padding:5px 0;transition:color .3s}
.lstep.active{color:var(--text)}
.lstep.done{color:var(--success)}
.lstep-dot{width:7px;height:7px;border-radius:50%;background:var(--border);flex-shrink:0;transition:background .3s}
.lstep.active .lstep-dot{background:var(--accent);animation:pulse .9s infinite}
.lstep.done .lstep-dot{background:var(--success)}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}

.output-area{display:none;flex-direction:column;gap:0}
.output-area.visible{display:flex}

.output-toolbar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--border)}
.toolbar-left{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.toolbar-right{display:flex;gap:6px}
.toolbar-badge{font-size:11px;background:rgba(34,197,94,.1);color:var(--success);border:1px solid rgba(34,197,94,.25);border-radius:20px;padding:3px 10px}
.search-box{display:flex;align-items:center;gap:6px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:5px 10px}
.search-box input{background:none;border:none;color:var(--text);font-size:12px;width:140px;outline:none;font-family:inherit}
.search-box input::placeholder{color:var(--muted)}

.tabs-header{display:flex;gap:1px;flex-wrap:wrap;border-bottom:1px solid var(--border);margin-bottom:0}
.tab{padding:8px 14px;font-size:12px;cursor:pointer;color:var(--muted);border-bottom:2px solid transparent;transition:all .15s;white-space:nowrap}
.tab:hover{color:var(--text)}
.tab.active{color:#a5b4fc;border-bottom-color:var(--accent)}
.tab-content{display:none;padding:18px 0}
.tab-content.active{display:block}

.sec-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;margin-bottom:14px;overflow:hidden;transition:border-color .2s}
.sec-card:hover{border-color:rgba(99,102,241,.3)}
.sec-head{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--surface2);cursor:pointer;user-select:none}
.sec-head-left{display:flex;align-items:center;gap:10px}
.sec-num{width:22px;height:22px;background:var(--accent);border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;flex-shrink:0}
.sec-title{font-size:13px;font-weight:600}
.sec-subtitle{font-size:10px;color:var(--muted)}
.sec-actions{display:flex;gap:5px;align-items:center}
.icon-btn{padding:4px 9px;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--muted);cursor:pointer;font-size:11px;transition:all .15s;display:flex;align-items:center;gap:3px;white-space:nowrap}
.icon-btn:hover{border-color:var(--accent);color:var(--text)}
.icon-btn.copied{border-color:var(--success);color:var(--success)}
.collapse-icon{font-size:12px;color:var(--muted);transition:transform .2s;margin-left:4px}
.sec-card.collapsed .collapse-icon{transform:rotate(-90deg)}
.sec-body{padding:16px;font-size:13px;line-height:1.85;color:var(--text);white-space:pre-wrap;word-wrap:break-word}
.sec-card.collapsed .sec-body{display:none}
.sec-card.collapsed .sec-body-edit{display:none}

.sec-body-edit{display:none;padding:4px 16px 16px}
.sec-body-edit textarea{min-height:200px;font-size:13px;line-height:1.85}
.edit-actions{display:flex;gap:6px;margin-top:8px}
.edit-save{padding:6px 14px;background:var(--accent);color:#fff;border:none;border-radius:7px;font-size:12px;cursor:pointer;font-weight:500}
.edit-cancel{padding:6px 14px;background:var(--surface2);color:var(--muted);border:1px solid var(--border);border-radius:7px;font-size:12px;cursor:pointer}

.highlight{background:rgba(251,191,36,.3);border-radius:2px}
.wc-badge{font-size:10px;color:var(--muted);background:var(--surface3);border-radius:4px;padding:2px 6px}

.ats-wrap{margin-bottom:14px}
.ats-label{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-bottom:4px}
.ats-track{height:6px;background:var(--border);border-radius:3px;overflow:hidden}
.ats-fill{height:100%;border-radius:3px;transition:width 1s ease}

.download-bar{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-top:10px}
.dl-text h4{font-size:13px;font-weight:600}
.dl-text p{font-size:11px;color:var(--muted)}
.dl-actions{display:flex;gap:7px;flex-wrap:wrap}
.dl-btn{padding:8px 14px;font-size:12px;border-radius:8px;cursor:pointer;font-weight:500;border:none;transition:opacity .15s;display:flex;align-items:center;gap:5px}
.dl-btn:hover{opacity:.85}
.dl-primary{background:var(--accent);color:#fff}
.dl-secondary{background:var(--surface2);color:var(--text);border:1px solid var(--border)}

.toast{position:fixed;bottom:24px;right:24px;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:12px 18px;font-size:13px;color:var(--text);z-index:9999;transform:translateY(80px);opacity:0;transition:all .3s;display:flex;align-items:center;gap:8px;max-width:320px;box-shadow:0 4px 20px rgba(0,0,0,.3)}
.toast.show{transform:translateY(0);opacity:1}
.toast.success{border-color:rgba(34,197,94,.4);color:var(--success)}
.toast.error{border-color:rgba(239,68,68,.4);color:var(--danger)}

.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:500;align-items:center;justify-content:center;padding:20px}
.modal-overlay.open{display:flex}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:24px;max-width:540px;width:100%;max-height:80vh;overflow-y:auto}
.modal h3{font-size:16px;font-weight:600;margin-bottom:8px}
.modal p{font-size:13px;color:var(--muted);margin-bottom:16px;line-height:1.7}
.modal-close{float:right;background:none;border:none;color:var(--muted);font-size:18px;cursor:pointer;margin-top:-4px}
.modal-close:hover{color:var(--text)}
.sample-list{display:flex;flex-direction:column;gap:8px}
.sample-btn{padding:10px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);cursor:pointer;font-size:12px;text-align:left;transition:border-color .15s;line-height:1.5}
.sample-btn:hover{border-color:var(--accent)}
.sample-btn strong{display:block;font-size:13px;margin-bottom:2px}
.share-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}
.share-btn{padding:10px;border:1px solid var(--border);border-radius:8px;background:var(--surface2);color:var(--text);cursor:pointer;font-size:12px;display:flex;align-items:center;gap:8px;transition:border-color .15s}
.share-btn:hover{border-color:var(--accent)}

footer{text-align:center;padding:20px;font-size:11px;color:var(--muted);border-top:1px solid var(--border)}
footer a{color:#a5b4fc}
</style>
</head>
<body>

<nav>
  <div class="nav-brand">
    <div class="nav-logo">✦</div>
    <div>
      <div class="nav-title">AI Career Toolkit</div>
      <div class="nav-sub">Powered by Claude AI</div>
    </div>
  </div>
  <div class="nav-right">
    <div class="nav-badge">12 Sections · ATS-Ready</div>
    <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="Toggle theme">🌙</button>
  </div>
</nav>

<div class="hero">
  <div class="hero-badge">✦ AI-Powered · Recruiter-Focused · ATS-Optimized</div>
  <h1>Your Complete<br><span>Job Search Toolkit</span></h1>
  <p>Paste your resume and get 12 ready-to-deploy career documents — cover letter, outreach emails, LinkedIn content, interview prep & more.</p>
  <div class="sc-pills">
    <span class="sc-pill">Cover Letter</span>
    <span class="sc-pill">Recruiter Emails</span>
    <span class="sc-pill">LinkedIn</span>
    <span class="sc-pill">Interview Prep</span>
    <span class="sc-pill">Skill Gap</span>
    <span class="sc-pill">Personal Brand</span>
  </div>
</div>

<div class="main">
  <div class="left-panel">

    <div class="panel-section">
      <div class="panel-title">API Key</div>
      <div class="api-row">
        <input type="password" id="apiKey" placeholder="sk-ant-…" autocomplete="off">
        <button class="show-btn" onclick="toggleApiVisibility()">Show</button>
      </div>
      <div class="api-info">
        Free key at <a href="https://console.anthropic.com" target="_blank">console.anthropic.com</a><br>
        Never stored — goes directly to Anthropic only.
      </div>
    </div>

    <div class="panel-section">
      <div class="panel-title">Resume / Background</div>
      <div class="upload-zone" id="uploadZone" onclick="document.getElementById('fileInput').click()" ondragover="dragOver(event)" ondragleave="dragLeave(event)" ondrop="dropFile(event)">
        <p>📄 Drop PDF or .txt file here</p>
        <span>or click to upload · or paste below</span>
      </div>
      <input type="file" id="fileInput" accept=".txt,.pdf" onchange="handleFile(event)">
      <textarea id="resumeText" placeholder="Paste your resume here — experience, skills, education, projects, certifications, achievements…&#10;&#10;More detail = better toolkit." oninput="updateCharCount()"></textarea>
      <div class="char-count" id="charCount">0 characters</div>
      <button class="tog-link" onclick="openSamplesModal()">📋 Load a sample resume to try</button>
    </div>

    <div class="panel-section">
      <div class="panel-title">Target Details</div>
      <div style="display:flex;flex-direction:column;gap:8px">
        <div>
          <label>Target role</label>
          <input type="text" id="targetRole" placeholder="e.g. Senior Product Manager">
        </div>
        <div class="input-row">
          <div>
            <label>Target company</label>
            <input type="text" id="targetCompany" placeholder="Optional">
          </div>
          <div>
            <label>Industry</label>
            <input type="text" id="targetIndustry" placeholder="e.g. SaaS">
          </div>
        </div>
        <div>
          <label>Experience level</label>
          <select id="expLevel">
            <option value="auto">Auto-detect from resume</option>
            <option value="student">Student / Intern</option>
            <option value="fresher">Fresher (0–1 yr)</option>
            <option value="junior">Junior (1–3 yrs)</option>
            <option value="mid">Mid-level (3–6 yrs)</option>
            <option value="senior">Senior (6–10 yrs)</option>
            <option value="manager">Manager / Lead</option>
            <option value="director">Director / VP</option>
            <option value="executive">C-Suite / Executive</option>
          </select>
        </div>
      </div>
    </div>

    <div class="panel-section">
      <div class="panel-title">Writing Tone</div>
      <div class="tone-grid">
        <div class="tone-btn active" data-tone="professional" onclick="selectTone(this)"><span class="tone-icon">💼</span>Professional</div>
        <div class="tone-btn" data-tone="confident" onclick="selectTone(this)"><span class="tone-icon">🚀</span>Bold & Confident</div>
        <div class="tone-btn" data-tone="warm" onclick="selectTone(this)"><span class="tone-icon">🤝</span>Warm & Human</div>
        <div class="tone-btn" data-tone="concise" onclick="selectTone(this)"><span class="tone-icon">⚡</span>Sharp & Concise</div>
      </div>
    </div>

    <div class="panel-section">
      <div class="panel-title">Sections to Generate</div>
      <div class="toggles" id="sectionToggles">
        <div class="tog on" data-sec="cover_letter">Cover Letter</div>
        <div class="tog on" data-sec="recruiter_email">Recruiter Email</div>
        <div class="tog on" data-sec="hiring_email">HM Email</div>
        <div class="tog on" data-sec="linkedin_request">LinkedIn DM</div>
        <div class="tog on" data-sec="referral">Referral Ask</div>
        <div class="tog on" data-sec="followup">Follow-Up</div>
        <div class="tog on" data-sec="intro">30-Sec Intro</div>
        <div class="tog on" data-sec="job_titles">Job Titles</div>
        <div class="tog on" data-sec="strengths">Strengths</div>
        <div class="tog on" data-sec="skill_gap">Skill Gap</div>
        <div class="tog on" data-sec="brand">Personal Brand</div>
        <div class="tog on" data-sec="interview">Interview Prep</div>
      </div>
      <div class="tog-actions">
        <button class="tog-link" onclick="toggleAll(true)">Select all</button>
        <span style="color:var(--muted);font-size:11px">·</span>
        <button class="tog-link" onclick="toggleAll(false)">Deselect all</button>
      </div>
    </div>

    <button class="gen-btn" id="genBtn" onclick="generate()">✦ Generate My Career Toolkit</button>
    <div class="progress-bar" id="progressBar"><div class="progress-fill" id="progressFill"></div></div>

    <div class="panel-section" id="historyPanel" style="display:none">
      <div class="panel-title">Recent Sessions</div>
      <div class="history-list" id="historyList"></div>
    </div>

  </div>

  <div class="right-panel">

    <div class="empty-state" id="emptyState">

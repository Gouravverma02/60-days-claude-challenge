// ── HISTORY ───────────────────────────────────────────────────────────────────
function saveHistory(role){
  let hist = JSON.parse(localStorage.getItem('ctg_history') || '[]');
  hist.unshift({ role: role || 'Unknown Role', date: new Date().toLocaleDateString(), data: toolkitData });
  localStorage.setItem('ctg_history', JSON.stringify(hist.slice(0,5)));
  loadHistory();
}
function loadHistory(){
  const hist = JSON.parse(localStorage.getItem('ctg_history') || '[]');
  const panel = document.getElementById('historyPanel');
  const list = document.getElementById('historyList');
  if(!hist.length){ panel.style.display='none'; return; }
  panel.style.display='flex';
  list.innerHTML = hist.map((h,i) => `
    <div class="hist-item" onclick="restoreHistory(${i})">
      <div><div class="hist-role">${escapeHTML(h.role)}</div><div class="hist-date">${h.date}</div></div>
      <button class="hist-del" onclick="deleteHistory(event,${i})">✕</button>
    </div>`).join('');
}
function restoreHistory(i){
  const hist = JSON.parse(localStorage.getItem('ctg_history') || '[]');
  if(!hist[i]) return;
  toolkitData = hist[i].data;
  const active = Object.keys(toolkitData).filter(k => k !== '_raw');
  renderOutput(toolkitData, active);
  document.getElementById('emptyState').style.display = 'none';
  document.getElementById('outputArea').classList.add('visible');
  showToast('✓ Session restored', 'success');
}
function deleteHistory(e,i){
  e.stopPropagation();
  const hist = JSON.parse(localStorage.getItem('ctg_history') || '[]');
  hist.splice(i,1);
  localStorage.setItem('ctg_history', JSON.stringify(hist));
  loadHistory();
}

// ── LOADING STEPS ─────────────────────────────────────────────────────────────
function setLoadingStep(n){
  for(let i=1;i<=6;i++){
    const el = document.getElementById('ls'+i);
    el.className = i < n ? 'lstep done' : i === n ? 'lstep active' : 'lstep';
  }
}
function setProgress(pct){ document.getElementById('progressFill').style.width = pct + '%'; }

// ── GENERATE ──────────────────────────────────────────────────────────────────
async function generate(){
  const apiKey = document.getElementById('apiKey').value.trim();
  const resume = document.getElementById('resumeText').value.trim();
  if(!apiKey.startsWith('sk-')){ showToast('Enter a valid Anthropic API key (sk-ant-…)', 'error'); return; }
  if(resume.length < 80){ showToast('Please paste your resume first', 'error'); return; }
  const activeSections = getActiveSections();
  if(!activeSections.length){ showToast('Select at least one section to generate', 'error'); return; }

  localStorage.setItem('ctg_apikey', apiKey);

  const btn = document.getElementById('genBtn');
  btn.disabled = true; btn.textContent = '⏳ Generating…';
  document.getElementById('emptyState').style.display = 'none';
  document.getElementById('outputArea').classList.remove('visible');
  document.getElementById('loadingState').classList.add('visible');
  document.getElementById('progressBar').classList.add('visible');
  setProgress(5); setLoadingStep(1);

  const role     = document.getElementById('targetRole').value.trim();
  const company  = document.getElementById('targetCompany').value.trim();
  const industry = document.getElementById('targetIndustry').value.trim();
  const level    = document.getElementById('expLevel').value;

  const toneMap = {
    professional: 'Professional, polished, and results-oriented. Confident but not arrogant.',
    confident:    'Bold, assertive, and achievement-forward. Lead with impact. Strong action verbs.',
    warm:         'Warm, personable, and human. Conversational yet professional. Builds rapport.',
    concise:      'Sharp, direct, and concise. Every word earns its place. No fluff.'
  };

  const sectionDefs = {
    cover_letter:    `SECTION cover_letter — ATS-Friendly Cover Letter (350–450 words): Strong opening hook, 2–3 paragraphs with specific quantified achievements, closing CTA. Keyword-dense for the target role.`,
    recruiter_email: `SECTION recruiter_email — Recruiter Outreach Email: Format as "SUBJECT: [line]" then blank line then body (150–200 words). Cold outreach. Top 2–3 achievements. Ask for 15-min call.`,
    hiring_email:    `SECTION hiring_email — Hiring Manager Email: Format as "SUBJECT: [line]" then blank line then body (150–200 words). Lead with business value and specific ROI.`,
    linkedin_request:`SECTION linkedin_request — LinkedIn Connection Request: STRICT MAX 300 CHARACTERS TOTAL. Warm, states who you are and why connecting.`,
    referral:        `SECTION referral — Referral Request Message (150–200 words): To a contact asking for internal referral. Polite, specific about the role, easy to forward to HR.`,
    followup:        `SECTION followup — Follow-Up Email: Format as "SUBJECT: [line]" then blank line then body (100–150 words). Sent 5 days after no response. Adds new value point. Not pushy.`,
    intro:           `SECTION intro — 30-Second Professional Introduction: Spoken script ~80–100 words. Who you are → what you do → key achievement → what you're looking for.`,
    job_titles:      `SECTION job_titles — Top 10 Job Titles: Number 1–10. Each: "[N]. [Title] — [1-sentence reason this fits the candidate]"`,
    strengths:       `SECTION strengths — Key Strengths (8–10): Each: "[Strength]: [1–2 sentences with specific resume evidence]"`,
    skill_gap:       `SECTION skill_gap — Skill Gap Analysis:\nCURRENT STRENGTHS:\n[bullets]\nMISSING / WEAK SKILLS:\n[bullets with explanation]\nRECOMMENDED LEARNING ROADMAP:\n[3 prioritized steps with specific course or certification names]`,
    brand:           `SECTION brand — Personal Brand Summary:\nUNIQUE VALUE PROPOSITION:\n[2–3 sentences]\nPROFESSIONAL POSITIONING STATEMENT:\n["I help [X] achieve [Y] by [Z]"]\nRECRUITER HEADLINE:\n[Under 120 chars for LinkedIn]`,
    interview:       `SECTION interview — Interview Talking Points:\nTOP 3 ACHIEVEMENTS (STAR FORMAT):\n[3 with Situation/Task/Action/Result]\nKEY STORIES TO DISCUSS:\n[3 narrative arcs]\nLIKELY INTERVIEW QUESTIONS + GUIDANCE:\n[5 questions with brief answer strategy]`
  };

  const sectionInstructions = activeSections.map(sid => sectionDefs[sid] || sid).join('\n\n');

  const prompt = `You are a world-class career coach, technical recruiter, and executive resume writer with 20+ years of experience.

Based ONLY on the candidate's resume below, produce a complete job search toolkit. Use only facts from the resume — never fabricate details or metrics.

CANDIDATE CONTEXT:
- Target Role: ${role || 'infer best fit from resume'}
- Target Company: ${company || 'write generically for the industry'}
- Target Industry: ${industry || 'infer from resume'}
- Experience Level: ${level === 'auto' ? 'infer from resume' : level}
- Writing Tone: ${toneMap[selectedTone]}

CRITICAL REQUIREMENTS:
- Quantify every achievement where data exists in the resume
- ATS-friendly: keyword-rich for the target role
- Each piece must be ready to use without edits
- Avoid generic AI phrasing — write like a seasoned human recruiter

SECTIONS TO GENERATE:
${sectionInstructions}

OUTPUT FORMAT — CRITICAL:
- Start each section EXACTLY: === SECTION_ID ===
- End each section EXACTLY: === END ===
- Use exact SECTION_IDs: ${activeSections.join(', ')}
- No text outside section blocks

RESUME:
${resume}`;

  let step = 1, prog = 5;
  const ticker = setInterval(() => {
    step = Math.min(step + 1, 5);
    prog = Math.min(prog + 14, 78);
    setLoadingStep(step);
    setProgress(prog);
  }, 3000);

  try {
    const resp = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01',
        'anthropic-dangerous-direct-browser-access': 'true'
      },
      body: JSON.stringify({
        model: 'claude-sonnet-4-6',
        max_tokens: 8000,
        messages: [{ role: 'user', content: prompt }]
      })
    });

    clearInterval(ticker);
    setLoadingStep(6); setProgress(95);

    if(!resp.ok){
      const err = await resp.json().catch(() => ({}));
      throw new Error(err.error?.message || `API error ${resp.status}`);
    }

    const data = await resp.json();
    const rawText = (data.content || []).filter(b => b.type === 'text').map(b => b.text).join('');

    toolkitData = parseToolkit(rawText, activeSections);
    renderOutput(toolkitData, activeSections);
    showATSScore();
    saveHistory(role || inferRole(resume));
    setProgress(100);

    setTimeout(() => {
      document.getElementById('loadingState').classList.remove('visible');
      document.getElementById('progressBar').classList.remove('visible');
      document.getElementById('outputArea').classList.add('visible');
      setProgress(0);
      showToast('✓ Career Toolkit ready!', 'success');
    }, 400);

  } catch(e) {
    clearInterval(ticker);
    document.getElementById('loadingState').classList.remove('visible');
    document.getElementById('progressBar').classList.remove('visible');
    const es = document.getElementById('emptyState');
    es.style.display = '';
    es.innerHTML = `<div class="empty-icon">⚠</div><h3 style="color:var(--danger)">Generation failed</h3><p>${escapeHTML(e.message)}</p><p style="margin-top:8px;font-size:12px;color:var(--muted)">Check your API key and resume length, then try again.</p>`;
    showToast(e.message, 'error');
    setProgress(0);
  }

  btn.disabled = false;
  btn.innerHTML = '✦ Generate My Career Toolkit';
}

function inferRole(resume){
  const m = resume.match(/(?:senior|lead|junior|principal)?\s*(?:software engineer|product manager|designer|developer|analyst|manager|director|engineer)/i);
  return m ? m[0].trim() : 'Career Profile';
}

// ── PARSE ─────────────────────────────────────────────────────────────────────
function parseToolkit(text, activeSections){
  const result = {};
  activeSections.forEach(sid => {
    const re = new RegExp(`===\\s*${sid}\\s*===([\\s\\S]*?)===\\s*END\\s*===`, 'i');
    const m = text.match(re);
    result[sid] = m ? m[1].trim() : '⚠ Content not generated for this section. Try regenerating.';
  });
  result._raw = text;
  return result;
}

// ── RENDER ────────────────────────────────────────────────────────────────────
function renderOutput(data, activeSections){
  const header = document.getElementById('tabsHeader');
  const body   = document.getElementById('tabsBody');
  header.innerHTML = ''; body.innerHTML = '';

  const groups = ['Outreach','Networking','Analysis','Branding'];
  let firstGroup = null;

  groups.forEach(g => {
    const gSecs = SECTIONS.filter(s => s.group === g && activeSections.includes(s.id));
    if(!gSecs.length) return;
    if(!firstGroup) firstGroup = g;

    const tab = document.createElement('div');
    tab.className = 'tab';
    tab.textContent = `${g} (${gSecs.length})`;
    tab.dataset.group = g;
    tab.onclick = () => switchTab(g);
    header.appendChild(tab);

    const pane = document.createElement('div');
    pane.className = 'tab-content';
    pane.id = 'pane_' + g;
    gSecs.forEach(sec => pane.appendChild(renderSection(sec, data[sec.id] || '')));
    body.appendChild(pane);
  });

  if(firstGroup) switchTab(firstGroup);
}

function switchTab(label){
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.group === label));
  document.querySelectorAll('.tab-content').forEach(p => p.classList.toggle('active', p.id === 'pane_' + label));
}

function renderSection(sec, content){
  const wc = content.split(/\s+/).filter(Boolean).length;
  const card = document.createElement('div');
  card.className = 'sec-card';
  card.id = 'card_' + sec.id;
  card.innerHTML = `
    <div class="sec-head" onclick="toggleCollapse('${sec.id}')">
      <div class="sec-head-left">
        <div class="sec-num">${sec.num}</div>
        <div>
          <div class="sec-title">${sec.title}</div>
          <div class="sec-subtitle">${sec.sub}</div>
        </div>
      </div>
      <div class="sec-actions" onclick="event.stopPropagation()">
        <span class="wc-badge">${wc} words</span>
        <button class="icon-btn" id="copyBtn_${sec.id}" onclick="copySection('${sec.id}')">⧉ Copy</button>
        <button class="icon-btn" onclick="startEdit('${sec.id}')">✏ Edit</button>
        <span class="collapse-icon">▾</span>
      </div>
    </div>
    <div class="sec-body" id="body_${sec.id}">${escapeHTML(content)}</div>
    <div class="sec-body-edit" id="edit_${sec.id}">
      <textarea id="editArea_${sec.id}">${escapeHTML(content)}</textarea>
      <div class="edit-actions">
        <button class="edit-save" onclick="saveEdit('${sec.id}')">Save changes</button>
        <button class="edit-cancel" onclick="cancelEdit('${sec.id}')">Cancel</button>
      </div>
    </div>`;
  return card;
}

function toggleCollapse(sid){ document.getElementById('card_'+sid).classList.toggle('collapsed'); }
function expandAll(){ document.querySelectorAll('.sec-card').forEach(c => c.classList.remove('collapsed')); }
function collapseAll(){ document.querySelectorAll('.sec-card').forEach(c => c.classList.add('collapsed')); }

function startEdit(sid){
  document.getElementById('body_'+sid).style.display = 'none';
  document.getElementById('edit_'+sid).style.display = 'block';
  document.getElementById('editArea_'+sid).value = toolkitData[sid] || '';
}
function saveEdit(sid){
  toolkitData[sid] = document.getElementById('editArea_'+sid).value;
  document.getElementById('body_'+sid).textContent = toolkitData[sid];
  cancelEdit(sid);
  showToast('✓ Section updated', 'success');
}
function cancelEdit(sid){
  document.getElementById('body_'+sid).style.display = '';
  document.getElementById('edit_'+sid).style.display = 'none';
}

function copySection(sid){
  navigator.clipboard.writeText(toolkitData[sid] || '').then(() => {
    const btn = document.getElementById('copyBtn_'+sid);
    if(btn){ btn.textContent='✓ Copied'; btn.classList.add('copied'); setTimeout(()=>{ btn.textContent='⧉ Copy'; btn.classList.remove('copied'); }, 1800); }
    showToast('Copied to clipboard', 'success');
  }).catch(() => showToast('Copy failed — select manually', 'error'));
}

// ── SEARCH ────────────────────────────────────────────────────────────────────
function searchSections(query){
  const q = query.toLowerCase().trim();
  document.querySelectorAll('.sec-card').forEach(card => {
    const sid = card.id.replace('card_','');
    const body = card.querySelector('.sec-body');
    if(!body) return;
    if(!q){
      card.style.display='';
      body.innerHTML = escapeHTML(toolkitData[sid]||'');
      return;
    }
    const text = (toolkitData[sid]||'').toLowerCase();
    if(text.includes(q)){
      card.style.display='';
      card.classList.remove('collapsed');
      const raw = escapeHTML(toolkitData[sid]||'');
      body.innerHTML = raw.replace(new RegExp(escapeRegex(escapeHTML(q)),'gi'), m=>`<mark class="highlight">${m}</mark>`);
    } else {
      card.style.display='none';
    }
  });
}
function escapeRegex(s){ return s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'); }

// ── ATS SCORE ─────────────────────────────────────────────────────────────────
function showATSScore(){
  const resume = document.getElementById('resumeText').value.toLowerCase();
  const role   = document.getElementById('targetRole').value.toLowerCase();
  const keywords = ['experience','skills','achieved','led','managed','developed','increased','reduced','launched','delivered','built','improved','collaborated','results','impact'];
  const roleWords = role.split(/\s+/).filter(w=>w.length>3);
  const all = [...keywords, ...roleWords];
  const matches = all.filter(w => resume.includes(w)).length;
  const score = Math.min(100, Math.round((matches / all.length) * 100 + 10));
  const wrap = document.getElementById('atsScore');
  const fill = document.getElementById('atsFill');
  const val  = document.getElementById('atsVal');
  wrap.style.display = 'block';
  fill.style.width    = score + '%';
  fill.style.background = score > 70 ? 'var(--success)' : score > 45 ? 'var(--warning)' : 'var(--danger)';
  val.textContent = `${score}% (${score>70?'Strong':score>45?'Good':'Needs work'})`;
  val.style.color = fill.style.background;
}

// ── EXPORT ────────────────────────────────────────────────────────────────────
function getCleanText(){
  const role = document.getElementById('targetRole').value.trim() || 'Career Profile';
  const lines = [`AI CAREER TOOLKIT — ${role.toUpperCase()}`, `Generated: ${new Date().toLocaleDateString()}`, '='.repeat(60), ''];
  SECTIONS.forEach(s => {
    if(!toolkitData[s.id]) return;
    lines.push(`SECTION ${s.num}: ${s.title.toUpperCase()}`, '-'.repeat(50), toolkitData[s.id], '', '');
  });
  return lines.join('\n');
}
function copyAll(){
  navigator.clipboard.writeText(getCleanText())
    .then(()=>showToast('✓ All sections copied','success'))
    .catch(()=>showToast('Copy failed','error'));
}
function downloadTxt(){
  const role = document.getElementById('targetRole').value.trim() || 'career';
  triggerDownload(new Blob([getCleanText()],{type:'text/plain'}), `career-toolkit-${slug(role)}.txt`);
  showToast('✓ Download started','success');
}
function downloadHTML(){
  const role = document.getElementById('targetRole').value.trim() || 'Career Profile';
  let html = `<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>Career Toolkit — ${escapeHTML(role)}</title>
<style>body{font-family:Georgia,serif;max-width:820px;margin:40px auto;padding:0 24px;color:#1a202c;line-height:1.8}h1{color:#6366f1;border-bottom:2px solid #6366f1;padding-bottom:12px}h2{color:#4338ca;margin-top:40px;border-left:4px solid #6366f1;padding-left:14px}pre{white-space:pre-wrap;font-family:inherit;background:#f8f9ff;padding:20px;border-radius:8px;border:1px solid #e5e7eb;font-size:14px}footer{margin-top:40px;color:#9ca3af;font-size:12px;border-top:1px solid #e5e7eb;padding-top:16px}</style></head><body>
<h1>Career Toolkit — ${escapeHTML(role)}</h1><p style="color:#6b7280">Generated ${new Date().toLocaleDateString()}</p>`;
  SECTIONS.forEach(s => {
    if(!toolkitData[s.id]) return;
    html += `<h2>Section ${s.num}: ${escapeHTML(s.title)}</h2><pre>${escapeHTML(toolkitData[s.id])}</pre>`;
  });
  html += `<footer>Created with AI Career Toolkit Generator</footer></body></html>`;
  triggerDownload(new Blob([html],{type:'text/html'}), `career-toolkit-${slug(role)}.html`);
  showToast('✓ HTML download started','success');
}
function printToolkit(){
  const role = document.getElementById('targetRole').value.trim() || 'Career Profile';
  const w = window.open('','_blank');
  let html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Career Toolkit</title>
  <style>body{font-family:Arial,sans-serif;max-width:800px;margin:20px auto;font-size:13px;line-height:1.7}h2{color:#4338ca;border-left:4px solid #6366f1;padding-left:10px;margin-top:30px}pre{white-space:pre-wrap;background:#f9f9f9;padding:14px;border-radius:6px;border:1px solid #e5e7eb}@media print{h2{color:#000;border-color:#000}}</style>
  </head><body><h1>Career Toolkit — ${escapeHTML(role)}</h1>`;
  SECTIONS.forEach(s => {
    if(!toolkitData[s.id]) return;
    html += `<h2>Section ${s.num}: ${escapeHTML(s.title)}</h2><pre>${escapeHTML(toolkitData[s.id])}</pre>`;
  });
  html += `</body></html>`;
  w.document.write(html); w.document.close();
  setTimeout(()=>w.print(), 500);
}
function triggerDownload(blob, name){
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = name; a.click();
}
function slug(s){ return s.replace(/\s+/g,'-').replace(/[^a-z0-9-]/gi,'').toLowerCase(); }

// ── SHARE MODAL ───────────────────────────────────────────────────────────────
function openShareModal(){ document.getElementById('shareModal').classList.add('open'); }
function closeShareModal(){ document.getElementById('shareModal').classList.remove('open'); }

// ── TOAST ─────────────────────────────────────────────────────────────────────
let toastTimer;
function showToast(msg, type=''){
  const t = document.getElementById('toast');
  clearTimeout(toastTimer);
  t.textContent = msg;
  t.className = 'toast ' + type;
  t.classList.add('show');
  toastTimer = setTimeout(() => t.classList.remove('show'), 2800);
}

// ── UTILS ─────────────────────────────────────────────────────────────────────
function escapeHTML(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

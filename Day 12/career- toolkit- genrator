// ── FILE UPLOAD ───────────────────────────────────────────────────────────────
function dragOver(e){ e.preventDefault(); document.getElementById('uploadZone').classList.add('drag'); }
function dragLeave(){ document.getElementById('uploadZone').classList.remove('drag'); }
function dropFile(e){ e.preventDefault(); dragLeave(); if(e.dataTransfer.files[0]) processFile(e.dataTransfer.files[0]); }
function handleFile(e){ if(e.target.files[0]) processFile(e.target.files[0]); }
function processFile(file){
  if(file.type === 'text/plain'){
    const r = new FileReader();
    r.onload = ev => { document.getElementById('resumeText').value = ev.target.result; updateCharCount(); showToast('✓ File loaded', 'success'); };
    r.readAsText(file);
  } else if(file.type === 'application/pdf'){
    showToast('PDF detected — extracting text…');
    const r = new FileReader();
    r.onload = async ev => {
      try {
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
        script.onload = async () => {
          window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
          const pdf = await window.pdfjsLib.getDocument({data: new Uint8Array(ev.target.result)}).promise;
          let text = '';
          for(let i=1;i<=pdf.numPages;i++){
            const page = await pdf.getPage(i);
            const content = await page.getTextContent();
            text += content.items.map(s=>s.str).join(' ') + '\n';
          }
          document.getElementById('resumeText').value = text.trim();
          updateCharCount();
          showToast('✓ PDF text extracted', 'success');
        };
        document.head.appendChild(script);
      } catch(err){ showToast('PDF extraction failed — paste text instead', 'error'); }
    };
    r.readAsArrayBuffer(file);
  } else {
    showToast('Please upload a .txt or .pdf file', 'error');
  }
}


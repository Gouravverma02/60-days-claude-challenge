];

/* ================= STATE ================= */
let state = {
  mode:"time", timeLimit:15, wordCount:25, lang:"javascript", category:"english",
  focus:false, zen:false, soundOn:true, fontSize:1.45
};
let session = null; // active session object
let historyData = JSON.parse(localStorage.getItem('tss_history')||'[]');
let personalBests = JSON.parse(localStorage.getItem('tss_bests')||'{}');
let adaptiveLevel = parseInt(localStorage.getItem('tss_adaptive_level')||'1',10);

/* ================= TEXT GENERATION ================= */
function wordsFromPool(pool, minWords){
  let out = [];
  while(out.length < minWords){
    const s = pool[Math.floor(Math.random()*pool.length)];
    out = out.concat(s.split(/\s+/));
  }
  return out.slice(0,minWords).join(' ');
}

function generateText(){
  if(state.mode === 'quote'){
    return QUOTES[Math.floor(Math.random()*QUOTES.length)];
  }
  if(state.mode === 'programming'){
    const pool = CODE[state.lang] || CODE.javascript;
    return pool[Math.floor(Math.random()*pool.length)];
  }
  if(state.mode === 'custom'){
    const t = document.getElementById('customText').value.trim();
    return t.length ? t : "Type your custom text in the box above to begin practicing with your own material.";
  }
  let cat = state.category;
  if(state.mode === 'adaptive'){
    // adaptive cycles category and scales word count by level
    const cats = Object.keys(BANK);
    cat = cats[adaptiveLevel % cats.length];
  }
  if(cat === 'programming'){
    const langs = Object.keys(CODE);
    const l = langs[Math.floor(Math.random()*langs.length)];
    return CODE[l][Math.floor(Math.random()*CODE[l].length)];
  }
  const pool = BANK[cat] || BANK.english;
  if(state.mode === 'time'){
    return wordsFromPool(pool, 220); // generous buffer, timer cuts it off
  }
  if(state.mode === 'words'){
    return wordsFromPool(pool, state.wordCount);
  }
  if(state.mode === 'adaptive'){
    return wordsFromPool(pool, 40 + adaptiveLevel*10);
  }
  return wordsFromPool(pool, 40);
}

/* ================= AUDIO ================= */
let actx = null;
function beep(freq, dur, vol){
  if(!state.soundOn) return;
  try{
    if(!actx) actx = new (window.AudioContext||window.webkitAudioContext)();
    const o = actx.createOscillator();
    const g = actx.createGain();
    o.type = 'sine'; o.frequency.value = freq;
    g.gain.value = vol;
    o.connect(g); g.connect(actx.destination);
    o.start();
    g.gain.exponentialRampToValueAtTime(0.001, actx.currentTime+dur);
    o.stop(actx.currentTime+dur);
  }catch(e){}
}

/* ================= DOM REFS ================= */
const textDisplay = document.getElementById('textDisplay');
const typeField = document.getElementById('typeField');
const hiddenInput = document.getElementById('hiddenInput');
const startOverlay = document.getElementById('startOverlay');
const progressFill = document.getElementById('progressFill');

/* ================= SESSION ENGINE ================= */
function buildSession(){
  const raw = generateText();
  const chars = raw.split('');
  session = {
    text: raw,
    chars: chars,
    typed: [], // per-index: 'correct' | 'incorrect' | null
    extra: [], // extra chars typed beyond text length (rare, ignored positionally)
    cursor: 0,
    startTime: null,
    endTime: null,
    lastTickTime: null,
    mistakeCount: 0,
    totalKeystrokes: 0,
    correctKeystrokes: 0,
    streak: 0,
    bestStreak: 0,
    running: false,
    paused: false,
    finished: false,
    wpmSamples: [], // {t, wpm}
    intervalId: null,
    remaining: state.mode==='time' ? state.timeLimit : null,
    erroredKeys: {} // char -> count of mistakes made when that char was expected
  };
  renderText();
  resetStatsDisplay();
  startOverlay.style.display = 'flex';
  document.getElementById('resultsPanel').classList.remove('visible');
}

function renderText(){
  const lines = wrapIntoLines(session.chars);
  textDisplay.innerHTML = '';
  session.lineMap = []; // char index -> line element index
  let idx = 0;
  lines.forEach((line)=>{
    const div = document.createElement('div');
    div.className = 'tline';
    line.forEach(ch=>{
      const span = document.createElement('span');
      span.className = 'char pending';
      span.textContent = ch === '\n' ? '¬\n' : ch;
      span.dataset.idx = idx;
      div.appendChild(span);
      session.lineMap.push(div);
      idx++;
    });
    textDisplay.appendChild(div);
  });
  markCurrentLine();
  updateCursorVisual();
}

function wrapIntoLines(chars){
  // simple wrap: split on existing newlines, and also soft-wrap long lines by char budget
  const budget = 64;
  const lines = [];
  let cur = [];
  let lineLen = 0;
  chars.forEach(ch=>{
    cur.push(ch);
    lineLen++;
    if(ch === '\n' || lineLen >= budget && ch === ' '){
      lines.push(cur); cur = []; lineLen = 0;
    }
  });
  if(cur.length) lines.push(cur);
  return lines;
}

function markCurrentLine(){
  document.querySelectorAll('.tline').forEach(l=>l.classList.remove('current'));
  const el = session.lineMap[Math.min(session.cursor, session.lineMap.length-1)];
  if(el) el.classList.add('current');
}

function updateCursorVisual(){
  document.querySelectorAll('.char.current').forEach(c=>c.classList.remove('current'));
  const span = textDisplay.querySelector('[data-idx="'+session.cursor+'"]');
  if(span) span.classList.add('current');
}

function resetStatsDisplay(){
  document.getElementById('statWpm').textContent = '0';
  document.getElementById('statRaw').textContent = '0';
  document.getElementById('statCpm').textContent = '0';
  document.getElementById('statAcc').textContent = '100%';
  document.getElementById('statTime').textContent = '0.0s';
  document.getElementById('statMistakes').textContent = '0';
  document.getElementById('statStreak').textContent = '0';
  document.getElementById('statPct').textContent = '0%';
  document.getElementById('statRemain').textContent = state.mode==='time' ? state.timeLimit+'s' : (state.mode==='words'? state.wordCount+' w' : '--');
  progressFill.style.width = '0%';
}

function startSession(){
  if(session.running) return;
  session.running = true;
  session.paused = false;
  session.startTime = performance.now();
  session.lastTickTime = session.startTime;
  startOverlay.style.display = 'none';
  hiddenInput.value = '';
  hiddenInput.focus();
  session.intervalId = setInterval(tick, 100);
}

function tick(){
  if(!session.running || session.paused || session.finished) return;
  const now = performance.now();
  const elapsedSec = (now - session.startTime)/1000;
  document.getElementById('statTime').textContent = elapsedSec.toFixed(1)+'s';
  // sample wpm every ~1s for consistency graph
  if(now - session.lastTickTime >= 1000){
    session.lastTickTime = now;
    const wpm = computeWpm(elapsedSec);
    session.wpmSamples.push({t: elapsedSec, wpm: wpm, acc: computeAccuracy()});
  }
  if(state.mode === 'time'){
    const remain = Math.max(0, state.timeLimit - elapsedSec);
    document.getElementById('statRemain').textContent = Math.ceil(remain)+'s';
    if(remain <= 0){ finishSession(); return; }
  }
  updateLiveStats(elapsedSec);
}

function computeWpm(elapsedSec){
  const minutes = Math.max(elapsedSec/60, 1/600);
  const correctChars = session.typed.filter(t=>t==='correct').length;
  return Math.round((correctChars/5) / minutes);
}
function computeRawWpm(elapsedSec){
  const minutes = Math.max(elapsedSec/60, 1/600);
  return Math.round((session.totalKeystrokes/5) / minutes);
}
function computeAccuracy(){
  if(session.totalKeystrokes === 0) return 100;
  return Math.max(0, Math.round((session.correctKeystrokes/session.totalKeystrokes)*1000)/10);
}

function updateLiveStats(elapsedSec){
  const wpm = computeWpm(elapsedSec);
  const raw = computeRawWpm(elapsedSec);
  const acc = computeAccuracy();
  const cpm = Math.round((session.correctKeystrokes / Math.max(elapsedSec/60,1/600)));
  document.getElementById('statWpm').textContent = clampDisplay(wpm);
  document.getElementById('statRaw').textContent = clampDisplay(raw);
  document.getElementById('statCpm').textContent = clampDisplay(cpm);
  document.getElementById('statAcc').textContent = acc+'%';
  document.getElementById('statMistakes').textContent = session.mistakeCount;
  document.getElementById('statStreak').textContent = session.bestStreak;
  const pct = Math.round((session.cursor/session.chars.length)*100);
  document.getElementById('statPct').textContent = pct+'%';
  progressFill.style.width = pct+'%';
  if(state.mode === 'words'){
    document.getElementById('statRemain').textContent = Math.max(0, state.wordCount - countWordsTyped())+' w';
  }
}
function clampDisplay(v){
  // sanity clamp: realistic human typing tops out well under 400 wpm
  if(!isFinite(v) || v<0) return 0;
  return Math.min(v, 400);
}
function countWordsTyped(){
  return session.text.slice(0, session.cursor).trim().split(/\s+/).filter(Boolean).length;
}

function handleKeydown(e){
  if(!session) return;
  if(e.key === 'Escape'){ e.preventDefault(); buildSession(); return; }
  if(e.key === ' ' && session.running && !session.finished){ 
    // allow space as normal char unless it's meant as pause - we use dedicated pause button + shortcut below only when not typing space char expected
  }
}

hiddenInput.addEventListener('keydown', function(e){
  if(!session || session.finished) return;
  if(session.paused) return;
  if(e.key === 'Escape'){ e.preventDefault(); buildSession(); return; }
  if(e.key === 'Backspace'){
    e.preventDefault();
    if(session.cursor > 0){
      session.cursor--;
      session.typed[session.cursor] = null;
      const span = textDisplay.querySelector('[data-idx="'+session.cursor+'"]');
      if(span){ span.className = 'char pending'; }
      markCurrentLine(); updateCursorVisual();
    }
    return;
  }
  if(e.key.length !== 1) return; // ignore control keys
  e.preventDefault();
  if(!session.running) startSession();
  processChar(e.key);
});

function processChar(key){
  const expected = session.chars[session.cursor];
  const span = textDisplay.querySelector('[data-idx="'+session.cursor+'"]');
  session.totalKeystrokes++;
  if(key === expected){
    session.typed[session.cursor] = 'correct';
    session.correctKeystrokes++;
    session.streak++;
    session.bestStreak = Math.max(session.bestStreak, session.streak);
    if(span) span.className = 'char correct';
    beep(880,0.05,0.03);
  } else {
    session.typed[session.cursor] = 'incorrect';
    session.mistakeCount++;
    session.streak = 0;
    session.erroredKeys[expected] = (session.erroredKeys[expected]||0)+1;
    if(span) span.className = 'char incorrect';
    beep(180,0.08,0.05);
  }
  session.cursor++;
  markCurrentLine();
  updateCursorVisual();
  if(session.cursor >= session.chars.length){
    finishSession();
  }
}

function finishSession(){
  if(session.finished) return;
  session.finished = true;
  session.running = false;
  clearInterval(session.intervalId);
  session.endTime = performance.now();
  const elapsedSec = (session.endTime - session.startTime)/1000;
  session.finalElapsed = elapsedSec;
  showResults();
  if(state.mode === 'adaptive'){
    const acc = computeAccuracy();
    const wpm = computeWpm(elapsedSec);
    if(acc > 96 && wpm > 45) adaptiveLevel = Math.min(adaptiveLevel+1, 20);
    else if(acc < 88) adaptiveLevel = Math.max(adaptiveLevel-1, 1);
    localStorage.setItem('tss_adaptive_level', adaptiveLevel);
  }
}

/* ================= RESULTS / ANALYTICS ================= */
function showResults(){
  const elapsedSec = session.finalElapsed;
  const wpm = computeWpm(elapsedSec);
  const raw = computeRawWpm(elapsedSec);
  const acc = computeAccuracy();
  const correct = session.typed.filter(t=>t==='correct').length;
  const incorrect = session.typed.filter(t=>t==='incorrect').length;
  const missed = session.chars.length - session.cursor;
  const consistency = computeConsistency();
  const pct = Math.round((session.cursor/session.chars.length)*100);
  const percentile = estimatePercentile(wpm);

  document.getElementById('rWpm').innerHTML = wpm+'<small>wpm</small>';
  document.getElementById('rAcc').innerHTML = acc+'%';
  document.getElementById('rCons').innerHTML = consistency+'%';
  document.getElementById('rPct').innerHTML = percentile+'<small>th</small>';

  const key = state.mode+'_'+(state.mode==='time'?state.timeLimit:state.mode==='words'?state.wordCount:'');
  const prevBest = personalBests[key];
  const isPB = !prevBest || wpm > prevBest.wpm;
  if(isPB){ personalBests[key] = {wpm, acc, date: Date.now()}; localStorage.setItem('tss_bests', JSON.stringify(personalBests)); }

  const grid = document.getElementById('gridStats');
  grid.innerHTML = '';
  const cells = [
    ['Raw WPM', raw], ['Session', elapsedSec.toFixed(1)+'s'], ['Mistakes', session.mistakeCount],
    ['Best Streak', session.bestStreak], ['Completion', pct+'%'],
    ['Correct Chars', correct], ['Incorrect', incorrect], ['Extra', 0], ['Missed', missed],
    ['Personal Best', isPB ? 'New!' : prevBest.wpm+' wpm']
  ];
  cells.forEach(([l,v])=>{
    const div = document.createElement('div');
    div.className='cell';
    div.innerHTML = '<div class="v">'+v+'</div><div class="l">'+l+(l==='Personal Best'&&isPB?' <span class="pb-tag">★</span>':'')+'</div>';
    grid.appendChild(div);
  });

  drawGraph();
  drawHeatmap();
  drawBadges(wpm, acc, session.mistakeCount, consistency);
  drawSummary(wpm, acc, consistency, session.erroredKeys);
  saveHistory(wpm, acc, elapsedSec, correct+incorrect);
  renderHistoryTable();

  document.getElementById('resultsPanel').classList.add('visible');
  document.getElementById('resultsPanel').scrollIntoView({behavior:'smooth', block:'start'});
}

function computeConsistency(){
  const samples = session.wpmSamples.map(s=>s.wpm).filter(v=>v>0);
  if(samples.length < 2) return 100;
  const mean = samples.reduce((a,b)=>a+b,0)/samples.length;
  const variance = samples.reduce((a,b)=>a+(b-mean)*(b-mean),0)/samples.length;
  const sd = Math.sqrt(variance);
  const cv = mean>0 ? sd/mean : 0;
  return Math.max(0, Math.round(100 - cv*100));
}

function estimatePercentile(wpm){
  // heuristic distribution modeled roughly on typical adult typing speed (mean ~40, sd ~15)
  const mean = 40, sd = 15;
  const z = (wpm-mean)/sd;
  const p = 1/(1+Math.exp(-1.7*z)); // logistic approx of normal CDF
  return Math.min(99, Math.max(1, Math.round(p*100)));
}

function drawGraph(){
  const canvas = document.getElementById('wpmGraph');
  const ctx = canvas.getContext('2d');
  const dpr = window.devicePixelRatio||1;
  const w = canvas.clientWidth, h = 180;
  canvas.width = w*dpr; canvas.height = h*dpr;
  ctx.scale(dpr,dpr);
  ctx.clearRect(0,0,w,h);
  const samples = session.wpmSamples.length ? session.wpmSamples : [{t:0,wpm:computeWpm(session.finalElapsed),acc:computeAccuracy()}];
  const maxWpm = Math.max(...samples.map(s=>s.wpm), 10);
  const stepX = w/Math.max(samples.length-1,1);
  // grid
  ctx.strokeStyle = 'rgba(255,255,255,0.08)';
  ctx.lineWidth = 1;
  for(let i=0;i<=4;i++){
    const y = h - (i/4)*h*0.85 - 10;
    ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(w,y); ctx.stroke();
  }
  // wpm line
  ctx.strokeStyle = '#d3a45c'; ctx.lineWidth = 2.5; ctx.beginPath();
  samples.forEach((s,i)=>{
    const x = i*stepX;
    const y = h - (s.wpm/maxWpm)*h*0.85 - 10;
    if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
  });
  ctx.stroke();
  // acc line
  ctx.strokeStyle = '#6fbf8b'; ctx.lineWidth = 1.5; ctx.beginPath();
  samples.forEach((s,i)=>{
    const x = i*stepX;
    const y = h - (s.acc/100)*h*0.85 - 10;
    if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
  });
  ctx.stroke();
}

const KEY_ROWS = ["QWERTYUIOP","ASDFGHJKL","ZXCVBNM"];
function drawHeatmap(){
  const container = document.getElementById('heatmap');
  container.innerHTML = '';
  const maxErr = Math.max(1, ...Object.values(session.erroredKeys));
  KEY_ROWS.forEach(row=>{
    const rowDiv = document.createElement('div');
    rowDiv.className = 'heatmap-key-row';
    row.split('').forEach(k=>{
      const lower = k.toLowerCase();
      const err = session.erroredKeys[lower] || session.erroredKeys[k] || 0;
      const intensity = err/maxErr;
      const div = document.createElement('div');
      div.className = 'hk';
      div.textContent = k;
      if(err>0){
        const r = 211, g = Math.round(105 - intensity*60), b = Math.round(92 - intensity*50);
        div.style.background = 'rgba('+r+','+g+','+b+','+(0.25+intensity*0.6)+')';
        div.style.color = '#fff';
      }
      rowDiv.appendChild(div);
    });
    container.appendChild(rowDiv);
  });
}

function drawBadges(wpm, acc, mistakes, consistency){
  const defs = [
    {id:'first', name:'First Session', ic:'🎯', test:()=>true},
    {id:'speed40', name:'40+ WPM', ic:'⚡', test:()=>wpm>=40},

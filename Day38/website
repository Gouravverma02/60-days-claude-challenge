    {id:'speed100', name:'Centurion (100+ WPM)', ic:'🏆', test:()=>wpm>=100},
    {id:'acc100', name:'Flawless', ic:'💎', test:()=>acc>=100},
    {id:'acc95', name:'Sharp Shooter', ic:'🎯', test:()=>acc>=95},
    {id:'cons90', name:'Steady Hands', ic:'🩶', test:()=>consistency>=90},
    {id:'nomiss', name:'Zero Mistakes', ic:'✨', test:()=>mistakes===0},
    {id:'marathon', name:'120s Marathon', ic:'🕐', test:()=>state.mode==='time'&&state.timeLimit===120}
  ];
  const row = document.getElementById('badgeRow');
  row.innerHTML = '';

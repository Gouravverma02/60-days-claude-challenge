<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Typing Speed Studio</title>
<style>
:root{
  --ink-950:#0b0d12;
  --ink-900:#12141c;
  --ink-800:#191d28;
  --ink-700:#232838;
  --ink-600:#323a4d;
  --paper:#e9e7de;
  --paper-dim:#9199a8;
  --brass:#d3a45c;
  --brass-dim:#8a744f;
  --ribbon:#c85a4a;
  --ok:#6fbf8b;
  --bad:#d3695c;
  --font-display:'Iowan Old Style','Palatino Linotype',Palatino,Georgia,serif;
  --font-mono:'SFMono-Regular','JetBrains Mono',Consolas,'Liberation Mono',Menlo,monospace;
  --font-ui:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --radius:10px;
  --dur:220ms;
}
[data-theme="light"]{
  --ink-950:#f3f1e9;
  --ink-900:#ffffff;
  --ink-800:#f6f4ec;
  --ink-700:#e9e5d8;
  --ink-600:#d6d0bd;
  --paper:#2a2823;
  --paper-dim:#75705f;
  --brass:#9c6b28;
  --brass-dim:#b9925a;
}
*,*::before,*::after{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0;
  background:
    radial-gradient(circle at 20% -10%, rgba(211,164,92,0.08), transparent 45%),
    radial-gradient(circle at 90% 10%, rgba(200,90,74,0.06), transparent 40%),
    var(--ink-950);
  color:var(--paper);
  font-family:var(--font-ui);
  min-height:100vh;
  transition:background var(--dur), color var(--dur);
}
@media (prefers-reduced-motion: reduce){
  *{animation-duration:0.01ms !important; transition-duration:0.01ms !important;}
}
::selection{background:var(--brass); color:var(--ink-950);}
a{color:inherit;}
button{font-family:inherit;}
:focus-visible{outline:2px solid var(--brass); outline-offset:2px;}

.wrap{max-width:1180px;margin:0 auto;padding:28px 24px 80px;}

/* ---------- HEADER ---------- */
header.top{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:28px;flex-wrap:wrap;gap:14px;
}
.brand{display:flex;align-items:baseline;gap:10px;}
.brand .mark{
  font-family:var(--font-display);font-size:1.9rem;font-weight:600;
  letter-spacing:0.5px;color:var(--paper);
}
.brand .mark em{font-style:italic;color:var(--brass);}
.brand .tag{font-size:0.72rem;letter-spacing:2.5px;text-transform:uppercase;color:var(--paper-dim);}
.top-controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
.icon-btn{
  width:38px;height:38px;border-radius:50%;border:1px solid var(--ink-600);
  background:var(--ink-800);color:var(--paper);cursor:pointer;
  display:flex;align-items:center;justify-content:center;font-size:1rem;
  transition:transform var(--dur), border-color var(--dur), background var(--dur);
}
.icon-btn:hover{transform:translateY(-2px);border-color:var(--brass);}
.icon-btn.active{border-color:var(--brass);color:var(--brass);}

/* ---------- PANEL SHELL ---------- */
.panel{
  background:linear-gradient(180deg, var(--ink-800), var(--ink-900));
  border:1px solid var(--ink-600);
  border-radius:var(--radius);
  padding:22px;
  margin-bottom:22px;
  box-shadow:0 20px 50px -30px rgba(0,0,0,0.6);
}

/* ---------- MODE / CATEGORY BARS ---------- */
.selector-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:14px;}
.selector-row:last-child{margin-bottom:0;}
.row-label{font-size:0.68rem;text-transform:uppercase;letter-spacing:2px;color:var(--paper-dim);width:88px;flex-shrink:0;}
.chip{
  padding:7px 14px;border-radius:999px;border:1px solid var(--ink-600);
  background:transparent;color:var(--paper-dim);font-size:0.82rem;cursor:pointer;
  transition:all var(--dur);white-space:nowrap;
}
.chip:hover{border-color:var(--brass-dim);color:var(--paper);}
.chip.active{background:var(--brass);border-color:var(--brass);color:var(--ink-950);font-weight:600;}
.chip.small{padding:5px 11px;font-size:0.76rem;}
.sub-row{display:none;}
.sub-row.visible{display:flex;}

/* ---------- TYPING STAGE ---------- */
.stage{position:relative;}
.stat-strip{
  display:flex;gap:26px;flex-wrap:wrap;margin-bottom:18px;align-items:flex-end;
}
.stat{display:flex;flex-direction:column;gap:2px;min-width:58px;}
.stat .val{font-family:var(--font-mono);font-size:1.7rem;font-weight:600;color:var(--paper);line-height:1;font-variant-numeric:tabular-nums;}
.stat .lab{font-size:0.65rem;text-transform:uppercase;letter-spacing:1.5px;color:var(--paper-dim);}
.stat.accent .val{color:var(--brass);}
.progress-track{
  height:4px;border-radius:2px;background:var(--ink-700);overflow:hidden;margin-bottom:22px;
}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--brass),var(--ribbon));width:0%;transition:width 120ms linear;}

.type-field{
  position:relative;font-family:var(--font-mono);font-size:1.45rem;line-height:2.15;
  letter-spacing:0.3px; padding:8px 4px; user-select:none; cursor:text;
  max-height:8.6em; overflow:hidden;
}
.type-field.focus-mode .tline{opacity:0.12;}
.type-field.focus-mode .tline.current{opacity:1;}
.type-field.zen-mode .stat-strip,.type-field.zen-mode .progress-track{display:none;}
.tline{transition:opacity var(--dur);}
.char{position:relative;white-space:pre;}
.char.pending{color:var(--paper-dim);}
.char.correct{color:var(--paper);}
.char.incorrect{color:var(--bad);background:rgba(211,105,92,0.16);border-radius:2px;}
.char.extra{color:var(--bad);text-decoration:underline wavy var(--bad);}
.char.current::before{
  content:'';position:absolute;left:-1px;top:2px;bottom:2px;width:2px;background:var(--brass);
  animation:blink 1s steps(1) infinite;
}
@keyframes blink{50%{opacity:0;}}
.hidden-input{position:absolute;opacity:0;pointer-events:none;width:1px;height:1px;}

.stage-overlay{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  background:rgba(10,11,15,0.72);backdrop-filter:blur(3px);border-radius:8px;
  flex-direction:column;gap:14px;
}
[data-theme="light"] .stage-overlay{background:rgba(240,238,230,0.82);}
.stage-overlay p{color:var(--paper-dim);margin:0;font-size:0.95rem;}
.big-btn{
  padding:12px 26px;border-radius:999px;border:none;background:var(--brass);
  color:var(--ink-950);font-weight:700;font-size:0.95rem;cursor:pointer;
  transition:transform var(--dur);
}
.big-btn:hover{transform:scale(1.04);}
.stage-footer{display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:10px;}
.ghost-btn{
  padding:9px 16px;border-radius:8px;border:1px solid var(--ink-600);background:transparent;
  color:var(--paper-dim);cursor:pointer;font-size:0.82rem;transition:all var(--dur);
}
.ghost-btn:hover{border-color:var(--brass-dim);color:var(--paper);}
.hint{font-size:0.72rem;color:var(--paper-dim);}
kbd{background:var(--ink-700);border:1px solid var(--ink-600);border-radius:4px;padding:1px 6px;font-family:var(--font-mono);font-size:0.75rem;}

/* ---------- RESULTS ---------- */
.results{display:none;}
.results.visible{display:block; animation:rise 420ms ease both;}
@keyframes rise{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
.result-hero{display:flex;gap:40px;flex-wrap:wrap;margin-bottom:26px;}
.hero-num{font-family:var(--font-display);font-size:4.4rem;font-weight:700;line-height:1;color:var(--brass);}
.hero-num small{font-size:1.2rem;color:var(--paper-dim);font-family:var(--font-ui);font-weight:500;margin-left:6px;}
.hero-block .lab{font-size:0.72rem;text-transform:uppercase;letter-spacing:2px;color:var(--paper-dim);margin-top:4px;}
.grid-stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:14px;margin-bottom:24px;}
.grid-stats .cell{background:var(--ink-700);border-radius:8px;padding:12px 14px;}
.grid-stats .cell .v{font-family:var(--font-mono);font-size:1.3rem;font-weight:600;}
.grid-stats .cell .l{font-size:0.64rem;text-transform:uppercase;letter-spacing:1.2px;color:var(--paper-dim);margin-top:2px;}
.dash-two-col{display:grid;grid-template-columns:1.4fr 1fr;gap:20px;margin-bottom:24px;}
@media(max-width:800px){.dash-two-col{grid-template-columns:1fr;}}
.card-title{font-size:0.72rem;text-transform:uppercase;letter-spacing:2px;color:var(--paper-dim);margin-bottom:12px;}
canvas{width:100%;display:block;}
.heatmap-key-row{display:flex;justify-content:center;gap:4px;margin-bottom:5px;flex-wrap:wrap;}
.hk{
  width:30px;height:30px;border-radius:5px;display:flex;align-items:center;justify-content:center;
  font-size:0.68rem;background:var(--ink-700);color:var(--paper-dim);font-family:var(--font-mono);
}
.badges{display:flex;flex-wrap:wrap;gap:10px;}
.badge{
  display:flex;align-items:center;gap:8px;background:var(--ink-700);border:1px solid var(--ink-600);
  border-radius:999px;padding:8px 14px;font-size:0.8rem;
}
.badge .ic{font-size:1.1rem;}
.badge.locked{opacity:0.35;}
.summary-box{background:var(--ink-700);border-radius:8px;padding:16px 18px;margin-bottom:24px;font-size:0.9rem;line-height:1.6;color:var(--paper);}
.summary-box b{color:var(--brass);}
.history-table{width:100%;border-collapse:collapse;font-size:0.85rem;}
.history-table th{text-align:left;color:var(--paper-dim);text-transform:uppercase;font-size:0.65rem;letter-spacing:1.5px;padding:6px 10px;border-bottom:1px solid var(--ink-600);}
.history-table td{padding:8px 10px;border-bottom:1px solid var(--ink-700);font-family:var(--font-mono);}
.history-table tr:hover td{background:var(--ink-700);}
.pb-tag{color:var(--brass);font-size:0.7rem;margin-left:6px;}

footer.appfoot{text-align:center;color:var(--paper-dim);font-size:0.75rem;margin-top:30px;}
</style>
</head>
<body data-theme="dark">
<div class="wrap">

<header class="top">
  <div class="brand">
    <span class="mark">Typing Speed <em>Studio</em></span>
    <span class="tag">precision practice</span>
  </div>
  <div class="top-controls">
    <button class="icon-btn" id="soundToggle" title="Toggle sound">&#128266;</button>
    <button class="icon-btn" id="themeToggle" title="Toggle theme">&#9789;</button>
    <button class="icon-btn" id="fontMinus" title="Smaller text">A-</button>
    <button class="icon-btn" id="fontPlus" title="Larger text">A+</button>
  </div>
</header>

<section class="panel" id="controlsPanel">
  <div class="selector-row" id="modeRow">
    <span class="row-label">Mode</span>
    <button class="chip active" data-mode="time">Time</button>
    <button class="chip" data-mode="words">Words</button>
    <button class="chip" data-mode="quote">Quote</button>
    <button class="chip" data-mode="programming">Programming</button>
    <button class="chip" data-mode="custom">Custom Text</button>
    <button class="chip" data-mode="adaptive">Adaptive</button>
  </div>
  <div class="selector-row sub-row visible" id="timeRow">
    <span class="row-label">Duration</span>
    <button class="chip small active" data-time="15">15s</button>
    <button class="chip small" data-time="30">30s</button>
    <button class="chip small" data-time="60">60s</button>
    <button class="chip small" data-time="120">120s</button>
  </div>
  <div class="selector-row sub-row" id="wordsRow">
    <span class="row-label">Word Count</span>
    <button class="chip small active" data-words="25">25</button>
    <button class="chip small" data-words="50">50</button>
    <button class="chip small" data-words="100">100</button>
    <button class="chip small" data-words="250">250</button>
  </div>
  <div class="selector-row sub-row" id="langRow">
    <span class="row-label">Language</span>
    <button class="chip small active" data-lang="javascript">JavaScript</button>
    <button class="chip small" data-lang="python">Python</button>
    <button class="chip small" data-lang="html">HTML</button>
    <button class="chip small" data-lang="css">CSS</button>
    <button class="chip small" data-lang="java">Java</button>
    <button class="chip small" data-lang="cpp">C++</button>
    <button class="chip small" data-lang="sql">SQL</button>
  </div>
  <div class="selector-row sub-row" id="categoryRow">
    <span class="row-label">Category</span>
    <button class="chip small active" data-cat="english">General English</button>
    <button class="chip small" data-cat="academic">Academic</button>
    <button class="chip small" data-cat="business">Business</button>
    <button class="chip small" data-cat="medical">Medical</button>
    <button class="chip small" data-cat="legal">Legal</button>
    <button class="chip small" data-cat="creative">Creative Writing</button>
    <button class="chip small" data-cat="programming">Programming</button>
  </div>
  <div class="selector-row sub-row" id="customRow">
    <span class="row-label">Your Text</span>
    <textarea id="customText" placeholder="Paste or type your own practice text here..." style="flex:1;min-width:220px;background:var(--ink-700);border:1px solid var(--ink-600);border-radius:8px;color:var(--paper);padding:10px;font-family:var(--font-mono);font-size:0.85rem;min-height:64px;"></textarea>
  </div>
  <div class="selector-row" id="toggleRow" style="margin-top:6px;">
    <span class="row-label">Extras</span>
    <button class="chip small" data-toggle="focus">Focus Mode</button>
    <button class="chip small" data-toggle="zen">Zen Mode</button>
  </div>
</section>

<section class="panel stage">
  <div class="stat-strip">
    <div class="stat accent"><span class="val" id="statWpm">0</span><span class="lab">WPM</span></div>
    <div class="stat"><span class="val" id="statRaw">0</span><span class="lab">Raw WPM</span></div>
    <div class="stat"><span class="val" id="statCpm">0</span><span class="lab">CPM</span></div>
    <div class="stat"><span class="val" id="statAcc">100%</span><span class="lab">Accuracy</span></div>
    <div class="stat"><span class="val" id="statTime">0.0s</span><span class="lab">Elapsed</span></div>
    <div class="stat"><span class="val" id="statMistakes">0</span><span class="lab">Mistakes</span></div>
    <div class="stat"><span class="val" id="statStreak">0</span><span class="lab">Streak</span></div>
    <div class="stat"><span class="val" id="statRemain">15s</span><span class="lab">Remaining</span></div>
    <div class="stat"><span class="val" id="statPct">0%</span><span class="lab">Complete</span></div>
  </div>
  <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>

  <div class="type-field" id="typeField" tabindex="0">
    <div id="textDisplay"></div>
    <div class="stage-overlay" id="startOverlay">
      <p>Click here or press any key to begin</p>
      <button class="big-btn" id="startBtn">Start Typing</button>
    </div>
  </div>
  <input class="hidden-input" id="hiddenInput" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false">

  <div class="stage-footer">
    <div class="hint">
      <kbd>Esc</kbd> restart &nbsp; <kbd>Tab</kbd> then <kbd>Enter</kbd> quick restart &nbsp; <kbd>Space</kbd> pause/resume
    </div>
    <div>
      <button class="ghost-btn" id="pauseBtn">Pause</button>
      <button class="ghost-btn" id="restartBtn">Restart</button>
    </div>
  </div>
</section>

<section class="panel results" id="resultsPanel">
  <div class="result-hero">
    <div class="hero-block">
      <div class="hero-num" id="rWpm">0<small>wpm</small></div>
      <div class="lab">Net Speed</div>
    </div>
    <div class="hero-block">
      <div class="hero-num" id="rAcc">0%<small></small></div>
      <div class="lab">Accuracy</div>
    </div>
    <div class="hero-block">
      <div class="hero-num" id="rCons">0%<small></small></div>
      <div class="lab">Consistency</div>
    </div>
    <div class="hero-block">
      <div class="hero-num" id="rPct">--<small>th</small></div>
      <div class="lab">Percentile</div>
    </div>
  </div>

  <div class="grid-stats" id="gridStats"></div>

  <div class="dash-two-col">
    <div>
      <div class="card-title">WPM &amp; Accuracy Over Time</div>
      <canvas id="wpmGraph" height="180"></canvas>
    </div>
    <div>
      <div class="card-title">Error Heatmap (key positions)</div>
      <div id="heatmap"></div>
    </div>
  </div>

  <div class="card-title">Achievements</div>
  <div class="badges" id="badgeRow"></div>
  <br>
  <div class="card-title">Performance Summary</div>
  <div class="summary-box" id="summaryBox"></div>

  <div class="card-title">Session History</div>
  <table class="history-table" id="historyTable">
    <thead><tr><th>#</th><th>Mode</th><th>WPM</th><th>Acc</th><th>Chars</th><th>Date</th></tr></thead>
    <tbody id="historyBody"></tbody>
  </table>
</section>

<footer class="appfoot">Typing Speed Studio &middot; all data stored locally in your browser &middot; no account required</footer>
</div>


function drawSummary(wpm, acc, consistency, erroredKeys){
  const box = document.getElementById('summaryBox');
  const sortedKeys = Object.entries(erroredKeys).sort((a,b)=>b[1]-a[1]).slice(0,3).map(e=>'"'+e[0]+'"');
  let strengths = [];
  let weaknesses = [];
  if(wpm>=70) strengths.push('excellent raw speed');
  else if(wpm>=40) strengths.push('solid, dependable pace');
  else weaknesses.push('speed has room to grow with regular practice');
  if(acc>=97) strengths.push('near-perfect accuracy');
  else if(acc<90) weaknesses.push('accuracy dipped below 90%, consider slowing down slightly');
  if(consistency>=85) strengths.push('very consistent rhythm');
  else weaknesses.push('rhythm varied — try to keep an even pace rather than bursts');
  if(sortedKeys.length) weaknesses.push('frequently mistyped keys: '+sortedKeys.join(', '));

  box.innerHTML =
    '<b>Strengths:</b> '+(strengths.length?strengths.join('; '):'building a baseline — keep practicing to reveal your strengths.')+'<br><br>'+
    '<b>Areas to improve:</b> '+(weaknesses.length?weaknesses.join('; '):'no major weaknesses detected in this session.')+'<br><br>'+
    '<b>Suggestion:</b> '+suggestionFor(wpm,acc,consistency);
}
function suggestionFor(wpm,acc,consistency){
  if(acc<90) return 'Focus on accuracy drills at a slower pace before pushing for higher WPM.';
  if(consistency<70) return 'Try Zen Mode to build a smoother, more even rhythm without time pressure.';
  if(wpm<40) return 'Practice short, frequent sessions (Word Count mode, 25 words) to build muscle memory.';
  return 'Push your limits with a 120s Time Mode session or a harder Programming snippet.';
}

function saveHistory(wpm, acc, elapsed, chars){
  historyData.unshift({
    mode: state.mode + (state.mode==='time'?(' '+state.timeLimit+'s'):state.mode==='words'?(' '+state.wordCount+'w'):''),
    wpm, acc, chars, date: Date.now()
  });
  historyData = historyData.slice(0,50);
  localStorage.setItem('tss_history', JSON.stringify(historyData));
}
function renderHistoryTable(){
  const body = document.getElementById('historyBody');
  body.innerHTML = '';
  historyData.slice(0,15).forEach((h,i)=>{
    const tr = document.createElement('tr');
    const d = new Date(h.date);
    tr.innerHTML = '<td>'+(i+1)+'</td><td>'+h.mode+'</td><td>'+h.wpm+'</td><td>'+h.acc+'%</td><td>'+h.chars+'</td><td>'+d.toLocaleDateString()+' '+d.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})+'</td>';
    body.appendChild(tr);
  });
}

/* ================= UI WIRING ================= */
document.getElementById('typeField').addEventListener('click', ()=>{
  hiddenInput.focus();
  if(session && !session.running && !session.finished) startSession();
});
document.getElementById('startBtn').addEventListener('click', (e)=>{
  e.stopPropagation();
  hiddenInput.focus();
  startSession();
});
document.getElementById('restartBtn').addEventListener('click', buildSession);
document.getElementById('pauseBtn').addEventListener('click', ()=>{
  if(!session || session.finished) return;
  if(!session.running) return;
  session.paused = !session.paused;
  document.getElementById('pauseBtn').textContent = session.paused ? 'Resume' : 'Pause';
  if(session.paused){
    // freeze start time offset
    session.pauseStart = performance.now();
  } else {
    const pausedFor = performance.now() - session.pauseStart;
    session.startTime += pausedFor;
    hiddenInput.focus();
  }
});
document.addEventListener('keydown', (e)=>{
  if(e.key === 'Escape'){ e.preventDefault(); buildSession(); }
});

document.getElementById('themeToggle').addEventListener('click', ()=>{
  const body = document.body;
  const next = body.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  body.setAttribute('data-theme', next);
  document.getElementById('themeToggle').classList.toggle('active', next==='light');
  if(session && session.finished) { drawGraph(); }
});
document.getElementById('soundToggle').addEventListener('click', ()=>{
  state.soundOn = !state.soundOn;
  document.getElementById('soundToggle').classList.toggle('active', !state.soundOn);
  document.getElementById('soundToggle').textContent = state.soundOn ? '🔊' : '🔇';
});
document.getElementById('fontPlus').addEventListener('click', ()=>{
  state.fontSize = Math.min(state.fontSize+0.15, 2.4);
  document.querySelector('.type-field').style.fontSize = state.fontSize+'rem';
});
document.getElementById('fontMinus').addEventListener('click', ()=>{
  state.fontSize = Math.max(state.fontSize-0.15, 0.9);
  document.querySelector('.type-field').style.fontSize = state.fontSize+'rem';
});

function setActiveChip(row, selector, value, dataAttr){
  document.querySelectorAll(row+' .chip').forEach(c=>c.classList.remove('active'));
  document.querySelector(row+' [data-'+dataAttr+'="'+value+'"]').classList.add('active');
}

document.querySelectorAll('#modeRow .chip').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    state.mode = btn.dataset.mode;
    document.querySelectorAll('#modeRow .chip').forEach(c=>c.classList.remove('active'));
    btn.classList.add('active');
    updateSubRows();
    buildSession();
  });
});
document.querySelectorAll('#timeRow .chip').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    state.timeLimit = parseInt(btn.dataset.time,10);
    setActiveChip('#timeRow','chip',state.timeLimit,'time');
    buildSession();
  });
});
document.querySelectorAll('#wordsRow .chip').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    state.wordCount = parseInt(btn.dataset.words,10);
    setActiveChip('#wordsRow','chip',state.wordCount,'words');
    buildSession();
  });
});
document.querySelectorAll('#langRow .chip').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    state.lang = btn.dataset.lang;
    setActiveChip('#langRow','chip',state.lang,'lang');
    buildSession();
  });
});
document.querySelectorAll('#categoryRow .chip').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    state.category = btn.dataset.cat;
    setActiveChip('#categoryRow','chip',state.category,'cat');
    buildSession();
  });
});
document.getElementById('customText').addEventListener('change', buildSession);
document.querySelectorAll('#toggleRow .chip').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    const t = btn.dataset.toggle;
    if(t==='focus'){ state.focus = !state.focus; btn.classList.toggle('active', state.focus); typeField.classList.toggle('focus-mode', state.focus); }
    if(t==='zen'){ state.zen = !state.zen; btn.classList.toggle('active', state.zen); typeField.classList.toggle('zen-mode', state.zen); }
  });
});

function updateSubRows(){
  document.getElementById('timeRow').classList.toggle('visible', state.mode==='time');
  document.getElementById('wordsRow').classList.toggle('visible', state.mode==='words');
  document.getElementById('langRow').classList.toggle('visible', state.mode==='programming');
  document.getElementById('categoryRow').classList.toggle('visible', state.mode!=='programming' && state.mode!=='quote' && state.mode!=='custom' && state.mode!=='adaptive');
  document.getElementById('customRow').classList.toggle('visible', state.mode==='custom');
}

/* ================= INIT ================= */
updateSubRows();
buildSession();
renderHistoryTable();
})();
</script>
</body>
</html>

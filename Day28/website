let scene=0, followupShown=false, choicesMade=0;

// Build dots
const dotsEl=document.getElementById('scene-dots');
for(let i=0;i<8;i++){
  const d=document.createElement('div');
  d.className='sdot'+(i===0?' active':'');
  d.id='dot-'+i;
  dotsEl.appendChild(d);
}

function updateDots(idx){
  for(let i=0;i<8;i++){
    const d=document.getElementById('dot-'+i);
    d.className='sdot'+(i<idx?'done':i===idx?'active':'');
  }
}

function el(tag,cls){const e=document.createElement(tag);if(cls)e.className=cls;return e;}

function makeBubble(msg){
  if(msg.type==='narrator'){
    const d=el('div','narrator new-msg');
    d.innerHTML=msg.text;
    return d;
  }
  if(msg.type==='narrator-sep'){
    const w=el('div','narrator-sep new-msg');
    const l1=el('div','line'); const t=el('div','txt'); const l2=el('div','line');
    t.textContent=msg.text;
    w.appendChild(l1);w.appendChild(t);w.appendChild(l2);
    return w;
  }
  const row=el('div','bubble-row new-msg '+(msg.type==='left'?'left':'right'));
  const avW=el('div','av-wrap');
  const av=el('div','avatar'); av.textContent=msg.emoji;
  const nm=el('div','av-name'); nm.textContent=msg.name;
  avW.appendChild(av); avW.appendChild(nm);
  const bub=el('div','bubble '+(msg.type==='left'?'left':'right'));
  bub.innerHTML=msg.text;
  row.appendChild(avW); row.appendChild(bub);
  return row;
}

function makeTyping(){
  const row=el('div','typing-row new-msg right');
  const avW=el('div','av-wrap');
  const av=el('div','avatar'); av.textContent='👧';
  const nm=el('div','av-name'); nm.textContent='Priya';
  avW.appendChild(av); avW.appendChild(nm);
  const bub=el('div','typing-bubble');
  for(let i=0;i<3;i++){const d=el('div','dot');bub.appendChild(d);}
  row.appendChild(avW); row.appendChild(bub);
  return row;
}

async function appendToFeed(msg, withTyping=false){
  const feed=document.getElementById('chat-feed');
  if(withTyping && msg.type==='right'){
    const t=makeTyping();
    feed.appendChild(t);
    feed.scrollTop=feed.scrollHeight;
    await new Promise(r=>setTimeout(r,900));
    feed.removeChild(t);
  }
  const node=makeBubble(msg);
  feed.appendChild(node);
  feed.scrollTop=feed.scrollHeight;
}

async function loadScene(idx){
  const s=SCENES[idx];
  const m=SCENE_META[idx];
  followupShown=false;

  // Update progress
  const pct=Math.round(((idx+1)/8)*100);
  document.getElementById('prog-bar').style.width=pct+'%';
  document.getElementById('prog-scene').textContent='Scene '+(idx+1)+' of 8';
  document.getElementById('prog-pct').textContent=pct+'%';
  document.getElementById('scene-label-text').textContent=m.label;
  document.getElementById('topbar-icon').textContent=m.icon;
  document.getElementById('topbar-title').textContent=m.label;
  const tag=document.getElementById('topbar-tag');
  tag.textContent=m.tag; tag.className='chat-topbar-tag '+(m.tagClass||'');
  updateDots(idx);

  // Clear
  document.getElementById('chat-feed').innerHTML='';
  document.getElementById('choices').innerHTML='';
  document.getElementById('choices-area').style.display='block';
  document.getElementById('next-btn').style.display='none';

  // Stream messages
  for(let i=0;i<s.messages.length;i++){
    const msg=s.messages[i];
    const isRight=msg.type==='right';
    if(i>0) await new Promise(r=>setTimeout(r, isRight?180:220));
    await appendToFeed(msg, isRight && i>0);
  }

  setTimeout(renderChoices, 250);
}

function renderChoices(){
  const s=SCENES[scene];
  const wrap=document.getElementById('choices');
  wrap.innerHTML='';
  s.choices.forEach((c,i)=>{
    const btn=el('button','choice-btn');
    const icon=el('span','cb-icon'); icon.textContent=String.fromCharCode(65+i);
    const txt=document.createTextNode(c.label);
    btn.appendChild(icon); btn.appendChild(txt);
    btn.addEventListener('click',()=>handleChoice(i));
    wrap.appendChild(btn);
  });
}

async function handleChoice(i){
  if(followupShown)return;
  followupShown=true;
  choicesMade++;

  document.querySelectorAll('.choice-btn').forEach((b,j)=>{
    b.disabled=true;
    if(j===i)b.classList.add('selected');
  });

  const msgs=SCENES[scene].followups[i];
  for(let m=0;m<msgs.length;m++){
    await new Promise(r=>setTimeout(r, m===0?300:300));
    await appendToFeed(msgs[m], true);
  }

  setTimeout(()=>{
    if(scene<7){
      document.getElementById('next-btn').style.display='block';
    } else {
      showDoneBanner();
    }
  }, msgs.length*300+200);
}

function showDoneBanner(){
  document.getElementById('choices-area').style.display='none';
  const feed=document.getElementById('chat-feed');
  const wrap=document.createElement('div');
  wrap.className='new-msg';
  wrap.innerHTML=`
    <div class="done-card">
      <div class="done-icon">🎉</div>
      <h2>Story Complete — PA Approved</h2>
      <p>You've followed Rahul's full journey: from diagnosis at City Medical Center through PA submission, denial, appeal, and final approval. Here's the summary.</p>
      <div class="done-stats">
        <div class="done-stat"><strong>~3 weeks</strong><span>Total time to approval</span></div>
        <div class="done-stat"><strong>1 denial</strong><span>Initial PA denied</span></div>
        <div class="done-stat"><strong>8 days</strong><span>Appeal resolution</span></div>
        <div class="done-stat"><strong>$6,000+</strong><span>Monthly list price of Humira</span></div>
        <div class="done-stat"><strong>2+ hrs</strong><span>Staff time to resolve</span></div>
        <div class="done-stat"><strong>Permanent</strong><span>PA on file — no repeat</span></div>
      </div>
      <button class="restart-btn" onclick="restartStory()">&#8635; Restart the story</button>
    </div>
  `;
  feed.appendChild(wrap);
  feed.scrollTop=feed.scrollHeight;
}

function restartStory(){
  scene=0; choicesMade=0;
  loadScene(0);
  window.scrollTo({top:0,behavior:'smooth'});
}

document.getElementById('next-btn').addEventListener('click',()=>{
  if(scene<7){
    scene++;
    loadScene(scene);
    window.scrollTo({top:document.querySelector('.shell').offsetTop-20,behavior:'smooth'});
  }
});

loadScene(0);
</script>

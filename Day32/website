          <div>
            <span className="score-label">{r.label} growth potential</span>
            <div className="bar-bg" style={{width:220}}><div className="bar-fill" style={{width:r.score + "%"}}></div></div>
          </div>
        </div>
      </div>

      <div className="card">
        <div className="report-section">
          <h3>Audience Understanding</h3>
          <p>{brand.audienceDesc} You identified these as the traits that matter most: {traits.join(", ")}.</p>
        </div>
        <div className="report-section">
          <h3>Platform Strategy</h3>
          <p>{r.platformNamed.map(p => `${p.label} (${TIER_LABEL[p.tier]})`).join(", ")}.</p>
        </div>
        <div className="report-section">
          <h3>Content Strategy</h3>
          <p>Three pillars: {r.pillars.map(p=>p.label).join(", ")} — covering {new Set(r.pillars.map(p=>p.goal)).size} distinct goal(s).</p>
        </div>
        <div className="report-section">
          <h3>Growth Potential</h3>
          <p>{r.score}/100 — {r.label}. This blends platform-audience fit, pillar diversity, and how well the unexpected moment was handled.</p>
        </div>
        <div className="report-section">
          <h3>Best Decision</h3>
          <p>{r.bestDecision}</p>
        </div>
        <div className="report-section">
          <h3>Biggest Mistake</h3>
          <p>{r.biggestMistake}</p>
        </div>
        <div className="report-section">
          <h3>Three Marketing Lessons</h3>
          {r.lessons.map((l,i) => (
            <div className="lesson-item" key={i}><span className="n">{i+1}</span><span>{l}</span></div>
          ))}
        </div>
      </div>

      <ClaudePromptCard prompt={prompt} />

      <div className="btn-row split">
        <button className="btn" onClick={onRestart}>🔄 Start over</button>
        {brand.mode === "random" || brand._wasRandom ? (
          <button className="btn btn-primary" onClick={onReroll}>🎲 Take a new client</button>
        ) : <span/>}
      </div>
      <p className="footer-note">Think Like a Marketing Strategist — a strategy simulator, not a content generator.</p>
    </div>
  );
}

/* ============================== APP ============================== */

/* Step map: 0 Welcome, 1 Choose Path, 2 Setup, 3 Meet the Brand, 4 Audience,
   5 Platforms, 6 Pillars, 7 Roadmap, 8 Curveball, 9 Report */

function App(){
  const [step, setStep] = useState(0);
  const [maxStep, setMaxStep] = useState(0);
  const [modeChoice, setModeChoice] = useState(null); // "business-own" | "personal" | "random"
  const [brand, setBrand] = useState(null);
  const [traits, setTraits] = useState([]);
  const [platforms, setPlatforms] = useState([]);
  const [pillars, setPillars] = useState([]);
  const [event, setEvent] = useState(null);
  const [eventChoice, setEventChoice] = useState(null);

  function goto(n){ setStep(n); setMaxStep(m => Math.max(m, n)); }

  function resetAll(){
    setStep(0); setMaxStep(0); setModeChoice(null); setBrand(null);
    setTraits([]); setPlatforms([]); setPillars([]); setEvent(null); setEventChoice(null);
  }

  function pickMode(m){
    setModeChoice(m);
    if (m === "random") {
      const b = randOf(RANDOM_CLIENTS);
      setBrand({...b, _wasRandom:true});
    } else {
      setBrand(null);
    }
    goto(2);
  }

  function rerollClient(){
    const b = randOf(RANDOM_CLIENTS);
    setBrand({...b, _wasRandom:true});
  }

  function submitBrand(b){
    setBrand(b);
    goto(3);
  }

  function toggleTrait(t){
    setTraits(prev => prev.includes(t) ? prev.filter(x=>x!==t) : [...prev, t]);
  }
  function togglePlatform(id){
    setPlatforms(prev => prev.includes(id) ? prev.filter(x=>x!==id) : [...prev, id]);
  }
  function togglePillar(id){
    setPillars(prev => prev.includes(id) ? prev.filter(x=>x!==id) : [...prev, id]);
  }

  function enterEventStep(){
    const list = brand.mode === "personal" ? PERSONAL_EVENTS : BUSINESS_EVENTS;
    setEvent(randOf(list));
    setEventChoice(null);
    goto(8);
  }

  function restartFull(){ resetAll(); }
  function rerollFromReport(){
    const b = randOf(RANDOM_CLIENTS);
    setBrand({...b, _wasRandom:true});
    setTraits([]); setPlatforms([]); setPillars([]); setEvent(null); setEventChoice(null);
    setModeChoice("random");
    setStep(2); setMaxStep(2);
  }

  return (
    <div>
      {step > 0 && <Rail step={step} maxStep={maxStep} onJump={goto} />}

      {step === 0 && <Welcome onStart={()=>goto(1)} />}

      {step === 1 && <ModeSelect onPick={pickMode} />}

      {step === 2 && modeChoice === "business-own" &&
        <OwnBusinessForm onSubmit={submitBrand} onBack={()=>goto(1)} />}

      {step === 2 && modeChoice === "personal" &&
        <PersonalBrandForm onSubmit={submitBrand} onBack={()=>goto(1)} />}

      {step === 2 && modeChoice === "random" && brand &&
        <RandomClientReveal brand={brand} onReroll={rerollClient} onSubmit={()=>goto(3)} onBack={()=>goto(1)} />}

      {step === 3 && brand &&
        <MeetBrand brand={brand} onContinue={()=>goto(4)} onBack={()=>goto(2)} />}

      {step === 4 && brand &&
        <AudienceStep brand={brand} selected={traits} onToggle={toggleTrait} onContinue={()=>goto(5)} onBack={()=>goto(3)} />}

      {step === 5 && brand &&
        <PlatformStep brand={brand} selected={platforms} onToggle={togglePlatform} onContinue={()=>goto(6)} onBack={()=>goto(4)} />}

      {step === 6 && brand &&
        <PillarStep brand={brand} selected={pillars} onToggle={togglePillar} onContinue={()=>goto(7)} onBack={()=>goto(5)} />}

      {step === 7 && brand &&
        <RoadmapStep brand={brand} pillars={pillars} platforms={platforms}
          onContinue={enterEventStep} onBack={()=>goto(6)} />}

      {step === 8 && brand && event &&
        <EventStep brand={brand} event={event} choice={eventChoice} onChoose={setEventChoice}
          onContinue={()=>goto(9)} onBack={()=>goto(7)} />}

      {step === 9 && brand && event && eventChoice != null &&
        <GrowthReport brand={brand} traits={traits} platforms={platforms} pillarIds={pillars}
          event={event} eventChoice={eventChoice} onRestart={restartFull} onReroll={rerollFromReport} />}
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>
</body>
</html>

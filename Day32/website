<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Think Like a Marketing Strategist: Grow This Brand</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.3.1/umd/react.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.3.1/umd/react-dom.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.22.20/babel.min.js"></script>
<style>
  :root{
    --ink:#0B1220;
    --panel:#121A2C;
    --panel-alt:#0E1728;
    --border:rgba(255,255,255,0.09);
    --border-soft:rgba(255,255,255,0.05);
    --chalk:#EDEFF3;
    --muted:#8695AC;
    --muted-dim:#5C6980;
    --gold:#E8A23D;
    --gold-dim:rgba(232,162,61,0.16);
    --teal:#4FD1C5;
    --teal-dim:rgba(79,209,197,0.14);
    --danger:#E8615F;
    --danger-dim:rgba(232,97,95,0.14);
    --radius:14px;
    --radius-sm:9px;
    --font-display: -apple-system, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    --font-body: -apple-system, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(1100px 600px at 15% -10%, rgba(232,162,61,0.07), transparent 60%),
      radial-gradient(900px 500px at 100% 0%, rgba(79,209,197,0.06), transparent 55%),
      var(--ink);
    color:var(--chalk);
    font-family:var(--font-body);
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  #root{max-width:980px; margin:0 auto; padding:24px 20px 80px;}
  @media (max-width:600px){ #root{padding:16px 14px 64px;} }

  h1,h2,h3{font-family:var(--font-display); margin:0; letter-spacing:-0.01em;}
  p{line-height:1.55; color:var(--chalk);}
  .muted{color:var(--muted);}
  .small{font-size:13px;}

  /* ---------- Marker underline signature ---------- */
  .marker{position:relative; display:inline-block;}
  .marker::after{
    content:"";
    position:absolute; left:-2px; right:-2px; bottom:2px; height:0.5em;
    background:linear-gradient(100deg, var(--gold) 0%, var(--gold) 100%);
    opacity:0.28; z-index:-1; border-radius:3px;
    transform:rotate(-0.6deg);
  }

  /* ---------- Top rail / tabs ---------- */
  .rail{
    display:flex; gap:6px; overflow-x:auto; padding-bottom:10px; margin-bottom:28px;
    border-bottom:1px solid var(--border);
    scrollbar-width:thin;
  }
  .rail::-webkit-scrollbar{height:4px;}
  .rail::-webkit-scrollbar-thumb{background:var(--border); border-radius:4px;}
  .rail-tab{
    flex:0 0 auto; padding:8px 12px 12px; font-size:12.5px; font-weight:600;
    color:var(--muted-dim); white-space:nowrap; cursor:default; position:relative;
    border:none; background:none; font-family:var(--font-body);
  }
  .rail-tab.reachable{cursor:pointer; color:var(--muted);}
  .rail-tab.active{color:var(--chalk);}
  .rail-tab.active::after{
    content:""; position:absolute; left:6px; right:6px; bottom:0; height:3px;
    background:var(--gold); border-radius:3px 3px 0 0;
  }
  .rail-tab .num{
    display:inline-block; width:16px; height:16px; border-radius:50%;
    background:var(--panel-alt); border:1px solid var(--border);
    font-size:9.5px; text-align:center; line-height:16px; margin-right:6px;
  }
  .rail-tab.active .num{background:var(--gold); border-color:var(--gold); color:#1A1204;}

  /* ---------- Layout blocks ---------- */
  .screen{animation:fadeUp 0.38s ease both;}
  @keyframes fadeUp{ from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);} }
  @media (prefers-reduced-motion:reduce){ .screen{animation:none;} }

  .eyebrow{
    font-size:11.5px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--teal); margin-bottom:10px; display:block;
  }
  .card{
    background:var(--panel); border:1px solid var(--border); border-radius:var(--radius);
    padding:20px 22px; margin-bottom:16px;
  }
  .card-alt{background:var(--panel-alt);}
  .teach{
    display:grid; grid-template-columns:1fr 1fr; gap:14px; margin:16px 0 20px;
  }
  @media (max-width:640px){ .teach{grid-template-columns:1fr;} }
  .teach .box{
    background:var(--panel-alt); border:1px solid var(--border-soft); border-radius:var(--radius-sm);
    padding:14px 16px;
  }
  .teach .box .label{font-size:11px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--gold); margin-bottom:6px; display:block;}

  .grid2{display:grid; grid-template-columns:1fr 1fr; gap:12px;}
  .grid3{display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px;}
  @media (max-width:720px){ .grid2, .grid3{grid-template-columns:1fr;} }

  /* ---------- Buttons ---------- */
  .btn{
    font-family:var(--font-body); font-size:14px; font-weight:600; cursor:pointer;
    border-radius:10px; padding:11px 18px; border:1px solid var(--border);
    background:var(--panel-alt); color:var(--chalk); transition:transform .12s ease, border-color .12s ease, background .12s ease;
  }
  .btn:hover{border-color:rgba(255,255,255,0.22);}
  .btn:active{transform:scale(0.98);}
  .btn-primary{background:var(--gold); color:#1A1204; border-color:var(--gold);}
  .btn-primary:hover{background:#f0af53;}
  .btn-primary:disabled{background:var(--panel-alt); color:var(--muted-dim); border-color:var(--border); cursor:not-allowed;}
  .btn-ghost{background:transparent;}
  .btn-row{display:flex; gap:10px; justify-content:flex-end; margin-top:18px; flex-wrap:wrap;}
  .btn-row.split{justify-content:space-between;}

  /* ---------- Choice cards (mode select) ---------- */
  .choice{
    text-align:left; cursor:pointer; padding:20px; border-radius:var(--radius);
    border:1px solid var(--border); background:var(--panel); transition:border-color .15s ease, transform .15s ease;
  }
  .choice:hover{border-color:var(--gold); transform:translateY(-2px);}
  .choice .ico{font-size:26px; margin-bottom:10px; display:block;}
  .choice h3{font-size:16px; margin-bottom:6px;}
  .choice p{font-size:13px; color:var(--muted); margin:0;}

  /* ---------- Chips (toggle) ---------- */
  .chip{
    display:inline-flex; align-items:center; gap:6px; padding:9px 14px; border-radius:999px;
    border:1px solid var(--border); background:var(--panel-alt); color:var(--muted); font-size:13px;
    cursor:pointer; margin:0 8px 8px 0; transition:all .12s ease; font-family:var(--font-body);
  }
  .chip:hover{border-color:rgba(255,255,255,0.25); color:var(--chalk);}
  .chip.selected{background:var(--gold-dim); border-color:var(--gold); color:var(--chalk); font-weight:600;}
  .chip.selected .tick{color:var(--gold);}
  .chip.disabled{opacity:0.35; cursor:not-allowed;}

  /* ---------- Platform / pillar cards ---------- */
  .pcard{
    border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px 16px; margin-bottom:10px;
    background:var(--panel-alt); cursor:pointer; transition:border-color .12s ease;
  }
  .pcard:hover{border-color:rgba(255,255,255,0.25);}
  .pcard.selected{border-color:var(--gold); background:linear-gradient(0deg, var(--gold-dim), var(--gold-dim)), var(--panel-alt);}
  .pcard .top{display:flex; justify-content:space-between; align-items:center; gap:10px;}
  .pcard .title{font-weight:700; font-size:14.5px;}
  .badge{font-size:11px; font-weight:700; padding:3px 9px; border-radius:999px; white-space:nowrap;}
  .badge.great{background:rgba(79,209,197,0.18); color:var(--teal);}
  .badge.good{background:rgba(232,162,61,0.18); color:var(--gold);}
  .badge.fair{background:rgba(255,255,255,0.08); color:var(--muted);}
  .badge.poor{background:rgba(232,97,95,0.14); color:var(--danger);}
  .pcard .desc{font-size:13px; color:var(--muted); margin-top:8px; line-height:1.5;}

  .pillar{
    border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px 16px; margin-bottom:10px;
    background:var(--panel-alt); cursor:pointer;
  }
  .pillar.selected{border-color:var(--teal); background:linear-gradient(0deg, var(--teal-dim), var(--teal-dim)), var(--panel-alt);}
  .pillar .top{display:flex; justify-content:space-between; align-items:baseline; gap:10px;}
  .pillar .title{font-weight:700; font-size:14.5px;}
  .pillar .goal{font-size:10.5px; text-transform:uppercase; letter-spacing:0.06em; color:var(--muted-dim); font-weight:700;}
  .pillar .desc{font-size:13px; color:var(--muted); margin-top:6px;}

  /* ---------- Prompt card ---------- */
  .prompt-card{
    border:1px dashed rgba(232,162,61,0.4); border-radius:var(--radius); padding:16px 18px;
    background:rgba(232,162,61,0.05); margin:22px 0 8px;
  }
  .prompt-card .head{display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;}
  .prompt-card .head span.tag{font-size:12px; font-weight:700; color:var(--gold);}
  .prompt-box{
    font-family:var(--font-mono); font-size:12.5px; color:#CFEFEA; background:#08121B;
    border:1px solid var(--border); border-radius:9px; padding:12px 14px; line-height:1.6;
    white-space:pre-wrap; word-break:break-word;
  }
  .copy-btn{
    font-size:11.5px; font-weight:700; padding:5px 10px; border-radius:7px; border:1px solid var(--border);
    background:var(--panel-alt); color:var(--muted); cursor:pointer;
  }
  .copy-btn:hover{color:var(--chalk); border-color:rgba(255,255,255,0.3);}

  /* ---------- Roadmap ---------- */
  .week{border-left:2px solid var(--border); padding-left:16px; margin-bottom:22px; position:relative;}
  .week::before{
    content:""; position:absolute; left:-5px; top:2px; width:8px; height:8px; border-radius:50%;
    background:var(--gold);
  }
  .week h3{font-size:15px; margin-bottom:2px;}
  .week .wk-goal{font-size:13px; color:var(--teal); margin-bottom:8px;}
  .week ul{margin:0; padding-left:18px;}
  .week li{font-size:13.5px; color:var(--muted); margin-bottom:6px; line-height:1.5;}

  /* ---------- Event ---------- */
  .event-option{
    display:block; width:100%; text-align:left; padding:14px 16px; border-radius:var(--radius-sm);
    border:1px solid var(--border); background:var(--panel-alt); color:var(--chalk); cursor:pointer;
    margin-bottom:10px; font-size:14px; font-family:var(--font-body);
  }
  .event-option:hover{border-color:var(--gold);}
  .outcome-box{border-radius:var(--radius-sm); padding:16px; margin-top:14px; border:1px solid var(--border);}
  .outcome-box.best{background:rgba(79,209,197,0.08); border-color:rgba(79,209,197,0.4);}
  .outcome-box.neutral{background:rgba(255,255,255,0.03);}
  .outcome-box.risky{background:rgba(232,97,95,0.08); border-color:rgba(232,97,95,0.4);}

  /* ---------- Report ---------- */
  .score-wrap{display:flex; align-items:center; gap:18px; margin-bottom:6px; flex-wrap:wrap;}
  .score-num{font-size:44px; font-weight:800; font-family:var(--font-display); color:var(--gold);}
  .score-label{font-size:14px; font-weight:700; color:var(--teal);}
  .bar-bg{height:8px; background:var(--panel-alt); border-radius:99px; overflow:hidden; margin-top:10px;}
  .bar-fill{height:100%; background:linear-gradient(90deg, var(--teal), var(--gold)); border-radius:99px; transition:width .6s ease;}

  .report-section{margin-bottom:18px;}
  .report-section h3{font-size:13px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted-dim); margin-bottom:8px;}
  .lesson-item{display:flex; gap:10px; margin-bottom:10px; font-size:14px;}
  .lesson-item .n{color:var(--gold); font-weight:800; font-family:var(--font-display); flex:0 0 auto;}

  .hero{
    text-align:left; padding:34px 0 8px;
  }
  .hero .kicker{font-size:12.5px; letter-spacing:0.16em; text-transform:uppercase; color:var(--muted); margin-bottom:14px; display:block;}
  .hero h1{font-size:clamp(28px,5vw,42px); line-height:1.12; max-width:640px;}
  .hero p.lede{font-size:16px; color:var(--muted); max-width:560px; margin-top:16px;}

  .snapshot-grid{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:14px;}
  @media (max-width:640px){ .snapshot-grid{grid-template-columns:1fr;} }
  .snap-item .k{font-size:10.5px; text-transform:uppercase; letter-spacing:0.07em; color:var(--gold); font-weight:700; display:block; margin-bottom:3px;}
  .snap-item .v{font-size:14px; color:var(--chalk);}
  .snap-item{margin-bottom:8px;}

  .counter{font-size:12.5px; color:var(--muted); font-weight:600;}
  .footer-note{text-align:center; color:var(--muted-dim); font-size:12px; margin-top:40px;}
  .form-field{margin-bottom:14px;}
  .form-field label{display:block; font-size:12.5px; font-weight:700; color:var(--muted); margin-bottom:6px;}
  .form-field input, .form-field textarea, .form-field select{
    width:100%; background:var(--panel-alt); border:1px solid var(--border); border-radius:9px;
    padding:10px 12px; color:var(--chalk); font-family:var(--font-body); font-size:14px;
  }
  .form-field textarea{resize:vertical; min-height:56px;}
  .form-field input:focus, .form-field textarea:focus, .form-field select:focus{outline:2px solid var(--gold); outline-offset:1px;}
  .link-btn{background:none; border:none; color:var(--teal); font-size:13px; font-weight:600; cursor:pointer; padding:0; text-decoration:underline;}
</style>
</head>

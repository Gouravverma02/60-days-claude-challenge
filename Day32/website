/* ============================== HELPERS ============================== */

function fill(str, brand){
  return str.replace(/\{name\}/g, brand.name).replace(/\{category\}/g, brand.category);
}

function getFitTier(brand, platformId){
  let tier = FIT_MATRIX[brand.audienceType][platformId];
  if (brand.visualness === "high" && ["instagram","tiktok","pinterest","youtube"].includes(platformId)) tier = Math.min(4, tier+1);
  if (brand.visualness === "low" && ["instagram","tiktok","pinterest"].includes(platformId)) tier = Math.max(1, tier-1);
  if (brand.mode === "personal" && ["linkedin","twitter","youtube","newsletter"].includes(platformId)) tier = Math.min(4, tier+1);
  if (brand.mode === "personal" && ["facebook","pinterest"].includes(platformId)) tier = Math.max(1, tier-1);
  return tier;
}

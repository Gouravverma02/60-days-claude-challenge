function computeReport(brand, traits, platforms, pillarIds, event, eventChoice){
  const isPersonal = brand.mode === "personal";
  const pillarList = isPersonal ? PERSONAL_PILLARS : BUSINESS_PILLARS;
  const pillars = pillarIds.map(id => pillarList.find(p=>p.id===id));
  const tiers = platforms.map(id => getFitTier(brand, id));
  const avgTier = tiers.reduce((a,b)=>a+b,0) / tiers.length;
  const fitScore = ((avgTier - 1) / 3) * 100;

  const distinctGoals = new Set(pillars.map(p=>p.goal)).size;
  const diversityScore = distinctGoals >= 3 ? 100 : distinctGoals === 2 ? 65 : 30;

  const chosenOpt = event.options[eventChoice];
  const eventScore = chosenOpt.quality === "best" ? 100 : chosenOpt.quality === "neutral" ? 60 : 25;

  const score = Math.round(fitScore*0.4 + diversityScore*0.3 + eventScore*0.3);
  const label = score <= 40 ? "Emerging" : score <= 65 ? "Promising" : score <= 85 ? "Strong" : "Breakout";

  const platformNamed = platforms.map((id,i) => ({ id, label: PLATFORM_INFO.find(p=>p.id===id).label, tier: tiers[i] }));
  const bestPlatform = platformNamed.reduce((a,b)=> b.tier > a.tier ? b : a, platformNamed[0]);
  const worstPlatform = platformNamed.reduce((a,b)=> b.tier < a.tier ? b : a, platformNamed[0]);

  let bestDecision;
  if (chosenOpt.quality === "best") {
    bestDecision = `Your call on "${event.title}" — choosing to ${chosenOpt.label.toLowerCase()}. ${chosenOpt.outcome}`;
  } else if (bestPlatform.tier >= 3) {
    bestDecision = `Choosing ${bestPlatform.label} — it's a ${TIER_LABEL[bestPlatform.tier].toLowerCase()} for an audience like ${isPersonal ? "yours" : brand.name + "'s"}.`;
  } else if (distinctGoals >= 3) {
    bestDecision = "Choosing three pillars that cover three different goals — awareness, trust, and conversion don't compete with each other, they stack.";
  } else {
    bestDecision = "Getting all the way through a real strategic process instead of jumping straight to posting — most people skip this step entirely.";
  }

  let biggestMistake;
  if (chosenOpt.quality === "risky") {
    biggestMistake = `Your call on "${event.title}" — choosing to ${chosenOpt.label.toLowerCase()}. ${chosenOpt.outcome}`;
  } else if (worstPlatform.tier <= 2) {
    biggestMistake = `Keeping ${worstPlatform.label} in the mix — it's only a ${TIER_LABEL[worstPlatform.tier].toLowerCase()} for this audience, and effort there may be wasted.`;
  } else if (platforms.length > 3) {
    biggestMistake = `Spreading across ${platforms.length} platforms at once. Even good-fit platforms are hard to run well without enough time or budget behind each one.`;
  } else if (distinctGoals === 1) {
    biggestMistake = "Choosing three pillars that all serve the same goal, leaving other goals — like trust or community — uncovered.";
  } else {
    biggestMistake = "No major missteps yet — the real risk now is coasting instead of continuing to iterate.";
  }

  const pool = isPersonal ? PERSONAL_LESSON_POOL : BUSINESS_LESSON_POOL;
  const lessons = [chosenOpt.lesson, pool[0], pool[1]];

  return { score, label, bestDecision, biggestMistake, lessons, pillars, platformNamed };
}

function GrowthReport({brand, traits, platforms, pillarIds, event, eventChoice, onRestart, onReroll}){
  const r = useMemo(()=>computeReport(brand, traits, platforms, pillarIds, event, eventChoice), [brand, traits, platforms, pillarIds, event, eventChoice]);
  const isPersonal = brand.mode === "personal";
  const prompt = `Based on this growth report for ${brand.name}: Score ${r.score}/100 (${r.label}). Best decision: ${r.bestDecision} Biggest mistake: ${r.biggestMistake} If you had to pick ONE thing to focus on for the next 30 days, what would it be and why?`;
  return (
    <div className="screen">
      <Eyebrow>Step 9 · Growth report</Eyebrow>
      <h2 style={{fontSize:22, marginBottom:4}}>{brand.name}'s Growth Report</h2>
      <p className="muted" style={{marginBottom:18}}>Here's how the whole strategy adds up.</p>


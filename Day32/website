  const week3 = {
    title:"Week 3 · Engage & Listen", goal:"Turn posting into a two-way conversation.",
    actions:[
      "Reply to every comment and DM for the week — engagement compounds more than raw reach does.",
      "Ask your audience one direct question to spark discussion.",
      "Note which pillar got the best response so far, and think about why.",

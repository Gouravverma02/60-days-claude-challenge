/* ============================== SMALL COMPONENTS ============================== */

function Eyebrow({children}){ return <span className="eyebrow">{children}</span>; }

function TeachBlock({what, why}){
  return (
    <div className="teach">
      <div className="box"><span className="label">What is this?</span><p style={{fontSize:"13.5px", margin:0}}>{what}</p></div>
      <div className="box"><span className="label">Why does it matter?</span><p style={{fontSize:"13.5px", margin:0}}>{why}</p></div>
    </div>
  );
}

function Rail({step, maxStep, onJump}){
  return (
    <div className="rail">
      {STEP_LABELS.map((label, i) => {
        const reachable = i <= maxStep;
        const cls = "rail-tab" + (i===step ? " active" : "") + (reachable ? " reachable" : "");
        return (
          <button key={i} className={cls} disabled={!reachable}
            onClick={()=> reachable && onJump(i)}>
            <span className="num">{i}</span>{label}
          </button>
        );
      })}
    </div>
  );
}

function ClaudePromptCard({prompt}){
  const [copied, setCopied] = useState(false);
  function copy(){
    try{
      navigator.clipboard.writeText(prompt);
      setCopied(true);
      setTimeout(()=>setCopied(false), 1600);
    }catch(e){}
  }
  return (
    <div className="prompt-card">
      <div className="head">
        <span className="tag">💬 How to ask Claude</span>
        <button className="copy-btn" onClick={copy}>{copied ? "Copied ✓" : "Copy prompt"}</button>
      </div>
      <div className="prompt-box">{prompt}</div>
      <p className="small muted" style={{marginTop:8, marginBottom:0}}>
        Try pasting this into Claude. Small, specific prompts like this — with real context baked in — beat generic requests like "give me a marketing plan."
      </p>
    </div>
  );
}

function BackContinue({onBack, onContinue, canContinue, continueLabel}){
  return (
    <div className="btn-row split">
      {onBack ? <button className="btn btn-ghost" onClick={onBack}>← Back</button> : <span/>}
      <button className="btn btn-primary" disabled={!canContinue} onClick={onContinue}>{continueLabel || "Continue →"}</button>
    </div>
  );
}


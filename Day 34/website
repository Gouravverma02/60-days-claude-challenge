<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Marketing Detective</title>
<style>
  :root{
    --bg-deepest:#100c09;
    --bg-room:#1a140f;
    --cork:#4a3320;
    --cork-dark:#3a2717;
    --cork-light:#5c4128;
    --paper:#f1e6cd;
    --paper-dark:#e4d5b0;
    --paper-shadow:#c9b78c;
    --ink:#2a1f14;
    --ink-soft:#4a3a28;
    --accent:#e07a2c;
    --accent-bright:#ff9a4d;
    --accent-glow:rgba(224,122,44,0.55);
    --gold:#d4a24c;
    --red-string:#a83c30;
    --danger:#c0392b;
    --success:#5a9764;
    --muted:#a89478;
    --font-display:'Courier New', Courier, monospace;
    --font-body:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --font-mono:'Courier New', Courier, monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(ellipse at 20% -10%, rgba(224,122,44,0.08), transparent 60%),
      radial-gradient(ellipse at 80% 110%, rgba(224,122,44,0.06), transparent 60%),
      var(--bg-deepest);
    color:var(--paper);
    font-family:var(--font-body);
    min-height:100vh;
    overflow-x:hidden;
  }
  #root{min-height:100vh;}
  ::-webkit-scrollbar{width:10px;height:10px;}
  ::-webkit-scrollbar-track{background:var(--bg-room);}
  ::-webkit-scrollbar-thumb{background:var(--cork);border-radius:6px;}

  .app{
    position:relative;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    background-image:
      repeating-linear-gradient(0deg, rgba(0,0,0,0.15) 0px, rgba(0,0,0,0.15) 1px, transparent 1px, transparent 3px),
      repeating-linear-gradient(90deg, rgba(0,0,0,0.1) 0px, rgba(0,0,0,0.1) 1px, transparent 1px, transparent 3px);
    background-size:6px 6px;
  }

  /* ---------- HEADER ---------- */
  .topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:18px 32px;
    background:linear-gradient(180deg, rgba(0,0,0,0.35), transparent);
    border-bottom:1px solid rgba(212,162,76,0.15);
    position:relative;
    z-index:20;
    flex-wrap:wrap;
    gap:12px;
  }
  .brand{
    display:flex;
    align-items:center;
    gap:12px;
  }
  .brand-badge{
    width:42px;height:42px;border-radius:50%;
    background:radial-gradient(circle at 35% 30%, var(--accent-bright), var(--accent) 60%, #8a4413 100%);
    display:flex;align-items:center;justify-content:center;
    font-family:var(--font-display);
    font-weight:700;
    font-size:16px;color:#1a0f04;
    box-shadow:0 0 18px var(--accent-glow), inset 0 0 6px rgba(0,0,0,0.4);
    flex-shrink:0;
  }
  .brand-title{
    font-family:var(--font-display);
    font-weight:700;
    font-size:20px;
    letter-spacing:2px;
    color:var(--paper);
    text-shadow:0 0 12px var(--accent-glow);
  }
  .brand-sub{
    font-size:11px;
    letter-spacing:3px;
    color:var(--muted);
    text-transform:uppercase;
    margin-top:2px;
  }
  .case-tag{
    font-family:var(--font-mono);
    font-size:13px;
    color:var(--gold);
    border:1px solid rgba(212,162,76,0.4);
    padding:6px 14px;
    border-radius:3px;
    background:rgba(0,0,0,0.25);
    letter-spacing:1px;
  }

  .steps{
    display:flex;
    gap:6px;
    align-items:center;
    padding:0 32px 14px;
    flex-wrap:wrap;
  }
  .step-pill{
    font-size:11px;
    letter-spacing:1px;
    text-transform:uppercase;
    padding:5px 12px;
    border-radius:20px;
    color:var(--muted);
    background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,255,255,0.06);
    transition:all .4s ease;
    white-space:nowrap;
  }
  .step-pill.active{
    color:#1a0f04;
    background:linear-gradient(135deg, var(--accent-bright), var(--accent));
    border-color:transparent;
    box-shadow:0 0 14px var(--accent-glow);
    font-weight:700;
  }
  .step-pill.done{
    color:var(--gold);
    border-color:rgba(212,162,76,0.5);
  }

  .stage{
    flex:1;
    position:relative;
    display:flex;
    flex-direction:column;
    align-items:center;
    padding:20px 20px 60px;
  }

  /* ---------- BUTTONS ---------- */
  .btn{
    font-family:var(--font-body);
    font-weight:700;
    letter-spacing:0.5px;
    font-size:14px;
    padding:13px 28px;
    border-radius:6px;
    border:none;
    cursor:pointer;
    background:linear-gradient(135deg, var(--accent-bright), var(--accent));
    color:#1a0f04;
    box-shadow:0 4px 18px rgba(224,122,44,0.35), inset 0 1px 0 rgba(255,255,255,0.3);
    transition:transform .18s ease, box-shadow .18s ease, filter .18s ease;
  }
  .btn:hover:not(:disabled){transform:translateY(-2px); box-shadow:0 8px 26px rgba(224,122,44,0.5), inset 0 1px 0 rgba(255,255,255,0.35);}
  .btn:active:not(:disabled){transform:translateY(0px) scale(.98);}
  .btn:disabled{opacity:0.35;cursor:not-allowed;filter:grayscale(0.4);box-shadow:none;}
  .btn.ghost{
    background:transparent;
    color:var(--gold);
    border:1px solid rgba(212,162,76,0.5);
    box-shadow:none;
  }
  .btn.ghost:hover:not(:disabled){background:rgba(212,162,76,0.08);}

  /* ---------- FOLDER / ASSIGNMENT ---------- */
  .folder-scene{
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    min-height:65vh;
    gap:26px;
    text-align:center;
    animation:fadeIn .6s ease;
  }
  .folder-stamp-line{
    font-family:var(--font-mono);
    color:var(--muted);
    letter-spacing:4px;
    font-size:12px;
    text-transform:uppercase;
  }
  .folder{
    position:relative;
    width:300px;
    height:210px;
    cursor:pointer;
    perspective:1400px;
  }
  .folder-back{
    position:absolute;inset:0;
    background:linear-gradient(160deg,#7a5230,#5c3d21);
    border-radius:4px 10px 4px 4px;
    box-shadow:0 20px 45px rgba(0,0,0,0.55);
  }
  .folder-tab{
    position:absolute;top:-16px;left:18px;
    width:120px;height:22px;
    background:linear-gradient(160deg,#7a5230,#5c3d21);
    border-radius:6px 6px 0 0;
  }
  .folder-front{
    position:absolute;inset:0;
    background:linear-gradient(155deg,#8a6238,#6b4526);
    border-radius:4px 4px 4px 4px;
    transform-origin:bottom;
    transition:transform .8s cubic-bezier(.5,-0.3,.5,1.3);
    box-shadow:0 10px 25px rgba(0,0,0,0.4), inset 0 0 40px rgba(0,0,0,0.15);
    display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;
  }
  .folder.open .folder-front{transform:rotateX(-125deg);}
  .folder-label{
    font-family:var(--font-display);
    font-weight:700;
    color:rgba(0,0,0,0.55);
    font-size:13px;letter-spacing:2px;
    border:2px solid rgba(0,0,0,0.35);
    padding:6px 12px;
    text-transform:uppercase;
  }
  .folder-classified{
    font-family:var(--font-mono);
    color:rgba(0,0,0,0.4);
    font-size:11px;
  }
  .folder-hint{
    font-size:13px;
    color:var(--muted);
    animation:pulse 2s infinite ease-in-out;
  }
  @keyframes pulse{0%,100%{opacity:0.5;}50%{opacity:1;}}

  .brief-card{
    background:var(--paper);
    color:var(--ink);
    border-radius:4px;
    max-width:640px;
    width:100%;
    padding:32px 36px;
    box-shadow:0 25px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(0,0,0,0.05);
    position:relative;
    animation:riseIn .55s cubic-bezier(.2,.8,.3,1.1);
    background-image:
      repeating-linear-gradient(0deg, rgba(0,0,0,0.02) 0, rgba(0,0,0,0.02) 1px, transparent 1px, transparent 28px);
  }
  @keyframes riseIn{from{opacity:0;transform:translateY(24px) scale(.97);}to{opacity:1;transform:translateY(0) scale(1);}}
  .brief-card:before{
    content:'';
    position:absolute;top:-10px;left:50%;transform:translateX(-50%);
    width:60px;height:20px;border-radius:3px;
    background:rgba(212,162,76,0.55);
    box-shadow:0 2px 5px rgba(0,0,0,0.3);
  }
  .brief-head{
    font-family:var(--font-display);
    font-weight:700;
    font-size:22px;
    border-bottom:2px dashed rgba(0,0,0,0.2);
    padding-bottom:12px;margin-bottom:16px;
    display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;
  }
  .brief-head span.tag{
    font-family:var(--font-mono);font-size:12px;color:#8a5a2b;
  }
  .brief-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;text-align:left;}
  .brief-field label{
    display:block;font-family:var(--font-mono);font-size:10px;letter-spacing:1.5px;
    text-transform:uppercase;color:#8a7350;margin-bottom:3px;
  }
  .brief-field div.val{font-size:15px;font-weight:600;line-height:1.4;}
  @media (max-width:560px){.brief-grid{grid-template-columns:1fr;}}

  /* ---------- CORKBOARD ---------- */
  .board-wrap{width:100%;max-width:1200px;}
  .progress-row{
    display:flex;align-items:center;gap:14px;
    background:rgba(0,0,0,0.3);
    border:1px solid rgba(212,162,76,0.2);
    padding:12px 18px;border-radius:8px;
    margin-bottom:22px;flex-wrap:wrap;
  }
  .progress-label{font-family:var(--font-mono);font-size:12px;color:var(--gold);white-space:nowrap;}
  .progress-track{flex:1;min-width:140px;height:8px;background:rgba(255,255,255,0.06);border-radius:6px;overflow:hidden;}
  .progress-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-bright));box-shadow:0 0 10px var(--accent-glow);transition:width .5s ease;}

  .corkboard{
    position:relative;
    background:
      radial-gradient(circle at 20% 20%, rgba(0,0,0,0.15) 0, transparent 3%),
      radial-gradient(circle at 70% 60%, rgba(0,0,0,0.12) 0, transparent 2%),
      radial-gradient(circle at 40% 85%, rgba(0,0,0,0.15) 0, transparent 3%),
      radial-gradient(circle at 85% 15%, rgba(0,0,0,0.12) 0, transparent 2%),
      repeating-radial-gradient(circle at 0 0, rgba(255,255,255,0.02) 0, transparent 3px),
      linear-gradient(155deg, var(--cork-light), var(--cork) 50%, var(--cork-dark));
    border-radius:10px;
    box-shadow:inset 0 0 60px rgba(0,0,0,0.5), 0 20px 50px rgba(0,0,0,0.5), 0 0 0 10px #2b1c10, 0 0 0 12px rgba(212,162,76,0.3);
    padding:28px;
  }
  .cork-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(230px, 1fr));
    gap:22px;
  }
  .evidence{
    position:relative;
    border-radius:3px;
    cursor:grab;
    transition:transform .25s ease, box-shadow .25s ease;
    animation:pinDrop .5s cubic-bezier(.3,.6,.3,1.2) backwards;
    min-height:150px;
  }
  .evidence:hover{transform:translateY(-4px) scale(1.02) rotate(0deg) !important; box-shadow:0 18px 30px rgba(0,0,0,0.45); z-index:5;}
  .evidence.dragging{opacity:0.35;}
  @keyframes pinDrop{from{opacity:0;transform:translateY(-30px) scale(.8);}to{opacity:1;transform:translateY(0) scale(1);}}

  .pin{
    position:absolute;top:-9px;left:50%;transform:translateX(-50%);
    width:16px;height:16px;border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #ff8a5e, var(--danger) 70%);
    box-shadow:0 3px 5px rgba(0,0,0,0.5), inset 0 0 3px rgba(255,255,255,0.5);
    z-index:2;
  }
  .card-inner{
    background:var(--paper);
    color:var(--ink);
    padding:16px 16px 14px;
    border-radius:2px;
    height:100%;
    box-shadow:0 8px 16px rgba(0,0,0,0.35), 0 0 0 1px rgba(0,0,0,0.06);
    display:flex;flex-direction:column;gap:8px;
    background-image:repeating-linear-gradient(0deg, rgba(0,0,0,0.015) 0, rgba(0,0,0,0.015) 1px, transparent 1px, transparent 22px);
  }
  .evidence.note .card-inner{background:#f4e0a0;box-shadow:0 8px 16px rgba(0,0,0,0.35);}
  .evidence.photo .card-inner{background:#e9e2d0;}
  .card-label{
    font-family:var(--font-mono);
    font-size:10px;letter-spacing:1.5px;text-transform:uppercase;
    color:#8a5a2b;display:flex;align-items:center;gap:6px;justify-content:space-between;
  }
  .reviewed-dot{width:7px;height:7px;border-radius:50%;background:var(--muted);display:inline-block;}
  .reviewed-dot.on{background:var(--success);box-shadow:0 0 6px var(--success);}
  .card-title{font-family:var(--font-display);font-weight:700;font-size:15px;line-height:1.3;}
  .card-body{font-size:13px;line-height:1.5;flex:1;}
  .chip-row{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;}
  .chip{
    font-size:11px;padding:3px 9px;border-radius:12px;
    background:rgba(138,90,43,0.12);color:#6b4526;font-weight:600;
    border:1px solid rgba(138,90,43,0.25);
  }

  .metric-bar-row{display:flex;align-items:center;gap:8px;margin:3px 0;font-size:11px;}
  .metric-bar-name{width:78px;flex-shrink:0;color:#6b4526;font-weight:700;text-transform:uppercase;letter-spacing:.5px;font-size:10px;}
  .metric-bar-track{flex:1;height:9px;background:rgba(0,0,0,0.08);border-radius:5px;overflow:hidden;}
  .metric-bar-fill{height:100%;border-radius:5px;background:linear-gradient(90deg,#c96a20,#e88a3d);width:0%;transition:width 1.1s cubic-bezier(.2,.7,.3,1);}
  .metric-bar-val{width:46px;text-align:right;font-family:var(--font-mono);color:#4a3a28;flex-shrink:0;}

  .quote{font-style:italic;font-size:12.5px;line-height:1.45;position:relative;padding-left:14px;border-left:3px solid rgba(138,90,43,0.3);margin-bottom:6px;}

  .social-row{display:flex;justify-content:space-between;gap:8px;font-size:12px;padding:3px 0;border-bottom:1px dashed rgba(0,0,0,0.1);}
  .social-row:last-child{border-bottom:none;}
  .social-plat{font-weight:700;color:#6b4526;flex-shrink:0;}

  /* Clue folded card */
  .evidence.clue .card-inner{
    background:linear-gradient(160deg,#3a2c1c,#241a10);
    color:var(--paper);
    align-items:center;justify-content:center;text-align:center;
    cursor:pointer;
  }
  .evidence.clue.open .card-inner{
    background:var(--paper);color:var(--ink);align-items:flex-start;text-align:left;
  }
  .clue-locked-icon{font-size:24px;filter:drop-shadow(0 0 6px var(--accent-glow));}
  .clue-locked-label{font-family:var(--font-display);font-weight:700;font-size:13px;color:var(--gold);}
  .clue-locked-sub{font-family:var(--font-mono);font-size:10px;color:var(--muted);letter-spacing:1px;}

  .solve-cta{
    position:sticky;bottom:18px;
    display:flex;justify-content:center;margin-top:26px;
  }
  .solve-cta .btn{font-size:16px;padding:16px 40px;}

  /* ---------- SOLVE SCREEN ---------- */
  .solve-wrap{max-width:900px;width:100%;animation:fadeIn .5s ease;}
  .solve-title{text-align:center;margin-bottom:6px;}
  .solve-title h2{font-family:var(--font-display);font-weight:700;font-size:24px;color:var(--paper);text-shadow:0 0 14px var(--accent-glow);margin:0;}
  .solve-title p{color:var(--muted);font-size:14px;margin:6px 0 24px;text-align:center;}
  .suspects{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  @media (max-width:640px){.suspects{grid-template-columns:1fr;}}
  .suspect-card{
    background:var(--paper);color:var(--ink);border-radius:6px;padding:18px 18px;
    cursor:pointer;border:3px solid transparent;position:relative;
    box-shadow:0 10px 24px rgba(0,0,0,0.35);
    transition:transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }
  .suspect-card:hover{transform:translateY(-3px);}
  .suspect-card.selected{border-color:var(--accent);box-shadow:0 0 0 4px var(--accent-glow), 0 14px 30px rgba(0,0,0,0.4);}
  .suspect-index{
    font-family:var(--font-display);font-weight:700;font-size:12px;color:#fff;
    background:#6b4526;display:inline-flex;width:26px;height:26px;border-radius:50%;
    align-items:center;justify-content:center;margin-bottom:8px;
  }
  .suspect-card.selected .suspect-index{background:var(--accent);}
  .suspect-text{font-size:14.5px;line-height:1.45;font-weight:600;}

  .confidence-wrap{
    margin:28px auto 8px;max-width:520px;background:rgba(0,0,0,0.3);
    border:1px solid rgba(212,162,76,0.25);border-radius:10px;padding:18px 22px;
  }
  .confidence-label{display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:12px;color:var(--gold);margin-bottom:10px;}
  .dial-track{position:relative;height:10px;border-radius:6px;background:linear-gradient(90deg,#5a9764,#d4a24c,#c0392b);}
  .dial-needle{
    position:absolute;top:-9px;width:0;height:0;
    border-left:8px solid transparent;border-right:8px solid transparent;
    border-top:14px solid var(--paper);
    transform:translateX(-8px);
    filter:drop-shadow(0 2px 3px rgba(0,0,0,0.6));
  }
  input[type=range].dial-input{
    -webkit-appearance:none;appearance:none;width:100%;height:10px;background:transparent;position:relative;margin-top:6px;cursor:pointer;
  }
  input[type=range].dial-input::-webkit-slider-thumb{
    -webkit-appearance:none;width:18px;height:18px;border-radius:50%;
    background:var(--paper);border:3px solid var(--accent);margin-top:-4px;cursor:pointer;
    box-shadow:0 0 8px var(--accent-glow);
  }
  input[type=range].dial-input::-moz-range-thumb{
    width:18px;height:18px;border-radius:50%;
    background:var(--paper);border:3px solid var(--accent);cursor:pointer;
    box-shadow:0 0 8px var(--accent-glow);
  }
  input[type=range].dial-input::-webkit-slider-runnable-track{height:2px;background:transparent;}
  input[type=range].dial-input::-moz-range-track{height:2px;background:transparent;}

  .solve-actions{display:flex;justify-content:center;margin-top:26px;}

  /* ---------- CASE CLOSED ---------- */
  .closed-scene{
    min-height:65vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;position:relative;
  }
  .stamp{
    font-family:var(--font-display);
    font-weight:700;
    font-size:48px;
    letter-spacing:4px;
    padding:18px 36px;
    border:8px solid currentColor;
    border-radius:10px;
    transform:rotate(-8deg) scale(0);
    text-transform:uppercase;
    animation:stampIn .5s cubic-bezier(.2,1.4,.4,1) .15s forwards;
    text-align:center;
  }
  .stamp.correct{color:var(--success);}
  .stamp.wrong{color:var(--danger);}
  @keyframes stampIn{
    0%{transform:rotate(-8deg) scale(2.6);opacity:0;}
    60%{transform:rotate(-8deg) scale(0.9);opacity:1;}
    80%{transform:rotate(-8deg) scale(1.08);}
    100%{transform:rotate(-8deg) scale(1);}
  }
  .closed-sub{font-family:var(--font-mono);color:var(--muted);font-size:13px;letter-spacing:1px;animation:fadeIn 1s ease .5s backwards;text-align:center;}

  /* ---------- REPORT ---------- */
  .report-wrap{max-width:820px;width:100%;animation:fadeIn .5s ease;}
  .report-card{
    background:var(--paper);color:var(--ink);border-radius:6px;padding:30px 34px;
    box-shadow:0 25px 55px rgba(0,0,0,0.5);margin-bottom:20px;
    background-image:repeating-linear-gradient(0deg, rgba(0,0,0,0.02) 0, rgba(0,0,0,0.02) 1px, transparent 1px, transparent 28px);
  }
  .report-card h3{
    font-family:var(--font-display);font-weight:700;font-size:17px;color:#6b4526;
    border-bottom:2px dashed rgba(0,0,0,0.15);padding-bottom:10px;margin:0 0 14px;
  }
  .report-card p{font-size:14.5px;line-height:1.6;margin:0 0 8px;}
  .clue-recap{display:flex;gap:10px;margin-bottom:12px;align-items:flex-start;}
  .clue-recap .num{
    flex-shrink:0;width:24px;height:24px;border-radius:50%;background:#6b4526;color:#fff;
    display:flex;align-items:center;justify-content:center;font-size:12px;font-family:var(--font-mono);
  }
  .improve-list{list-style:none;padding:0;margin:0;}
  .improve-list li{
    padding:10px 0 10px 30px;position:relative;font-size:14.5px;line-height:1.5;
    border-bottom:1px dashed rgba(0,0,0,0.1);
  }
  .improve-list li:last-child{border-bottom:none;}
  .improve-list li:before{

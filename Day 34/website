/* ============================= HELPERS ============================= */
function pickNewCaseIndex(currentIdx){
  if(CASES.length <= 1) return 0;
  var idx;
  do{ idx = Math.floor(Math.random()*CASES.length); } while(idx === currentIdx);
  return idx;
}
function rotFor(i){
  var vals=[-2.4,1.6,-1.1,2.2,-2.8,1.2,-1.7,2.6,-1.3,2.0];
  return vals[i % vals.length];
}

/* ============================= STATE ============================= */
var state = {
  caseIndex: Math.floor(Math.random()*CASES.length),
  screen: "assignment",
  folderOpen: false,
  order: [],
  reviewed: new Set(),
  openClues: new Set(),
  selectedMistake: null,
  confidence: 50,
  result: null,
  record: {played:0, correct:0}
};

function getCase(){ return CASES[state.caseIndex]; }

function getBaseEvidence(c){
  return [
    {key:"objective", type:"note", label:"OBJECTIVE", title:"Campaign Goal", bodyHtml: c.objective},
    {key:"audience", type:"note", label:"TARGET", title:"Audience Profile", bodyHtml: c.audience},
    {key:"channels", type:"photo", label:"BUDGET", title:"Channel Allocation", bodyHtml: chipsHtml(c.channels)},
    {key:"metrics", type:"photo", label:"ANALYTICS", title:"Campaign Metrics", bodyHtml: metricsHtml(c.metrics)},
    {key:"comments", type:"note", label:"WITNESSES", title:"Customer Comments", bodyHtml: commentsHtml(c.comments)},
    {key:"social", type:"photo", label:"SURVEILLANCE", title:"Social Performance", bodyHtml: socialHtml(c.social)}
  ];
}
function getClueEvidence(c){
  return c.clues.map(function(text,i){ return {key:"clue"+i, type:"clue", clueNum:i+1, content:text}; });
}
function chipsHtml(channels){
  return '<div class="chip-row">' + channels.map(function(ch){ return '<span class="chip">'+ch.name+' \u2022 '+ch.pct+'%</span>'; }).join("") + '</div>';
}
function metricsHtml(metrics){
  var rows = [
    {name:"Reach", val: metrics.reach, pct: 90},
    {name:"CTR", val: metrics.ctr, pct: Math.min(100, parseFloat(metrics.ctr)*14)},
    {name:"Engage", val: metrics.engagement, pct: Math.min(100, parseFloat(metrics.engagement)*11)},
    {name:"Convert", val: metrics.conversions, pct: Math.min(100, parseFloat(metrics.conversions)*28)}
  ];
  var html = rows.map(function(r){
    return '<div class="metric-bar-row"><span class="metric-bar-name">'+r.name+'</span><div class="metric-bar-track"><div class="metric-bar-fill" data-pct="'+r.pct+'" style="width:0%"></div></div><span class="metric-bar-val">'+r.val+'</span></div>';
  }).join("");
  html += '<div class="metric-bar-row"><span class="metric-bar-name">Sales</span><div class="metric-bar-track"><div class="metric-bar-fill" data-pct="100" style="width:0%;background:linear-gradient(90deg,#5a9764,#8fce9c)"></div></div><span class="metric-bar-val" style="width:auto">'+metrics.sales+'</span></div>';
  return html;
}
function commentsHtml(comments){
  return '<div>' + comments.map(function(q){ return '<div class="quote">'+q+'</div>'; }).join("") + '</div>';
}
function socialHtml(social){
  var keys = Object.keys(social);
  return '<div>' + keys.map(function(k){ return '<div class="social-row"><span class="social-plat">'+k+'</span><span>'+social[k]+'</span></div>'; }).join("") + '</div>';
}

function resetForNewCase(){
  var c = getCase();
  var base = getBaseEvidence(c);
  state.order = base.map(function(e){ return e.key; });
  state.reviewed = new Set();
  state.openClues = new Set();
  state.selectedMistake = null;
  state.confidence = 50;
  state.result = null;
  state.folderOpen = false;
}
resetForNewCase();

function ensureCluesInOrder(){
  var c = getCase();
  var clues = getClueEvidence(c);
  var existing = {};
  state.order.forEach(function(k){ existing[k]=true; });
  clues.forEach(function(cl){ if(!existing[cl.key]) state.order.push(cl.key); });
}

function allEvidenceMap(c){
  var map = {};
  getBaseEvidence(c).forEach(function(e){ map[e.key]=e; });
  getClueEvidence(c).forEach(function(e){ map[e.key]=e; });
  return map;
}

/* ============================= CARD RENDER ============================= */
function evidenceCardHTML(item, idx){
  var rot = rotFor(idx);
  if(item.type === "clue"){
    var isOpen = state.openClues.has(item.key);
    var reviewedOn = state.reviewed.has(item.key);
    return '<div class="evidence clue '+(isOpen?"open":"")+'" style="transform:rotate('+rot+'deg)" draggable="true" data-key="'+item.key+'" data-index="'+idx+'" data-action="evidence-click" title="'+(isOpen?"Click to re-seal":"Click to unfold clue")+'">'
      + '<div class="pin"></div>'
      + '<div class="card-inner">'
      + (isOpen ?
          ('<div class="card-label">CLUE #'+item.clueNum+' <span class="reviewed-dot on"></span></div>'
          + '<div class="card-title">Field Note</div>'
          + '<div class="card-body">'+item.content+'</div>')
        :
          ('<div class="clue-locked-icon">\uD83D\uDD0E</div>'
          + '<div class="clue-locked-label">SEALED CLUE #'+item.clueNum+'</div>'
          + '<div class="clue-locked-sub">TAP TO UNFOLD</div>')
        )
      + '</div></div>';
  } else {
    var reviewed = state.reviewed.has(item.key);
    return '<div class="evidence '+item.type+'" style="transform:rotate('+rot+'deg)" draggable="true" data-key="'+item.key+'" data-index="'+idx+'" data-action="evidence-click" title="Click to mark as reviewed \u2022 drag to rearrange">'
      + '<div class="pin"></div>'
      + '<div class="card-inner">'
      + '<div class="card-label">'+item.label+'<span class="reviewed-dot '+(reviewed?"on":"")+'"></span></div>'
      + '<div class="card-title">'+item.title+'</div>'
      + '<div class="card-body">'+item.bodyHtml+'</div>'
      + '</div></div>';
  }
}

/* ============================= SCREEN RENDER ============================= */
function renderTopbar(c){
  return '<div class="topbar">'
    + '<div class="brand"><div class="brand-badge">MD</div><div><div class="brand-title">MARKETING DETECTIVE</div><div class="brand-sub">Case Files Division</div></div></div>'
    + '<div class="case-tag">CASE #'+String(state.caseIndex+1).padStart(3,"0")+' \u2014 '+c.company.toUpperCase()+'</div>'
    + '</div>';
}
function renderSteps(){
  var steps = ["Assignment","Board","Investigate","Solve","Closed","Report"];
  var order = ["assignment","board","investigate","solve","closed","report"];
  var curIdx = order.indexOf(state.screen);
  return '<div class="steps">' + steps.map(function(s,i){
    var cls = i===curIdx ? "active" : (i<curIdx ? "done" : "");
    return '<div class="step-pill '+cls+'">'+(i+1)+'. '+s+'</div>';
  }).join("") + '</div>';
}

function renderAssignment(c){
  var idx3 = String(state.caseIndex+1).padStart(3,"0");
  var inner;
  if(!state.folderOpen){
    inner = '<div class="folder" data-action="open-folder">'
      + '<div class="folder-tab"></div><div class="folder-back"></div>'
      + '<div class="folder-front"><div class="folder-label">Case File</div><div class="folder-classified">Eyes Only \u2022 #'+idx3+'</div></div>'
      + '</div>'
      + '<div class="folder-hint">Click the folder to open your assignment</div>';
  } else {
    inner = '<div class="brief-card">'
      + '<div class="brief-head"><span>'+c.company+'</span><span class="tag">'+c.industry+'</span></div>'
      + '<div class="brief-grid">'
      + '<div class="brief-field"><label>Campaign Objective</label><div class="val">'+c.objective+'</div></div>'
      + '<div class="brief-field"><label>Target Audience</label><div class="val">'+c.audience+'</div></div>'
      + '<div class="brief-field"><label>Total Budget</label><div class="val">'+c.budget.total+'</div></div>'
      + '<div class="brief-field"><label>Total Sales Result</label><div class="val">'+c.metrics.sales+'</div></div>'
      + '</div>'
      + '<div style="margin-top:22px;text-align:center;"><button class="btn" data-action="goto-board">Head to the Investigation Board \u2192</button></div>'
      + '</div>';
  }
  return '<div class="folder-scene">'
    + '<div class="folder-stamp-line">\u2014 TOP SECRET \u2022 MARKETING DETECTIVE UNIT \u2014</div>'
    + inner
    + '</div>';
}

function renderBoard(c, isInvestigate){
  var map = allEvidenceMap(c);
  var displayKeys = state.order.filter(function(k){
    var item = map[k];
    if(!item) return false;
    if(!isInvestigate && item.type === "clue") return false;
    return true;
  });
  var baseEv = getBaseEvidence(c);
  var clueEv = getClueEvidence(c);
  var totalForScreen = isInvestigate ? (baseEv.length + clueEv.length) : baseEv.length;
  var relevantKeys = isInvestigate ? baseEv.concat(clueEv).map(function(e){return e.key;}) : baseEv.map(function(e){return e.key;});
  var reviewedCount = relevantKeys.filter(function(k){ return state.reviewed.has(k); }).length;
  var pct = totalForScreen === 0 ? 0 : Math.round((reviewedCount/totalForScreen)*100);

  var cardsHtml = displayKeys.map(function(k){
    var idx = state.order.indexOf(k);
    return evidenceCardHTML(map[k], idx);
  }).join("");

  var allBaseReviewed = baseEv.every(function(e){ return state.reviewed.has(e.key); });
  var cluesOpened = clueEv.every(function(e){ return state.reviewed.has(e.key); });
  var readyToSolve = allBaseReviewed && cluesOpened;

  var ctaHtml;
  if(!isInvestigate){
    ctaHtml = '<button class="btn" data-action="goto-investigate" '+(allBaseReviewed?"":"disabled")+'>'
      + (allBaseReviewed ? "Dig Deeper \u2014 Investigate Further \u2192" : "Review all evidence to continue")
      + '</button>';
  } else {
    ctaHtml = '<button class="btn" data-action="goto-solve" '+(readyToSolve?"":"disabled")+'>'
      + (readyToSolve ? "Solve the Case \u2192" : "Unfold all sealed clues to continue")
      + '</button>';
  }

  return '<div class="board-wrap">'
    + '<div class="progress-row"><span class="progress-label">EVIDENCE REVIEWED: '+reviewedCount+'/'+totalForScreen+'</span><div class="progress-track"><div class="progress-fill" style="width:'+pct+'%"></div></div></div>'
    + '<div class="corkboard"><div class="cork-grid">'+cardsHtml+'</div></div>'
    + '<div class="solve-cta">'+ctaHtml+'</div>'
    + '</div>';
}

function renderSolve(c){
  var idx3 = String(state.caseIndex+1).padStart(3,"0");
  var optionsHtml = c.mistakeOptions.map(function(opt,i){
    var sel = state.selectedMistake === i;
    return '<div class="suspect-card '+(sel?"selected":"")+'" data-action="select-suspect" data-idx="'+i+'">'
      + '<div class="suspect-index">'+String.fromCharCode(65+i)+'</div>'
      + '<div class="suspect-text">'+opt+'</div>'
      + '</div>';
  }).join("");
  var label = state.confidence < 34 ? "Hunch" : state.confidence < 67 ? "Fairly Sure" : "Certain";
  return '<div class="solve-wrap">'
    + '<div class="solve-title"><h2>What was the primary marketing mistake?</h2><p>Review your evidence. Choose the theory that best fits the facts of Case #'+idx3+'.</p></div>'
    + '<div class="suspects">'+optionsHtml+'</div>'
    + '<div class="confidence-wrap">'
      + '<div class="confidence-label"><span>DETECTIVE CONFIDENCE</span><span>'+state.confidence+'% \u2014 '+label+'</span></div>'
      + '<div class="dial-track"><div class="dial-needle" style="left:'+state.confidence+'%"></div></div>'
      + '<input class="dial-input" type="range" min="0" max="100" value="'+state.confidence+'">'
      + '</div>'
    + '<div class="solve-actions"><button class="btn" data-action="close-case" '+(state.selectedMistake===null?"disabled":"")+'>Close the Case</button></div>'
    + '</div>';
}

function renderClosed(c){
  var correct = state.result.correct;
  return '<div class="closed-scene">'
    + '<div class="stamp '+(correct?"correct":"wrong")+'">'+(correct?"Case Solved":"Case Misfiled")+'</div>'
    + '<div class="closed-sub">'
      + (correct ? "Sharp eye, detective. Your theory matches the official record." : "Not quite \u2014 the official record points elsewhere. Every investigation teaches something.")
      + '<br/>Confidence logged at '+state.confidence+'%.'
      + '</div>'
    + '<button class="btn" data-action="goto-report">View Learning Report \u2192</button>'
    + '</div>';
}

function renderReport(c){
  var rank = "Rookie Detective";
  if(state.record.played>0){
    var rate = state.record.correct/state.record.played;
    if(rate >= 0.8 && state.record.played>=3) rank = "Chief Inspector";
    else if(rate >= 0.5) rank = "Detective";
  }
  var cluesHtml = c.clues.map(function(clue,i){
    return '<div class="clue-recap"><div class="num">'+(i+1)+'</div><p style="margin:0">'+clue+'</p></div>';
  }).join("");
  var improveHtml = c.improvements.map(function(imp){ return '<li>'+imp+'</li>'; }).join("");
  return '<div class="report-wrap">'
    + '<div style="text-align:center"><div class="rank-badge">\u2605 '+rank+' \u2014 '+state.record.correct+'/'+state.record.played+' cases correctly solved</div></div>'
    + '<div class="report-card"><h3>The Real Story</h3><p>'+c.explanation+'</p></div>'
    + '<div class="report-card"><h3>Key Clues, Revisited</h3>'+cluesHtml+'</div>'
    + '<div class="report-card"><h3>Suggested Improvements</h3><ul class="improve-list">'+improveHtml+'</ul></div>'
    + '<div class="report-actions">'
      + '<button class="btn" data-action="new-case">Take on a New Case \u2192</button>'
      + '<button class="btn ghost" data-action="reopen-board">Re-open Investigation Board</button>'
      + '</div>'
    + '</div>';
}

/* ============================= MAIN RENDER ============================= */
function render(){
  var c = getCase();
  var stageHtml;
  if(state.screen === "assignment") stageHtml = renderAssignment(c);
  else if(state.screen === "board") stageHtml = renderBoard(c, false);
  else if(state.screen === "investigate") stageHtml = renderBoard(c, true);
  else if(state.screen === "solve") stageHtml = renderSolve(c);
  else if(state.screen === "closed") stageHtml = renderClosed(c);
  else if(state.screen === "report") stageHtml = renderReport(c);
  else stageHtml = "";

  var html = '<div class="app">'
    + renderTopbar(c)
    + renderSteps()
    + '<div class="stage">'+stageHtml+'</div>'
    + '<div class="footer-note">MARKETING DETECTIVE \u2014 A CASE-BASED LEARNING SIMULATION \u2014 '+CASES.length+' CASES ON FILE</div>'
    + '</div>';

  document.getElementById("root").innerHTML = html;
  afterRender();
}

function afterRender(){
  if(state.screen === "board" || state.screen === "investigate"){
    setTimeout(function(){
      var fills = document.querySelectorAll(".metric-bar-fill");
      fills.forEach(function(el){
        var pct = el.getAttribute("data-pct");
        if(pct !== null) el.style.width = pct + "%";
      });
    }, 70);
  }
}

/* ============================= EVENT HANDLING ============================= */
var dragFromIndex = null;

function onRootClick(e){
  var actionEl = e.target.closest("[data-action]");
  if(!actionEl) return;
  var action = actionEl.getAttribute("data-action");

  if(action === "open-folder"){
    state.folderOpen = true;
    render();
  } else if(action === "goto-board"){
    state.screen = "board";
    render();
  } else if(action === "evidence-click"){
    var key = actionEl.getAttribute("data-key");
    var c = getCase();
    var map = allEvidenceMap(c);
    var item = map[key];
    if(item && item.type === "clue"){
      if(!state.reviewed.has(key)){
        state.reviewed.add(key);
        state.openClues.add(key);
      } else {
        if(state.openClues.has(key)) state.openClues.delete(key);
        else state.openClues.add(key);
      }
    } else {
      state.reviewed.add(key);
    }
    render();
  } else if(action === "goto-investigate"){
    ensureCluesInOrder();
    state.screen = "investigate";
    render();
  } else if(action === "goto-solve"){
    state.screen = "solve";
    render();
  } else if(action === "select-suspect"){
    state.selectedMistake = parseInt(actionEl.getAttribute("data-idx"),10);
    render();
  } else if(action === "close-case"){
    var cc = getCase();
    var correct = state.selectedMistake === cc.correctIndex;
    state.result = {correct: correct};
    state.record.played += 1;
    if(correct) state.record.correct += 1;
    state.screen = "closed";
    render();
  } else if(action === "goto-report"){
    state.screen = "report";
    render();
  } else if(action === "new-case"){
    state.caseIndex = pickNewCaseIndex(state.caseIndex);
    resetForNewCase();
    state.screen = "assignment";
    render();
  } else if(action === "reopen-board"){
    state.screen = "board";
    state.reviewed = new Set();
    state.openClues = new Set();
    render();
  }
}

function onRootDragStart(e){
  var card = e.target.closest(".evidence");
  if(!card) return;
  dragFromIndex = parseInt(card.getAttribute("data-index"),10);
  card.classList.add("dragging");
  if(e.dataTransfer){
    e.dataTransfer.effectAllowed = "move";
    try{ e.dataTransfer.setData("text/plain", String(dragFromIndex)); }catch(err){}
  }
}
function onRootDragOver(e){
  var card = e.target.closest(".evidence");
  if(card) e.preventDefault();
}
function onRootDrop(e){
  var card = e.target.closest(".evidence");
  if(!card) return;
  e.preventDefault();
  var toIndex = parseInt(card.getAttribute("data-index"),10);
  if(dragFromIndex === null || dragFromIndex === toIndex){ dragFromIndex = null; return; }
  var moved = state.order.splice(dragFromIndex,1)[0];
  state.order.splice(toIndex,0,moved);
  dragFromIndex = null;
  render();
}
function onRootDragEnd(){
  dragFromIndex = null;
}
function onRootInput(e){
  if(e.target && e.target.classList && e.target.classList.contains("dial-input")){
    var val = parseInt(e.target.value,10);
    state.confidence = val;
    var needle = document.querySelector(".dial-needle");
    if(needle) needle.style.left = val + "%";
    var labelSpan = document.querySelector(".confidence-label span:last-child");
    if(labelSpan){
      var label = val < 34 ? "Hunch" : val < 67 ? "Fairly Sure" : "Certain";
      labelSpan.textContent = val + "% \u2014 " + label;
    }
  }
}

document.addEventListener("DOMContentLoaded", function(){
  var root = document.getElementById("root");
  root.addEventListener("click", onRootClick);
  root.addEventListener("dragstart", onRootDragStart);
  root.addEventListener("dragover", onRootDragOver);
  root.addEventListener("drop", onRootDrop);
  root.addEventListener("dragend", onRootDragEnd);
  root.addEventListener("input", onRootInput);
  render();
});
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🧩 Prompt Puzzle — Master AI Prompting Through Play</title>
<style>
  :root{
    --bg1:#0b0e1a; --bg2:#141a2e; --panel:#161c30; --panel2:#1d2440;
    --accent:#7c5cff; --accent2:#22d3ee; --good:#34d399; --bad:#f87171; --warn:#fbbf24;
    --text:#e8ebff; --muted:#9aa3c7; --glass: rgba(255,255,255,0.04);
    --radius:16px;
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    background: radial-gradient(circle at 20% -10%, #23295a 0%, transparent 45%),
                radial-gradient(circle at 90% 10%, #2a1a4a 0%, transparent 40%),
                linear-gradient(160deg, var(--bg1), var(--bg2));
    color:var(--text); min-height:100vh; overflow-x:hidden;
  }
  #app{max-width:1100px; margin:0 auto; padding:20px 18px 60px;}
  .top{
    display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap;
    background:var(--glass); border:1px solid rgba(255,255,255,0.08); border-radius:var(--radius);
    padding:16px 20px; backdrop-filter: blur(10px); margin-bottom:18px;
  }
  h1{font-size:1.35rem; margin:0; letter-spacing:.3px;
     background:linear-gradient(90deg,#fff,var(--accent2)); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .sub{color:var(--muted); font-size:.85rem; margin-top:2px;}
  .stats{display:flex; gap:10px; flex-wrap:wrap;}
  .chip{
    background:var(--panel2); border:1px solid rgba(255,255,255,.08); padding:8px 14px; border-radius:999px;
    font-size:.8rem; color:var(--muted); display:flex; gap:6px; align-items:center; transition:.25s;
  }
  .chip b{color:var(--text); font-variant-numeric:tabular-nums;}
  .progress-wrap{height:8px; border-radius:999px; background:rgba(255,255,255,.06); overflow:hidden; margin-top:10px;}
  .progress-bar{height:100%; width:0%; background:linear-gradient(90deg,var(--accent),var(--accent2)); transition:width .5s ease; border-radius:999px;}

  .card{
    background:var(--panel); border:1px solid rgba(255,255,255,.07); border-radius:var(--radius);
    padding:22px; margin-bottom:18px; position:relative; overflow:hidden;
    box-shadow:0 10px 30px rgba(0,0,0,.25);
  }
  .card::before{content:''; position:absolute; inset:0; background:linear-gradient(120deg, rgba(124,92,255,.06), transparent 40%); pointer-events:none;}
  .badge{
    display:inline-block; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.6px;
    padding:4px 10px; border-radius:999px; background:rgba(124,92,255,.18); color:#c9bfff; margin-bottom:10px;
  }
  .scenario-title{font-size:1.15rem; margin:0 0 6px; font-weight:700;}
  .desired{color:var(--muted); font-size:.92rem; line-height:1.5; margin-bottom:16px; padding:12px 14px; background:rgba(255,255,255,.03); border-left:3px solid var(--accent2); border-radius:8px;}

  .btn{
    background:linear-gradient(90deg,var(--accent),#5f3fe0); color:#fff; border:none; padding:10px 18px;
    border-radius:10px; cursor:pointer; font-weight:600; font-size:.88rem; transition:.2s; box-shadow:0 4px 14px rgba(124,92,255,.35);
  }
  .btn:hover{transform:translateY(-2px); box-shadow:0 8px 20px rgba(124,92,255,.5);}
  .btn:disabled{opacity:.35; cursor:not-allowed; transform:none; box-shadow:none;}
  .btn.secondary{background:var(--panel2); box-shadow:none; border:1px solid rgba(255,255,255,.1); color:var(--text);}
  .btn.ghost{background:transparent; border:1px solid rgba(255,255,255,.15); color:var(--muted); box-shadow:none;}
  .btn.ghost:hover{color:var(--text); border-color:var(--accent2);}

  .row{display:flex; gap:10px; flex-wrap:wrap; align-items:center;}
  .space{flex:1;}

  /* Build the Prompt */
  .slots{display:flex; flex-direction:column; gap:10px; margin-bottom:18px;}
  .slot{
    min-height:56px; border:2px dashed rgba(255,255,255,.15); border-radius:12px; padding:10px 14px;
    display:flex; align-items:center; gap:10px; transition:.2s; background:rgba(255,255,255,.02);
  }
  .slot .label{font-size:.68rem; text-transform:uppercase; letter-spacing:.6px; color:var(--muted); min-width:80px; font-weight:700;}
  .slot.filled{border-style:solid; border-color:var(--good); background:rgba(52,211,153,.08);}
  .slot.wrong-flash{border-color:var(--bad); animation:shake .35s;}
  .slot .block-in-slot{font-size:.85rem; padding:6px 10px; background:var(--panel2); border-radius:8px; flex:1;}
  @keyframes shake{
    0%,100%{transform:translateX(0);} 25%{transform:translateX(-6px);} 75%{transform:translateX(6px);}
  }
  .pool{display:flex; flex-wrap:wrap; gap:10px; margin-bottom:8px;}
  .block{
    background:var(--panel2); border:1px solid rgba(255,255,255,.1); padding:10px 14px; border-radius:10px;
    cursor:grab; font-size:.85rem; transition:.18s; user-select:none;
  }
  .block:hover{border-color:var(--accent2); transform:translateY(-2px);}
  .block:active{cursor:grabbing;}
  .block.placed-ghost{opacity:.25; pointer-events:none;}

  /* Clean the prompt */
  .chunks{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px; line-height:2.4;}
  .chunk{
    background:var(--panel2); border:1px solid rgba(255,255,255,.1); padding:8px 12px; border-radius:8px;
    cursor:pointer; font-size:.85rem; transition:.18s;
  }
  .chunk:hover{border-color:var(--accent2);}
  .chunk.removed{opacity:.4; text-decoration:line-through; border-color:var(--bad); background:rgba(248,113,113,.08);}

  /* choose */
  .choices{display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:14px; margin-bottom:18px;}
  .choice-card{
    background:var(--panel2); border:2px solid rgba(255,255,255,.08); border-radius:12px; padding:16px;
    cursor:pointer; transition:.2s; font-size:.82rem; color:var(--muted); line-height:1.5;
  }
  .choice-card:hover{border-color:var(--accent2); transform:translateY(-3px);}
  .choice-card.selected{border-color:var(--accent); box-shadow:0 0 0 3px rgba(124,92,255,.25);}
  .choice-card .tag{font-weight:700; color:var(--text); display:block; margin-bottom:8px;}

  .reveal{margin-top:10px; padding:16px; border-radius:12px; background:rgba(255,255,255,.03); border:1px solid rgba(255,255,255,.08); display:none;}
  .reveal.show{display:block; animation:fadeIn .4s ease;}
  @keyframes fadeIn{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}
  .compare{display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:10px;}
  @media (max-width:640px){.compare{grid-template-columns:1fr;}}
  .compare .col{background:rgba(255,255,255,.02); border-radius:10px; padding:12px;}
  .compare h4{margin:0 0 8px; font-size:.78rem; text-transform:uppercase; letter-spacing:.5px;}
  .compare .weak h4{color:var(--bad);} .compare .opt h4{color:var(--good);}
  .compare p{font-size:.82rem; color:var(--muted); line-height:1.5; margin:0;}
  .principle{margin-top:14px; font-size:.85rem; color:#c9bfff; background:rgba(124,92,255,.1); padding:12px 14px; border-radius:10px;}

  /* toasts */
  #toasts{position:fixed; top:20px; right:20px; display:flex; flex-direction:column; gap:10px; z-index:999;}
  .toast{
    background:var(--panel2); border:1px solid rgba(255,255,255,.12); padding:12px 18px; border-radius:10px;
    font-size:.85rem; box-shadow:0 8px 24px rgba(0,0,0,.4); animation:slideIn .3s ease, fadeOut .3s ease 2.2s forwards;
    max-width:280px;
  }
  .toast.good{border-color:var(--good); color:var(--good);}
  .toast.bad{border-color:var(--bad); color:var(--bad);}
  .toast.info{border-color:var(--accent2); color:var(--accent2);}
  @keyframes slideIn{from{transform:translateX(120%); opacity:0;} to{transform:translateX(0); opacity:1;}}
  @keyframes fadeOut{to{opacity:0; transform:translateX(40px);}}

  /* intro & report */
  .center{text-align:center;}
  .hero{font-size:2.2rem; margin:10px 0;}
  .domain-pill{display:inline-block; background:rgba(34,211,238,.12); color:var(--accent2); padding:6px 16px; border-radius:999px; font-size:.8rem; font-weight:700; margin-bottom:14px;}

  .dna-wrap{display:flex; justify-content:center; margin:20px 0;}
  .report-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin:20px 0;}
  .stat-box{background:var(--panel2); border-radius:12px; padding:16px; text-align:center; border:1px solid rgba(255,255,255,.06);}
  .stat-box .val{font-size:1.6rem; font-weight:800; background:linear-gradient(90deg,#fff,var(--accent2)); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .stat-box .lbl{font-size:.72rem; color:var(--muted); text-transform:uppercase; letter-spacing:.5px; margin-top:4px;}
  .score-pop{animation:pop .5s ease;}
  @keyframes pop{0%{transform:scale(1);} 40%{transform:scale(1.25);} 100%{transform:scale(1);}}
  .rank-badge{
    display:inline-flex; align-items:center; justify-content:center; width:90px; height:90px; border-radius:50%;
    font-size:2rem; font-weight:900; background:conic-gradient(var(--accent), var(--accent2), var(--accent));
    margin:10px auto; color:#0b0e1a;
  }
  .feedback-box{background:rgba(255,255,255,.03); border-left:3px solid var(--accent); padding:14px 16px; border-radius:10px; margin:16px 0; font-size:.9rem; color:var(--muted); text-align:left;}
  .final-prompt{background:var(--panel2); border-radius:12px; padding:16px; text-align:left; font-size:.85rem; color:var(--text); border:1px solid rgba(255,255,255,.08); margin-top:10px; white-space:pre-wrap;}
  .hint-text{font-size:.8rem; color:var(--warn); margin-top:8px; display:none;}
  .hint-text.show{display:block;}
</style>
</head>
<body>
<div id="toasts"></div>
<div id="app"></div>

<script>
/* ============================= DATA ============================= */
const DOMAIN = "Software Engineering & Coding";
const DIFFICULTY = "Intermediate";
const CATS = ['role','context','task','constraints','format'];
const CAT_LABELS = {role:'Role', context:'Context', task:'Task', constraints:'Constraints', format:'Format'};

function block(cat, text){ return {id: cat+'_'+Math.random().toString(36).slice(2,8), category:cat, text:text}; }
function distractor(text){ return {id:'dx_'+Math.random().toString(36).slice(2,8), category:'distractor', text:text}; }
function chunk(text, shouldRemove){ return {id:'ck_'+Math.random().toString(36).slice(2,8), text:text, shouldRemove:shouldRemove}; }

const RAW_SCENARIOS = [
  {
    type:'build',
    title:'Build a Secure Registration Endpoint',
    desiredOutput:'A production-ready Express endpoint that validates input, hashes passwords, and returns correct HTTP status codes.',
    blocks:[
      block('role','You are a senior backend engineer specializing in secure REST API design.'),
      block('context','The app uses Node.js, Express, and PostgreSQL with an existing users table (id, email, password_hash, created_at).'),
      block('task','Write a POST /api/register endpoint that creates a new user account.'),
      block('constraints','Validate email format, enforce password length of at least 8 characters, hash passwords with bcrypt, and return proper HTTP status codes (201, 400, 409).'),
      block('format','Return only the code as a single JavaScript function with inline comments explaining each validation step.')
    ],
    distractors:[
      distractor('You are a friendly assistant who loves using emojis.'),
      distractor('Explain what an API is to a five-year-old.'),
      distractor('Use Python and Flask instead of the current stack.'),
      distractor('Make the response as long as possible regardless of relevance.')
    ],
    weakPrompt:'write a register endpoint',
    weakOutput:'Here is a basic function that saves a user to the database. (No validation, no password hashing, generic status codes.)',
    optimizedOutput:'A complete Express route handler that validates the email and password, hashes the password with bcrypt, checks for duplicate emails, and returns 201/400/409 with clear inline comments.',
    overEngineeredExtra:' Also, please be extremely thorough, think step by step, consider every conceivable edge case, first write a 2000 word essay about password security history, then provide the code, then explain everything a second time in different words, add ASCII art dividers between every section, restate the requirements back to me before answering, include a table of contents, cite five academic papers on hashing algorithms, and translate all comments into three languages.',
    principle:'Specificity + Structure: defining role, context, explicit constraints, and output format turns a vague guess into production-ready code.'
  },
  {
    type:'clean',
    title:'Debug a Null Reference Exception',
    desiredOutput:'A focused debugging prompt that isolates the root cause and produces a minimal, correct fix.',
    chunks:[
      chunk('You are an expert software debugger.', false),
      chunk('Please think very, very carefully and take a deep breath before answering.', true),
      chunk('Here is the stack trace: NullPointerException at UserService.java line 42.', false),
      chunk('Also tell me your opinion on the best programming language of all time.', true),
      chunk('Identify the root cause and propose a fix with corrected code.', false),
      chunk('Write your answer in the form of a Shakespearean sonnet.', true),
      chunk('Return the fix as a code diff with a one-line explanation.', false),
      chunk('Also apologize repeatedly if you are not fully sure of the answer.', true)
    ],
    weakPrompt:'my code has a null error, fix it',
    weakOutput:'A vague guess that suggests "check for null somewhere" without locating the actual cause.',
    optimizedOutput:'A precise diagnosis pointing to the unset field in UserService.java, with a minimal code diff that fixes it.',
    principle:'Remove noise and conflicting instructions — irrelevant or contradictory clauses dilute focus and confuse the model.'
  },
  {
    type:'choose',
    title:'Write Unit Tests for a Function',
    desiredOutput:'A concise, complete Jest test file covering the key edge cases.',
    weakPrompt:'write tests for my function',
    optimizedPrompt:'You are a QA engineer. Write Jest unit tests for the function calculateDiscount(price, percentage), covering normal cases, zero percentage, negative price, and percentage above 100. Return only the test file code.',
    overEngineeredExtra:' Also write fifty tests, use every testing library available at once (Jest, Mocha, Jasmine, Ava), add performance benchmarks, generate a mutation-testing report, explain testing theory from first principles, and include a philosophical reflection on the nature of correctness.',
    weakOutput:'One shallow test that only checks a single normal case, missing edge cases entirely.',
    optimizedOutput:'A focused four-case Jest suite covering normal, zero, negative, and out-of-range inputs, ready to run.',
    principle:'Balance is key: enough detail to be precise, not so much detail that it drowns the actual task.'
  },
  {
    type:'build',
    title:'Optimize a Slow SQL Query',
    desiredOutput:'A rewritten, indexed query with a clear explanation of performance gains.',
    blocks:[
      block('role','You are a database performance engineer.'),
      block('context','The query runs against a PostgreSQL orders table with five million rows, joined with customers on customer_id, filtered by order_date range.'),
      block('task','Optimize this slow query: SELECT * FROM orders JOIN customers ON orders.customer_id = customers.id WHERE order_date > 2024-01-01.'),
      block('constraints','Suggest appropriate indexes, avoid SELECT star, and explain the expected performance improvement.'),
      block('format','Provide the rewritten query followed by a short bullet list of the optimizations made.')
    ],
    distractors:[
      distractor('Rewrite this in MongoDB syntax instead.'),
      distractor('Make the query as complex as possible to show off.'),
      distractor('You are a poet who writes verses about databases.'),
      distractor('Ignore indexing, it does not matter for this table.')
    ],
    weakPrompt:'make this query faster',
    weakOutput:'A generic suggestion to "add an index" with no specifics on which columns or why.',
    optimizedOutput:'A rewritten query selecting only needed columns, with a composite index recommendation on (order_date, customer_id) and a clear explanation of the expected speedup.',
    overEngineeredExtra:' Also benchmark this against every database engine that exists, rewrite the entire schema from scratch, produce a 10-page whitepaper on relational theory, add unrelated caching layers, and suggest migrating to a NoSQL database for no clear reason.',
    principle:'Specificity + Structure: naming the real schema, data scale, and constraints lets the model target the actual bottleneck.'
  },
  {
    type:'clean',
    title:'Request Code Review Comments',
    desiredOutput:'A professional, structured review with severity-labeled inline comments.',
    chunks:[
      chunk('You are a senior engineer performing a code review.', false),
      chunk('Be extremely harsh and mock the developer for their mistakes.', true),
      chunk('Here is the pull request diff to review.', false),
      chunk('Comment on code quality, potential bugs, and adherence to the team style guide.', false),
      chunk('Also recommend which restaurant I should eat at tonight.', true),
      chunk('Provide feedback as inline comments with severity labels: nit, suggestion, or blocking.', false),
      chunk('Write the entire review in ALL CAPS for emphasis.', true)
    ],
    weakPrompt:'review my code',
    weakOutput:'A single vague comment like "looks fine" with no structure or actionable detail.',
    optimizedOutput:'Inline comments labeled nit/suggestion/blocking that pinpoint real issues in style and logic, in a professional tone.',
    principle:'Tone and scope matter as much as task clarity — strip unprofessional or off-topic clauses that would derail the output.'
  },
  {
    type:'choose',
    title:'Explain the Big-O of an Algorithm',
    desiredOutput:'A clear, step-by-step complexity analysis with a final Big-O answer.',
    weakPrompt:'what is the time complexity',
    optimizedPrompt:'You are a computer science instructor. Analyze the time and space complexity of this bubble sort function. Explain your reasoning step-by-step and state the final Big-O for both best and worst case.',
    overEngineeredExtra:' Also compare it to fifteen other sorting algorithms, derive complexity using a formal proof with summation notation spanning three pages, provide historical context on sorting algorithms dating back to the 1950s, and include a poem about efficiency.',
    weakOutput:'A one-line guess of "O(n)" with no reasoning and no mention of best/worst case.',
    optimizedOutput:'A clear breakdown showing nested loops leading to O(n^2) worst case and O(n) best case with a short justification.',
    principle:'Ask for reasoning explicitly ("step-by-step") when you need explanations, not just answers — and keep scope proportional to the question.'
  }
];

function buildScenarios(){
  return RAW_SCENARIOS.map((r,i)=>{
    const s = JSON.parse(JSON.stringify(r));
    s.uid = 'sc'+i+'_'+Math.random().toString(36).slice(2,6);
    if(s.type==='build'){
      s.optimizedPrompt = s.blocks.map(b=>b.text).join(' ');
      s.overEngineeredPrompt = s.optimizedPrompt + (s.overEngineeredExtra||'');
    } else if(s.type==='clean'){
      s.optimizedPrompt = s.chunks.filter(c=>!c.shouldRemove).map(c=>c.text).join(' ');
      s.overEngineeredPrompt = s.chunks.map(c=>c.text).join(' ');
    } else if(s.type==='choose'){
      s.overEngineeredPrompt = s.optimizedPrompt + (s.overEngineeredExtra||'');
    }
    return s;
  });
}

function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
  return a;
}

/* ============================= STATE ============================= */
let GAME = null;

function newGame(){
  const scenarios = shuffle(buildScenarios());
  GAME = {
    scenarios,
    idx:0,
    results:[],
    hintUsedThisScenario:false,
    startTime:Date.now(),
    scenarioStart:Date.now(),
    timerHandle:null,
    slots:null, pool:null,
    chunkState:null,
    selectedChoice:null,
    scenarioLocked:false,
    wrongCount:0, movesCount:0
  };
}

function toast(msg,type){
  type = type||'info';
  const el = document.createElement('div');
  el.className = 'toast '+type;
  el.textContent = msg;
  document.getElementById('toasts').appendChild(el);
  setTimeout(()=>el.remove(), 2600);
}

/* ============================= RENDER: INTRO ============================= */
function renderIntro(){
  const app = document.getElementById('app');
  app.innerHTML = `
    <div class="card center">
      <div class="domain-pill">${DOMAIN} · ${DIFFICULTY}</div>
      <div class="hero">🧩 Prompt Puzzle</div>
      <div class="sub" style="margin-bottom:18px;">Master AI Prompting Through Play</div>
      <p style="color:var(--muted); max-width:560px; margin:0 auto 20px; line-height:1.6; font-size:.92rem;">
        Six hand-crafted challenges across three formats — <b>Build the Prompt</b>, <b>Clean the Prompt</b>, and
        <b>Choose the Best Prompt</b> — built for ${DOMAIN} at ${DIFFICULTY} level. Drag, click, and reason your way
        to prompting mastery, then unlock your full Prompt Performance Report.
      </p>
      <button class="btn" id="startBtn">Start Puzzle ▸</button>
    </div>
  `;
  document.getElementById('startBtn').onclick = ()=>{ newGame(); renderScenario(); };
}

/* ============================= HEADER ============================= */
function renderHeader(){
  const total = GAME.scenarios.length;
  const pct = Math.round((GAME.idx/total)*100);
  const elapsed = Math.floor((Date.now()-GAME.startTime)/1000);
  const runningScore = GAME.results.reduce((a,r)=>a+r.score,0);
  return `
    <div class="top">
      <div>
        <h1>🧩 Prompt Puzzle</h1>
        <div class="sub">${DOMAIN} · ${DIFFICULTY} · Scenario ${Math.min(GAME.idx+1,total)} of ${total}</div>
      </div>
      <div class="stats">
        <div class="chip">⭐ Score <b id="scoreChip">${runningScore}</b></div>
        <div class="chip">⏱ Time <b id="timeChip">${elapsed}s</b></div>
      </div>
    </div>
    <div class="progress-wrap"><div class="progress-bar" style="width:${pct}%"></div></div>
  `;
}

function tickTimer(){
  const c = document.getElementById('timeChip');
  if(c) c.textContent = Math.floor((Date.now()-GAME.startTime)/1000)+'s';
}

/* ============================= SCENARIO DISPATCH ============================= */
function renderScenario(){
  if(GAME.idx >= GAME.scenarios.length){ return renderReport(); }
  GAME.scenarioStart = Date.now();
  GAME.hintUsedThisScenario = false;
  GAME.scenarioLocked = false;
  GAME.wrongCount = 0;
  GAME.movesCount = 0;
  const s = GAME.scenarios[GAME.idx];

  if(GAME.timerHandle) clearInterval(GAME.timerHandle);
  GAME.timerHandle = setInterval(tickTimer, 1000);

  if(s.type==='build') return renderBuild(s);
  if(s.type==='clean') return renderClean(s);
  if(s.type==='choose') return renderChoose(s);
}

function typeLabel(t){
  return t==='build' ? 'Build the Prompt' : t==='clean' ? 'Clean the Prompt' : 'Choose the Best Prompt';
}

/* ============================= BUILD THE PROMPT ============================= */
function renderBuild(s){
  GAME.slots = CATS.map(cat=>({category:cat, filled:null}));
  GAME.pool = shuffle(s.blocks.concat(s.distractors));

  paintBuild(s);
}

function paintBuild(s){
  const app = document.getElementById('app');
  const slotsHtml = GAME.slots.map((slot,i)=>`
    <div class="slot" id="slot_${i}" data-idx="${i}">
      <span class="label">${CAT_LABELS[slot.category]}</span>
      ${slot.filled ? `<span class="block-in-slot">${slot.filled.text}</span>` : `<span style="color:var(--muted); font-size:.8rem;">Drop or tap a matching block here</span>`}
    </div>
  `).join('');

  const poolHtml = GAME.pool.map(b=>`
    <div class="block" draggable="true" id="blk_${b.id}" data-id="${b.id}">${b.text}</div>
  `).join('');

  const allFilled = GAME.slots.every(sl=>sl.filled);

  app.innerHTML = renderHeader() + `
    <div class="card">
      <span class="badge">${typeLabel(s.type)}</span>
      <h2 class="scenario-title">${s.title}</h2>
      <div class="desired"><b>🎯 Desired Output:</b> ${s.desiredOutput}</div>

      <div style="font-size:.78rem; color:var(--muted); margin-bottom:8px; text-transform:uppercase; letter-spacing:.5px;">Assemble the prompt — drag or tap blocks into the right slot</div>
      <div class="slots">${slotsHtml}</div>

      <div style="font-size:.78rem; color:var(--muted); margin-bottom:8px; text-transform:uppercase; letter-spacing:.5px;">Available blocks</div>
      <div class="pool" id="poolArea">${poolHtml || '<span style="color:var(--muted); font-size:.85rem;">All correct blocks placed!</span>'}</div>

      <div class="hint-text" id="hintText">💡 ${s.principle}</div>

      <div class="row" style="margin-top:14px;">
        <button class="btn ghost" id="hintBtn">💡 Hint</button>
        <div class="space"></div>
        <button class="btn" id="finishBtn" ${allFilled ? '' : 'disabled'}>Reveal Result ▸</button>
      </div>

      <div class="reveal" id="revealBox"></div>
    </div>
  `;

  document.getElementById('hintBtn').onclick = ()=>{
    if(!GAME.hintUsedThisScenario) GAME.hintUsedThisScenario = true;
    document.getElementById('hintText').classList.add('show');
    toast('Hint revealed', 'info');
  };
  document.getElementById('finishBtn').onclick = ()=> finishScenario(s);

  GAME.pool.forEach(b=>{
    const el = document.getElementById('blk_'+b.id);
    if(!el) return;
    el.addEventListener('dragstart', e=>{ e.dataTransfer.setData('text/plain', b.id); });
    el.addEventListener('click', ()=>{
      const emptyIdx = GAME.slots.findIndex(sl=>!sl.filled);
      if(emptyIdx>=0) attemptPlace(s, b.id, emptyIdx);
    });
  });
  GAME.slots.forEach((slot,i)=>{
    const el = document.getElementById('slot_'+i);
    el.addEventListener('dragover', e=>e.preventDefault());
    el.addEventListener('drop', e=>{
      e.preventDefault();
      const id = e.dataTransfer.getData('text/plain');
      attemptPlace(s, id, i);
    });
    if(slot.filled){
      el.addEventListener('click', ()=>{
        GAME.pool.push(slot.filled);
        slot.filled = null;
        paintBuild(s);
      });
    }
  });
}

function attemptPlace(s, blockId, slotIdx){
  if(GAME.slots[slotIdx].filled) return;
  const bIdx = GAME.pool.findIndex(b=>b.id===blockId);
  if(bIdx<0) return;
  const b = GAME.pool[bIdx];
  GAME.movesCount++;
  const targetCat = GAME.slots[slotIdx].category;

  if(b.category === targetCat){
    GAME.pool.splice(bIdx,1);
    GAME.slots[slotIdx].filled = b;
    toast('Nice fit! ✅', 'good');
    paintBuild(s);
  } else {
    GAME.wrongCount++;
    toast('Not quite the right fit for that slot ✗', 'bad');
    const el = document.getElementById('slot_'+slotIdx);
    if(el){
      el.classList.add('wrong-flash');
      setTimeout(()=>el.classList.remove('wrong-flash'), 350);
    }
  }
}

/* ============================= CLEAN THE PROMPT ============================= */
function renderClean(s){
  GAME.chunkState = s.chunks.map(c=>({...c, removed:false}));
  paintClean(s);
}

function paintClean(s){
  const app = document.getElementById('app');
  const chunksHtml = GAME.chunkState.map(c=>`
    <span class="chunk ${c.removed?'removed':''}" id="chunk_${c.id}" data-id="${c.id}">${c.text}</span>
  `).join(' ');

  app.innerHTML = renderHeader() + `
    <div class="card">
      <span class="badge">${typeLabel(s.type)}</span>
      <h2 class="scenario-title">${s.title}</h2>
      <div class="desired"><b>🎯 Desired Output:</b> ${s.desiredOutput}</div>
      <div style="font-size:.78rem; color:var(--muted); margin-bottom:8px; text-transform:uppercase; letter-spacing:.5px;">Tap the clauses that don't belong — strip the noise to reveal an optimized prompt</div>
      <div class="chunks">${chunksHtml}</div>

      <div class="hint-text" id="hintText">💡 ${s.principle}</div>

      <div class="row" style="margin-top:14px;">
        <button class="btn ghost" id="hintBtn">💡 Hint</button>
        <div class="space"></div>
        <button class="btn" id="finishBtn">Reveal Result ▸</button>
      </div>
      <div class="reveal" id="revealBox"></div>
    </div>
  `;

  document.getElementById('hintBtn').onclick = ()=>{
    if(!GAME.hintUsedThisScenario) GAME.hintUsedThisScenario = true;
    document.getElementById('hintText').classList.add('show');
    toast('Hint revealed', 'info');
  };
  document.getElementById('finishBtn').onclick = ()=> finishScenario(s);

  GAME.chunkState.forEach(c=>{
    const el = document.getElementById('chunk_'+c.id);
    el.addEventListener('click', ()=>{
      GAME.movesCount++;
      c.removed = !c.removed;
      if(c.removed !== c.shouldRemove){
        toast(c.removed? 'Hmm, that one might be useful...' : 'Are you sure that belongs?', 'info');
      } else {
        toast('Good call ✅', 'good');
      }
      paintClean(s);
    });
  });
}

/* ============================= CHOOSE THE BEST PROMPT ============================= */
function renderChoose(s){
  const opts = shuffle([
    {label:'Prompt A', kind:'weak', text:s.weakPrompt},
    {label:'Prompt B', kind:'optimized', text:s.optimizedPrompt},
    {label:'Prompt C', kind:'over', text:s.overEngineeredPrompt}
  ]);
  GAME.choiceOpts = opts;
  GAME.selectedChoice = null;
  paintChoose(s);
}

function paintChoose(s){
  const app = document.getElementById('app');
  const cardsHtml = GAME.choiceOpts.map(o=>`
    <div class="choice-card ${GAME.selectedChoice===o.kind?'selected':''}" id="opt_${o.kind}" data-kind="${o.kind}">
      <span class="tag">${o.label}</span>
      ${o.text}
    </div>
  `).join('');

  app.innerHTML = renderHeader() + `
    <div class="card">
      <span class="badge">${typeLabel(s.type)}</span>
      <h2 class="scenario-title">${s.title}</h2>
      <div class="desired"><b>🎯 Desired Output:</b> ${s.desiredOutput}</div>
      <div style="font-size:.78rem; color:var(--muted); margin-bottom:8px; text-transform:uppercase; letter-spacing:.5px;">Which prompt will produce the best result?</div>
      <div class="choices">${cardsHtml}</div>

      <div class="hint-text" id="hintText">💡 ${s.principle}</div>

      <div class="row" style="margin-top:14px;">
        <button class="btn ghost" id="hintBtn">💡 Hint</button>
        <div class="space"></div>
        <button class="btn" id="finishBtn" ${GAME.selectedChoice? '' : 'disabled'}>Submit Choice ▸</button>
      </div>
      <div class="reveal" id="revealBox"></div>
    </div>
  `;

  document.getElementById('hintBtn').onclick = ()=>{
    if(!GAME.hintUsedThisScenario) GAME.hintUsedThisScenario = true;
    document.getElementById('hintText').classList.add('show');
    toast('Hint revealed', 'info');
  };
  document.getElementById('finishBtn').onclick = ()=> finishScenario(s);

  GAME.choiceOpts.forEach(o=>{
    document.getElementById('opt_'+o.kind).addEventListener('click', ()=>{
      GAME.movesCount++;
      GAME.selectedChoice = o.kind;
      paintChoose(s);
    });
  });
}

/* ============================= FINISH SCENARIO ============================= */
function finishScenario(s){
  if(GAME.scenarioLocked) return;
  GAME.scenarioLocked = true;
  if(GAME.timerHandle) clearInterval(GAME.timerHandle);

  let finalWrong = GAME.wrongCount;
  let correctOverall = true;

  if(s.type==='clean'){
    const mismatches = GAME.chunkState.filter(c=>c.removed!==c.shouldRemove).length;
    finalWrong += mismatches;
    correctOverall = mismatches===0;
  }
  if(s.type==='choose'){
    if(GAME.selectedChoice!=='optimized'){ finalWrong += 1; correctOverall=false; }
  }
  if(s.type==='build'){
    correctOverall = finalWrong===0;
  }

  const elapsed = Math.max(1, Math.floor((Date.now()-GAME.scenarioStart)/1000));
  const timeThreshold = 35;
  const timePenalty = elapsed>timeThreshold ? Math.min(20, elapsed-timeThreshold) : 0;
  const hintPenalty = GAME.hintUsedThisScenario ? 10 : 0;
  const wrongPenalty = finalWrong*8;
  const optBonus = (finalWrong===0 && !GAME.hintUsedThisScenario) ? 25 : 0;

  let score = 100 - wrongPenalty - hintPenalty - timePenalty + optBonus;
  score = Math.max(0, Math.min(150, score));

  GAME.results.push({
    type:s.type, score, wrong:finalWrong, hints:GAME.hintUsedThisScenario?1:0,
    moves:GAME.movesCount, time:elapsed, optBonus:optBonus>0, correct:correctOverall
  });

  const box = document.getElementById('revealBox');
  box.classList.add('show');
  box.innerHTML = `
    <div class="compare">
      <div class="col weak"><h4>Weak Prompt Result</h4><p>${s.weakOutput}</p></div>
      <div class="col opt"><h4>Optimized Prompt Result</h4><p>${s.optimizedOutput}</p></div>
    </div>
    <div class="principle">💡 <b>Principle:</b> ${s.principle}</div>
    <div class="row" style="margin-top:16px;">
      <div class="chip">Wrong: <b>${finalWrong}</b></div>
      <div class="chip">Hints: <b>${GAME.hintUsedThisScenario?1:0}</b></div>
      <div class="chip">Time: <b>${elapsed}s</b></div>
      <div class="chip score-pop">Scenario Score: <b>${score}</b></div>
      <div class="space"></div>
      <button class="btn" id="nextBtn">${GAME.idx < GAME.scenarios.length-1 ? 'Next Scenario ▸' : 'View Report ▸'}</button>
    </div>
  `;
  document.getElementById('nextBtn').onclick = ()=>{
    GAME.idx++;
    renderScenario();
  };
  toast(correctOverall && !GAME.hintUsedThisScenario ? 'Perfect! Optimization bonus earned 🚀' : 'Scenario complete', correctOverall?'good':'info');

  document.querySelectorAll('.slot, .chunk, .choice-card, .block').forEach(el=>{
    el.style.pointerEvents='none'; el.style.opacity = el.style.opacity || '0.85';
  });
  const fb = document.getElementById('finishBtn'); if(fb) fb.disabled = true;
}

/* ============================= REPORT ============================= */
function renderReport(){
  if(GAME.timerHandle) clearInterval(GAME.timerHandle);
  const results = GAME.results;
  const totalScore = results.reduce((a,r)=>a+r.score,0);
  const maxScore = results.length*150;
  const pct = Math.round((totalScore/maxScore)*100);

  let rating, rank;
  if(pct>=90){ rating='Prompt Master'; rank='S'; }
  else if(pct>=75){ rating='Prompt Architect'; rank='A'; }
  else if(pct>=60){ rating='Skilled Prompter'; rank='B'; }
  else if(pct>=40){ rating='Developing Prompter'; rank='C'; }
  else { rating='Prompt Novice'; rank='D'; }

  function axisFor(type){
    const rs = results.filter(r=>r.type===type);
    if(rs.length===0) return 70;
    const avg = rs.reduce((a,r)=>a + Math.max(0,100-(r.wrong*25)),0)/rs.length;
    return Math.round(Math.max(0,Math.min(100,avg)));
  }
  const structure = axisFor('build');
  const clarity = axisFor('clean');
  const specificity = axisFor('choose');
  const avgTime = results.reduce((a,r)=>a+r.time,0)/results.length;
  const avgMoves = results.reduce((a,r)=>a+r.moves,0)/results.length;
  const efficiency = Math.round(Math.max(0,Math.min(100, 100 - (avgTime-20)*1.5 - (avgMoves-6)*3)));
  const bonusCount = results.filter(r=>r.optBonus).length;
  const optimization = Math.round((bonusCount/results.length)*100);

  const axes = [
    {label:'Structure', val:structure},
    {label:'Clarity', val:clarity},
    {label:'Specificity', val:specificity},
    {label:'Efficiency', val:Math.max(0,efficiency)},
    {label:'Optimization', val:optimization}
  ];

  const cx=150, cy=150, r=110;
  const angleStep = (Math.PI*2)/axes.length;
  function pointAt(val, i){
    const angle = -Math.PI/2 + i*angleStep;
    const dist = (val/100)*r;
    return [cx+dist*Math.cos(angle), cy+dist*Math.sin(angle)];
  }
  const dataPoints = axes.map((a,i)=>pointAt(a.val,i).join(',')).join(' ');
  const gridLevels = [20,40,60,80,100];
  const gridPolys = gridLevels.map(lvl=>{
    return axes.map((a,i)=>pointAt(lvl,i).join(',')).join(' ');
  });
  const labelPoints = axes.map((a,i)=>{
    const angle = -Math.PI/2 + i*angleStep;
    const lx = cx + (r+28)*Math.cos(angle);
    const ly = cy + (r+28)*Math.sin(angle);
    return {x:lx, y:ly, label:a.label, val:a.val};
  });

  const axesLines = axes.map((a,i)=>{
    const [x,y] = pointAt(100,i);
    return `<line x1="${cx}" y1="${cy}" x2="${x}" y2="${y}" stroke="rgba(255,255,255,.12)" stroke-width="1"/>`;
  }).join('');
  const gridSvg = gridPolys.map(p=>`<polygon points="${p}" fill="none" stroke="rgba(255,255,255,.08)" stroke-width="1"/>`).join('');
  const labelsSvg = labelPoints.map(l=>`<text x="${l.x}" y="${l.y}" fill="#9aa3c7" font-size="11" text-anchor="middle">${l.label} (${l.val})</text>`).join('');

  const weakestAxis = axes.slice().sort((a,b)=>a.val-b.val)[0];
  const feedbackMap = {
    Structure:'Practice ordering your prompt as Role → Context → Task → Constraints → Format so nothing essential is left implicit.',
    Clarity:'Focus on stripping filler, contradictory tone requests, and off-topic asks — keep only clauses that serve the goal.',
    Specificity:'When comparing prompt options, look for the one with concrete detail without unnecessary bulk — precision beats volume.',
    Efficiency:'Try to resolve each puzzle with fewer exploratory moves — read all blocks/options once before committing.',
    Optimization:'Aim for zero-hint, zero-mistake runs to consistently earn the optimization bonus.'
  };
  const feedback = feedbackMap[weakestAxis.label];
  const nextMilestone = pct<90
    ? `Reach ${Math.min(100, pct+15)}% to advance toward "${pct>=75?'Prompt Master':'Prompt Architect'}" status.`
    : `You're at peak performance — try a full run with zero hints and zero wrong placements for a flawless S-Rank.`;

  const lastBuild = GAME.scenarios.find(s=>s.type==='build');
  const finalPrompt = lastBuild ? lastBuild.optimizedPrompt : (GAME.scenarios[0].optimizedPrompt||'');

  const app = document.getElementById('app');
  app.innerHTML = `
    <div class="card center">
      <span class="badge">Prompt Performance Report</span>
      <h2 class="scenario-title" style="font-size:1.4rem;">Session Complete 🎉</h2>
      <div class="rank-badge">${rank}</div>
      <div style="font-size:1.1rem; font-weight:700; margin-top:6px;">${rating}</div>
      <div style="color:var(--muted); font-size:.85rem;">Prompt Score: <b class="score-pop" style="color:var(--text); font-size:1.1rem;">${totalScore}</b> / ${maxScore} (${pct}%)</div>

      <div class="report-grid">
        <div class="stat-box"><div class="val">${pct}%</div><div class="lbl">Accuracy</div></div>
        <div class="stat-box"><div class="val">${Math.round(avgTime)}s</div><div class="lbl">Avg Time</div></div>
        <div class="stat-box"><div class="val">${Math.round(avgMoves)}</div><div class="lbl">Avg Moves</div></div>
        <div class="stat-box"><div class="val">${results.reduce((a,r)=>a+r.wrong,0)}</div><div class="lbl">Wrong Placements</div></div>
        <div class="stat-box"><div class="val">${results.reduce((a,r)=>a+r.hints,0)}</div><div class="lbl">Hints Used</div></div>
        <div class="stat-box"><div class="val">${bonusCount}</div><div class="lbl">Optimization Bonuses</div></div>
      </div>

      <div style="font-size:.78rem; color:var(--muted); text-transform:uppercase; letter-spacing:.5px; margin-top:10px;">Prompt DNA</div>
      <div class="dna-wrap">
        <svg width="300" height="300" viewBox="0 0 300 300">
          ${gridSvg}
          ${axesLines}
          <polygon points="${dataPoints}" fill="rgba(124,92,255,.35)" stroke="#7c5cff" stroke-width="2"/>
          ${labelsSvg}
        </svg>
      </div>

      <div class="feedback-box">
        <b>🧠 Personalized Feedback:</b> ${feedback}<br><br>
        <b>🎯 Next Milestone:</b> ${nextMilestone}
      </div>

      <div style="text-align:left;">
        <div style="font-size:.78rem; color:var(--muted); text-transform:uppercase; letter-spacing:.5px; margin-top:4px;">Example: A Fully Optimized Prompt</div>
        <div class="final-prompt">${finalPrompt}</div>
      </div>

      <div class="row" style="margin-top:22px; justify-content:center;">
        <button class="btn" id="replayBtn">🔁 Play Again (New Scenarios)</button>
      </div>
    </div>
  `;
  document.getElementById('replayBtn').onclick = ()=>{ newGame(); renderScenario(); };
}

/* ============================= INIT ============================= */
renderIntro();
</script>
